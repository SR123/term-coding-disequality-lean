 0} v 2))))))))","unsafe":false,"value":330,"source":{"code":"theorem mem_cutSet (K : Finset g.base.Tm) (v : ℕ) :\n    v ∈ g.cutSet hv K ↔ v ∈ g.network.nodes ∧ (v = g.netS ∨\n      (v / 2 < g.base.nodes.length ∧\n        ((v % 2 = 0 ∧ g.Pre K (g.base.termD (g.baseValid hv) (v / 2))) ∨\n         (v % 2 = 1 ∧ Avoids K (g.base.termD (g.baseValid hv) (v / 2)))))) := by\n  unfold cutSet\n  rw [Finset.mem_filter, List.mem_toFinset]","start":467,"end":473,"lines":[[{"text":"theorem mem_cutSet (K : "},{"text":"Finset","name":"Finset"},{"text":" "},{"text":"g.base.Tm","name":"DisequalityDispersion.Encoded.Instance.Tm"},{"text":") (v : "},{"text":"ℕ","name":"Nat"},{"text":") :"}],[{"text":"    "},{"text":"v ∈ g.cutSet hv K","name":"Membership.mem"},{"text":" ↔ "},{"text":"v ∈ g.network.nodes","name":"Membership.mem"},{"text":" ∧ ("},{"text":"v = g.netS","name":"Eq"},{"text":" ∨"}],[{"text":"      ("},{"text":"v / 2","name":"HDiv.hDiv"},{"text":" < "},{"text":"g.base.nodes.length","name":"List.length"},{"text":" ∧"}],[{"text":"        ("},{"text":"(v % 2 = 0 ∧ g.Pre K (g.base.termD (g.baseValid hv) (v / 2)))","name":"And"},{"text":" ∨"}],[{"text":"         "},{"text":"(v % 2 = 1 ∧ Avoids K (g.base.termD (g.baseValid hv) (v / 2)))","name":"And"},{"text":"))) := by"}],[{"text":"  unfold "},{"text":"cutSet","name":"DisequalityDispersion.Encoded.GInstance.cutSet"}],[{"text":"  "},{"text":"rw [Finset.mem_filter, List.mem_toFinset]","name":"Iff.rfl"}]]},"steps":[{"after":[],"before":[0],"declaration":"DisequalityDispersion.Encoded.GInstance.mem_cutSet","elaborator":"[anonymous]","id":5678,"kind":"tactic","parent":0,"range":{"end":{"byte":20419,"column":43,"line":473},"start":{"byte":20357,"column":78,"line":471}},"syntax":"Lean.Parser.Term.byTactic","code":"by\n  unfold cutSet\n  rw [Finset.mem_filter, List.mem_toFinset]"},{"after":[],"before":[0],"declaration":"DisequalityDispersion.Encoded.GInstance.mem_cutSet","elaborator":"[anonymous]","id":5679,"kind":"tactic","parent":5678,"r