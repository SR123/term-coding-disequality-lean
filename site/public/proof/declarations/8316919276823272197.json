ype",134,581,"explicit"],["lambda","resourceExhausted",125,582,"explicit"],["lambda","permissionDenied",116,583,"explicit"],["lambda","invalidArgument",107,584,"explicit"],["lambda","noFileOrDirectory",98,585,"explicit"],["lambda","interrupted",89,586,"explicit"],["lambda","timeExpired",80,587,"explicit"],["lambda","protocolError",73,588,"explicit"],["lambda","illegalOperation",66,589,"explicit"],["lambda","unsatisfiedConstraints",59,590,"explicit"],["lambda","hardwareFault",52,591,"explicit"],["lambda","unsupportedOperation",45,592,"explicit"],["lambda","resourceVanished",38,593,"explicit"],["lambda","resourceBusy",31,594,"explicit"],["lambda","otherError",24,595,"explicit"],["lambda","alreadyExists",18,596,"explicit"],["lambda","motive",2,597,"explicit"],["lambda","userError",149,11,"explicit"],["lambda","unexpectedEof",145,599,"explicit"],["lambda","noSuchThing",143,600,"explicit"],["lambda","inappropriateType",134,601,"explicit"],["lambda","resourceExhausted",125,602,"explicit"],["lambda","permissionDenied",116,603,"explicit"],["lambda","invalidArgument",107,604,"explicit"],["lambda","noFileOrDirectory",98,605,"explicit"],["lambda","interrupted",89,606,"explicit"],["lambda","timeExpired",80,607,"explicit"],["lambda","protocolError",73,608,"explicit"],["lambda","illegalOperation",66,609,"explicit"],["lambda","unsatisfiedConstraints",59,610,"explicit"],["lambda","hardwareFault",52,611,"explicit"],["lambda","unsupportedOperation",45,612,"explicit"],["lambda","resourceVanished",38,613,"explicit"],["lambda","resourceBusy",31,614,"explicit"],["lambda","otherError",24,615,"explicit"],["lambda","alreadyExists",18,616,"explicit"],["lambda","motive",2,617,"explicit"],["apply",11,13],["lambda","msg",4,619,"explicit"],["lambda","userError",149,620,"explicit"],["lambda","unexpectedEof",145,621,"explicit"],["lambda","noSuchThing",143,622,"explicit"],["lambda","inappropriateType",134,623,"explicit"],["lambda","resourceExhausted",125,624,"explicit"],["lambda","permissionDenied",116,625,"explicit"],["lambda","invalidArgument",107,626,"explicit"],["lambda","noFileOrDirectory",98,627,"explicit"],["lambda","interrupted",89,628,"explicit"],["lambda","timeExpired",80,629,"explicit"],["lambda","protocolError",73,630,"explicit"],["lambda","illegalOperation",66,631,"explicit"],["lambda","unsatisfiedConstraints",59,632,"explicit"],["lambda","hardwareFault",52,633,"explicit"],["lambda","unsupportedOperation",45,634,"explicit"],["lambda","resourceVanished",38,635,"explicit"],["lambda","resourceBusy",31,636,"explicit"],["lambda","otherError",24,637,"explicit"],["lambda","alreadyExists",18,638,"explicit"],["lambda","motive",2,639,"explicit"]],"project":false,"range":{"column":0,"endColumn":28,"endLine":140,"line":15},"type":172,"typeText":"{motive : IO.Error → Sort u} →\n  ((filename : Option.{0} String) →\n      (osCode : UInt32) → (details : String) → motive (IO.Error.alreadyExists filename osCode details)) →\n    ((osCode : UInt32) → (details : String) → motive (IO.Error.otherError osCode details)) →\n      ((osCode : UInt32) → (details : String) → motive (IO.Error.resourceBusy osCode details)) →\n        ((osCode : UInt32) → (details : String) → motive (IO.Error.resourceVanished osCode details)) →\n          ((osCode : UInt32) → (details : String) → motive (IO.Error.unsupportedOperation osCode details)) →\n            ((osCode : UInt32) → (details : String) → motive (IO.Error.hardwareFault osCode details)) →\n              ((osCode : UInt32) → (details : String) → motive (IO.Error.unsatisfiedConstraints osCode details)) →\n                ((osCode : UInt32) → (details : String) → motive (IO.Error.illegalOperation osCode details)) →\n                  ((osCode : UInt32) → (details : String) → motive (IO.Error.protocolError osCode details)) →\n                    ((osCode : UInt32) → (details : String) → motive (IO.Error.timeExpired osCode details)) →\n                      ((filename : String) →\n                          (osCode : UInt32) →\n                            (details : String) → motive (IO.Error.interrupted filename osCode details)) →\n                        ((filename : String) →\n                            (osCode : UInt32) →\n                              (details : String) → motive (IO.Error.noFileOrDirectory filename osCode details)) →\n                          ((filename : Option.{0} String) →\n                              (osCode : UInt32) →\n                                (details : String) → motive (IO.Error.invalidArgument filename osCode details)) →\n                            ((filename : Option.{0} String) →\n                                (osCode : UInt32) →\n                                  (details : String) → motive (IO.Error.permissionDenied filename osCode details)) →\n                              ((filename : Option.{0} String) →\n                                  (osCode : UInt32) →\n                                    (details : String) → motive (IO.Error.resourceExhausted filename osCode details)) →\n                                ((filename : Option.{0} String) →\n                                    (osCode : UInt32) →\n                                      (details : String) →\n                                        motive (IO.Error.inappropriateType filename osCode details)) →\n                                  ((filename : Option.{0} String) →\n                                      (osCode : UInt32) →\n                                        (details : String) → motive (IO.Error.noSuchThing filename osCode details)) →\n                                    motive IO.Error.unexpectedEof →\n                                      ((msg : String) → motive (IO.Error.userError msg)) → (t : IO.Error) → motive t","unsafe":false,"value":null,"source":{"code":"/--\nExceptions that may be thrown in the `IO` monad.\n\nMany of the constructors of `IO.Error` correspond to POSIX error numbers. In these cases, the\ndocumentation string lists POSIX standard error macros that correspond to the error. This list is\nnot necessarily exhaustive, and these constructor includes a field for the underlying error number.\n-/\n-- Imitates the structure of IOErrorType in Haskell:\n-- https://hackage.haskell.org/package/base-4.12.0.0/docs/System-IO-Error.html#t:IOErrorType\ninductive IO.Error where\n  /--\n  The operation failed because a file already exists.\n\n  This corresponds to POSIX errors `EEXIST`, `EINPROGRESS`, and `EISCONN`.\n  -/\n  | alreadyExists (filename : Option String) (osCode : UInt32) (details : String)\n  /--\n  Some error not covered by the other constructors of `IO.Error` occurred.\n\n  This also includes POSIX error `EFAULT`.\n  -/\n  | otherError (osCode : UInt32) (details : String)\n  /--\n  A necessary resource was busy.\n\n  This corresponds to POSIX errors `EADDRINUSE`, `EBUSY`, `EDEADLK`, and `ETXTBSY`.\n  -/\n  | resourceBusy (osCode : UInt32) (details : String)\n  /--\n  A necessary resource is no longer available.\n\n  This corresponds to POSIX errors `ECONNRESET`, `EIDRM`, `ENETDOWN`, `ENETRESET`, `ENOLINK`, and\n  `EPIPE`.\n  -/\n  | resourceVanished (osCode : UInt32) (details : String)\n  /--\n  An operation was not supported.\n\n  This corresponds to POSIX errors `EADDRNOTAVAIL`, `EAFNOSUPPORT`, `ENODEV`, `ENOPROTOOPT`\n  `ENOSYS`, `EOPNOTSUPP`, `ERANGE`, `ESPIPE`, and `EXDEV`.\n  -/\n  | unsupportedOperation (osCode : UInt32) (details : String)\n  /--\n  The operation failed due to a hardware problem, such as an I/O error.\n\n  This corresponds to the POSIX error `EIO`.\n  -/\n  | hardwareFault (osCode : UInt32) (details : String)\n  /--\n  A constraint required by an operation was not satisfied (e.g. a directory was not empty).\n\n  This corresponds to the POSIX error `ENOTEMPTY`.\n  -/\n  | unsatisfiedConstraints (osCode : UInt32) (details : String)\n  /--\n  An inappropriate I/O control operation was attempted.\n\n  This corresponds to the POSIX error `ENOTTY`.\n  -/\n  | illegalOperation (osCode : UInt32) (details : String)\n  /--\n  A protocol error occurred.\n\n  This corresponds to the POSIX errors `EPROTO`, `EPROTONOSUPPORT`, and `EPROTOTYPE`.\n  -/\n  | protocolError (osCode : UInt32) (details : String)\n  /--\n  An operation timed out.\n\n  This corresponds to the POSIX errors `ETIME`, and `ETIMEDOUT`.\n  -/\n  | timeExpired (osCode : UInt32) (details : String)\n  /--\n  The operation was interrupted.\n\n  This corresponds to the POSIX error `EINTR`.\n  -/\n  | interrupted (filename : String) (osCode : UInt32) (details : String)\n  /--\n  No such file or directory.\n\n  This corresponds to the POSIX error `ENOENT`.\n  -/\n  | noFileOrDirectory (filename : String) (osCode : UInt32) (details : String)\n  /--\n  An argument to an I/O operation was invalid.\n\n  This corresponds to the POSIX errors `ELOOP`, `ENAMETOOLONG`, `EDESTADDRREQ`, `EILSEQ`, `EINVAL`, `EDOM`, `EBADF`\n  `ENOEXEC`, `ENOSTR`, `ENOTCONN`, and `ENOTSOCK`.\n  -/\n  | invalidArgument (filename : Option String) (osCode : UInt32) (details : String)\n\n  /--\n  An operation failed due to insufficient permissions.\n\n  This corresponds to the POSIX errors `EACCES`, `EROFS`, `ECONNABORTED`, `EFBIG`, and `EPERM`.\n  -/\n  | permissionDenied (filename : Option String) (osCode : UInt32) (details : String)\n\n  /--\n  A resource was exhausted.\n\n  This corresponds to the POSIX errors  `EMFILE`, `ENFILE`, `ENOSPC`, `E2BIG`, `EAGAIN`, `EMLINK`,\n  `EMSGSIZE`, `ENOBUFS`, `ENOLCK`, `ENOMEM`, and `ENOSR`.\n  -/\n  | resourceExhausted (filename : Option String) (osCode : UInt32) (details : String)\n\n  /--\n  An argument was the wrong type (e.g. a directory when a file was required).\n\n  This corresponds to the POSIX errors `EISDIR`, `EBADMSG`, and `ENOTDIR`.\n  -/\n  | inappropriateType (filename : Option String) (osCode : UInt32) (details : String)\n\n  /--\n  A required resource does not exist.\n\n  This corresponds to the POSIX errors `ENXIO`, `EHOSTUNREACH`, `ENETUNREACH`, `ECHILD`,\n  `ECONNREFUSED`, `ENODATA`, `ENOMSG`, and `ESRCH`.\n  -/\n  | noSuchThing (filename : Option String) (osCode : UInt32) (details : String)\n\n  /-- An unexpected end-of-file marker was encountered. -/\n  | unexpectedEof\n  /-- Some other error occurred. -/\n  | userError (msg : String)","start":15,"end":140},"axioms":[]}