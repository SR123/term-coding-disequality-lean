7,"implicit"],["lambda","f",3,1008,"implicit"],["lambda","β",1,1009,"implicit"],["lambda","α",0,1010,"implicit"]],"project":false,"range":{"column":0,"endColumn":27,"endLine":212,"line":201},"type":57,"typeText":"∀ {α : Type u} {β : Type v} {f : α → β} {l : List.{u} α},\n  List.Nodup.{v} (List.map.{u, v} f l) →\n    ∀ ⦃x : α⦄,\n      Membership.mem.{u, u} l x → ∀ ⦃y : α⦄, Membership.mem.{u, u} l y → Eq.{v + 1} (f x) (f y) → Eq.{u + 1} x y","unsafe":false,"value":1011,"source":{"code":"theorem inj_on_of_nodup_map {f : α → β} {l : List α} (d : Nodup (map f l)) :\n    ∀ ⦃x⦄, x ∈ l → ∀ ⦃y⦄, y ∈ l → f x = f y → x = y := by\n  induction l with\n  | nil => simp\n  | cons hd tl ih =>\n    simp only [map, nodup_cons, mem_map, not_exists, not_and, ← Ne.eq_def] at d\n    simp only [mem_cons]\n    rintro _ (rfl | h₁) _ (rfl | h₂) h₃\n    · rfl\n    · apply (d.1 _ h₂ h₃.symm).elim\n    · apply (d.1 _ h₁ h₃).elim\n    · apply ih d.2 h₁ h₂ h₃","start":201,"end":212},"axioms":["Quot.sound","propext"]}