typeText":"{α : Type u_1} → [DecidableEq.{u_1 + 1} α] → Multiset.{u_1} α → Multiset.{u_1} α → Multiset.{u_1} α","unsafe":false,"value":51,"source":{"code":"/-- `s ∩ t` is the multiset such that the multiplicity of each `a` in it is the minimum of the\nmultiplicity of `a` in `s` and `t`. This is the infimum of multisets. -/\ndef inter (s t : Multiset α) : Multiset α :=\n  Quotient.liftOn₂ s t (fun l₁ l₂ => (l₁.bagInter l₂ : Multiset α)) fun _v₁ _v₂ _w₁ _w₂ p₁ p₂ =>\n    Quot.sound <| p₁.bagInter p₂","start":86,"end":90},"axioms":["Classical.choice","Quot.sound","propext"]}