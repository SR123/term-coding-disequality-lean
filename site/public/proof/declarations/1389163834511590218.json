6,"source":{"code":"/-- In a nontrivial monoid with zero, zero and one are different. -/\ninstance NeZero.one : NeZero (1 : M₀) := ⟨by\n  intro h\n  rcases exists_pair_ne M₀ with ⟨x, y, hx⟩\n  apply hx\n  calc\n    x = 1 * x := by rw [one_mul]\n    _ = 0 := by rw [h, zero_mul]\n    _ = 1 * y := by rw [h, zero_mul]\n    _ = y := by rw [one_mul]⟩","start":26,"end":35},"axioms":[]}