,"explicit"],["lambda","rl",220,1478,"explicit"],["lambda","rv",846,1479,"explicit"],["lambda","rk",216,1480,"explicit"],["lambda","rs",145,1481,"explicit"],["apply",845,1482],["lambda","h",546,1483,"explicit"],["lambda","hl",533,1484,"explicit"],["lambda","lr",527,1485,"explicit"],["lambda","ll",70,1486,"explicit"],["lambda","lv",525,1487,"explicit"],["lambda","lk",53,1488,"explicit"],["lambda","ls",145,1489,"explicit"],["apply",524,1490],["lambda","h",36,1491,"explicit"],["lambda","hr",22,1492,"explicit"],["lambda","hl",18,1493,"explicit"],["lambda","r",13,1494,"explicit"],["lambda","l",10,1495,"explicit"],["lambda","v",5,1496,"explicit"],["lambda","k",4,1497,"explicit"],["lambda","β",3,1498,"implicit"],["lambda","α",0,1499,"implicit"]],"project":false,"range":{"column":0,"endColumn":36,"endLine":342,"line":280},"type":48,"typeText":"{α : Type u} →\n  {β : α → Type v} →\n    (k : α) →\n      β k →\n        (l r : Std.DTreeMap.Internal.Impl.{u, v} α β) →\n          Std.DTreeMap.Internal.Impl.Balanced.{u, v} l →\n            Std.DTreeMap.Internal.Impl.Balanced.{u, v} r →\n              Or\n                  (Std.DTreeMap.Internal.Impl.BalanceLErasePrecond (Std.DTreeMap.Internal.Impl.size.{u, v} l)\n                    (Std.DTreeMap.Internal.Impl.size.{u, v} r))\n                  (Std.DTreeMap.Internal.Impl.BalanceLErasePrecond (Std.DTreeMap.Internal.Impl.size.{u, v} r)\n                    (Std.DTreeMap.Internal.Impl.size.{u, v} l)) →\n                Std.DTreeMap.Internal.Impl.{u, v} α β","unsafe":false,"value":1500,"source":{"code":"/-- Rebalances a tree after at most one element was added or removed from either subtree. -/\ndef balance (k : α) (v : β k) (l r : Impl α β) (hl : Balanced l) (hr : Balanced r)\n    (h : BalanceLErasePrecond l.size r.size ∨\n      BalanceLErasePrecond r.size l.size) : Impl α β :=\n  match l with\n  | .leaf =>\n    match r with\n    | .leaf => .inner 1 k v .leaf .leaf\n    | .inner _ _ _ .leaf .leaf => .inner 2 k v .leaf r\n    | .inner _ rk rv .leaf rr@(.inner _ _ _ _ _) => .inner 3 rk rv (.inner 1 k v .leaf .leaf) rr\n    | .inner _ rk rv (.inner _ rlk rlv _ _) .leaf => .inner 3 rlk rlv (.inner 1 k v .leaf .leaf)\n        (.inner 1 rk rv .leaf .leaf)\n    | .inner rs rk rv (.inner rls rlk rlv rll rlr) rr@(.inner rrs _ _ _ _) =>\n        .inner (1 + rs) rk rv (.inner (1 + rls) k v .leaf (.inner rls rlk rlv rll rlr)) rr\n  | .inner ls lk lv ll lr =>\n    match r with\n    | .leaf =>\n      match ll, lr with\n      | .leaf, .leaf => .inner 2 k v l .leaf\n      | .leaf, .inner _ lrk lrv _ _ => .inner 3 lrk lrv (.inner 1 lk lv .leaf .leaf)\n          (.inner 1 k v .leaf .leaf)\n      | .inner _ _ _ _ _, .leaf => .inner 3 lk lv ll (.inner 1 k v .leaf .leaf)\n      | .inner lls _ _ _ _, .inner lrs lrk lrv lrl lrr =>\n        .inner (1 + ls) lk lv ll (.inner (1 + lrs) k v (.inner lrs lrk lrv lrl lrr) .leaf)\n    | .inner rs rk rv rl rr =>\n      if h₁ : delta * ls < rs then\n        match rl, rr with\n        | .inner rls rlk rlv rll rlr, .inner rrs _ _ _ _ =>\n          if rls < ratio * rrs then\n            .inner (1 + ls + rs) rk rv (.inner (1 + ls + rls) k v l rl) rr\n          else\n            .inner (1 + ls + rs) rlk rlv (.inner (1 + ls + rll.size) k v l rll)\n              (.inner (1 + rrs + rlr.size) rk rv rlr rr)\n        | inner _ _ _ _ _, .leaf => False.elim (by\n          simp only [balanced_inner_iff, size_inner, size_leaf, balancedAtRoot_zero_iff'] at hr\n          simp only [delta] at h₁\n          have := hl.one_le\n          omega)\n        | .leaf, _ => False.elim (by\n          simp only [balanced_inner_iff, size_leaf, balancedAtRoot_zero_iff] at hr\n          simp only [delta] at h₁\n          have := hl.one_le\n          omega)\n      else if h₂ : delta * rs < ls then\n        match ll, lr with\n        | .inner lls _ _ _ _, .inner lrs lrk lrv lrl lrr =>\n          if lrs < ratio * lls then\n            .inner (1 + ls + rs) lk lv ll (.inner (1 + rs + lrs) k v lr r)\n          else\n            .inner (1 + ls + rs) lrk lrv (.inner (1 + lls + lrl.size) lk lv ll lrl)\n              (.inner (1 + rs + lrr.size) k v lrr r)\n        | inner _ _ _ _ _, .leaf => False.elim (by\n          simp only [balanced_inner_iff, size_inner, size_leaf, balancedAtRoot_zero_iff'] at hl\n          simp only [delta] at h₂\n          have := hr.one_le\n          omega)\n        | .leaf, _ => False.elim (by\n          simp only [balanced_inner_iff, size_leaf, balancedAtRoot_zero_iff] at hl\n          simp only [delta] at h₂\n          have := hr.one_le\n          omega)\n      else\n        .inner (1 + ls + rs) k v l r","start":280,"end":342},"axioms":["Classical.choice","Quot.sound","propext"]}