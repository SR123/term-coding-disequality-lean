":false,"range":{"column":0,"endColumn":71,"endLine":43,"line":31},"type":16,"typeText":"∀ {p : Nat → Prop}, (∃ n, p n) → WellFounded.{1} Nat.lbp✝","unsafe":false,"value":222,"source":{"code":"private def wf_lbp : WellFounded (@lbp p) :=\n  ⟨let ⟨n, pn⟩ := H\n    suffices ∀ m k, n ≤ k + m → Acc lbp k from fun _ => this _ _ (Nat.le_add_left _ _)\n    fun m =>\n    Nat.recOn m\n      (fun _ kn =>\n        ⟨_, fun y r =>\n          match y, r with\n          | _, ⟨rfl, a⟩ => absurd pn (a _ kn)⟩)\n      fun m IH k kn =>\n      ⟨_, fun y r =>\n        match y, r with\n        | _, ⟨rfl, _a⟩ => IH _ (by rw [Nat.add_right_comm]; exact kn)⟩⟩","start":31,"end":43},"axioms":[]}