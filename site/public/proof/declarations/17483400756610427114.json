apply",328,571],["apply",572,333],["apply",458,573],["apply",570,574],["lambda","x",0,575,"explicit"],["apply",563,576],["constant","Nat.sub_sub",[]],["apply",578,414],["apply",579,389],["apply",580,362],["apply",577,581],["apply",561,582],["constant","eq_self",[["succ",["zero"]]]],["apply",584,0],["apply",585,548],["apply",583,586],["apply",551,587],["apply",542,588],["apply",517,589],["apply",490,590],["let","h₃",368,442,591,true],["let","h₂",342,358,592,true],["lambda","h₁",337,593,"explicit"],["lambda","IH",231,594,"explicit"],["lambda","p",0,595,"explicit"],["apply",319,596],["apply",597,19],["apply",598,14],["lambda","h₀",76,599,"explicit"],["apply",211,600],["lambda","h₁",20,601,"explicit"],["lambda","p",0,602,"explicit"],["lambda","n",0,603,"explicit"],["lambda","x",0,604,"explicit"]],"project":false,"range":{"column":0,"endColumn":34,"endLine":376,"line":362},"type":57,"typeText":"∀ (x n p : Nat),\n  LE.le.{0} (HMul.hMul.{0, 0, 0} n p) x →\n    Eq.{1} (HDiv.hDiv.{0, 0, 0} (HSub.hSub.{0, 0, 0} x (HMul.hMul.{0, 0, 0} n p)) n)\n      (HSub.hSub.{0, 0, 0} (HDiv.hDiv.{0, 0, 0} x n) p)","unsafe":false,"value":605,"source":{"code":"/-- See also `sub_mul_div` for a strictly more general version. -/\ntheorem sub_mul_div_of_le (x n p : Nat) (h₁ : n*p ≤ x) : (x - n*p) / n = x / n - p := by\n  match eq_zero_or_pos n with\n  | .inl h₀ => rw [h₀, Nat.div_zero, Nat.div_zero, Nat.zero_sub]\n  | .inr h₀ => induction p with\n    | zero => rw [Nat.mul_zero, Nat.sub_zero, Nat.sub_zero]\n    | succ p IH =>\n      have h₂ : n * p ≤ x := Nat.le_trans (Nat.mul_le_mul_left _ (le_succ _)) h₁\n      have h₃ : x - n * p ≥ n := by\n        apply Nat.le_of_add_le_add_right\n        rw [Nat.sub_add_cancel h₂, Nat.add_comm]\n        rw [mul_succ] at h₁\n        exact h₁\n      rw [sub_succ, ← IH h₂, div_eq_sub_div h₀ h₃]\n      simp [mul_succ, Nat.sub_sub]","start":362,"end":376},"axioms":["propext"]}