.Ring.GeomSum.2232220491._hygCtx._hyg.4",3,613,"instance"],["lambda","R",0,614,"implicit"]],"project":false,"range":{"column":0,"endColumn":35,"endLine":185,"line":181},"type":178,"typeText":"∀ {R : Type u_1} [inst : Ring.{u_1} R] {x y : R},\n  Commute.{u_1} x y →\n    ∀ (n : Nat),\n      Eq.{u_1 + 1}\n        (HMul.hMul.{u_1, u_1, u_1}\n          (∑ i ∈ Finset.range n,\n            HMul.hMul.{u_1, u_1, u_1} (HPow.hPow.{u_1, 0, u_1} x i)\n              (HPow.hPow.{u_1, 0, u_1} y (HSub.hSub.{0, 0, 0} (HSub.hSub.{0, 0, 0} n 1) i)))\n          (HSub.hSub.{u_1, u_1, u_1} x y))\n        (HSub.hSub.{u_1, u_1, u_1} (HPow.hPow.{u_1, 0, u_1} x n) (HPow.hPow.{u_1, 0, u_1} y n))","unsafe":false,"value":615,"source":{"code":"protected lemma Commute.geom_sum₂_mul (h : Commute x y) (n : ℕ) :\n    (∑ i ∈ range n, x ^ i * y ^ (n - 1 - i)) * (x - y) = x ^ n - y ^ n := by\n  have := (h.sub_left (Commute.refl y)).geom_sum₂_mul_add n\n  rw [sub_add_cancel] at this\n  rw [← this, add_sub_cancel_right]","start":181,"end":185},"axioms":["Classical.choice","Quot.sound","propext"]}