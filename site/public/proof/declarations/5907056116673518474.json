,204,500],["lambda","b",45,501,"implicit"],["lambda","a",44,502,"implicit"],["lambda","inst._@.Mathlib.Topology.Order.IntermediateValue.1786278073._hygCtx._hyg.12",43,503,"instance"],["lambda","inst._@.Mathlib.Topology.Order.IntermediateValue.1786278073._hygCtx._hyg.9",26,504,"instance"],["lambda","inst._@.Mathlib.Topology.Order.IntermediateValue.1786278073._hygCtx._hyg.6",6,505,"instance"],["lambda","inst._@.Mathlib.Topology.Order.IntermediateValue.1786278073._hygCtx._hyg.3",3,506,"instance"],["lambda","α",0,507,"implicit"]],"project":false,"range":{"column":0,"endColumn":63,"endLine":429,"line":419},"type":72,"typeText":"∀ {α : Type u} [inst : ConditionallyCompleteLinearOrder.{u} α] [inst_1 : TopologicalSpace.{u} α] [OrderTopology.{u} α]\n  [DenselyOrdered.{u} α] {a b : α}, IsPreconnected.{u} (Set.Icc.{u} a b)","unsafe":false,"value":508,"source":{"code":"/-- A closed interval in a densely ordered conditionally complete linear order is preconnected. -/\ntheorem isPreconnected_Icc : IsPreconnected (Icc a b) :=\n  isPreconnected_closed_iff.2\n    (by\n      rintro s t hs ht hab ⟨x, hx⟩ ⟨y, hy⟩\n      -- This used to use `wlog`, but it was causing timeouts.\n      rcases le_total x y with h | h\n      · exact isPreconnected_Icc_aux x y s t h hs ht hab hx hy\n      · rw [inter_comm s t]\n        rw [union_comm s t] at hab\n        exact isPreconnected_Icc_aux y x t s h ht hs hab hy hx)","start":419,"end":429},"axioms":["Classical.choice","Quot.sound","propext"]}