code":"theorem HasBasis.inf' (hl : l.HasBasis p s) (hl' : l'.HasBasis p' s') :\n    (l ⊓ l').HasBasis (fun i : PProd ι ι' => p i.1 ∧ p' i.2) fun i => s i.1 ∩ s' i.2 :=\n  ⟨by\n    intro t\n    constructor\n    · simp only [mem_inf_iff, hl.mem_iff, hl'.mem_iff]\n      rintro ⟨t, ⟨i, hi, ht⟩, t', ⟨i', hi', ht'⟩, rfl⟩\n      exact ⟨⟨i, i'⟩, ⟨hi, hi'⟩, inter_subset_inter ht ht'⟩\n    · rintro ⟨⟨i, i'⟩, ⟨hi, hi'⟩, H⟩\n      exact mem_inf_of_inter (hl.mem_of_mem hi) (hl'.mem_of_mem hi') H⟩","start":391,"end":400},"axioms":["Quot.sound","propext"]}