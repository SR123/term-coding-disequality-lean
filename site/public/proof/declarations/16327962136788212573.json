"],["apply",1099,1108],["apply",573,1021],["apply",1110,230],["apply",1109,1111],["apply",1097,1112],["apply",1094,1113],["apply",228,1093],["apply",1020,1061],["apply",32,1116],["apply",1117,1091],["apply",1063,1118],["apply",1115,1119],["apply",268,1093],["apply",1121,1119],["apply",174,1122],["apply",273,1089],["apply",1124,1116],["apply",472,276],["apply",81,1126],["apply",1106,1127],["lambda","_a",0,1128,"explicit"],["apply",1125,1129],["apply",293,1116],["apply",1131,1089],["apply",1081,276],["apply",1133,33],["apply",1132,1134],["apply",1130,1135],["apply",1123,1136],["apply",1120,1137],["apply",228,1119],["apply",43,1091],["apply",1140,1061],["apply",1013,1141],["apply",23,1142],["apply",1143,1061],["apply",14,1144],["apply",1145,1118],["apply",1139,1146],["apply",268,1119],["apply",1148,1146],["apply",174,1149],["apply",273,1015],["apply",1151,1141],["apply",1100,3],["apply",23,1153],["apply",1154,1091],["apply",14,1155],["apply",1071,1091],["apply",32,1157],["apply",1158,1126],["apply",1156,1159],["lambda","_a",0,1160,"explicit"],["apply",1152,1161],["apply",293,1141],["apply",1163,1015],["constant","Int.neg_mul_neg",[]],["apply",1165,230],["apply",1166,33],["apply",1164,1167],["apply",1162,1168],["apply",1150,1169],["apply",1147,1170],["apply",46,276],["apply",1172,1091],["apply",1173,1061],["constant","Int.neg_pos_of_neg",[]],["apply",1175,33],["apply",1176,3],["apply",1174,1177],["apply",1171,1178],["apply",1138,1179],["apply",1114,1180],["apply",1087,1181],["apply",1059,1182],["lambda","hlt",1006,1183,"explicit"],["apply",1030,1184],["constant","absurd",[["zero"]]],["apply",14,33],["apply",1187,11],["apply",1186,1188],["apply",1189,1024],["apply",1190,3],["apply",1191,44],["lambda","HEq",1009,1192,"explicit"],["apply",1185,1193],["apply",1172,230],["apply",1195,33],["apply",1196,3],["lambda","hgt",863,1197,"explicit"],["apply",1194,1198],["let","this",79,1001,1199,true],["lambda","H",12,1200,"explicit"],["lambda","c",0,1201,"implicit"],["lambda","b",0,1202,"explicit"],["lambda","a",0,1203,"explicit"]],"project":false,"range":{"column":0,"endColumn":66,"endLine":178,"line":150},"type":60,"typeText":"∀ (a b : Int) {c : Int},\n  Ne.{1} c 0 →\n    Eq.{1} (HDiv.hDiv.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} a (HMul.hMul.{0, 0, 0} b c)) c)\n      (HAdd.hAdd.{0, 0, 0} (HDiv.hDiv.{0, 0, 0} a c) b)","unsafe":false,"value":1204,"source":{"code":"theorem add_mul_ediv_right (a b : Int) {c : Int} (H : c ≠ 0) : (a + b * c) / c = a / c + b :=\n  suffices ∀ {{a b c : Int}}, 0 < c → (a + b * c).ediv c = a.ediv c + b from\n    match Int.lt_trichotomy c 0 with\n    | Or.inl hlt => by\n      rw [← Int.neg_inj, ← Int.ediv_neg, Int.neg_add, ← Int.ediv_neg, ← Int.neg_mul_neg]\n      exact this (Int.neg_pos_of_neg hlt)\n    | Or.inr (Or.inl HEq) => absurd HEq H\n    | Or.inr (Or.inr hgt) => this hgt\n  suffices ∀ {k n : Nat} {a : Int}, (a + n * k.succ).ediv k.succ = a.ediv k.succ + n from\n    fun a b c H => match c, eq_succ_of_zero_lt H, b with\n      | _, ⟨_, rfl⟩, ofNat _ => this\n      | _, ⟨k, rfl⟩, -[n+1] => show (a - n.succ * k.succ).ediv k.succ = a.ediv k.succ - n.succ by\n        rw [← Int.add_sub_cancel (ediv ..), ← this, Int.sub_add_cancel]\n  fun {k n} => @fun\n  | ofNat _ => congrArg ofNat <| Nat.add_mul_div_right _ _ k.succ_pos\n  | -[m+1] => by\n    change ((n * k.succ : Nat) - m.succ : Int).ediv k.succ = n - (m / k.succ + 1 : Nat)\n    by_cases h : m < n * k.succ\n    · rw [← Int.ofNat_sub h, ← Int.ofNat_sub ((Nat.div_lt_iff_lt_mul k.succ_pos).2 h)]\n      apply congrArg ofNat\n      rw [Nat.mul_comm, Nat.mul_sub_div]; rwa [Nat.mul_comm]\n    · have h := Nat.not_lt.1 h\n      have H {a b : Nat} (h : a ≤ b) : (a : Int) + -((b : Int) + 1) = -[b - a +1] := by\n        rw [negSucc_eq, Int.ofNat_sub h]\n        simp only [Int.sub_eq_add_neg, Int.neg_add, Int.neg_neg, Int.add_left_comm, Int.add_assoc]\n      change ediv (↑(n * succ k) + -((m : Int) + 1)) (succ k) = n + -(↑(m / succ k) + 1 : Int)\n      rw [H h, H ((Nat.le_div_iff_mul_le k.succ_pos).2 h)]\n      apply congrArg negSucc\n      rw [Nat.mul_comm, Nat.sub_mul_div_of_le]; rwa [Nat.mul_comm]","start":150,"end":178},"axioms":["propext"]}