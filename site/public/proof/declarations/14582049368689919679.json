      | cons y ys =>\n        simp only [set_cons_zero, dot_cons₂, get_cons_zero, Int.sub_mul]\n        rw [Int.add_right_comm, Int.add_comm (x * y), Int.sub_add_cancel]\n    | succ i =>\n      cases ys with\n      | nil => simp\n      | cons y ys => simp_all [Int.add_assoc]","start":281,"end":299},"axioms":["Quot.sound","propext"]}