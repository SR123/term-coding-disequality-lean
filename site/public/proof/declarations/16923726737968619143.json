{"dependencies":["Complex.partialOrder._proof_3","Real","Complex.partialOrder._proof_4","And","Complex.re","Real.instLE","LT.lt","Complex","Complex.partialOrder._proof_1","PartialOrder.mk","Real.instLT","PartialOrder","LE.mk","LE.le","Complex.partialOrder._proof_2","Preorder.mk","LT.mk","Eq","Complex.im"],"doc":"We put a partial order on ℂ so that `z ≤ w` exactly if `w - z` is real and nonnegative.\nComplex numbers with different imaginary parts are incomparable.\n","extra":null,"kind":"definition","levels":[],"module":"Mathlib.Analysis.Complex.Order","name":"Complex.partialOrder","nodes":[["constant","PartialOrder",[["zero"]]],["constant","Complex",[]],["apply",0,1],["constant","PartialOrder.mk",[["zero"]]],["apply",3,1],["constant","Preorder.mk",[["zero"]]],["apply",5,1],["constant","LE.mk",[["zero"]]],["apply",7,1],["constant","And",[]],["constant","LE.le",[["zero"]]],["constant","Real",[]],["apply",10,11],["constant","Real.instLE",[]],["apply",12,13],["constant","Complex.re",[]],["bound",1],["apply",15,16],["apply",14,17],["bound",0],["apply",15,19],["apply",18,20],["apply",9,21],["constant","Eq",[["succ",["zero"]]]],["apply",23,11],["constant","Complex.im",[]],["apply",25,16],["apply",24,26],["apply",25,19],["apply",27,28],["apply",22,29],["lambda","w",1,30,"explicit"],["lambda","z",1,31,"explicit"],["apply",8,32],["apply",6,33],["constant","LT.mk",[["zero"]]],["apply",35,1],["constant","LT.lt",[["zero"]]],["apply",37,11],["constant","Real.instLT",[]],["apply",38,39],["apply",40,17],["apply",41,20],["apply",9,42],["apply",43,29],["lambda","w",1,44,"explicit"],["lambda","z",1,45,"explicit"],["apply",36,46],["apply",34,47],["constant","Complex.partialOrder._proof_1",[]],["apply",48,49],["constant","Complex.partialOrder._proof_2",[]],["apply",50,51],["constant","Complex.partialOrder._proof_3",[]],["apply",52,53],["apply",4,54],["constant","Complex.partialOrder._proof_4",[]],["apply",55,56]],"project":false,"range":{"column":0,"endColumn":56,"endLine":46,"line":35},"type":2,"typeText":"PartialOrder.{0} Complex","unsafe":false,"value":57,"source":{"code":"/-- We put a partial order on ℂ so that `z ≤ w` exactly if `w - z` is real and nonnegative.\nComplex numbers with different imaginary parts are incomparable.\n-/\nprotected def partialOrder : PartialOrder ℂ where\n  le z w := z.re ≤ w.re ∧ z.im = w.im\n  lt z w := z.re < w.re ∧ z.im = w.im\n  lt_iff_le_not_ge z w := by\n    rw [lt_iff_le_not_ge]\n    tauto\n  le_refl _ := ⟨le_rfl, rfl⟩\n  le_trans _ _ _ h₁ h₂ := ⟨h₁.1.trans h₂.1, h₁.2.trans h₂.2⟩\n  le_antisymm _ _ h₁ h₂ := ext (h₁.1.antisymm h₂.1) h₁.2","start":35,"end":46},"axioms":["Classical.choice","Quot.sound","propext"]}