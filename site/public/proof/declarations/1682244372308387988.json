["apply",203,19],["apply",204,16],["apply",205,14],["apply",206,148],["apply",207,9],["apply",196,208],["constant","Function.Surjective.monoid._proof_2",[["param","u_2"],["param","u_1"]]],["apply",210,183],["apply",211,93],["apply",212,57],["apply",213,53],["apply",214,26],["apply",215,19],["apply",216,16],["apply",217,148],["apply",218,9],["apply",209,219],["let","__src._@.Mathlib.Algebra.Group.InjSurj.1372201069._hygCtx._hyg.78",152,164,220,false],["let","__src._@.Mathlib.Algebra.Group.InjSurj.1372201069._hygCtx._hyg.77",138,150,221,false],["lambda","npow",123,222,"explicit"],["lambda","mul",90,223,"explicit"],["lambda","one",52,224,"explicit"],["lambda","hf",22,225,"explicit"],["lambda","f",17,226,"explicit"],["lambda","inst._@.Mathlib.Algebra.Group.InjSurj.1372201069._hygCtx._hyg.16",15,227,"instance"],["lambda","inst._@.Mathlib.Algebra.Group.InjSurj.1372201069._hygCtx._hyg.10",12,228,"instance"],["lambda","inst._@.Mathlib.Algebra.Group.InjSurj.1372201069._hygCtx._hyg.7",7,229,"instance"],["lambda","inst._@.Mathlib.Algebra.Group.InjSurj.1372201069._hygCtx._hyg.4",4,230,"instance"],["lambda","M₂",1,231,"implicit"],["lambda","M₁",0,232,"implicit"]],"project":false,"range":{"column":0,"endColumn":44,"endLine":369,"line":357},"type":136,"typeText":"{M₁ : Type u_1} →\n  {M₂ : Type u_2} →\n    [inst : Mul.{u_2} M₂] →\n      [inst_1 : One.{u_2} M₂] →\n        [inst_2 : Pow.{u_2, 0} M₂ Nat] →\n          [inst_3 : Monoid.{u_1} M₁] →\n            (f : M₁ → M₂) →\n              Function.Surjective.{u_1 + 1, u_2 + 1} f →\n                Eq.{u_2 + 1} (f 1) 1 →\n                  (∀ (x y : M₁),\n                      Eq.{u_2 + 1} (f (HMul.hMul.{u_1, u_1, u_1} x y)) (HMul.hMul.{u_2, u_2, u_2} (f x) (f y))) →\n                    (∀ (x : M₁) (n : Nat),\n                        Eq.{u_2 + 1} (f (HPow.hPow.{u_1, 0, u_1} x n)) (HPow.hPow.{u_2, 0, u_2} (f x) n)) →\n                      Monoid.{u_2} M₂","unsafe":false,"value":233,"source":{"code":"/-- A type endowed with `1` and `*` is a monoid, if it admits a surjective map that preserves `1`\nand `*` to a monoid. See note [reducible non-instances]. -/\n@[to_additive\n/-- A type endowed with `0` and `+` is an additive monoid, if it admits a\nsurjective map that preserves `0` and `+` to an additive monoid. This version takes a custom `nsmul`\nas a `[SMul ℕ M₂]` argument. -/]\nprotected abbrev monoid [Monoid M₁] (f : M₁ → M₂) (hf : Surjective f) (one : f 1 = 1)\n    (mul : ∀ x y, f (x * y) = f x * f y) (npow : ∀ (x) (n : ℕ), f (x ^ n) = f x ^ n) : Monoid M₂ :=\n  { hf.semigroup f mul, hf.mulOneClass f one mul with\n    npow := fun n x => x ^ n,\n    npow_zero := hf.forall.2 fun x => by rw [← npow, pow_zero, ← one],\n    npow_succ := fun n => hf.forall.2 fun x => by\n      rw [← npow, pow_succ, ← npow, ← mul] }","start":357,"end":369},"axioms":["propext"]}