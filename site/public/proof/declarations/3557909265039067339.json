smul i a := neg_zsmul a i\n    neg_add_cancel := by simp [neg_add_cancel]\n    intCast_ofNat\n    | 0 => Int.cast_zero\n    | 1 => Int.cast_one\n    | _ + 2 => Int.cast_ofNat _\n    intCast_neg := Int.cast_neg\n    zsmul_natCast_eq_nsmul n a := natCast_zsmul a n }","start":55,"end":70},"axioms":["Quot.sound","propext"]}