lambda","inst._@.Mathlib.Algebra.Field.Basic.3045832005._hygCtx._hyg.4",4,674,"instance"],["lambda","L",1,675,"implicit"],["lambda","K",0,676,"implicit"]],"project":false,"range":{"column":0,"endColumn":74,"endLine":235,"line":223},"type":486,"typeText":"{K : Type u_1} →\n  {L : Type u_2} →\n    [inst : Zero.{u_1} K] →\n      [inst_1 : Add.{u_1} K] →\n        [inst_2 : One.{u_1} K] →\n          [inst_3 : Mul.{u_1} K] →\n            [inst_4 : Inv.{u_1} K] →\n              [inst_5 : Div.{u_1} K] →\n                [inst_6 : SMul.{0, u_1} Nat K] →\n                  [inst_7 : SMul.{0, u_1} NNRat K] →\n                    [inst_8 : Pow.{u_1, 0} K Nat] →\n                      [inst_9 : Pow.{u_1, 0} K Int] →\n                        [inst_10 : NatCast.{u_1} K] →\n                          [inst_11 : NNRatCast.{u_1} K] →\n                            (f : K → L) →\n                              Function.Injective.{u_1 + 1, u_2 + 1} f →\n                                [inst_12 : DivisionSemiring.{u_2} L] →\n                                  Eq.{u_2 + 1} (f 0) 0 →\n                                    Eq.{u_2 + 1} (f 1) 1 →\n                                      (∀ (x y : K),\n                                          Eq.{u_2 + 1} (f (HAdd.hAdd.{u_1, u_1, u_1} x y))\n                                            (HAdd.hAdd.{u_2, u_2, u_2} (f x) (f y))) →\n                                        (∀ (x y : K),\n                                            Eq.{u_2 + 1} (f (HMul.hMul.{u_1, u_1, u_1} x y))\n                                              (HMul.hMul.{u_2, u_2, u_2} (f x) (f y))) →\n                                          (∀ (x : K), Eq.{u_2 + 1} (f (Inv.inv.{u_1} x)) (Inv.inv.{u_2} (f x))) →\n                                            (∀ (x y : K),\n                                                Eq.{u_2 + 1} (f (HDiv.hDiv.{u_1, u_1, u_1} x y))\n                                                  (HDiv.hDiv.{u_2, u_2, u_2} (f x) (f y))) →\n                                              (∀ (n : Nat) (x : K),\n                                                  Eq.{u_2 + 1} (f (HSMul.hSMul.{0, u_1, u_1} n x))\n                                                    (HSMul.hSMul.{0, u_2, u_2} n (f x))) →\n                                                (∀ (q : NNRat) (x : K),\n                                                    Eq.{u_2 + 1} (f (HSMul.hSMul.{0, u_1, u_1} q x))\n                                                      (HSMul.hSMul.{0, u_2, u_2} q (f x))) →\n                                                  (∀ (x : K) (n : Nat),\n                                                      Eq.{u_2 + 1} (f (HPow.hPow.{u_1, 0, u_1} x n))\n                                                        (HPow.hPow.{u_2, 0, u_2} (f x) n)) →\n                                                    (∀ (x : K) (n : Int),\n                                                        Eq.{u_2 + 1} (f (HPow.hPow.{u_1, 0, u_1} x n))\n                                                          (HPow.hPow.{u_2, 0, u_2} (f x) n)) →\n                                                      (∀ (n : Nat), Eq.{u_2 + 1} (f ↑n) ↑n) →\n                                                        (∀ (q : NNRat), Eq.{u_2 + 1} (f ↑q) ↑q) →\n                                                          DivisionSemiring.{u_1} K","unsafe":false,"value":677,"source":{"code":"/-- Pullback a `DivisionSemiring` along an injective function. -/\n-- See note [reducible non-instances]\nprotected abbrev divisionSemiring [DivisionSemiring L] (zero : f 0 = 0) (one : f 1 = 1)\n    (add : ∀ x y, f (x + y) = f x + f y) (mul : ∀ x y, f (x * y) = f x * f y)\n    (inv : ∀ x, f x⁻¹ = (f x)⁻¹) (div : ∀ x y, f (x / y) = f x / f y)\n    (nsmul : ∀ (n : ℕ) (x), f (n • x) = n • f x) (nnqsmul : ∀ (q : ℚ≥0) (x), f (q • x) = q • f x)\n    (npow : ∀ (x) (n : ℕ), f (x ^ n) = f x ^ n) (zpow : ∀ (x) (n : ℤ), f (x ^ n) = f x ^ n)\n    (natCast : ∀ n : ℕ, f n = n) (nnratCast : ∀ q : ℚ≥0, f q = q) : DivisionSemiring K where\n  toSemiring := hf.semiring f zero one add mul nsmul npow natCast\n  __ := hf.groupWithZero f zero one mul inv div npow zpow\n  nnratCast_def q := hf <| by rw [nnratCast, NNRat.cast_def, div, natCast, natCast]\n  nnqsmul := (· • ·)\n  nnqsmul_def q a := hf <| by rw [nnqsmul, NNRat.smul_def, mul, nnratCast]","start":223,"end":235},"axioms":["Classical.choice","Quot.sound","propext"]}