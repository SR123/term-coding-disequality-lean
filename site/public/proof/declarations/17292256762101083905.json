,["lambda","s",6,240,"implicit"],["lambda","inst._@.Mathlib.Topology.Connected.Basic.329429118._hygCtx._hyg.8",3,241,"instance"],["lambda","α",0,242,"implicit"]],"project":false,"range":{"column":0,"endColumn":77,"endLine":108,"line":102},"type":70,"typeText":"∀ {α : Type u} [inst : TopologicalSpace.{u} α] {s : Set.{u} α},\n  (∀ (x : α),\n      Membership.mem.{u, u} s x →\n        ∀ (y : α),\n          Membership.mem.{u, u} s y →\n            ∃ t,\n              And (HasSubset.Subset.{u} t s)\n                (And (Membership.mem.{u, u} t x) (And (Membership.mem.{u, u} t y) (IsPreconnected.{u} t)))) →\n    IsPreconnected.{u} s","unsafe":false,"value":243,"source":{"code":"/-- If any two points of a set are contained in a preconnected subset,\nthen the original set is preconnected as well. -/\ntheorem isPreconnected_of_forall_pair {s : Set α}\n    (H : ∀ x ∈ s, ∀ y ∈ s, ∃ t, t ⊆ s ∧ x ∈ t ∧ y ∈ t ∧ IsPreconnected t) :\n    IsPreconnected s := by\n  rcases eq_empty_or_nonempty s with (rfl | ⟨x, hx⟩)\n  exacts [isPreconnected_empty, isPreconnected_of_forall x fun y => H x hx y]","start":102,"end":108},"axioms":["Classical.choice","Quot.sound","propext"]}