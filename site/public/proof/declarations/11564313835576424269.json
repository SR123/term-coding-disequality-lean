.{u_1, u_1} l a)","unsafe":false,"value":433,"source":{"code":"@[simp, grind =] theorem mem_eraseP_of_neg {l : List α} (pa : ¬p a) : a ∈ l.eraseP p ↔ a ∈ l := by\n  refine ⟨mem_of_mem_eraseP, fun al => ?_⟩\n  match exists_or_eq_self_of_eraseP p l with\n  | .inl h => rw [h]; assumption\n  | .inr ⟨c, l₁, l₂, h₁, h₂, h₃, h₄⟩ =>\n    rw [h₄]; rw [h₃] at al\n    have : a ≠ c := fun h => (h ▸ pa).elim h₂\n    simp [this] at al; simp [al]","start":132,"end":139},"axioms":["propext"]}