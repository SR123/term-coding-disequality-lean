a","ctx",0,519,"explicit"]],"project":false,"range":{"column":0,"endColumn":12,"endLine":1227,"line":1218},"type":54,"typeText":"∀ (ctx : Int.Linear.Context) (x : Int.Linear.Var) (p₁ p₂ p₃ : Int.Linear.Poly),\n  Eq.{1} (Int.Linear.eq_le_subst_nonpos_cert x p₁ p₂ p₃) Bool.true →\n    Eq.{1} (Int.Linear.Poly.denote' ctx p₁) 0 →\n      LE.le.{0} (Int.Linear.Poly.denote' ctx p₂) 0 → LE.le.{0} (Int.Linear.Poly.denote' ctx p₃) 0","unsafe":false,"value":520,"source":{"code":"theorem eq_le_subst_nonpos (ctx : Context) (x : Var) (p₁ : Poly) (p₂ : Poly) (p₃ : Poly)\n    : eq_le_subst_nonpos_cert x p₁ p₂ p₃ → p₁.denote' ctx = 0 → p₂.denote' ctx ≤ 0 → p₃.denote' ctx ≤ 0 := by\n  simp [eq_le_subst_nonpos_cert]\n  intro h\n  intro; subst p₃\n  intro h₁ h₂\n  simp [*, -Int.neg_nonpos_iff, Int.neg_mul]\n  replace h₂ := Int.mul_le_mul_of_nonpos_left h₂ h; simp at h₂; clear h\n  rw [Int.mul_comm]\n  assumption","start":1218,"end":1227},"axioms":["Classical.choice","Quot.sound","propext"]}