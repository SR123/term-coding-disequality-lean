75,231,1161,true],["lambda","s",50,1162,"explicit"],["lambda","hab",47,1163,"explicit"],["lambda","b",28,1164,"implicit"],["lambda","a",27,1165,"implicit"],["lambda","inst._@.Mathlib.Topology.Order.LeftRightNhds.2034469175._hygCtx._hyg.11",26,1166,"instance"],["lambda","inst._@.Mathlib.Topology.Order.LeftRightNhds.2034469175._hygCtx._hyg.8",6,1167,"instance"],["lambda","inst._@.Mathlib.Topology.Order.LeftRightNhds.2034469175._hygCtx._hyg.5",3,1168,"instance"],["lambda","α",0,1169,"implicit"]],"project":false,"range":{"column":0,"endColumn":13,"endLine":63,"line":37},"type":172,"typeText":"∀ {α : Type u_1} [inst : TopologicalSpace.{u_1} α] [inst_1 : LinearOrder.{u_1} α] [OrderTopology.{u_1} α] {a b : α},\n  LT.lt.{u_1} a b →\n    ∀ (s : Set.{u_1} α),\n      List.TFAE\n        (List.cons.{0} (Membership.mem.{u_1, u_1} (nhdsWithin.{u_1} a (Set.Ioi.{u_1} a)) s)\n          (List.cons.{0} (Membership.mem.{u_1, u_1} (nhdsWithin.{u_1} a (Set.Ioc.{u_1} a b)) s)\n            (List.cons.{0} (Membership.mem.{u_1, u_1} (nhdsWithin.{u_1} a (Set.Ioo.{u_1} a b)) s)\n              (List.cons.{0}\n                (∃ u,\n                  And (Membership.mem.{u_1, u_1} (Set.Ioc.{u_1} a b) u) (HasSubset.Subset.{u_1} (Set.Ioo.{u_1} a u) s))\n                (List.cons.{0}\n                  (∃ u,\n                    And (Membership.mem.{u_1, u_1} (Set.Ioi.{u_1} a) u) (HasSubset.Subset.{u_1} (Set.Ioo.{u_1} a u) s))\n                  List.nil.{0})))))","unsafe":false,"value":1170,"source":{"code":"/-- The following statements are equivalent:\n\n0. `s` is a neighborhood of `a` within `(a, +∞)`;\n1. `s` is a neighborhood of `a` within `(a, b]`;\n2. `s` is a neighborhood of `a` within `(a, b)`;\n3. `s` includes `(a, u)` for some `u ∈ (a, b]`;\n4. `s` includes `(a, u)` for some `u > a`.\n-/\ntheorem TFAE_mem_nhdsGT {a b : α} (hab : a < b) (s : Set α) :\n    TFAE [s ∈ 𝓝[>] a,\n      s ∈ 𝓝[Ioc a b] a,\n      s ∈ 𝓝[Ioo a b] a,\n      ∃ u ∈ Ioc a b, Ioo a u ⊆ s,\n      ∃ u ∈ Ioi a, Ioo a u ⊆ s] := by\n  tfae_have 1 ↔ 2 := by\n    rw [nhdsWithin_Ioc_eq_nhdsGT hab]\n  tfae_have 1 ↔ 3 := by\n    rw [nhdsWithin_Ioo_eq_nhdsGT hab]\n  tfae_have 4 → 5 := fun ⟨u, umem, hu⟩ => ⟨u, umem.1, hu⟩\n  tfae_have 5 → 1\n  | ⟨u, hau, hu⟩ => mem_of_superset (Ioo_mem_nhdsGT hau) hu\n  tfae_have 1 → 4\n  | h => by\n    rcases mem_nhdsWithin_iff_exists_mem_nhds_inter.1 h with ⟨v, va, hv⟩\n    rcases exists_Ico_subset_of_mem_nhds' va hab with ⟨u, au, hu⟩\n    exact ⟨u, au, fun x hx => hv ⟨hu ⟨le_of_lt hx.1, hx.2⟩, hx.1⟩⟩\n  tfae_finish","start":37,"end":63},"axioms":["Classical.choice","Quot.sound","propext"]}