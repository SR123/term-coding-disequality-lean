],["apply",676,155],["apply",677,125],["apply",678,139],["apply",606,679],["apply",595,680],["apply",303,681],["apply",300,682],["constant","Eq.refl",[["succ",["param","u_1"]]]],["apply",684,52],["apply",685,295],["apply",683,686],["apply",291,687],["lambda","h",51,688,"explicit"],["lambda","l",17,689,"implicit"],["lambda","l₂",15,690,"implicit"],["lambda","l₁",13,691,"implicit"],["lambda","a₂",10,692,"implicit"],["lambda","a₁",8,693,"explicit"],["lambda","inst._@.Mathlib.Tactic.FieldSimp.Lemmas.1064027047._hygCtx._hyg.3",3,694,"instance"],["lambda","M",0,695,"implicit"]],"project":false,"range":{"column":0,"endColumn":8,"endLine":257,"line":253},"type":88,"typeText":"∀ {M : Type u_1} [inst : CommGroupWithZero.{u_1} M] (a₁ : Prod.{0, u_1} Int M) {a₂ : Prod.{0, u_1} Int M}\n  {l₁ l₂ l : Mathlib.Tactic.FieldSimp.NF.{u_1} M},\n  Eq.{u_1 + 1}\n      (HDiv.hDiv.{u_1, u_1, u_1} (Mathlib.Tactic.FieldSimp.NF.eval.{u_1} l₁)\n        (Mathlib.Tactic.FieldSimp.NF.eval.{u_1} (Mathlib.Tactic.FieldSimp.NF.cons.{u_1} a₂ l₂)))\n      (Mathlib.Tactic.FieldSimp.NF.eval.{u_1} l) →\n    Eq.{u_1 + 1}\n      (HDiv.hDiv.{u_1, u_1, u_1} (Mathlib.Tactic.FieldSimp.NF.eval.{u_1} (Mathlib.Tactic.FieldSimp.NF.cons.{u_1} a₁ l₁))\n        (Mathlib.Tactic.FieldSimp.NF.eval.{u_1} (Mathlib.Tactic.FieldSimp.NF.cons.{u_1} a₂ l₂)))\n      (Mathlib.Tactic.FieldSimp.NF.eval.{u_1} (Mathlib.Tactic.FieldSimp.NF.cons.{u_1} a₁ l))","unsafe":false,"value":696,"source":{"code":"theorem div_eq_eval₁ [CommGroupWithZero M] (a₁ : ℤ × M) {a₂ : ℤ × M} {l₁ l₂ l : NF M}\n    (h : l₁.eval / (a₂ ::ᵣ l₂).eval = l.eval) :\n    (a₁ ::ᵣ l₁).eval / (a₂ ::ᵣ l₂).eval = (a₁ ::ᵣ l).eval := by\n  simp only [eval_cons, ← h, div_eq_mul_inv]\n  ac_rfl","start":253,"end":257},"axioms":["Classical.choice","Quot.sound","propext"]}