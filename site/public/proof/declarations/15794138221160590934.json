00,1158,"explicit"],["apply",719,1159],["let","am",549,677,1160,true],["let","bm",635,647,1161,true],["lambda","p",633,1162,"explicit"],["lambda","h₂",347,1163,"explicit"],["lambda","h₁",343,1164,"explicit"],["lambda","l₁",123,1165,"implicit"],["lambda","ih",340,1166,"explicit"],["lambda","a._@._internal.0.Batteries.Data.List.Perm.2038011609._hygCtx._hyg.163",325,1167,"explicit"],["lambda","b",106,1168,"explicit"],["lambda","r₂",105,1169,"implicit"],["lambda","l₁._@.Batteries.Data.List.Perm.2038011609._hygCtx._hyg.162",103,1170,"implicit"],["apply",629,1171],["apply",1172,9],["apply",1173,52],["apply",1174,1],["apply",1175,76],["apply",1176,32],["apply",1177,28],["apply",1178,3],["lambda","s",99,1179,"explicit"],["lambda","p",79,1180,"explicit"],["apply",96,1181],["lambda","h._@.Batteries.Data.List.Perm.2038011609._hygCtx._hyg.44",61,1182,"explicit"],["lambda","l",48,1183,"explicit"],["apply",74,1184],["lambda","s",31,1185,"explicit"],["lambda","h₂",26,1186,"explicit"],["lambda","h₁",18,1187,"explicit"],["lambda","l₂",6,1188,"implicit"],["lambda","l₁",4,1189,"implicit"],["lambda","a",1,1190,"implicit"],["lambda","α",0,1191,"implicit"]],"project":false,"range":{"column":0,"endColumn":94,"endLine":112,"line":93},"type":46,"typeText":"∀ {α : Type u_1} {a : α} {l₁ l₂ : List.{u_1} α},\n  a ∉ l₁ → Membership.mem.{u_1, u_1} l₂ a → List.Subperm.{u_1} l₁ l₂ → List.Subperm.{u_1} (List.cons.{u_1} a l₁) l₂","unsafe":false,"value":1192,"source":{"code":"/-- Weaker version of `Subperm.cons_left` -/\ntheorem cons_subperm_of_not_mem_of_mem {a : α} {l₁ l₂ : List α} (h₁ : a ∉ l₁) (h₂ : a ∈ l₂)\n    (s : l₁ <+~ l₂) : a :: l₁ <+~ l₂ := by\n  obtain ⟨l, p, s⟩ := s\n  induction s generalizing l₁ with\n  | slnil => cases h₂\n  | @cons r₁ _ b s' ih =>\n    simp at h₂\n    match h₂ with\n    | .inl e => subst_vars; exact ⟨_ :: r₁, p.cons _, s'.cons₂ _⟩\n    | .inr m => let ⟨t, p', s'⟩ := ih h₁ m p; exact ⟨t, p', s'.cons _⟩\n  | @cons₂ _ r₂ b _ ih =>\n    have bm : b ∈ l₁ := p.subset mem_cons_self\n    have am : a ∈ r₂ := by\n      simp only [mem_cons] at h₂\n      exact h₂.resolve_left fun e => h₁ <| e.symm ▸ bm\n    obtain ⟨t₁, t₂, rfl⟩ := append_of_mem bm\n    have st : t₁ ++ t₂ <+ t₁ ++ b :: t₂ := by simp\n    obtain ⟨t, p', s'⟩ := ih (mt (st.subset ·) h₁) am (.cons_inv <| p.trans perm_middle)\n    exact ⟨b :: t, (p'.cons b).trans <| (swap ..).trans (perm_middle.symm.cons a), s'.cons₂ _⟩","start":93,"end":112},"axioms":["propext"]}