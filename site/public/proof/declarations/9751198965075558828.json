\n  simp only [sublists'_cons, mem_append, IH, mem_map]\n  constructor <;> intro h\n  · rcases h with (h | ⟨s, h, rfl⟩)\n    · exact sublist_cons_of_sublist _ h\n    · exact h.cons_cons _\n  · obtain - | ⟨-, h⟩ | ⟨-, h⟩ := h\n    · exact Or.inl h\n    · exact Or.inr ⟨_, h, rfl⟩","start":71,"end":85},"axioms":["Quot.sound","propext"]}