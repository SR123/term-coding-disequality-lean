0],["apply",372,375],["apply",5,45],["apply",377,2],["apply",376,378],["apply",343,379],["lambda","y",64,380,"explicit"],["lambda","x",77,381,"explicit"],["apply",250,382],["lambda","a._@.Mathlib.Topology.UniformSpace.UniformEmbedding.2443230027._hygCtx._hyg.181",59,383,"strictImplicit"],["apply",207,384],["apply",189,385],["apply",100,386],["constant","refl_le_uniformity",[["param","u_1"]]],["apply",388,13],["constant","UniformSpace.comap",[["param","u_1"],["param","v"]]],["apply",390,13],["apply",391,64],["apply",392,5],["apply",393,77],["apply",389,394],["apply",387,395],["lambda","hf",54,396,"explicit"],["lambda","hs",28,397,"explicit"],["lambda","s",11,398,"implicit"],["lambda","f",6,399,"implicit"],["lambda","α",4,400,"implicit"],["lambda","inst._@.Mathlib.Topology.UniformSpace.UniformEmbedding.2443230027._hygCtx._hyg.8",3,401,"instance"],["lambda","β",0,402,"implicit"]],"project":false,"range":{"column":0,"endColumn":50,"endLine":221,"line":210},"type":93,"typeText":"∀ {β : Type v} [inst : UniformSpace.{v} β] {α : Type u_1} {f : α → β} {s : Set.{v} (Prod.{v, v} β β)},\n  Membership.mem.{v, v} (uniformity.{v} β) s →\n    (Pairwise.{u_1} fun x y => Prod.mk.{v, v} (f x) (f y) ∉ s) →\n      Eq.{u_1 + 1} (Filter.comap.{u_1, v} (Prod.map.{u_1, v, u_1, v} f f) (uniformity.{v} β))\n        (Filter.principal.{u_1} SetRel.id.{u_1})","unsafe":false,"value":403,"source":{"code":"/-- If a map `f : α → β` sends any two distinct points to point that are **not** related by a fixed\n`s ∈ 𝓤 β`, then `f` is uniform inducing with respect to the discrete uniformity on `α`:\nthe preimage of `𝓤 β` under `Prod.map f f` is the principal filter generated by the diagonal in\n`α × α`. -/\ntheorem comap_uniformity_of_spaced_out {α} {f : α → β} {s : Set (β × β)} (hs : s ∈ 𝓤 β)\n    (hf : Pairwise fun x y => (f x, f y) ∉ s) : comap (Prod.map f f) (𝓤 β) = 𝓟 SetRel.id := by\n  refine le_antisymm ?_ (@refl_le_uniformity α (UniformSpace.comap f _))\n  calc\n    comap (Prod.map f f) (𝓤 β) ≤ comap (Prod.map f f) (𝓟 s) := comap_mono (le_principal_iff.2 hs)\n    _ = 𝓟 (Prod.map f f ⁻¹' s) := comap_principal\n    _ ≤ 𝓟 SetRel.id := principal_mono.2 ?_\n  rintro ⟨x, y⟩; simpa [not_imp_not] using @hf x y","start":210,"end":221},"axioms":["Classical.choice","Quot.sound","propext"]}