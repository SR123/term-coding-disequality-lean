,"__src._@.Mathlib.RingTheory.Congruence.Basic.165571206._hygCtx._hyg.246",163,304,313,false],["apply",293,314],["apply",291,315],["constant","RingCon.instCompleteLattice._proof_13",[["param","u_3"]]],["apply",317,35],["apply",318,9],["apply",319,5],["apply",316,320],["apply",288,321],["apply",145,322],["let","__spread.0._@.Mathlib.RingTheory.Congruence.Basic.165571206._hygCtx._hyg.25",13,33,323,false],["lambda","inst._@.Mathlib.RingTheory.Congruence.Basic.165571206._hygCtx._hyg.8",6,324,"instance"],["lambda","inst._@.Mathlib.RingTheory.Congruence.Basic.165571206._hygCtx._hyg.5",3,325,"instance"],["lambda","R",0,326,"implicit"]],"project":false,"range":{"column":0,"endColumn":40,"endLine":177,"line":155},"type":16,"typeText":"{R : Type u_3} → [inst : Add.{u_3} R] → [inst_1 : Mul.{u_3} R] → CompleteLattice.{u_3} (RingCon.{u_3} R)","unsafe":false,"value":327,"source":{"code":"/-- The complete lattice of congruence relations on a given type with multiplication and\naddition. -/\ninstance : CompleteLattice (RingCon R) where\n  __ := completeLatticeOfInf (RingCon R) fun s =>\n    ⟨fun r hr x y h => (h : ∀ r ∈ s, (r : RingCon R) x y) r hr,\n      fun _r hr _x _y h _r' hr' => hr hr' h⟩\n  inf c d :=\n    { toSetoid := c.toSetoid ⊓ d.toSetoid\n      mul' := fun h1 h2 => ⟨c.mul h1.1 h2.1, d.mul h1.2 h2.2⟩\n      add' := fun h1 h2 => ⟨c.add h1.1 h2.1, d.add h1.2 h2.2⟩ }\n  inf_le_left _ _ := fun _ _ h => h.1\n  inf_le_right _ _ := fun _ _ h => h.2\n  le_inf _ _ _ hb hc := fun _ _ h => ⟨hb h, hc h⟩\n  top :=\n    { (⊤ : Setoid R) with\n      mul' := fun _ _ => trivial\n      add' := fun _ _ => trivial }\n  le_top _ := fun _ _ _h => trivial\n  bot :=\n    { (⊥ : Setoid R) with\n      mul' := congr_arg₂ _\n      add' := congr_arg₂ _ }\n  bot_le c := fun x _y h => h ▸ c.refl x","start":155,"end":177},"axioms":["Quot.sound","propext"]}