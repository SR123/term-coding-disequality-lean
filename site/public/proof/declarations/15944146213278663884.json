17],["constant","Nat.Partrec.comp",[]],["apply",919,908],["apply",920,910],["apply",921,17],["apply",922,6],["lambda","pg",182,923,"explicit"],["lambda","pf",182,924,"explicit"],["lambda","cg",10,925,"explicit"],["lambda","cf",10,926,"explicit"],["apply",918,927],["constant","Nat.Partrec.prec",[]],["apply",929,908],["apply",930,910],["apply",931,17],["apply",932,6],["lambda","pg",182,933,"explicit"],["lambda","pf",182,934,"explicit"],["lambda","cg",10,935,"explicit"],["lambda","cf",10,936,"explicit"],["apply",928,937],["constant","Nat.Partrec.rfind'",[]],["apply",939,165],["apply",940,6],["lambda","pf",896,941,"explicit"],["lambda","cf",10,942,"explicit"],["apply",938,943],["apply",944,17],["apply",894,945],["apply",946,167],["apply",947,6],["lambda","h._@.Mathlib.Computability.PartrecCode.1594345677._hygCtx._hyg.151",28,948,"explicit"],["lambda","c",10,949,"explicit"],["apply",892,950],["lambda","a._@._internal.0.Mathlib.Computability.PartrecCode.1594345677._hygCtx._hyg.150",20,951,"explicit"],["apply",887,952],["lambda","f",3,953,"implicit"]],"project":false,"range":{"column":0,"endColumn":37,"endLine":579,"line":548},"type":22,"typeText":"∀ {f : PFun.{0, 0} Nat Nat}, Iff (Nat.Partrec f) (∃ c, Eq.{1} (Nat.Partrec.Code.eval c) f)","unsafe":false,"value":954,"source":{"code":"/-- A function is partial recursive if and only if there is a code implementing it. Therefore,\n`eval` is a **universal partial recursive function**. -/\ntheorem exists_code {f : ℕ →. ℕ} : Nat.Partrec f ↔ ∃ c : Code, eval c = f := by\n  refine ⟨fun h => ?_, ?_⟩\n  · induction h with\n    | zero => exact ⟨zero, rfl⟩\n    | succ => exact ⟨succ, rfl⟩\n    | left => exact ⟨left, rfl⟩\n    | right => exact ⟨right, rfl⟩\n    | pair pf pg hf hg =>\n      rcases hf with ⟨cf, rfl⟩; rcases hg with ⟨cg, rfl⟩\n      exact ⟨pair cf cg, rfl⟩\n    | comp pf pg hf hg =>\n      rcases hf with ⟨cf, rfl⟩; rcases hg with ⟨cg, rfl⟩\n      exact ⟨comp cf cg, rfl⟩\n    | prec pf pg hf hg =>\n      rcases hf with ⟨cf, rfl⟩; rcases hg with ⟨cg, rfl⟩\n      exact ⟨prec cf cg, rfl⟩\n    | rfind pf hf =>\n      rcases hf with ⟨cf, rfl⟩\n      refine ⟨comp (rfind' cf) (pair Code.id zero), ?_⟩\n      simp [eval, Seq.seq, pure, PFun.pure, Part.map_id']\n  · rintro ⟨c, rfl⟩\n    induction c with\n    | zero => exact Nat.Partrec.zero\n    | succ => exact Nat.Partrec.succ\n    | left => exact Nat.Partrec.left\n    | right => exact Nat.Partrec.right\n    | pair cf cg pf pg => exact pf.pair pg\n    | comp cf cg pf pg => exact pf.comp pg\n    | prec cf cg pf pg => exact pf.prec pg\n    | rfind' cf pf => exact pf.rfind'","start":548,"end":579},"axioms":["Classical.choice","Quot.sound","propext"]}