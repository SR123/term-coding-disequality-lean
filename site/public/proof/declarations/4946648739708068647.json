= ctx.op (evalList α ctx l) (evalList α ctx r) := by\n  induction l using List.two_step_induction with\n  | empty => simp_all\n  | single x =>\n    cases r\n    . simp at h₂\n    . simp [List.append, evalList, EvalInformation.evalOp]\n  | step x y ys ih => simp [List.append, evalList, EvalInformation.evalOp] at *; rw [ih]; simp [ctx.assoc.1]","start":314,"end":326},"axioms":["propext"]}