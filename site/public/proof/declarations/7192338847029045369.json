Space.Defs.894173753._hygCtx._hyg.7",3,332,"instance"],["lambda","α",0,333,"implicit"]],"project":false,"range":{"column":0,"endColumn":18,"endLine":580,"line":572},"type":75,"typeText":"∀ {α : Type ua} [inst : UniformSpace.{ua} α] {s : SetRel.{ua, ua} α α},\n  Membership.mem.{ua, ua} (uniformity.{ua} α) s →\n    ∃ t,\n      And (Membership.mem.{ua, ua} (uniformity.{ua} α) t)\n        (And (SetRel.IsSymm.{ua} t) (HasSubset.Subset.{ua} (SetRel.comp.{ua, ua, ua} t t) s))","unsafe":false,"value":334,"source":{"code":"/-- See also `comp_open_symm_mem_uniformity_sets`. -/\ntheorem comp_symm_mem_uniformity_sets {s : SetRel α α} (hs : s ∈ 𝓤 α) :\n    ∃ t ∈ 𝓤 α, SetRel.IsSymm t ∧ t ○ t ⊆ s := by\n  obtain ⟨w, w_in, w_sub⟩ : ∃ w ∈ 𝓤 α, w ○ w ⊆ s := comp_mem_uniformity_sets hs\n  use SetRel.symmetrize w, symmetrize_mem_uniformity w_in, inferInstance\n  have : SetRel.symmetrize w ⊆ w := SetRel.symmetrize_subset_self\n  calc SetRel.symmetrize w ○ SetRel.symmetrize w\n    _ ⊆ w ○ w := by gcongr\n    _ ⊆ s := w_sub","start":572,"end":580},"axioms":["Classical.choice","Quot.sound","propext"]}