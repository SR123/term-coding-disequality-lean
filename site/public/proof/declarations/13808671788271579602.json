ambda","k",0,507,"explicit"]],"project":false,"range":{"column":0,"endColumn":38,"endLine":353,"line":343},"type":15,"typeText":"∀ (k : Int) (p : Int.Linear.Poly), Eq.{1} (Int.Linear.Poly.mul_k p k) (Int.Linear.Poly.mul p k)","unsafe":false,"value":508,"source":{"code":"@[simp] theorem Poly.mul_k_eq_mul (k : Int) (p : Poly) : p.mul_k k = p.mul k := by\n  simp [mul_k, mul]; split\n  next =>\n    have h : Int.beq' k 0 = true := by simp [*]\n    simp [h]\n  next =>\n    have h₁ : Int.beq' k 0 = false := by rw [← Bool.not_eq_true, Int.beq'_eq]; assumption\n    simp [h₁]\n    induction p\n    next => rfl\n    next k m p ih => simp [mul', ← ih]","start":343,"end":353},"axioms":["Quot.sound","propext"]}