ll","a",22,63,"implicit"],["apply",8,25],["apply",65,23],["apply",66,1],["apply",23,2],["apply",68,1],["forall","t",67,69,"explicit"],["forall","a._@._internal._hyg.0",24,70,"implicit"],["forall","cons",64,71,"explicit"],["forall","nil",21,72,"explicit"],["forall","motive",14,73,"implicit"],["forall","R",5,74,"implicit"],["forall","α",0,75,"implicit"],["lambda","cons",64,2,"explicit"],["lambda","nil",21,77,"explicit"],["lambda","motive",14,78,"explicit"],["lambda","R",5,79,"explicit"],["lambda","α",0,80,"implicit"],["apply",6,25],["apply",26,53],["apply",6,53],["apply",83,84],["apply",31,53],["apply",85,86],["apply",87,2],["apply",88,1],["apply",53,22],["apply",90,2],["forall","a._@._internal._hyg.0",89,91,"explicit"],["forall","a'",27,92,"explicit"],["apply",8,53],["apply",94,27],["apply",95,2],["apply",23,22],["apply",97,9],["apply",98,2],["apply",99,1],["constant","List.Pairwise.rec",[["param","u"]]],["apply",101,46],["apply",102,53],["apply",103,27],["apply",104,25],["apply",105,23],["apply",106,9],["apply",107,1],["apply",100,108],["lambda","a._@._internal._hyg.0",96,109,"explicit"],["lambda","a._@._internal._hyg.0",93,110,"explicit"],["lambda","l",82,111,"implicit"],["lambda","a",23,112,"implicit"],["lambda","cons",64,113,"explicit"],["lambda","nil",21,114,"explicit"],["lambda","motive",14,115,"explicit"],["lambda","R",5,116,"explicit"],["lambda","α",0,117,"implicit"]],"project":false,"range":{"column":0,"endColumn":91,"endLine":1335,"line":1310},"type":76,"typeText":"∀ {α : Type u} {R : α → α → Prop} {motive : (a : List.{u} α) → List.Pairwise.{u} R a → Prop},\n  motive List.nil.{u} ⋯ →\n    (∀ {a : α} {l : List.{u} α} (a_1 : ∀ (a' : α), Membership.mem.{u, u} l a' → R a a') (a_2 : List.Pairwise.{u} R l),\n        motive l a_2 → motive (List.cons.{u} a l) ⋯) →\n      ∀ {a : List.{u} α} (t : List.Pairwise.{u} R a), motive a t","unsafe":false,"value":null,"source":{"code":"/--\nEach element of a list is related to all later elements of the list by `R`.\n\n`Pairwise R l` means that all the elements of `l` with earlier indexes are `R`-related to all the\nelements with later indexes.\n\nFor example, `Pairwise (· ≠ ·) l` asserts that `l` has no duplicates, and `Pairwise (· < ·) l`\nasserts that `l` is (strictly) sorted.\n\nExamples:\n * `Pairwise (· < ·) [1, 2, 3] ↔ (1 < 2 ∧ 1 < 3) ∧ 2 < 3`\n * `Pairwise (· = ·) [1, 2, 3] = False`\n * `Pairwise (· ≠ ·) [1, 2, 3] = True`\n-/\ninductive Pairwise : List α → Prop\n  /-- All elements of the empty list are vacuously pairwise related. -/\n  | nil : Pairwise []\n  /--\n  A nonempty list is pairwise related with `R` if the head is related to every element of the tail\n  and the tail is itself pairwise related.\n\n  That is, `a :: l` is `Pairwise R` if:\n   * `R` relates `a` to every element of `l`\n   * `l` is `Pairwise R`.\n  -/\n  | cons : ∀ {a : α} {l : List α}, (∀ a', a' ∈ l → R a a') → Pairwise l → Pairwise (a :: l)","start":1310,"end":1335},"axioms":[]}