:61},"type":100,"typeText":"{m : DisequalityDispersion.Machine.Mem} →\n  {bs : List.{0} Bool} →\n    {motive : DisequalityDispersion.Machine.PState m bs → Sort u} →\n      ((input : DisequalityDispersion.Machine.Input m bs) →\n          (n : Eq.{1} (m DisequalityDispersion.Machine.N) (List.length.{0} bs)) →\n            (inb :\n                Eq.{1} (m DisequalityDispersion.Machine.INB) (HAdd.hAdd.{0, 0, 0} DisequalityDispersion.Machine.IN 1)) →\n              (one : Eq.{1} (m DisequalityDispersion.Machine.ONE) 1) →\n                (zero : Eq.{1} (m DisequalityDispersion.Machine.ZERO) 0) →\n                  (hp :\n                      LE.le.{0}\n                        (HAdd.hAdd.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} DisequalityDispersion.Machine.IN 1)\n                          (List.length.{0} bs))\n                        (m DisequalityDispersion.Machine.HP)) →\n                    motive ⋯) →\n        (t : DisequalityDispersion.Machine.PState m bs) → motive t","unsafe":false,"value":null,"source":{"code":"/-- The standing invariant of the parser: the input array, the parser constants, and a heap\npointer above the input. -/\nstructure PState (m : Mem) (bs : List Bool) : Prop where\n  input : Input m bs\n  n : m N = bs.length\n  inb : m INB = IN + 1\n  one : m ONE = 1\n  zero : m ZERO = 0\n  hp : IN + 1 + bs.length ≤ m HP","start":61,"end":69,"lines":[[{"text":"/-- The standing invariant of the parser: the input array, the parser constants, and a heap"}],[{"text":"pointer above the input. -/"}],[{"text":"structure PState (m : Mem) (bs : List Bool) : Prop where"}],[{"text":"  input : Input m bs"}],[{"text":"  n : m N = bs.length"}],[{"text":"  inb : m INB = IN + 1"}],[{"text":"  one : m ONE = 1"}],[{"text":"  zero : m ZERO = 0"}],[{"text":"  hp : IN + 1 + bs.length ≤ m HP"}]]},"steps":[],"stepGoalPool":[],"references":[],"axioms":[]}