ce [dp : Decidable p] [dq : Decidable q] : Decidable (Or p q) :=\n  match dp with\n  | isTrue  hp => isTrue (Or.inl hp)\n  | isFalse hp =>\n    match dq with\n    | isTrue hq  => isTrue (Or.inr hq)\n    | isFalse hq =>\n      isFalse fun h => match h with\n        | Or.inl h => hp h\n        | Or.inr h => hq h","start":1091,"end":1100},"axioms":[]}