["apply",300,7],["lambda","p",281,585,"explicit"],["apply",286,586],["apply",285,587],["apply",588,38],["apply",137,589],["lambda","i",8,590,"explicit"],["apply",584,591],["apply",592,577],["apply",31,577],["apply",470,594],["apply",80,72],["apply",332,596],["lambda","p",314,597,"explicit"],["apply",319,598],["apply",318,599],["apply",600,49],["apply",595,601],["apply",60,10],["apply",603,7],["apply",602,604],["apply",605,2],["apply",593,606],["lambda","H",582,607,"explicit"],["lambda","hi",556,608,"explicit"],["lambda","i",60,609,"explicit"],["apply",576,610],["lambda","x._@.Mathlib.Topology.EMetricSpace.Defs.1050390428._hygCtx._hyg.133",178,611,"explicit"],["apply",547,612],["apply",193,613],["lambda","s",117,614,"explicit"],["apply",115,615],["lambda","hf",57,616,"explicit"],["lambda","hf₀",35,617,"explicit"],["lambda","f",9,618,"implicit"],["lambda","p",6,619,"implicit"],["lambda","β",4,620,"implicit"],["lambda","inst._@.Mathlib.Topology.EMetricSpace.Defs.1050390428._hygCtx._hyg.5",3,621,"instance"],["lambda","α",0,622,"implicit"]],"project":false,"range":{"column":0,"endColumn":46,"endLine":182,"line":169},"type":109,"typeText":"∀ {α : Type u} [inst : PseudoEMetricSpace.{u} α] {β : Type u_2} {p : β → Prop} {f : β → ENNReal},\n  (∀ (x : β), p x → LT.lt.{0} 0 (f x)) →\n    (∀ (ε : ENNReal), LT.lt.{0} 0 ε → ∃ x, And (p x) (LE.le.{0} (f x) ε)) →\n      Filter.HasBasis.{u, u_2 + 1} (uniformity.{u} α) p fun x =>\n        setOf.{u} fun p => LT.lt.{0} (EDist.edist.{u} p.1 p.2) (f x)","unsafe":false,"value":623,"source":{"code":"/-- Given `f : β → ℝ≥0∞`, if `f` sends `{i | p i}` to a set of positive numbers\naccumulating to zero, then `f i`-neighborhoods of the diagonal form a basis of `𝓤 α`.\n\nFor specific bases see `uniformity_basis_edist`, `uniformity_basis_edist'`,\n`uniformity_basis_edist_nnreal`, and `uniformity_basis_edist_inv_nat`. -/\nprotected theorem EMetric.mk_uniformity_basis {β : Type*} {p : β → Prop} {f : β → ℝ≥0∞}\n    (hf₀ : ∀ x, p x → 0 < f x) (hf : ∀ ε, 0 < ε → ∃ x, p x ∧ f x ≤ ε) :\n    (𝓤 α).HasBasis p fun x => { p : α × α | edist p.1 p.2 < f x } := by\n  refine ⟨fun s => uniformity_basis_edist.mem_iff.trans ?_⟩\n  constructor\n  · rintro ⟨ε, ε₀, hε⟩\n    rcases hf ε ε₀ with ⟨i, hi, H⟩\n    exact ⟨i, hi, fun x hx => hε <| lt_of_lt_of_le hx.out H⟩\n  · exact fun ⟨i, hi, H⟩ => ⟨f i, hf₀ i hi, H⟩","start":169,"end":182},"axioms":["Classical.choice","Quot.sound","propext"]}