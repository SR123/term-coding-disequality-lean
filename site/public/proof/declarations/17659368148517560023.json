mbda","m",0,1241,"implicit"]],"project":false,"range":{"column":0,"endColumn":13,"endLine":1954,"line":1948},"type":107,"typeText":"∀ {m i : Nat} {x : BitVec m} {n : Nat} (h : LT.lt.{0} i (HAdd.hAdd.{0, 0, 0} m n)),\n  Eq.{1} (GetElem.getElem.{0, 0, 0} (BitVec.shiftLeftZeroExtend x n) i h)\n    (if h' : LT.lt.{0} i n then Bool.false else GetElem.getElem.{0, 0, 0} x (HSub.hSub.{0, 0, 0} i n) ⋯)","unsafe":false,"value":1242,"source":{"code":"@[simp] theorem getElem_shiftLeftZeroExtend {x : BitVec m} {n : Nat} (h : i < m + n) :\n    (shiftLeftZeroExtend x n)[i] = if h' : i < n then false else x[i - n] := by\n  rw [shiftLeftZeroExtend_eq]\n  simp only [getElem_eq_testBit_toNat]\n  cases h₁ : decide (i < n) <;> cases h₂ : decide (i - n < m + n)\n    <;> simp_all\n    <;> omega","start":1948,"end":1954},"axioms":["Quot.sound","propext"]}