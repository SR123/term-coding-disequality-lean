y",15,6],["apply",69,3],["apply",70,1],["constant","List.Mem.rec",[["param","u"]]],["apply",72,34],["apply",73,41],["apply",74,28],["apply",75,26],["apply",76,15],["apply",77,3],["apply",78,1],["apply",71,79],["lambda","a._@._internal._hyg.0",68,80,"explicit"],["lambda","as",65,81,"implicit"],["lambda","b",26,82,"explicit"],["lambda","tail",50,83,"explicit"],["lambda","head",25,84,"explicit"],["lambda","motive",12,85,"explicit"],["lambda","a",1,86,"explicit"],["lambda","α",0,87,"implicit"]],"project":false,"range":{"column":0,"endColumn":57,"endLine":832,"line":817},"type":57,"typeText":"∀ {α : Type u} {a : α} {motive : (a_1 : List.{u} α) → List.Mem.{u} a a_1 → Prop},\n  (∀ (as : List.{u} α), motive (List.cons.{u} a as) ⋯) →\n    (∀ (b : α) {as : List.{u} α} (a_1 : List.Mem.{u} a as), motive as a_1 → motive (List.cons.{u} b as) ⋯) →\n      ∀ {a_1 : List.{u} α} (t : List.Mem.{u} a a_1), motive a_1 t","unsafe":false,"value":null,"source":{"code":"/--\nList membership, typically accessed via the `∈` operator.\n\n`a ∈ l` means that `a` is an element of the list `l`. Elements are compared according to Lean's\nlogical equality.\n\nThe related function `List.elem` is a Boolean membership test that uses a `BEq α` instance.\n\nExamples:\n* `a ∈ [x, y, z] ↔ a = x ∨ a = y ∨ a = z`\n-/\ninductive Mem (a : α) : List α → Prop\n  /-- The head of a list is a member: `a ∈ a :: as`. -/\n  | head (as : List α) : Mem a (a::as)\n  /-- A member of the tail of a list is a member of the list: `a ∈ l → a ∈ b :: l`. -/\n  | tail (b : α) {as : List α} : Mem a as → Mem a (b::as)","start":817,"end":832},"axioms":[]}