| Ordering.gt =>\n          Lean.Grind.CommRing.Poly.add k₁ m₁\n            (Lean.Grind.CommRing.Poly.combine.go fuel p₁ (Lean.Grind.CommRing.Poly.add k₂ m₂ p₂))\n        | Ordering.lt =>\n          Lean.Grind.CommRing.Poly.add k₂ m₂\n            (Lean.Grind.CommRing.Poly.combine.go fuel (Lean.Grind.CommRing.Poly.add k₁ m₁ p₁) p₂))","unsafe":false,"value":547,"axioms":["Quot.sound","propext"]}