Column":73,"endLine":879,"line":868},"type":32,"typeText":"∀ {a : Rat} {n : Int}, LE.le.{0} 0 a → LE.le.{0} 0 (HPow.hPow.{0, 0, 0} a n)","unsafe":false,"value":354,"source":{"code":"protected theorem zpow_nonneg {a : Rat} {n : Int} (h : 0 ≤ a) : 0 ≤ a ^ n := by\n  by_cases h' : a = 0\n  · simp [h']\n    match n with\n    | (0 : Nat) => simp; rfl\n    | (n + 1 : Nat) =>\n      rw [Rat.zpow_natCast, Rat.pow_succ, Rat.mul_zero]\n      rfl\n    | -(n + 1 : Nat) =>\n      rw [Rat.zpow_neg, Rat.zpow_natCast, Rat.pow_succ, Rat.mul_zero, Rat.inv_zero]\n      rfl\n  · exact Rat.le_of_lt (Rat.zpow_pos (Rat.lt_of_le_of_ne h (Ne.symm h')))","start":868,"end":879},"axioms":["Classical.choice","Quot.sound","propext"]}