:{"code":"theorem sublists_cons (a : α) (l : List α) :\n    sublists (a :: l) = sublists l >>= (fun x => [x, a :: x]) :=\n  show sublists ([a] ++ l) = _ by\n  rw [sublists_append]\n  simp only [sublists_singleton, map_cons, bind_eq_flatMap, nil_append, cons_append, map_nil]","start":134,"end":138},"axioms":["Quot.sound","propext"]}