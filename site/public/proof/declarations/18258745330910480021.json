u_1} l' l →\n    ∃ is,\n      And (Eq.{u_1 + 1} l' (List.map.{0, u_1} (fun x => GetElem.getElem.{u_1, 0, u_1} l x ⋯) is))\n        (List.Pairwise.{0} (fun x1 x2 => LT.lt.{0} x1 x2) is)","unsafe":false,"value":1222,"source":{"code":"/-- Given a sublist `l' <+ l`, there exists an increasing list of indices `is` such that\n  `l' = is.map fun i => l[i]`. -/\ntheorem sublist_eq_map_getElem {l l' : List α} (h : l' <+ l) : ∃ is : List (Fin l.length),\n    l' = is.map (l[·]) ∧ is.Pairwise (· < ·) := by\n  induction h with\n  | slnil => exact ⟨[], by simp⟩\n  | cons _ _ IH =>\n    let ⟨is, IH⟩ := IH\n    refine ⟨is.map (·.succ), ?_⟩\n    simpa [Function.comp_def, pairwise_map]\n  | cons₂ _ _ IH =>\n    rcases IH with ⟨is,IH⟩\n    refine ⟨⟨0, by simp [Nat.zero_lt_succ]⟩ :: is.map (·.succ), ?_⟩\n    simp [Function.comp_def, pairwise_map, IH, ← get_eq_getElem, get_cons_zero, get_cons_succ']","start":42,"end":55},"axioms":["Quot.sound","propext"]}