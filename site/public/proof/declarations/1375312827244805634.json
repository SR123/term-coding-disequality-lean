unpaired.{1}\n          (fun a n =>\n            Nat.casesOn.{1} n (Nat.Partrec.Code.evaln (HAdd.hAdd.{0, 0, 0} k 1) cf a) fun y => do\n              let i ← Nat.Partrec.Code.evaln k (Nat.Partrec.Code.prec cf cg) (Nat.pair a y)\n              Nat.Partrec.Code.evaln (HAdd.hAdd.{0, 0, 0} k 1) cg (Nat.pair a (Nat.pair y i)))\n          n\n    | Nat.succ k, Nat.Partrec.Code.rfind' cf => fun n => do\n      guard.{0} (LE.le.{0} n k)\n      Nat.unpaired.{1}\n          (fun a m => do\n            let x ← Nat.Partrec.Code.evaln (HAdd.hAdd.{0, 0, 0} k 1) cf (Nat.pair a m)\n            ite.{1} (Eq.{1} x 0) (Pure.pure.{0, 0} m)\n                (Nat.Partrec.Code.evaln k (Nat.Partrec.Code.rfind' cf) (Nat.pair a (HAdd.hAdd.{0, 0, 0} m 1))))\n          n)","unsafe":false,"value":283,"axioms":["Classical.choice","Quot.sound","propext"]}