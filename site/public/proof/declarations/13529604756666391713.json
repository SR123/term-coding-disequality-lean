t":"∀ {α : Type u} (l : List.{u} α) (a : α),\n  Eq.{u + 1} (List.sublists.{u} (HAppend.hAppend.{u, u, u} l (List.cons.{u} a List.nil.{u})))\n    (HAppend.hAppend.{u, u, u} (List.sublists.{u} l)\n      (List.map.{u, u} (fun x => HAppend.hAppend.{u, u, u} x (List.cons.{u} a List.nil.{u})) (List.sublists.{u} l)))","unsafe":false,"value":358,"source":{"code":"@[simp]\ntheorem sublists_concat (l : List α) (a : α) :\n    sublists (l ++ [a]) = sublists l ++ map (fun x => x ++ [a]) (sublists l) := by\n  rw [sublists_append, sublists_singleton, bind_eq_flatMap, flatMap_cons, flatMap_cons, flatMap_nil,\n     map_id'' append_nil, append_nil]","start":140,"end":144},"axioms":["Quot.sound","propext"]}