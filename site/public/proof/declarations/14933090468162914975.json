   cons _ _  => isFalse (fun h => List.noConfusion h)\n  | cons a as, cons b bs =>\n    match decEq a b with\n    | isTrue hab  =>\n      match List.hasDecEq as bs with\n      | isTrue habs  => isTrue (hab ▸ habs ▸ rfl)\n      | isFalse nabs => isFalse (fun h => List.noConfusion h (fun _ habs => absurd habs nabs))\n    | isFalse nab => isFalse (fun h => List.noConfusion h (fun hab _ => absurd hab nab))","start":2910,"end":2921},"axioms":[]}