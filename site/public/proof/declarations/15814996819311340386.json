",709,811],["let","__spread.2._@.Mathlib.Algebra.Order.Ring.InjSurj.4079743615._hygCtx._hyg.119",357,380,812,false],["let","__spread.1._@.Mathlib.Algebra.Order.Ring.InjSurj.4079743615._hygCtx._hyg.119",319,353,813,false],["let","__spread.0._@.Mathlib.Algebra.Order.Ring.InjSurj.4079743615._hygCtx._hyg.119",290,317,814,false],["lambda","lt",261,815,"explicit"],["lambda","le",234,816,"explicit"],["lambda","mul",204,817,"explicit"],["lambda","add",157,818,"explicit"],["lambda","one",106,819,"explicit"],["lambda","zero",66,820,"explicit"],["lambda","f",21,821,"explicit"],["lambda","inst._@.Mathlib.Algebra.Order.Ring.InjSurj.4079743615._hygCtx._hyg.16",18,822,"instance"],["lambda","inst._@.Mathlib.Algebra.Order.Ring.InjSurj.4079743615._hygCtx._hyg.13",15,823,"instance"],["lambda","inst._@.Mathlib.Algebra.Order.Ring.InjSurj.4079743615._hygCtx._hyg.10",13,824,"instance"],["lambda","inst._@.Mathlib.Algebra.Order.Ring.InjSurj.4079743615._hygCtx._hyg.7",7,825,"instance"],["lambda","inst._@.Mathlib.Algebra.Order.Ring.InjSurj.4079743615._hygCtx._hyg.4",4,826,"instance"],["lambda","S",1,827,"implicit"],["lambda","R",0,828,"implicit"]],"project":false,"range":{"column":0,"endColumn":87,"endLine":47,"line":35},"type":279,"typeText":"∀ {R : Type u_1} {S : Type u_2} [inst : Semiring.{u_1} R] [inst_1 : PartialOrder.{u_1} R] [IsStrictOrderedRing.{u_1} R]\n  [inst_3 : Semiring.{u_2} S] [inst_4 : PartialOrder.{u_2} S] (f : S → R),\n  Eq.{u_1 + 1} (f 0) 0 →\n    Eq.{u_1 + 1} (f 1) 1 →\n      (∀ (x y : S), Eq.{u_1 + 1} (f (HAdd.hAdd.{u_2, u_2, u_2} x y)) (HAdd.hAdd.{u_1, u_1, u_1} (f x) (f y))) →\n        (∀ (x y : S), Eq.{u_1 + 1} (f (HMul.hMul.{u_2, u_2, u_2} x y)) (HMul.hMul.{u_1, u_1, u_1} (f x) (f y))) →\n          (∀ {x y : S}, Iff (LE.le.{u_1} (f x) (f y)) (LE.le.{u_2} x y)) →\n            (∀ {x y : S}, Iff (LT.lt.{u_1} (f x) (f y)) (LT.lt.{u_2} x y)) → IsStrictOrderedRing.{u_2} S","unsafe":false,"value":829,"source":{"code":"/-- Pullback a `IsStrictOrderedRing` under an injective map. -/\nprotected lemma isStrictOrderedRing [IsStrictOrderedRing R] [Semiring S] [PartialOrder S]\n    (f : S → R) (zero : f 0 = 0) (one : f 1 = 1)\n    (add : ∀ x y, f (x + y) = f x + f y) (mul : ∀ x y, f (x * y) = f x * f y)\n    (le : ∀ {x y}, f x ≤ f y ↔ x ≤ y) (lt : ∀ {x y}, f x < f y ↔ x < y) :\n    IsStrictOrderedRing S where\n  __ := Function.Injective.isOrderedCancelAddMonoid f add le\n  __ := domain_nontrivial f zero one\n  __ := Function.Injective.isOrderedRing f zero one add mul le\n  mul_lt_mul_of_pos_left a ha b c hbc := by\n    rw [← lt, mul, mul]; refine mul_lt_mul_of_pos_left (lt.2 hbc) ?_; rwa [← zero, lt]\n  mul_lt_mul_of_pos_right a ha b c hbc := by\n    rw [← lt, mul, mul]; refine mul_lt_mul_of_pos_right (lt.2 hbc) ?_; rwa [← zero, lt]","start":35,"end":47},"axioms":["Classical.choice","Quot.sound","propext"]}