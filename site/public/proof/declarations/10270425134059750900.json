 →\n            ((st : DisequalityDispersion.Machine.PState m bs) →\n                (hj : LE.le.{0} j c) →\n                  (hc : LE.le.{0} (HAdd.hAdd.{0, 0, 0} q1 c) (List.length.{0} bs)) →\n                    (jv : Eq.{1} (m DisequalityDispersion.Machine.J) j) →\n                      (cnt : Eq.{1} (m DisequalityDispersion.Machine.CNT) c) →\n                        (pos : Eq.{1} (m DisequalityDispersion.Machine.POS) (HAdd.hAdd.{0, 0, 0} q1 j)) →\n                          (val :\n                              Eq.{1} (m DisequalityDispersion.Machine.VAL)\n                                (DisequalityDispersion.Encoded.fromBits (List.take.{0} j (List.drop.{0} q1 bs)))) →\n                            (pow : Eq.{1} (m DisequalityDispersion.Machine.POW) (HPow.hPow.{0, 0, 0} 2 j)) →\n                              (last :\n                                  Eq.{1} (m DisequalityDispersion.Machine.LAST)\n                                    (if h : LT.lt.{0} 0 j then\n                                      DisequalityDispersion.Machine.bitv\n                                        (GetElem.getElem.{0, 0, 0} bs (HSub.hSub.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} q1 j) 1)\n                                          ⋯)\n                                    else 1)) →\n                                (pres :\n                                    DisequalityDispersion.Machine.Pres m₀ m (m₀ DisequalityDispersion.Machine.HP)\n                                      DisequalityDispersion.Machine.bitVars) →\n                                  (hp :\n                                      Eq.{1} (m DisequalityDispersion.Machine.HP)\n                                        (m₀ DisequalityDispersion.Machine.HP)) →\n                                    motive ⋯) →\n              motive t","unsafe":false,"value":276,"source":{"code":"/-- Invariant of the digit loop: `j` digits read from position `q1`. -/\nstructure BitInv (m₀ : Mem) (bs : List Bool) (q1 c : ℕ) (j : ℕ) (m : Mem) : Prop where\n  st : PState m bs\n  hj : j ≤ c\n  hc : q1 + c ≤ bs.length\n  jv : m J = j\n  cnt : m CNT = c\n  pos : m POS = q1 + j\n  val : m VAL = fromBits ((bs.drop q1).take j)\n  pow : m POW = 2 ^ j\n  last : m LAST = if h : 0 < j then bitv (bs[q1 + j - 1]'(by omega)) else 1\n  pres : Pres m₀ m (m₀ HP) bitVars\n  hp : m HP = m₀ HP","start":383,"end":395,"lines":[[{"text":"/-- Invariant of the digit loop: `j` digits read from position `q1`. -/"}],[{"text":"structure BitInv (m₀ : Mem) (bs : List Bool) (q1 c : ℕ) (j : ℕ) (m : Mem) : Prop where"}],[{"text":"  st : PState m bs"}],[{"text":"  hj : j ≤ c"}],[{"text":"  hc : q1 + c ≤ bs.length"}],[{"text":"  jv : m J = j"}],[{"text":"  cnt : m CNT = c"}],[{"text":"  pos : m POS = q1 + j"}],[{"text":"  val : m VAL = fromBits ((bs.drop q1).take j)"}],[{"text":"  pow : m POW = 2 ^ j"}],[{"text":"  last : m LAST = if h : 0 < j then bitv (bs[q1 + j - 1]'(by omega)) else 1"}],[{"text":"  pres : Pres m₀ m (m₀ HP) bitVars"}],[{"text":"  hp : m HP = m₀ HP"}]]},"steps":[],"stepGoalPool":[],"references":[],"axioms":["Quot.sound","propext"]}