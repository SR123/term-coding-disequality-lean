g.CommSolver.2117316834._hygCtx._hyg.110",38,111,"explicit"],["lambda","fuel",0,112,"explicit"],["apply",35,113],["apply",114,9],["lambda","m₂",1,115,"explicit"],["lambda","m₁",1,116,"explicit"],["lambda","f",14,117,"explicit"],["lambda","fuel",0,118,"explicit"],["apply",10,119],["apply",120,70],["apply",121,13],["lambda","m₂",1,122,"explicit"],["lambda","m₁",1,123,"explicit"],["lambda","fuel",0,124,"explicit"]],"project":false,"range":{"column":0,"endColumn":53,"endLine":243,"line":226},"type":5,"typeText":"Nat → Lean.Grind.CommRing.Mon → Lean.Grind.CommRing.Mon → Ordering","unsafe":false,"value":125,"source":{"code":"def Mon.revlexFuel (fuel : Nat) (m₁ m₂ : Mon) : Ordering :=\n  match fuel with\n  | 0 =>\n    -- This branch is not reachable in practice, but we add it here\n    -- to ensure we can prove helper theorems\n    revlexWF m₁ m₂\n  | fuel + 1 =>\n    match m₁, m₂ with\n    | .unit, .unit => .eq\n    | .unit, .mult ..  => .gt\n    | .mult .., .unit => .lt\n    | .mult pw₁ m₁, .mult pw₂ m₂ =>\n      bif pw₁.x == pw₂.x then\n        revlexFuel fuel m₁ m₂ |>.then (powerRevlex pw₁.k pw₂.k)\n      else bif pw₁.x.blt pw₂.x then\n        revlexFuel fuel m₁ (.mult pw₂ m₂) |>.then .lt\n      else\n        revlexFuel fuel (.mult pw₁ m₁) m₂ |>.then .gt","start":226,"end":243},"axioms":["Quot.sound","propext"]}