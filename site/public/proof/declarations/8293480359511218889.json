licit"],["apply",40,261],["lambda","b",15,262,"explicit"],["lambda","a",14,263,"explicit"],["lambda","m",13,264,"explicit"],["lambda","inst._@.Std.Data.DHashMap.Internal.Defs.3710859409._hygCtx._hyg.16",9,265,"instance"],["lambda","inst._@.Std.Data.DHashMap.Internal.Defs.3710859409._hygCtx._hyg.13",6,266,"instance"],["lambda","β",3,267,"implicit"],["lambda","α",0,268,"implicit"]],"project":false,"range":{"column":0,"endColumn":71,"endLine":325,"line":314},"type":30,"typeText":"{α : Type u} →\n  {β : α → Type v} →\n    [BEq.{u} α] →\n      [Hashable.{u + 1} α] →\n        Std.DHashMap.Internal.Raw₀.{u, v} α β →\n          (a : α) → β a → Prod.{0, max v u} Bool (Std.DHashMap.Internal.Raw₀.{u, v} α β)","unsafe":false,"value":269,"source":{"code":"/-- Internal implementation detail of the hash map -/\n@[inline] def containsThenInsertIfNew [BEq α] [Hashable α] (m : Raw₀ α β) (a : α) (b : β a) :\n    Bool × Raw₀ α β :=\n  let ⟨⟨size, buckets⟩, hm⟩ := m\n  let ⟨i, h⟩ := mkIdx buckets.size hm (hash a)\n  let bkt := buckets[i]\n  if bkt.contains a then\n    (true, ⟨⟨size, buckets⟩, hm⟩)\n  else\n    let size'    := size + 1\n    let buckets' := buckets.uset i (AssocList.cons a b bkt) h\n    (false, expandIfNecessary ⟨⟨size', buckets'⟩, by simpa [buckets']⟩)","start":314,"end":325},"axioms":["Quot.sound","propext"]}