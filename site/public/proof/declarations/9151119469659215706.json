₁ then\n            Lean.Grind.CommRing.Mon.mult pw₂\n              (Lean.Grind.CommRing.Mon.mul.go fuel (Lean.Grind.CommRing.Mon.mult pw₁ m₁) m₂)\n          else\n            Lean.Grind.CommRing.Mon.mult\n              { x := Lean.Grind.CommRing.Power.x pw₁,\n                k := HAdd.hAdd.{0, 0, 0} (Lean.Grind.CommRing.Power.k pw₁) (Lean.Grind.CommRing.Power.k pw₂) }\n              (Lean.Grind.CommRing.Mon.mul.go fuel m₁ m₂))","unsafe":false,"value":418,"axioms":[]}