olver.3069861988._hygCtx._hyg.12",13,468,"instance"],["lambda","inst._@.Init.Grind.Ring.CommSolver.3069861988._hygCtx._hyg.9",9,469,"instance"],["lambda","inst._@.Init.Grind.Ring.CommSolver.3069861988._hygCtx._hyg.6",6,470,"instance"],["lambda","inst._@.Init.Grind.Ring.CommSolver.3069861988._hygCtx._hyg.3",3,471,"instance"],["lambda","α",0,472,"implicit"]],"project":false,"range":{"column":0,"endColumn":64,"endLine":1760,"line":1755},"type":78,"typeText":"∀ {α : Type u_1} [inst : Lean.Grind.CommRing.{u_1} α] [inst_1 : LE.{u_1} α] [inst_2 : LT.{u_1} α]\n  [inst_3 : Std.IsPreorder.{u_1} α] [Lean.Grind.OrderedRing.{u_1} α] (ctx : Lean.Grind.CommRing.Context.{u_1} α)\n  (lhs rhs lhs' rhs' : Lean.Grind.CommRing.Expr),\n  Eq.{1} (Lean.Grind.CommRing.norm_cnstr_cert lhs rhs lhs' rhs') Bool.true →\n    Eq.{1} (LE.le.{u_1} (Lean.Grind.CommRing.Expr.denote.{u_1} ctx lhs) (Lean.Grind.CommRing.Expr.denote.{u_1} ctx rhs))\n      (LE.le.{u_1} (Lean.Grind.CommRing.Expr.denote.{u_1} ctx lhs') (Lean.Grind.CommRing.Expr.denote.{u_1} ctx rhs'))","unsafe":false,"value":473,"source":{"code":"theorem le_norm_expr {α} [CommRing α] [LE α] [LT α] [IsPreorder α] [OrderedRing α] (ctx : Context α) (lhs rhs : Expr) (lhs' rhs' : Expr)\n    : norm_cnstr_cert lhs rhs lhs' rhs' → (lhs.denote ctx ≤ rhs.denote ctx) = (lhs'.denote ctx ≤ rhs'.denote ctx) := by\n  simp [norm_cnstr_cert]; intro h\n  replace h := congrArg (Poly.denote ctx) h; simp [Expr.denote_toPoly] at h\n  replace h : rhs.denote ctx - lhs.denote ctx = rhs'.denote ctx - lhs'.denote ctx := h\n  rw [← OrderedAdd.sub_nonneg_iff, h, OrderedAdd.sub_nonneg_iff]","start":1755,"end":1760},"axioms":["Classical.choice","Quot.sound","propext"]}