nce to a `Primcodable` type. -/\ndef ofEquiv (α) {β} [Primcodable α] (e : β ≃ α) : Primcodable β :=\n  { __ := Encodable.ofEquiv α e\n    prim := (Primcodable.prim α).of_eq fun n => by\n      rw [decode_ofEquiv]\n      cases (@decode α _ n) <;>\n        simp [encode_ofEquiv] }","start":146,"end":152},"axioms":["Quot.sound","propext"]}