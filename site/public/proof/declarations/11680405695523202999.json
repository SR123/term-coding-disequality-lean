pply",767,2],["apply",791,1717],["apply",1718,444],["lambda","x",691,1719,"explicit"],["apply",1716,1720],["apply",1721,2],["apply",1712,1722],["apply",1723,28],["let","this",1060,1703,1724,true],["lambda","t₁b",1057,1725,"explicit"],["lambda","t₁a",1026,1726,"explicit"],["apply",1051,1727],["lambda","ht₁",1025,1728,"explicit"],["lambda","left._@.Mathlib.Topology.Order.IntermediateValue.2987564383._hygCtx._hyg.808",592,1729,"explicit"],["apply",1023,1730],["let","t₁_mem",497,575,1731,true],["let","t₁",414,496,1732,false],["let","bdd_A",411,489,1733,true],["let","a_mem",324,395,1734,true],["let","A",113,322,1735,false],["lambda","hab",210,1736,"explicit"],["apply",302,1737],["lambda","h",166,1738,"explicit"],["lambda","ha",86,1739,"explicit"],["lambda","hs",76,1740,"explicit"],["lambda","s",48,1741,"implicit"],["lambda","b",45,1742,"implicit"],["lambda","a",44,1743,"implicit"],["lambda","inst._@.Mathlib.Topology.Order.IntermediateValue.2987564383._hygCtx._hyg.12",43,1744,"instance"],["lambda","inst._@.Mathlib.Topology.Order.IntermediateValue.2987564383._hygCtx._hyg.9",26,1745,"instance"],["lambda","inst._@.Mathlib.Topology.Order.IntermediateValue.2987564383._hygCtx._hyg.6",6,1746,"instance"],["lambda","inst._@.Mathlib.Topology.Order.IntermediateValue.2987564383._hygCtx._hyg.3",3,1747,"instance"],["lambda","α",0,1748,"implicit"]],"project":false,"range":{"column":0,"endColumn":7,"endLine":391,"line":354},"type":186,"typeText":"∀ {α : Type u} [inst : ConditionallyCompleteLinearOrder.{u} α] [inst_1 : TopologicalSpace.{u} α] [OrderTopology.{u} α]\n  [DenselyOrdered.{u} α] {a b : α} {s : Set.{u} α},\n  IsClosed.{u} (Inter.inter.{u} s (Set.Icc.{u} a b)) →\n    Membership.mem.{u, u} s a →\n      (∀ (t : α),\n          Membership.mem.{u, u} (Set.Ico.{u} a b) t →\n            HasSubset.Subset.{u} (Set.Icc.{u} a t) s → Membership.mem.{u, u} (nhdsWithin.{u} t (Set.Ioi.{u} t)) s) →\n        HasSubset.Subset.{u} (Set.Icc.{u} a b) s","unsafe":false,"value":1749,"source":{"code":"/-- A \"continuous induction principle\" for a closed interval: if a set `s` meets `[a, b]`\non a closed subset, contains `a`, and for any `x ∈ [a, b)` such that `[a, x]` is included in `s`,\nthe set `s` includes some open neighborhood of `x` within `(x, +∞)`, then `[a, b] ⊆ s`. -/\nlemma IsClosed.Icc_subset_of_forall_mem_nhdsGT_of_Icc_subset {a b : α} {s : Set α}\n    (hs : IsClosed (s ∩ Icc a b)) (ha : a ∈ s)\n    (h : ∀ t ∈ Ico a b, Icc a t ⊆ s → s ∈ 𝓝[>] t) :\n    Icc a b ⊆ s := by\n  rcases lt_or_ge b a with hab | hab\n  · simp_all\n  set A := {t ∈ Icc a b | Icc a t ⊆ s}\n  have a_mem : a ∈ A := ⟨left_mem_Icc.mpr hab, by simp [ha]⟩\n  have bdd_A : BddAbove A := ⟨b, fun t ht ↦ ht.1.2⟩\n  set t₁ := sSup A\n  have t₁_mem : t₁ ∈ Icc a b := ⟨le_csSup bdd_A a_mem, csSup_le ⟨a, a_mem⟩ (fun t ht ↦ ht.1.2)⟩\n  obtain ⟨⟨t₁a, t₁b⟩, ht₁⟩ : t₁ ∈ A := by\n    refine ⟨t₁_mem, fun t ht ↦ ?_⟩\n    rcases ht.2.eq_or_lt with rfl | h\n    · have : closure A ⊆ s ∩ Icc a b := by\n        apply (closure_subset_iff hs).2 (fun t ht ↦ ⟨?_, ht.1⟩)\n        have : t ∈ Icc a t := ⟨ht.1.1, le_rfl⟩\n        exact ht.2 this\n      apply this.trans inter_subset_left\n      exact csSup_mem_closure ⟨a, a_mem⟩ bdd_A\n    · obtain ⟨c, cA, tc⟩ : ∃ c ∈ A, t < c := (lt_csSup_iff bdd_A ⟨a, a_mem⟩).1 h\n      apply cA.2\n      exact ⟨ht.1, tc.le⟩\n  suffices t₁ = b by simpa [this] using ht₁\n  apply eq_of_le_of_not_lt t₁b fun t₁b' ↦ ?_\n  obtain ⟨m, t₁m, H⟩ : ∃ m > t₁, Ioo t₁ m ⊆ s :=\n    (mem_nhdsGT_iff_exists_Ioo_subset' t₁b').mp (h t₁ ⟨t₁a, t₁b'⟩ (fun s hs ↦ ht₁ hs))\n  obtain ⟨t, hat, ht⟩ : ∃ t, t₁ < t ∧ t < min m b := exists_between (lt_min t₁m t₁b')\n  have : t ∈ A := by\n    refine ⟨⟨by order, ht.le.trans (min_le_right _ _)⟩, fun t' ht' ↦ ?_⟩\n    rcases le_or_gt t' t₁ with h't' | h't'\n    · exact ht₁ ⟨ht'.1, h't'⟩\n    · exact H ⟨h't', ht'.2.trans_lt <| ht.trans_le <| min_le_left ..⟩\n  have : t ≤ t₁ := le_csSup bdd_A this\n  order","start":354,"end":391},"axioms":["Classical.choice","Quot.sound","propext"]}