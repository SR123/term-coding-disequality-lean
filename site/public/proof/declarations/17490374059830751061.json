],["constant","PSigma",[["max",["succ",["param","u"]],["succ",["param","v"]]],["succ",["zero"]]]],["bound",6],["apply",4,56],["apply",57,21],["apply",55,58],["constant","PSigma",[["zero"],["zero"]]],["bound",7],["apply",11,61],["apply",62,56],["apply",63,5],["apply",60,64],["bound",8],["apply",11,66],["apply",67,61],["apply",68,5],["lambda","hl",64,69,"explicit"],["apply",65,70],["lambda","r",58,71,"explicit"],["apply",59,72],["lambda","l",53,73,"explicit"],["apply",54,74],["apply",75,12],["constant","PSigma.mk",[["max",["succ",["param","u"]],["succ",["param","v"]]],["succ",["zero"]]]],["apply",77,53],["apply",11,56],["apply",79,21],["apply",80,16],["apply",60,81],["lambda","hl",81,64,"explicit"],["apply",82,83],["lambda","r",53,84,"explicit"],["apply",78,85],["apply",86,8],["constant","PSigma.mk",[["zero"],["zero"]]],["apply",11,21],["apply",89,16],["apply",90,12],["apply",88,91],["apply",80,12],["lambda","hl",91,93,"explicit"],["apply",92,94],["apply",95,5],["apply",96,1],["apply",87,97],["apply",76,98],["apply",50,99],["lambda","hr",19,100,"explicit"],["lambda","hl",15,101,"explicit"],["lambda","r",10,102,"explicit"],["lambda","l",7,103,"explicit"],["lambda","β",3,104,"implicit"],["lambda","α",0,105,"implicit"]],"project":false,"range":{"column":0,"endColumn":34,"endLine":273,"line":256},"type":47,"typeText":"{α : Type u} →\n  {β : α → Type v} →\n    (l r : Std.DTreeMap.Internal.Impl.{u, v} α β) →\n      Std.DTreeMap.Internal.Impl.Balanced.{u, v} l →\n        Std.DTreeMap.Internal.Impl.Balanced.{u, v} r →\n          Std.DTreeMap.Internal.Impl.Tree.{u, v} α β\n            (HAdd.hAdd.{0, 0, 0} (Std.DTreeMap.Internal.Impl.size.{u, v} l) (Std.DTreeMap.Internal.Impl.size.{u, v} r))","unsafe":false,"value":106,"source":{"code":"/-- Builds the tree `l ++ r` without any balancing information at the root. -/\ndef link2 (l r : Impl α β) (hl : l.Balanced) (hr : r.Balanced) :\n    Tree α β (l.size + r.size) :=\n  match hl' : l with\n  | leaf => ⟨r, ✓, ✓⟩\n  | (inner szl k' v' l' r') =>\n    match hr' : r with\n    | leaf => ⟨l, ✓, ✓⟩\n    | (inner szr k'' v'' l'' r'') =>\n      if h₁ : delta * szl < szr then\n        let ⟨ℓ, hℓ₁, hℓ₂⟩ := link2 l l'' ✓ ✓\n        ⟨balanceLErase k'' v'' ℓ r'' ✓ ✓ ✓, ✓, ✓⟩\n      else if h₂ : delta * szr < szl then\n        let ⟨ℓ, hℓ₁, hℓ₂⟩ := link2 r' r ✓ ✓\n        ⟨balanceRErase k' v' l' ℓ ✓ ✓ ✓, ✓, ✓⟩\n      else\n        ⟨glue l r ✓ ✓ ✓, ✓, ✓⟩\ntermination_by sizeOf l + sizeOf r","start":256,"end":273},"axioms":["Classical.choice","Quot.sound","propext"]}