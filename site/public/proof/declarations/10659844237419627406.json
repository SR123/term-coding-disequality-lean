,"a",0,534,"implicit"]],"project":false,"range":{"column":0,"endColumn":35,"endLine":870,"line":861},"type":40,"typeText":"∀ {a b : Nat}, Iff (Eq.{1} (HDiv.hDiv.{0, 0, 0} a b) 0) (Or (Eq.{1} b 0) (LT.lt.{0} a b))","unsafe":false,"value":535,"source":{"code":"@[simp] protected theorem div_eq_zero_iff : a / b = 0 ↔ b = 0 ∨ a < b where\n  mp h := by\n    rw [← mod_add_div a b, h, Nat.mul_zero, Nat.add_zero, Decidable.or_iff_not_imp_left]\n    exact mod_lt _ ∘ Nat.pos_iff_ne_zero.2\n  mpr := by\n    obtain rfl | hb := Decidable.em (b = 0)\n    · simp\n    simp only [hb, false_or]\n    rw [← Nat.mul_right_inj hb, ← Nat.add_left_cancel_iff, mod_add_div]\n    simp +contextual [mod_eq_of_lt]","start":861,"end":870},"axioms":["propext"]}