"string","Std.DTreeMap.Internal.Impl.balanceR!"],["apply",386,387],["natural","272"],["apply",47,389],["apply",50,389],["apply",390,391],["apply",388,392],["natural","35"],["apply",47,394],["apply",50,394],["apply",395,396],["apply",393,397],["string","balanceR! input was not balanced"],["apply",398,399],["lambda","r._@.Std.Data.DTreeMap.Internal.Balancing.1376552986._hygCtx._hyg.510",304,400,"explicit"],["lambda","l._@.Std.Data.DTreeMap.Internal.Balancing.1376552986._hygCtx._hyg.509",302,401,"explicit"],["lambda","v._@.Std.Data.DTreeMap.Internal.Balancing.1376552986._hygCtx._hyg.508",300,402,"explicit"],["lambda","k._@.Std.Data.DTreeMap.Internal.Balancing.1376552986._hygCtx._hyg.507",108,403,"explicit"],["lambda","size._@.Std.Data.DTreeMap.Internal.Balancing.1376552986._hygCtx._hyg.506",46,404,"explicit"],["apply",378,405],["apply",379,170],["apply",381,108],["apply",408,95],["apply",407,409],["apply",410,385],["apply",411,387],["natural","273"],["apply",47,413],["apply",50,413],["apply",414,415],["apply",412,416],["natural","21"],["apply",47,418],["apply",50,418],["apply",419,420],["apply",417,421],["apply",422,399],["lambda","x._@.Std.Data.DTreeMap.Internal.Balancing.1376552986._hygCtx._hyg.525",97,423,"explicit"],["apply",406,424],["apply",288,425],["apply",205,64],["apply",204,427],["apply",428,11],["apply",101,429],["apply",430,87],["apply",431,89],["apply",432,85],["apply",433,138],["apply",426,434],["lambda","rr",93,435,"explicit"],["lambda","rl",90,436,"explicit"],["lambda","rv",86,437,"explicit"],["lambda","rk",85,438,"explicit"],["lambda","rs",46,439,"explicit"],["apply",263,440],["lambda","r._@.Std.Data.DTreeMap.Internal.Balancing.1376552986._hygCtx._hyg.308",84,441,"explicit"],["lambda","l._@.Std.Data.DTreeMap.Internal.Balancing.1376552986._hygCtx._hyg.307",242,442,"explicit"],["lambda","v._@.Std.Data.DTreeMap.Internal.Balancing.1376552986._hygCtx._hyg.306",240,443,"explicit"],["lambda","k._@.Std.Data.DTreeMap.Internal.Balancing.1376552986._hygCtx._hyg.305",26,444,"explicit"],["lambda","ls",46,445,"explicit"],["apply",239,446],["lambda","r",13,447,"explicit"],["lambda","l",10,448,"explicit"],["lambda","v",5,449,"explicit"],["lambda","k",4,450,"explicit"],["lambda","β",3,451,"implicit"],["lambda","α",0,452,"implicit"]],"project":false,"range":{"column":0,"endColumn":39,"endLine":274,"line":246},"type":22,"typeText":"{α : Type u} →\n  {β : α → Type v} →\n    (k : α) →\n      β k →\n        Std.DTreeMap.Internal.Impl.{u, v} α β →\n          Std.DTreeMap.Internal.Impl.{u, v} α β → Std.DTreeMap.Internal.Impl.{u, v} α β","unsafe":false,"value":453,"source":{"code":"/--\nSlower version of `balanceR` which can be used in the complete absence of balancing information\nbut still assumes that the preconditions of `balanceR` or `balanceRErase` are satisfied\n(otherwise panics).\n-/\n@[inline]\ndef balanceR! (k : α) (v : β k) (l r : Impl α β) : Impl α β :=\n  match l with\n  | leaf => match r with\n    | leaf => .inner 1 k v .leaf .leaf\n    | inner _ _ _ .leaf .leaf => .inner 2 k v .leaf r\n    | inner _ rk rv .leaf rr@(.inner _ _ _ _ _) => .inner 3 rk rv (.inner 1 k v .leaf .leaf) rr\n    | inner _ rk rv (.inner _ rlk rlv _ _) .leaf => .inner 3 rlk rlv (.inner 1 k v .leaf .leaf)\n        (.inner 1 rk rv .leaf .leaf)\n    | inner rs rk rv rl@(.inner rls _ _ _ _) rr@(.inner _ _ _ _ _) =>\n      .inner (1 + rs) rk rv (.inner (1 + rls) k v .leaf rl) rr\n  | inner ls _ _ _ _ => match r with\n    | leaf => .inner (1 + ls) k v l .leaf\n    | inner rs rk rv rl rr =>\n      if rs > delta * ls then match rl, rr with\n        | inner rls rlk rlv rll rlr, .inner rrs _ _ _ _ =>\n          if rls < ratio * rrs then\n            .inner (1 + ls + rs) rk rv (.inner (1 + ls + rls) k v l rl) rr\n          else\n            .inner (1 + ls + rs) rlk rlv (.inner (1 + ls + rll.size) k v l rll)\n              (.inner (1 + rrs + rlr.size) rk rv rlr rr)\n        | inner _ _ _ _ _, leaf => panic! \"balanceR! input was not balanced\"\n        | leaf, _ => panic! \"balanceR! input was not balanced\"\n      else .inner (1 + ls + rs) k v l r","start":246,"end":274},"axioms":[]}