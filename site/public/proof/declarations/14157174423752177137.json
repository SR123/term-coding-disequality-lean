y",632,637],["constant","Filter.tendsto_snd",[["param","u"],["param","v"]]],["apply",639,32],["apply",640,40],["apply",641,5],["apply",642,45],["apply",638,643],["apply",621,644],["apply",581,645],["lambda","m₂",11,646,"implicit"],["lambda","m₁",11,647,"implicit"],["lambda","f₂",8,648,"implicit"],["lambda","f₁",6,649,"implicit"],["lambda","β₂",3,650,"implicit"],["lambda","β₁",2,651,"implicit"],["lambda","α₂",1,652,"implicit"],["lambda","α₁",0,653,"implicit"]],"project":false,"range":{"column":0,"endColumn":74,"endLine":335,"line":327},"type":96,"typeText":"∀ {α₁ : Type u} {α₂ : Type v} {β₁ : Type w} {β₂ : Type x} {f₁ : Filter.{u} α₁} {f₂ : Filter.{v} α₂} {m₁ : α₁ → β₁}\n  {m₂ : α₂ → β₂},\n  Eq.{max (w + 1) (x + 1)} (SProd.sprod.{w, x, max w x} (Filter.map.{u, w} m₁ f₁) (Filter.map.{v, x} m₂ f₂))\n    (Filter.map.{max u v, max x w} (fun p => Prod.mk.{w, x} (m₁ p.1) (m₂ p.2)) (SProd.sprod.{u, v, max u v} f₁ f₂))","unsafe":false,"value":654,"source":{"code":"theorem prod_map_map_eq.{u, v, w, x} {α₁ : Type u} {α₂ : Type v} {β₁ : Type w} {β₂ : Type x}\n    {f₁ : Filter α₁} {f₂ : Filter α₂} {m₁ : α₁ → β₁} {m₂ : α₂ → β₂} :\n    map m₁ f₁ ×ˢ map m₂ f₂ = map (fun p : α₁ × α₂ => (m₁ p.1, m₂ p.2)) (f₁ ×ˢ f₂) :=\n  le_antisymm\n    (fun s hs =>\n      let ⟨s₁, hs₁, s₂, hs₂, h⟩ := mem_prod_iff.mp hs\n      mem_of_superset (prod_mem_prod (image_mem_map hs₁) (image_mem_map hs₂)) <|\n        by rwa [prod_image_image_eq, image_subset_iff])\n    ((tendsto_map.comp tendsto_fst).prodMk (tendsto_map.comp tendsto_snd))","start":327,"end":335},"axioms":["Quot.sound","propext"]}