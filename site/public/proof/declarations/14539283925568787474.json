[["param","u_1"]]],["apply",961,56],["apply",32,56],["apply",963,80],["apply",962,964],["apply",965,8],["apply",966,27],["apply",967,5],["apply",960,968],["apply",969,414],["apply",948,970],["apply",337,971],["lambda","s",50,972,"explicit"],["lambda","h",47,973,"explicit"],["lambda","b",28,974,"implicit"],["lambda","a",27,975,"implicit"],["lambda","inst._@.Mathlib.Topology.Order.LeftRightNhds.2790033233._hygCtx._hyg.11",26,976,"instance"],["lambda","inst._@.Mathlib.Topology.Order.LeftRightNhds.2790033233._hygCtx._hyg.8",6,977,"instance"],["lambda","inst._@.Mathlib.Topology.Order.LeftRightNhds.2790033233._hygCtx._hyg.5",3,978,"instance"],["lambda","α",0,979,"implicit"]],"project":false,"range":{"column":0,"endColumn":51,"endLine":181,"line":168},"type":172,"typeText":"∀ {α : Type u_1} [inst : TopologicalSpace.{u_1} α] [inst_1 : LinearOrder.{u_1} α] [OrderTopology.{u_1} α] {a b : α},\n  LT.lt.{u_1} a b →\n    ∀ (s : Set.{u_1} α),\n      List.TFAE\n        (List.cons.{0} (Membership.mem.{u_1, u_1} (nhdsWithin.{u_1} b (Set.Iio.{u_1} b)) s)\n          (List.cons.{0} (Membership.mem.{u_1, u_1} (nhdsWithin.{u_1} b (Set.Ico.{u_1} a b)) s)\n            (List.cons.{0} (Membership.mem.{u_1, u_1} (nhdsWithin.{u_1} b (Set.Ioo.{u_1} a b)) s)\n              (List.cons.{0}\n                (∃ l,\n                  And (Membership.mem.{u_1, u_1} (Set.Ico.{u_1} a b) l) (HasSubset.Subset.{u_1} (Set.Ioo.{u_1} l b) s))\n                (List.cons.{0}\n                  (∃ l,\n                    And (Membership.mem.{u_1, u_1} (Set.Iio.{u_1} b) l) (HasSubset.Subset.{u_1} (Set.Ioo.{u_1} l b) s))\n                  List.nil.{0})))))","unsafe":false,"value":980,"source":{"code":"/-- The following statements are equivalent:\n\n0. `s` is a neighborhood of `b` within `(-∞, b)`\n1. `s` is a neighborhood of `b` within `[a, b)`\n2. `s` is a neighborhood of `b` within `(a, b)`\n3. `s` includes `(l, b)` for some `l ∈ [a, b)`\n4. `s` includes `(l, b)` for some `l < b` -/\ntheorem TFAE_mem_nhdsLT {a b : α} (h : a < b) (s : Set α) :\n    TFAE [s ∈ 𝓝[<] b,-- 0 : `s` is a neighborhood of `b` within `(-∞, b)`\n        s ∈ 𝓝[Ico a b] b,-- 1 : `s` is a neighborhood of `b` within `[a, b)`\n        s ∈ 𝓝[Ioo a b] b,-- 2 : `s` is a neighborhood of `b` within `(a, b)`\n        ∃ l ∈ Ico a b, Ioo l b ⊆ s,-- 3 : `s` includes `(l, b)` for some `l ∈ [a, b)`\n        ∃ l ∈ Iio b, Ioo l b ⊆ s] := by-- 4 : `s` includes `(l, b)` for some `l < b`\n  simpa using TFAE_mem_nhdsGT h.dual (ofDual ⁻¹' s)","start":168,"end":181},"axioms":["Classical.choice","Quot.sound","propext"]}