→\n        [inst : Add.{u_2} S] →\n          [inst_1 : Mul.{u_2} S] →\n            [inst_2 : Zero.{u_2} S] →\n              [inst_3 : One.{u_2} S] →\n                [inst_4 : SMul.{0, u_2} Nat S] →\n                  [inst_5 : NatCast.{u_2} S] →\n                    [inst_6 : NonAssocSemiring.{u_1} R] →\n                      Eq.{u_2 + 1} (f 0) 0 →\n                        Eq.{u_2 + 1} (f 1) 1 →\n                          (∀ (x y : R),\n                              Eq.{u_2 + 1} (f (HAdd.hAdd.{u_1, u_1, u_1} x y))\n                                (HAdd.hAdd.{u_2, u_2, u_2} (f x) (f y))) →\n                            (∀ (x y : R),\n                                Eq.{u_2 + 1} (f (HMul.hMul.{u_1, u_1, u_1} x y))\n                                  (HMul.hMul.{u_2, u_2, u_2} (f x) (f y))) →\n                              (∀ (n : Nat) (x : R),\n                                  Eq.{u_2 + 1} (f (HSMul.hSMul.{0, u_1, u_1} n x))\n                                    (HSMul.hSMul.{0, u_2, u_2} n (f x))) →\n                                (∀ (n : Nat), Eq.{u_2 + 1} (f ↑n) ↑n) → NonAssocSemiring.{u_2} S","unsafe":false,"value":369,"source":{"code":"/-- Pushforward a `NonAssocSemiring` instance along a surjective function. -/\n-- See note [reducible non-instances]\nprotected abbrev nonAssocSemiring [NonAssocSemiring R] (zero : f 0 = 0) (one : f 1 = 1)\n    (add : ∀ x y, f (x + y) = f x + f y) (mul : ∀ x y, f (x * y) = f x * f y)\n    (nsmul : ∀ (n : ℕ) (x), f (n • x) = n • f x)\n    (natCast : ∀ n : ℕ, f n = n) : NonAssocSemiring S where\n  toNonUnitalNonAssocSemiring := hf.nonUnitalNonAssocSemiring f zero add mul nsmul\n  __ := hf.mulZeroOneClass f zero one mul\n  __ := hf.addMonoidWithOne f zero one add nsmul natCast","start":362,"end":370},"axioms":["propext"]}