roject":false,"range":{"column":0,"endColumn":44,"endLine":671,"line":661},"type":11,"typeText":"(M : Type u_2) → [inst : Mul.{u_2} M] → Group.{u_2} (MulAut.{u_2} M)","unsafe":false,"value":125,"source":{"code":"/-- The group operation on multiplicative automorphisms is defined by `g h => MulEquiv.trans h g`.\nThis means that multiplication agrees with composition, `(g*h)(x) = g (h x)`.\n-/\ninstance : Group (MulAut M) where\n  mul g h := MulEquiv.trans h g\n  one := MulEquiv.refl _\n  inv := MulEquiv.symm\n  mul_assoc _ _ _ := rfl\n  one_mul _ := rfl\n  mul_one _ := rfl\n  inv_mul_cancel := MulEquiv.self_trans_symm","start":661,"end":671},"axioms":["Quot.sound"]}