cit"],["lambda","x",20,64,"explicit"],["apply",61,65],["lambda","x._@.Init.PropLemmas.1448310553._hygCtx._hyg.57",53,66,"explicit"],["lambda","h",29,67,"explicit"],["apply",50,68],["lambda","q",10,69,"implicit"],["lambda","p",3,70,"implicit"],["lambda","α",0,71,"implicit"]],"project":false,"range":{"column":0,"endColumn":56,"endLine":219,"line":213},"type":33,"typeText":"∀ {α : Sort u_1} {p : α → Prop} {q : (∃ x, p x) → Prop}, Iff (∀ (h : ∃ x, p x), q h) (∀ (x : α) (h : p x), q ⋯)","unsafe":false,"value":72,"source":{"code":"/--\nAs `simp` does not index foralls, this `@[simp]` lemma is tried on every `forall` expression.\nThis is not ideal, and likely a performance issue, but it is difficult to remove this attribute at this time.\n-/\n@[simp] theorem forall_exists_index {q : (∃ x, p x) → Prop} :\n    (∀ h, q h) ↔ ∀ x (h : p x), q ⟨x, h⟩ :=\n  ⟨fun h x hpx => h ⟨x, hpx⟩, fun h ⟨x, hpx⟩ => h x hpx⟩","start":213,"end":219},"axioms":[]}