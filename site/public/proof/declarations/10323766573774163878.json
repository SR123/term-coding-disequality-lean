,898,170],["apply",899,154],["apply",900,100],["apply",901,91],["apply",902,52],["apply",903,48],["apply",904,32],["apply",905,7],["apply",906,9],["apply",907,4],["apply",908,1],["apply",893,909],["lambda","hlr",892,910,"explicit"],["lambda","hlb",877,911,"explicit"],["lambda","x._@.Std.Data.DTreeMap.Internal.Balancing.4203757215._hygCtx._hyg.659",635,912,"explicit"],["apply",865,913],["lambda","hlsd",617,914,"explicit"],["apply",622,915],["constant","Not",[]],["apply",917,617],["apply",122,362],["apply",919,331],["apply",456,463],["apply",921,154],["apply",920,922],["apply",923,304],["apply",924,236],["apply",925,215],["apply",926,197],["lambda","hlsd",918,927,"explicit"],["apply",916,928],["lambda","hlr",595,929,"explicit"],["lambda","hlb",581,930,"explicit"],["lambda","lr",275,931,"explicit"],["lambda","ll",272,932,"explicit"],["lambda","lv",575,933,"explicit"],["lambda","lk",191,934,"explicit"],["lambda","ls",126,935,"explicit"],["apply",574,936],["lambda","hlr",512,937,"explicit"],["lambda","hrb",503,938,"explicit"],["lambda","r._@.Std.Data.DTreeMap.Internal.Balancing.4203757215._hygCtx._hyg.389",497,939,"explicit"],["lambda","l._@.Std.Data.DTreeMap.Internal.Balancing.4203757215._hygCtx._hyg.388",61,940,"explicit"],["lambda","v._@.Std.Data.DTreeMap.Internal.Balancing.4203757215._hygCtx._hyg.387",495,941,"explicit"],["lambda","k._@.Std.Data.DTreeMap.Internal.Balancing.4203757215._hygCtx._hyg.386",48,942,"explicit"],["lambda","rs",126,943,"explicit"],["apply",494,944],["lambda","hlr",31,945,"explicit"],["lambda","hrb",22,946,"explicit"],["lambda","hlb",18,947,"explicit"],["lambda","r",13,948,"explicit"],["lambda","l",10,949,"explicit"],["lambda","v",5,950,"explicit"],["lambda","k",4,951,"explicit"],["lambda","β",3,952,"implicit"],["lambda","α",0,953,"implicit"]],"project":false,"range":{"column":0,"endColumn":39,"endLine":150,"line":121},"type":43,"typeText":"{α : Type u} →\n  {β : α → Type v} →\n    (k : α) →\n      β k →\n        (l r : Std.DTreeMap.Internal.Impl.{u, v} α β) →\n          Std.DTreeMap.Internal.Impl.Balanced.{u, v} l →\n            Std.DTreeMap.Internal.Impl.Balanced.{u, v} r →\n              Std.DTreeMap.Internal.Impl.BalanceLErasePrecond (Std.DTreeMap.Internal.Impl.size.{u, v} l)\n                  (Std.DTreeMap.Internal.Impl.size.{u, v} r) →\n                Std.DTreeMap.Internal.Impl.{u, v} α β","unsafe":false,"value":954,"source":{"code":"/--\nSlower version of `balanceL` with weaker balancing assumptions that hold after erasing from\nthe right side of the tree.\n-/\n@[inline]\ndef balanceLErase (k : α) (v : β k) (l r : Impl α β) (hlb : Balanced l) (hrb : Balanced r)\n    (hlr : BalanceLErasePrecond l.size r.size) : Impl α β :=\n  match r with\n  | leaf => match l with\n    | leaf => .inner 1 k v .leaf .leaf\n    | inner _ _ _ .leaf .leaf => .inner 2 k v l .leaf\n    | inner _ lk lv .leaf (.inner _ lrk lrv _ _) =>\n      .inner 3 lrk lrv (.inner 1 lk lv .leaf .leaf) (.inner 1 k v .leaf .leaf)\n    | inner _ lk lv ll@(.inner _ _ _ _ _) .leaf =>\n      .inner 3 lk lv ll (.inner 1 k v .leaf .leaf)\n    | inner ls lk lv ll@(.inner lls _ _ _ _) lr@(.inner lrs lrk lrv lrl lrr) =>\n      .inner (1 + ls) lk lv ll (.inner (1 + lrs) k v lr .leaf)\n  | (inner rs _ _ _ _) => match l with\n    | leaf => .inner (1 + rs) k v .leaf r\n    | (inner ls lk lv ll lr) =>\n      if hlsd : delta * rs < ls then match ll, lr with\n        | inner lls _ _ _ _, inner lrs lrk lrv lrl lrr =>\n          if lrs < ratio * lls then\n            .inner (1 + ls + rs) lk lv ll (.inner (1 + rs + lrs) k v lr r)\n          else\n            .inner (1 + ls + rs) lrk lrv (.inner (1 + lls + lrl.size) lk lv ll lrl)\n              (.inner (1 + rs + lrr.size) k v lrr r)\n        | inner _ _ _ _ _, leaf => False.elim ✓\n        | leaf, _ => False.elim ✓\n      else .inner (1 + ls + rs) k v l r","start":121,"end":150},"axioms":["Quot.sound","propext"]}