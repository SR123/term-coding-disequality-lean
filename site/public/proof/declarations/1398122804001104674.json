bda","x._@.Init.Data.List.Erase.2449189046._hygCtx._hyg.104",101,1412,"explicit"],["apply",175,1413],["apply",1414,7],["apply",1415,5],["apply",1416,1],["lambda","x._@.Init.Data.List.Erase.2449189046._hygCtx._hyg.107",23,1417,"explicit"],["lambda","x._@.Init.Data.List.Erase.2449189046._hygCtx._hyg.106",17,1418,"explicit"],["lambda","x._@.Init.Data.List.Erase.2449189046._hygCtx._hyg.105",7,1419,"explicit"],["lambda","x._@.Init.Data.List.Erase.2449189046._hygCtx._hyg.104",6,1420,"explicit"],["lambda","p",3,1421,"implicit"],["lambda","α",0,1422,"implicit"]],"project":false,"range":{"column":0,"endColumn":56,"endLine":73,"line":62},"type":98,"typeText":"∀ {α : Type u_1} {p : α → Bool} {l : List.{u_1} α} {a : α},\n  Membership.mem.{u_1, u_1} l a →\n    Eq.{1} (p a) Bool.true →\n      ∃ a l₁ l₂,\n        And (∀ (b : α), Membership.mem.{u_1, u_1} l₁ b → Not (Eq.{1} (p b) Bool.true))\n          (And (Eq.{1} (p a) Bool.true)\n            (And (Eq.{u_1 + 1} l (HAppend.hAppend.{u_1, u_1, u_1} l₁ (List.cons.{u_1} a l₂)))\n              (Eq.{u_1 + 1} (List.eraseP.{u_1} p l) (HAppend.hAppend.{u_1, u_1, u_1} l₁ l₂))))","unsafe":false,"value":1423,"source":{"code":"theorem exists_of_eraseP : ∀ {l : List α} {a} (_ : a ∈ l) (_ : p a),\n    ∃ a l₁ l₂, (∀ b ∈ l₁, ¬p b) ∧ p a ∧ l = l₁ ++ a :: l₂ ∧ l.eraseP p = l₁ ++ l₂\n  | b :: l, _, al, pa =>\n    if pb : p b then\n      ⟨b, [], l, forall_mem_nil _, pb, by simp [pb]⟩\n    else\n      match al with\n      | .head .. => nomatch pb pa\n      | .tail _ al =>\n        let ⟨c, l₁, l₂, h₁, h₂, h₃, h₄⟩ := exists_of_eraseP al pa\n        ⟨c, b::l₁, l₂, (forall_mem_cons ..).2 ⟨pb, h₁⟩,\n          h₂, by rw [h₃, cons_append], by simp [pb, h₄]⟩","start":62,"end":73},"axioms":["propext"]}