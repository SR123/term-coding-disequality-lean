{S : Type} [inst : DecidableEq.{1} S] (w : List.{0} (DisequalityDispersion.Letter.{0} S)),\n  Iff (DisequalityDispersion.Reduced w) (List.IsChain.{0} (fun a b => Ne.{1} b (DisequalityDispersion.Letter.inv a)) w)","unsafe":false,"value":337,"source":{"code":"/-- Reduced words are exactly the chains of the adjacency relation. -/\ntheorem reduced_iff_isChain (w : List (Letter S)) :\n    Reduced w ↔ w.IsChain (fun a b => b ≠ Letter.inv a) := by\n  unfold Reduced\n  induction w with\n  | nil => simp [reducedB]\n  | cons a l ih =>\n      rw [List.isChain_cons, ← ih]\n      simp only [reducedB, Bool.and_eq_true, headOk_iff]","start":72,"end":80,"lines":[[{"text":"/-- Reduced words are exactly the chains of the adjacency relation. -/"}],[{"text":"theorem reduced_iff_isChain (w : "},{"text":"List","name":"List"},{"text":" "},{"text":"(Letter S)","name":"DisequalityDispersion.Letter"},{"text":") :"}],[{"text":"    "},{"text":"Reduced","name":"DisequalityDispersion.Reduced"},{"text":" w ↔ "},{"text":"w.IsChain (fun a b => b ≠ Letter.inv a)","name":"List.IsChain"},{"text":" := by"}],[{"text":"  unfold "},{"text":"Reduced","name":"DisequalityDispersion.Reduced"}],[{"text":"  induction w with"}],[{"text":"  | "},{"text":"nil","name":"List.nil"},{"text":" => simp ["},{"text":"reducedB","name":"DisequalityDispersion.reducedB"},{"text":"]"}],[{"text":"  | "},{"text":"cons","name":"List.cons"},{"text":" a l ih =>"}],[{"text":"      rw ["},{"text":"List.isChain_cons","name":"List.isChain_cons"},{"text":", ← ih]"}],[{"text":"      simp only ["},{"text":"reducedB","name":"DisequalityDispersion.reducedB"},{"text":", "},{"text":"Bool.and_eq_true","name":"Bool.and_eq_true"},{"text":", "},{"text":"headOk_iff","name":"DisequalityDispersion.headOk_iff"},{"text":"]"}]]},"steps":[{"after":[],"before":[0],"declaration":"DisequalityDispersion.reduced_iff_isChain","elaborator":"[anonymous]","id":385,"kind":"tactic","parent":0,"range":{"end":{"byte":3129,"column":56,"line":80},"start":{"byte":2951,