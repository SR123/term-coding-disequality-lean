,229,612,"explicit"],["lambda","r'",218,613,"explicit"],["lambda","l'",216,614,"explicit"],["lambda","v'",214,615,"explicit"],["lambda","k'",106,616,"explicit"],["lambda","sz",29,617,"explicit"],["apply",213,618],["apply",619,5],["lambda","hl",100,620,"explicit"],["lambda","f",99,621,"explicit"],["lambda","t",59,622,"explicit"],["apply",77,623],["apply",624,1],["lambda","hl",18,625,"explicit"],["lambda","t",13,626,"explicit"],["lambda","v",8,627,"explicit"],["lambda","k",7,628,"explicit"],["lambda","inst._@.Std.Data.DTreeMap.Internal.Operations.2613969841._hygCtx._hyg.10",6,629,"instance"],["lambda","β",3,630,"implicit"],["lambda","α",0,631,"implicit"]],"project":false,"range":{"column":0,"endColumn":43,"endLine":335,"line":322},"type":54,"typeText":"{α : Type u} →\n  {β : α → Type v} →\n    [Ord.{u} α] →\n      (k : α) →\n        β k →\n          (t : Std.DTreeMap.Internal.Impl.{u, v} α β) →\n            Std.DTreeMap.Internal.Impl.Balanced.{u, v} t →\n              Std.DTreeMap.Internal.Impl.SizedBalancedTree.{u, v} α β (Std.DTreeMap.Internal.Impl.size.{u, v} t)\n                (HAdd.hAdd.{0, 0, 0} (Std.DTreeMap.Internal.Impl.size.{u, v} t) 1)","unsafe":false,"value":632,"source":{"code":"/-- Adds a new mapping to the key, overwriting an existing one with equal key if present. -/\ndef insert [Ord α] (k : α) (v : β k) (t : Impl α β) (hl : t.Balanced) :\n    SizedBalancedTree α β t.size (t.size + 1) :=\n  match t with\n  | leaf => ⟨.inner 1 k v .leaf .leaf, ✓, ✓, ✓⟩\n  | inner sz k' v' l' r' =>\n    match compare k k' with\n    | .lt =>\n        let ⟨d, hd, hd₁, hd₂⟩ := insert k v l' ✓\n        ⟨balanceL k' v' d r' ✓ ✓ ✓, ✓, ✓, ✓⟩\n    | .gt =>\n        let ⟨d, hd, hd₁, hd₂⟩ := insert k v r' ✓\n        ⟨balanceR k' v' l' d ✓ ✓ ✓, ✓, ✓, ✓⟩\n    | .eq => ⟨.inner sz k v l' r', ✓, ✓, ✓⟩","start":322,"end":335},"axioms":["Classical.choice","Quot.sound","propext"]}