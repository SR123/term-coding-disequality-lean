u_1} α] {a : α} {l : List.{u_1} α},\n  Membership.mem.{u_1, u_1} l a →\n    ∃ l₁ l₂,\n      And (a ∉ l₁)\n        (And (Eq.{u_1 + 1} l (HAppend.hAppend.{u_1, u_1, u_1} l₁ (List.cons.{u_1} a l₂)))\n          (Eq.{u_1 + 1} (List.erase.{u_1} l a) (HAppend.hAppend.{u_1, u_1, u_1} l₁ l₂)))","unsafe":false,"value":524,"source":{"code":"theorem exists_erase_eq [LawfulBEq α] {a : α} {l : List α} (h : a ∈ l) :\n    ∃ l₁ l₂, a ∉ l₁ ∧ l = l₁ ++ a :: l₂ ∧ l.erase a = l₁ ++ l₂ := by\n  let ⟨_, l₁, l₂, h₁, e, h₂, h₃⟩ := exists_of_eraseP h (beq_self_eq_true _)\n  rw [erase_eq_eraseP]; exact ⟨l₁, l₂, fun h => h₁ _ h (beq_self_eq_true _), eq_of_beq e ▸ h₂, h₃⟩","start":359,"end":362},"axioms":["Classical.choice","Quot.sound","propext"]}