{"dependencies":["TopologicalSpace","T0Space.mk","Inseparable","T0Space.rec","T0Space","Eq"],"doc":null,"extra":null,"kind":"definition","levels":["u_1","u"],"module":"Mathlib.Topology.Separation.Basic","name":"T0Space.casesOn","nodes":[["sort",["succ",["param","u"]]],["constant","TopologicalSpace",[["param","u"]]],["bound",0],["apply",1,2],["constant","T0Space",[["param","u"]]],["bound",1],["apply",4,5],["apply",6,2],["sort",["param","u_1"]],["forall","t",7,8,"explicit"],["bound",2],["apply",4,10],["apply",11,5],["bound",3],["bound",4],["constant","Inseparable",[["param","u"]]],["bound",5],["apply",15,16],["apply",17,14],["apply",18,5],["apply",19,2],["constant","Eq",[["succ",["param","u"]]]],["bound",6],["apply",21,22],["apply",23,10],["apply",24,5],["forall","a._@._internal._hyg.0",20,25,"explicit"],["forall","y",14,26,"strictImplicit"],["forall","x",13,27,"strictImplicit"],["constant","T0Space.mk",[["param","u"]]],["apply",29,14],["apply",30,13],["apply",31,2],["apply",10,32],["forall","t0",28,33,"explicit"],["apply",10,5],["forall","mk",34,35,"explicit"],["forall","t",12,36,"explicit"],["forall","motive",9,37,"implicit"],["forall","inst._@.Mathlib.Topology.Separation.Basic.1650707418._hygCtx._hyg.13",3,38,"instance"],["forall","X",0,39,"implicit"],["constant","T0Space.rec",[["param","u_1"],["param","u"]]],["apply",41,14],["apply",42,13],["apply",43,10],["apply",15,22],["apply",45,16],["apply",46,5],["apply",47,2],["bound",7],["apply",21,49],["apply",50,10],["apply",51,5],["forall","a._@._internal._hyg.0",48,52,"explicit"],["forall","y",16,53,"strictImplicit"],["forall","x",14,54,"strictImplicit"],["apply",5,2],["lambda","t0",55,56,"explicit"],["apply",44,57],["apply",58,5],["lambda","mk",34,59,"explicit"],["lambda","t",12,60,"explicit"],["lambda","motive",9,61,"implicit"],["lambda","inst._@.Mathlib.Topology.Separation.Basic.1650707418._hygCtx._hyg.13",3,62,"instance"],["lambda","X",0,63,"implicit"]],"project":false,"range":{"column":0,"endColumn":43,"endLine":79,"line":73},"type":40,"typeText":"{X : Type u} →\n  [inst : TopologicalSpace.{u} X] →\n    {motive : T0Space.{u} X → Sort u_1} →\n      (t : T0Space.{u} X) → ((t0 : ∀ ⦃x y : X⦄, Inseparable.{u} x y → Eq.{u + 1} x y) → motive ⋯) → motive t","unsafe":false,"value":64,"source":{"code":"/-- A T₀ space, also known as a Kolmogorov space, is a topological space such that for every pair\n`x ≠ y`, there is an open set containing one but not the other. We formulate the definition in terms\nof the `Inseparable` relation. -/\n@[stacks 004X \"(2)\"]\nclass T0Space (X : Type u) [TopologicalSpace X] : Prop where\n  /-- Two inseparable points in a T₀ space are equal. -/\n  t0 : ∀ ⦃x y : X⦄, Inseparable x y → x = y","start":73,"end":79},"axioms":["Quot.sound","propext"]}