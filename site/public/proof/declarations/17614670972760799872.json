apply",75,11],["apply",76,10],["apply",77,5],["apply",78,2],["apply",13,79],["forall","inv_val",71,80,"explicit"],["forall","val_inv",46,81,"explicit"],["forall","inv",11,82,"explicit"],["forall","val",10,83,"explicit"],["apply",4,11],["apply",85,10],["apply",10,2],["forall","t",86,87,"explicit"],["forall","mk",84,88,"explicit"],["forall","motive",9,89,"implicit"],["forall","inst._@.Mathlib.Algebra.Group.Units.Defs.805054321._hygCtx._hyg.5",3,90,"instance"],["forall","α",0,91,"implicit"],["apply",61,2],["apply",48,93],["apply",94,70],["apply",12,73],["apply",15,73],["apply",97,73],["apply",98,73],["apply",19,73],["apply",21,73],["apply",23,73],["apply",25,73],["apply",103,47],["apply",102,104],["apply",101,105],["apply",100,106],["apply",99,107],["apply",108,5],["apply",109,10],["apply",96,110],["apply",35,73],["apply",112,37],["apply",39,73],["apply",41,73],["apply",115,105],["apply",114,116],["apply",113,117],["apply",111,118],["apply",13,11],["apply",120,10],["apply",121,5],["apply",122,2],["lambda","inv_val",119,123,"explicit"],["lambda","val_inv",95,124,"explicit"],["lambda","inv",13,125,"explicit"],["lambda","val",11,126,"explicit"],["lambda","mk",84,127,"explicit"],["lambda","motive",9,128,"explicit"],["lambda","inst._@.Mathlib.Algebra.Group.Units.Defs.805054321._hygCtx._hyg.5",3,129,"instance"],["lambda","α",0,130,"explicit"]],"project":false,"range":{"column":0,"endColumn":25,"endLine":56,"line":43},"type":92,"typeText":"{α : Type u} →\n  [inst : Monoid.{u} α] →\n    {motive : Units.{u} α → Sort u_1} →\n      ((val inv : α) →\n          (val_inv : Eq.{u + 1} (HMul.hMul.{u, u, u} val inv) 1) →\n            (inv_val : Eq.{u + 1} (HMul.hMul.{u, u, u} inv val) 1) → motive (Units.mk.{u} val inv val_inv inv_val)) →\n        (t : Units.{u} α) → motive t","unsafe":false,"value":null,"source":{"code":"/-- Units of a `Monoid`, bundled version. Notation: `αˣ`.\n\nAn element of a `Monoid` is a unit if it has a two-sided inverse.\nThis version bundles the inverse element so that it can be computed.\nFor a predicate see `IsUnit`. -/\nstructure Units (α : Type u) [Monoid α] where\n  /-- The underlying value in the base `Monoid`. -/\n  val : α\n  /-- The inverse value of `val` in the base `Monoid`. -/\n  inv : α\n  /-- `inv` is the right inverse of `val` in the base `Monoid`. -/\n  val_inv : val * inv = 1\n  /-- `inv` is the left inverse of `val` in the base `Monoid`. -/\n  inv_val : inv * val = 1","start":43,"end":56},"axioms":[]}