"apply",437,481],["apply",515,516],["apply",514,517],["lambda","_a",0,518,"explicit"],["apply",505,519],["constant","Int.mul_neg",[]],["apply",521,483],["apply",522,62],["apply",520,523],["apply",503,524],["apply",500,525],["apply",130,499],["apply",486,495],["apply",437,528],["apply",16,529],["apply",530,492],["apply",527,531],["apply",159,499],["apply",533,531],["apply",157,534],["apply",164,497],["apply",536,529],["apply",212,517],["lambda","_a",0,538,"explicit"],["apply",537,539],["constant","Int.ediv_neg",[]],["apply",541,485],["apply",542,495],["apply",540,543],["apply",535,544],["apply",532,545],["apply",130,531],["apply",491,62],["apply",437,548],["apply",530,549],["apply",547,550],["apply",159,531],["apply",552,550],["apply",157,553],["apply",164,492],["apply",555,549],["apply",509,481],["apply",512,557],["apply",437,558],["apply",16,559],["apply",560,59],["lambda","_a",0,561,"explicit"],["apply",556,562],["apply",541,475],["apply",564,62],["apply",563,565],["apply",554,566],["apply",551,567],["apply",163,0],["apply",569,528],["apply",570,548],["apply",571,437],["apply",572,476],["apply",568,573],["apply",546,574],["apply",526,575],["lambda","H",472,576,"explicit"],["lambda","k",50,577,"explicit"],["lambda","m",50,578,"explicit"],["apply",480,579],["let","this",71,411,580,true],["lambda","H",14,581,"explicit"],["lambda","c",0,582,"explicit"],["lambda","b",0,583,"explicit"],["lambda","a",0,584,"implicit"]],"project":false,"range":{"column":0,"endColumn":30,"endLine":614,"line":592},"type":49,"typeText":"∀ {a : Int} (b c : Int),\n  LT.lt.{0} 0 a →\n    Eq.{1} (HDiv.hDiv.{0, 0, 0} (HMul.hMul.{0, 0, 0} a b) (HMul.hMul.{0, 0, 0} a c)) (HDiv.hDiv.{0, 0, 0} b c)","unsafe":false,"value":585,"source":{"code":"@[simp] theorem mul_ediv_mul_of_pos {a : Int}\n    (b c : Int) (H : 0 < a) : (a * b) / (a * c) = b / c :=\n  suffices ∀ (m k : Nat) (b : Int), (m.succ * b) / (m.succ * k) = b / k from\n    match a, eq_succ_of_zero_lt H, c, Int.eq_nat_or_neg c with\n    | _, ⟨m, rfl⟩, _, ⟨k, .inl rfl⟩ => this _ ..\n    | _, ⟨m, rfl⟩, _, ⟨k, .inr rfl⟩ => by\n      rw [Int.mul_neg, Int.ediv_neg, Int.ediv_neg]; apply congrArg Neg.neg; apply this\n  fun m k b =>\n  match b, k with\n  | ofNat _, _ => congrArg ofNat (Nat.mul_div_mul_left _ _ m.succ_pos)\n  | -[n+1], 0 => by\n    rw [Int.ofNat_zero, Int.mul_zero, Int.ediv_zero, Int.ediv_zero]\n  | -[n+1], succ k => congrArg negSucc <|\n    show (m.succ * n + m) / (m.succ * k.succ) = n / k.succ by\n      apply Nat.div_eq_of_lt_le\n      · refine Nat.le_trans ?_ (Nat.le_add_right _ _)\n        rw [← Nat.mul_div_mul_left _ _ m.succ_pos]\n        apply Nat.div_mul_le_self\n      · change m.succ * n.succ ≤ _\n        rw [Nat.mul_left_comm]\n        apply Nat.mul_le_mul_left\n        apply (Nat.div_lt_iff_lt_mul k.succ_pos).1\n        apply Nat.lt_succ_self","start":592,"end":614},"axioms":["propext"]}