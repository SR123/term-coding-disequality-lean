"apply",1709,1711],["apply",375,1689],["apply",1713,1711],["apply",373,1714],["apply",250,1687],["apply",1716,1553],["apply",784,42],["apply",1718,1626],["lambda","_a",1,1719,"explicit"],["apply",1717,1720],["constant","Nat.add_sub_add_right",[]],["apply",1722,1551],["apply",1723,323],["apply",1724,795],["apply",1721,1725],["apply",1715,1726],["apply",1712,1727],["apply",698,1553],["apply",1728,1729],["apply",1708,1730],["apply",1682,1731],["apply",1659,1732],["apply",1733,1599],["apply",1647,1734],["let","hge",1520,1525,1735,true],["lambda","hi",1513,1736,"explicit"],["apply",1512,1737],["apply",781,1738],["let","heq",507,701,1739,true],["let","this",429,469,1740,true],["let","this",349,401,1741,true],["let","h'",336,346,1742,true],["lambda","h",329,1743,"explicit"],["lambda","hge",318,1744,"explicit"],["lambda","start",1,1745,"implicit"],["lambda","ys",315,1746,"implicit"],["lambda","ih",170,1747,"explicit"],["lambda","size",1,1748,"explicit"],["apply",314,1749],["apply",1750,30],["apply",1751,11],["apply",1752,5],["apply",1753,3],["apply",1754,42],["lambda","h",33,1755,"explicit"],["lambda","hge",17,1756,"explicit"],["lambda","start",1,1757,"implicit"],["lambda","size",1,1758,"implicit"],["lambda","ys",6,1759,"implicit"],["lambda","xs",4,1760,"implicit"],["lambda","i",1,1761,"implicit"],["lambda","α",0,1762,"implicit"]],"project":false,"range":{"column":0,"endColumn":72,"endLine":2797,"line":2768},"type":107,"typeText":"∀ {α : Type u_1} {i : Nat} {xs ys : Array.{u_1} α} {size start : Nat} (hge : GE.ge.{0} i (Array.size.{u_1} ys))\n  (h : LT.lt.{0} i (Array.size.{u_1} (Array.extract.loop.{u_1} xs size start ys))),\n  Eq.{u_1 + 1} (GetElem.getElem.{u_1, 0, u_1} (Array.extract.loop.{u_1} xs size start ys) i h)\n    (GetElem.getElem.{u_1, 0, u_1} xs (HSub.hSub.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} start i) (Array.size.{u_1} ys)) ⋯)","unsafe":false,"value":1763,"source":{"code":"theorem getElem_extract_loop_ge {xs ys : Array α} {size start : Nat} (hge : i ≥ ys.size)\n    (h : i < (extract.loop xs size start ys).size) :\n    (extract.loop xs size start ys)[i] = xs[start + i - ys.size]'(getElem_extract_loop_ge_aux hge h) := by\n  induction size using Nat.recAux generalizing start ys with\n  | zero =>\n    rw [size_extract_loop, Nat.zero_min, Nat.add_zero] at h\n    omega\n  | succ size ih =>\n    have h' : start + i - ys.size < xs.size := getElem_extract_loop_ge_aux hge h\n    have : start < xs.size := by\n      apply Nat.lt_of_le_of_lt (Nat.le_add_right start (i - ys.size))\n      rwa [← Nat.add_sub_assoc hge]\n    have : i < (extract.loop xs size (start+1) (ys.push xs[start])).size := by\n      rwa [← extract_loop_succ]\n    have heq : (extract.loop xs (size+1) start ys)[i] =\n        (extract.loop xs size (start+1) (ys.push xs[start]))[i] := by\n      congr 1; rw [extract_loop_succ]\n    rw [heq]\n    if hi : ys.size = i then\n      cases hi\n      have h₁ : ys.size < (ys.push xs[start]).size := by rw [size_push]; exact Nat.lt_succ_self ..\n      have h₂ : ys.size < (extract.loop xs size (start+1) (ys.push xs[start])).size := by\n        rw [size_extract_loop]; apply Nat.lt_of_lt_of_le h₁; exact Nat.le_add_right ..\n      have h : (extract.loop xs size (start + 1) (ys.push xs[start]))[ys.size] = xs[start] := by\n        rw [getElem_extract_loop_lt h₁ h₂, getElem_push_eq]\n      rw [h]; congr; rw [Nat.add_sub_cancel]\n    else\n      have hge : ys.size + 1 ≤ i := Nat.lt_of_le_of_ne hge hi\n      rw [ih ((size_push ..).symm ▸ hge)]\n      congr 1; rw [size_push, Nat.add_right_comm, Nat.add_sub_add_right]","start":2768,"end":2797},"axioms":["Classical.choice","Quot.sound","propext"]}