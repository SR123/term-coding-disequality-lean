79._hygCtx._hyg.45",25,260,"instance"],["lambda","inst._@.Mathlib.Algebra.Ring.InjSurj.2168556279._hygCtx._hyg.27",22,261,"instance"],["lambda","inst._@.Mathlib.Algebra.Ring.InjSurj.2168556279._hygCtx._hyg.18",17,262,"instance"],["lambda","inst._@.Mathlib.Algebra.Ring.InjSurj.2168556279._hygCtx._hyg.15",14,263,"instance"],["lambda","inst._@.Mathlib.Algebra.Ring.InjSurj.2168556279._hygCtx._hyg.9",11,264,"instance"],["lambda","hf",9,265,"explicit"],["lambda","f",3,266,"explicit"],["lambda","S",1,267,"implicit"],["lambda","R",0,268,"implicit"]],"project":false,"range":{"column":0,"endColumn":82,"endLine":308,"line":299},"type":189,"typeText":"{R : Type u_1} →\n  {S : Type u_2} →\n    (f : R → S) →\n      Function.Surjective.{u_1 + 1, u_2 + 1} f →\n        [inst : Add.{u_2} S] →\n          [inst_1 : Zero.{u_2} S] →\n            [inst_2 : One.{u_2} S] →\n              [inst_3 : SMul.{0, u_2} Nat S] →\n                [inst_4 : NatCast.{u_2} S] →\n                  [inst_5 : AddMonoidWithOne.{u_1} R] →\n                    Eq.{u_2 + 1} (f 0) 0 →\n                      Eq.{u_2 + 1} (f 1) 1 →\n                        (∀ (x y : R),\n                            Eq.{u_2 + 1} (f (HAdd.hAdd.{u_1, u_1, u_1} x y)) (HAdd.hAdd.{u_2, u_2, u_2} (f x) (f y))) →\n                          (∀ (n : Nat) (x : R),\n                              Eq.{u_2 + 1} (f (HSMul.hSMul.{0, u_1, u_1} n x)) (HSMul.hSMul.{0, u_2, u_2} n (f x))) →\n                            (∀ (n : Nat), Eq.{u_2 + 1} (f ↑n) ↑n) → AddMonoidWithOne.{u_2} S","unsafe":false,"value":269,"source":{"code":"/-- A type endowed with `0`, `1` and `+` is an additive monoid with one, if it admits a surjective\nmap that preserves `0`, `1` and `*` from an additive monoid with one. See note\n[reducible non-instances]. -/\nprotected abbrev addMonoidWithOne [AddMonoidWithOne R] (zero : f 0 = 0) (one : f 1 = 1)\n    (add : ∀ x y, f (x + y) = f x + f y) (nsmul : ∀ (n : ℕ) (x), f (n • x) = n • f x)\n    (natCast : ∀ n : ℕ, f n = n) : AddMonoidWithOne S :=\n  { hf.addMonoid f zero add (swap nsmul) with\n    natCast := Nat.cast,\n    natCast_zero := by rw [← natCast, Nat.cast_zero, zero]\n    natCast_succ := fun n => by rw [← natCast, Nat.cast_succ, add, one, natCast] }","start":299,"end":308},"axioms":["propext"]}