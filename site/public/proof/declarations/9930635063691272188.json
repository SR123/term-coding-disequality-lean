{"dependencies":["PProd.rec","PProd","PProd.mk"],"doc":null,"extra":null,"kind":"definition","levels":["u_1","u","v"],"module":"Init.Prelude","name":"PProd.casesOn","nodes":[["sort",["param","u"]],["sort",["param","v"]],["constant","PProd",[["param","u"],["param","v"]]],["bound",1],["apply",2,3],["bound",0],["apply",4,5],["sort",["param","u_1"]],["forall","t",6,7,"explicit"],["bound",2],["apply",2,9],["apply",10,3],["bound",3],["constant","PProd.mk",[["param","u"],["param","v"]]],["bound",5],["apply",13,14],["bound",4],["apply",15,16],["apply",17,3],["apply",18,5],["apply",12,19],["forall","snd",12,20,"explicit"],["forall","fst",12,21,"explicit"],["apply",9,3],["forall","mk",22,23,"explicit"],["forall","t",11,24,"explicit"],["forall","motive",8,25,"implicit"],["forall","β",1,26,"implicit"],["forall","α",0,27,"implicit"],["constant","PProd.rec",[["param","u_1"],["param","u"],["param","v"]]],["apply",29,16],["apply",30,12],["apply",31,9],["apply",23,5],["lambda","snd",16,33,"explicit"],["lambda","fst",16,34,"explicit"],["apply",32,35],["apply",36,3],["lambda","mk",22,37,"explicit"],["lambda","t",11,38,"explicit"],["lambda","motive",8,39,"implicit"],["lambda","β",1,40,"implicit"],["lambda","α",0,41,"implicit"]],"project":false,"range":{"column":0,"endColumn":9,"endLine":528,"line":518},"type":28,"typeText":"{α : Sort u} →\n  {β : Sort v} →\n    {motive : PProd.{u, v} α β → Sort u_1} →\n      (t : PProd.{u, v} α β) → ((fst : α) → (snd : β) → motive ⟨fst, snd⟩) → motive t","unsafe":false,"value":42,"source":{"code":"/--\nA product type in which the types may be propositions, usually written `α ×' β`.\n\nThis type is primarily used internally and as an implementation detail of proof automation. It is\nrarely useful in hand-written code.\n-/\nstructure PProd (α : Sort u) (β : Sort v) where\n  /-- The first element of a pair. -/\n  fst : α\n  /-- The second element of a pair. -/\n  snd : β","start":518,"end":528},"axioms":[]}