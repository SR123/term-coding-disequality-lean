76._hygCtx._hyg.4",4,1309,"instance"],["lambda","β",1,1310,"implicit"],["lambda","α",0,1311,"implicit"]],"project":false,"range":{"column":0,"endColumn":33,"endLine":539,"line":531},"type":256,"typeText":"∀ {α : Type u_1} {β : Type u_2} [inst : Field.{u_1} α] [inst_1 : LinearOrder.{u_1} α]\n  [inst_2 : IsStrictOrderedRing.{u_1} α] [inst_3 : DivisionRing.{u_2} β] {abv : β → α} [IsAbsoluteValue.{u_1, u_2} abv]\n  {f : CauSeq.{u_1, u_2} β abv},\n  Not (CauSeq.LimZero.{u_1, u_2} f) →\n    ∀ (ε : α),\n      GT.gt.{u_1} ε 0 →\n        ∃ i,\n          ∀ (j : Nat),\n            GE.ge.{0} j i →\n              LT.lt.{u_1} (abv (HSub.hSub.{u_2, u_2, u_2} (Inv.inv.{u_2} (↑f j)) (Inv.inv.{u_2} (↑f i)))) ε","unsafe":false,"value":1312,"source":{"code":"theorem inv_aux {f : CauSeq β abv} (hf : ¬LimZero f) :\n    ∀ ε > 0, ∃ i, ∀ j ≥ i, abv ((f j)⁻¹ - (f i)⁻¹) < ε\n  | _, ε0 =>\n    let ⟨_, K0, HK⟩ := abv_pos_of_not_limZero hf\n    let ⟨_, δ0, Hδ⟩ := rat_inv_continuous_lemma abv ε0 K0\n    let ⟨i, H⟩ := exists_forall_ge_and HK (f.cauchy₃ δ0)\n    ⟨i, fun _ ij =>\n      let ⟨iK, H'⟩ := H _ le_rfl\n      Hδ (H _ ij).1 iK (H' _ ij)⟩","start":531,"end":539},"axioms":["Classical.choice","Quot.sound","propext"]}