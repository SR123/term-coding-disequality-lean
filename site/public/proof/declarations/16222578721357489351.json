mn":46,"endLine":300,"line":295},"type":94,"typeText":"∀ {n : Nat} {α : Sort u_1} {i : Nat} (f : Fin (HAdd.hAdd.{0, 0, 0} n 1) → α → α) (x : α)\n  (h : LE.le.{0} (HAdd.hAdd.{0, 0, 0} i 1) (HAdd.hAdd.{0, 0, 0} n 1)),\n  Eq.{u_1} (Fin.foldr.loop.{u_1} (HAdd.hAdd.{0, 0, 0} n 1) f (HAdd.hAdd.{0, 0, 0} i 1) h x)\n    (f 0 (Fin.foldr.loop.{u_1} n (fun j => f (Fin.succ j)) i ⋯ x))","unsafe":false,"value":455,"source":{"code":"private theorem foldr_loop (f : Fin (n+1) → α → α) (x) (h : i+1 ≤ n+1) :\n    foldr.loop (n+1) f (i+1) h x =\n      f 0 (foldr.loop n (fun j => f j.succ) i (Nat.le_of_succ_le_succ h) x) := by\n  induction i generalizing x with\n  | zero => simp [foldr_loop_succ, foldr_loop_zero]\n  | succ i ih => rw [foldr_loop_succ, ih]; rfl","start":295,"end":300},"axioms":["propext"]}