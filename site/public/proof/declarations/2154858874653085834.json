14",13,1265,"instance"],["lambda","inst._@.Init.Data.Range.Polymorphic.Instances.909517098._hygCtx._hyg.11",10,1266,"instance"],["lambda","inst._@.Init.Data.Range.Polymorphic.Instances.909517098._hygCtx._hyg.8",6,1267,"instance"],["lambda","inst._@.Init.Data.Range.Polymorphic.Instances.909517098._hygCtx._hyg.5",3,1268,"instance"],["lambda","α",0,1269,"implicit"]],"project":false,"range":{"column":0,"endColumn":79,"endLine":132,"line":97},"type":65,"typeText":"∀ {α : Type u_1} [inst : Std.PRange.UpwardEnumerable.{u_1} α] [inst_1 : LE.{u_1} α] [DecidableLE.{u_1} α]\n  [inst_3 : LT.{u_1} α] [DecidableLT.{u_1} α] [Std.LawfulOrderLT.{u_1} α] [Std.IsPartialOrder.{u_1} α]\n  [Std.PRange.LawfulUpwardEnumerable.{u_1} α] [Std.PRange.LawfulUpwardEnumerableLE.{u_1} α]\n  [inst_9 : Std.Rxc.HasSize.{u_1} α] [Std.Rxc.LawfulHasSize.{u_1} α], Std.Rxo.LawfulHasSize.{u_1} α","unsafe":false,"value":1270,"source":{"code":"instance LawfulHasSize.of_closed [UpwardEnumerable α] [LE α] [DecidableLE α]\n    [LT α] [DecidableLT α] [LawfulOrderLT α] [IsPartialOrder α]\n    [LawfulUpwardEnumerable α] [LawfulUpwardEnumerableLE α]\n    [Rxc.HasSize α] [Rxc.LawfulHasSize α] :\n    LawfulHasSize α where\n  size_eq_zero_of_not_le lo hi h := by\n    simp only [HasSize.size]\n    by_cases h' : lo ≤ hi\n    · match hs : succ? lo with\n      | none => rw [Rxc.LawfulHasSize.size_eq_one_of_succ?_eq_none (h := h') (h' := by omega)]\n      | some b =>\n        rw [Rxc.LawfulHasSize.size_eq_succ_of_succ?_eq_some (h := h') (h' := hs)]\n        have : ¬ b ≤ hi := by\n          intro hb\n          have : lo < b := by\n            rw [UpwardEnumerable.lt_iff]\n            exact ⟨0, by simpa [succMany?_one] using hs⟩\n          exact h (lt_of_lt_of_le this hb)\n        rw [Rxc.LawfulHasSize.size_eq_zero_of_not_le (h := this)]\n    · suffices Rxc.HasSize.size lo hi = 0 by omega\n      exact Rxc.LawfulHasSize.size_eq_zero_of_not_le _ _ h'\n  size_eq_one_of_succ?_eq_none bound a h h' := by\n    exfalso\n    simp only [UpwardEnumerable.lt_iff] at h\n    obtain ⟨n, hn⟩ := h\n    simp [succMany?_add_one_eq_succ?_bind_succMany?, h'] at hn\n  size_eq_succ_of_succ?_eq_some bound a a' h h' := by\n    simp only [HasSize.size, Nat.pred_eq_succ_iff]\n    rw [Rxc.LawfulHasSize.size_eq_succ_of_succ?_eq_some (h := le_of_lt h) (h' := h')]\n    rw [← Nat.sub_add_comm]\n    · omega\n    · simp only [Nat.succ_le_iff, Rxc.size_pos_iff_le]\n      rw [UpwardEnumerable.le_iff]\n      rw [UpwardEnumerable.lt_iff] at h\n      refine ⟨h.choose, ?_⟩\n      simpa [succMany?_add_one_eq_succ?_bind_succMany?, h'] using h.choose_spec","start":97,"end":132},"axioms":["Classical.choice","Quot.sound","propext"]}