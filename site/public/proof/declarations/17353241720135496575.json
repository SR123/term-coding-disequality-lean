098,6],["apply",1099,6],["apply",1096,1100],["apply",1101,41],["apply",1082,1102],["lambda","h",1059,1103,"explicit"],["lambda","hi",1021,1104,"explicit"],["apply",1053,1105],["lambda","h._@.Mathlib.Order.Filter.Bases.Basic.3418263732._hygCtx._hyg.160",270,1106,"explicit"],["lambda","i",51,1107,"explicit"],["apply",1020,1108],["lambda","a._@._internal.0.Mathlib.Order.Filter.Bases.Basic.3418263732._hygCtx._hyg.159",189,1109,"explicit"],["apply",1008,1110],["lambda","t",131,1111,"explicit"],["apply",389,1112],["lambda","h_dir",75,1113,"explicit"],["lambda","hlb",33,1114,"explicit"],["lambda","hla",27,1115,"explicit"],["lambda","sb",19,1116,"implicit"],["lambda","p",15,1117,"implicit"],["lambda","lb",13,1118,"implicit"],["lambda","sa",10,1119,"implicit"],["lambda","la",5,1120,"implicit"],["lambda","ι",2,1121,"implicit"],["lambda","β",1,1122,"implicit"],["lambda","α",0,1123,"implicit"]],"project":false,"range":{"column":0,"endColumn":31,"endLine":730,"line":721},"type":127,"typeText":"∀ {α : Type u_1} {β : Type u_2} {ι : Sort u_4} {la : Filter.{u_1} α} {sa : ι → Set.{u_1} α} {lb : Filter.{u_2} β}\n  {p : ι → Prop} {sb : ι → Set.{u_2} β},\n  Filter.HasBasis.{u_1, u_4} la p sa →\n    Filter.HasBasis.{u_2, u_4} lb p sb →\n      (∀ {i j : ι},\n          p i →\n            p j → ∃ k, And (p k) (And (HasSubset.Subset.{u_1} (sa k) (sa i)) (HasSubset.Subset.{u_2} (sb k) (sb j)))) →\n        Filter.HasBasis.{max u_1 u_2, u_4} (SProd.sprod.{u_1, u_2, max u_1 u_2} la lb) p fun i =>\n          SProd.sprod.{u_1, u_2, max u_1 u_2} (sa i) (sb i)","unsafe":false,"value":1124,"source":{"code":"theorem HasBasis.prod_same_index {p : ι → Prop} {sb : ι → Set β} (hla : la.HasBasis p sa)\n    (hlb : lb.HasBasis p sb) (h_dir : ∀ {i j}, p i → p j → ∃ k, p k ∧ sa k ⊆ sa i ∧ sb k ⊆ sb j) :\n    (la ×ˢ lb).HasBasis p fun i => sa i ×ˢ sb i := by\n  simp only [hasBasis_iff, (hla.prod_pprod hlb).mem_iff]\n  refine fun t => ⟨?_, ?_⟩\n  · rintro ⟨⟨i, j⟩, ⟨hi, hj⟩, hsub : sa i ×ˢ sb j ⊆ t⟩\n    rcases h_dir hi hj with ⟨k, hk, ki, kj⟩\n    exact ⟨k, hk, (Set.prod_mono ki kj).trans hsub⟩\n  · rintro ⟨i, hi, h⟩\n    exact ⟨⟨i, i⟩, ⟨hi, hi⟩, h⟩","start":721,"end":730},"axioms":["Quot.sound","propext"]}