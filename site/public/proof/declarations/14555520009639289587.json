["apply",372,282],["apply",743,1],["apply",744,20],["apply",745,15],["apply",676,746],["constant","Std.DTreeMap.Internal.Impl.alter._proof_30",[["param","u"],["param","v"]]],["apply",748,365],["apply",749,302],["apply",750,282],["apply",751,81],["apply",752,29],["apply",753,24],["apply",754,20],["apply",755,15],["apply",756,11],["apply",757,1],["apply",747,758],["constant","Std.DTreeMap.Internal.Impl.alter._proof_33",[["param","u"],["param","v"]]],["apply",760,365],["apply",761,302],["apply",762,282],["apply",763,81],["apply",764,29],["apply",765,24],["apply",766,20],["apply",767,15],["apply",768,11],["apply",769,1],["apply",759,770],["constant","Std.DTreeMap.Internal.Impl.alter._proof_35",[["param","u"],["param","v"]]],["apply",772,365],["apply",773,302],["apply",774,282],["apply",775,81],["apply",776,29],["apply",777,24],["apply",778,20],["apply",779,15],["apply",780,11],["apply",781,1],["apply",771,782],["lambda","v",650,783,"explicit"],["apply",742,784],["lambda","h",646,785,"explicit"],["apply",644,786],["lambda","x._@.Std.Data.DTreeMap.Internal.Operations.3553935046._hygCtx._hyg.4156",324,787,"explicit"],["lambda","hl",292,788,"explicit"],["lambda","r'",281,789,"explicit"],["lambda","l'",279,790,"explicit"],["lambda","v'",277,791,"explicit"],["lambda","k'",131,792,"explicit"],["lambda","sz",33,793,"explicit"],["apply",276,794],["apply",795,5],["lambda","hl",125,796,"explicit"],["lambda","f",124,797,"explicit"],["lambda","t",80,798,"explicit"],["apply",100,799],["apply",800,1],["lambda","hl",27,801,"explicit"],["lambda","t",22,802,"explicit"],["lambda","f",18,803,"explicit"],["lambda","k",11,804,"explicit"],["lambda","inst._@.Std.Data.DTreeMap.Internal.Operations.3553935046._hygCtx._hyg.13",10,805,"instance"],["lambda","inst._@.Std.Data.DTreeMap.Internal.Operations.3553935046._hygCtx._hyg.10",6,806,"instance"],["lambda","β",3,807,"implicit"],["lambda","α",0,808,"implicit"]],"project":false,"range":{"column":0,"endColumn":48,"endLine":800,"line":775},"type":75,"typeText":"{α : Type u} →\n  {β : α → Type v} →\n    [inst : Ord.{u} α] →\n      [Std.LawfulEqOrd.{u} α] →\n        (k : α) →\n          (Option.{v} (β k) → Option.{v} (β k)) →\n            (t : Std.DTreeMap.Internal.Impl.{u, v} α β) →\n              Std.DTreeMap.Internal.Impl.Balanced.{u, v} t →\n                Std.DTreeMap.Internal.Impl.SizedBalancedTree.{u, v} α β\n                  (HSub.hSub.{0, 0, 0} (Std.DTreeMap.Internal.Impl.size.{u, v} t) 1)\n                  (HAdd.hAdd.{0, 0, 0} (Std.DTreeMap.Internal.Impl.size.{u, v} t) 1)","unsafe":false,"value":809,"source":{"code":"/--\nChanges the mapping of the key `k` by applying the function `f` to the current mapped value\n(if any). This function can be used to insert a new mapping, modify an existing one or delete it.\nThis version of the function requires `LawfulEqOrd α`. There is an alternative non-dependent version\ncalled `Const.alter`.\n-/\n@[specialize]\ndef alter [Ord α] [LawfulEqOrd α] (k : α) (f : Option (β k) → Option (β k)) (t : Impl α β)\n    (hl : t.Balanced) : SizedBalancedTree α β (t.size - 1) (t.size + 1) :=\n  match t with\n  | .leaf =>\n    match f none with\n    | none => ⟨.leaf, ✓, ✓, ✓⟩\n    | some v => ⟨.inner 1 k v .leaf .leaf, ✓, ✓, ✓⟩\n  | .inner sz k' v' l' r' =>\n    match h : compare k k' with\n    | .lt =>\n      let ⟨d, hd, hd'₁, hd'₂⟩ := alter k f l' ✓\n      ⟨balance k' v' d r' ✓ ✓ (hl.at_root.adjust_left hd'₁ hd'₂), ✓, ✓, ✓⟩\n    | .gt =>\n      let ⟨d, hd, hd'₁, hd'₂⟩ := alter k f r' ✓\n      ⟨balance k' v' l' d ✓ ✓ (hl.at_root.adjust_right hd'₁ hd'₂), ✓, ✓, ✓⟩\n    | .eq =>\n      match f (some (cast (congrArg β <| compare_eq_iff_eq.mp h).symm v')) with\n      | none => ⟨glue l' r' ✓ ✓ ✓, ✓, ✓, ✓⟩\n      | some v => ⟨.inner sz k v l' r', ✓, ✓, ✓⟩","start":775,"end":800},"axioms":["Classical.choice","Quot.sound","propext"]}