ternal.AssocList.{v, u} α fun x => β) →\n          Eq.{1} (Std.DHashMap.Internal.AssocList.contains.{v, u} a l) Bool.true → β","unsafe":false,"value":199,"source":{"code":"/-- Internal implementation detail of the hash map -/\ndef get {β : Type v} [BEq α] (a : α) : (l : AssocList α (fun _ => β)) → l.contains a → β\n  | cons k v es, h => if hka : k == a then v else get a es\n      (by rw [← h, contains, Bool.of_not_eq_true hka, Bool.false_or])","start":121,"end":124},"axioms":[]}