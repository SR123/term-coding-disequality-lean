 (p ·)) = filter p := by\n  funext l\n  induction l with\n  | nil => rfl\n  | cons a l IH => by_cases pa : p a <;> simp [Option.guard, pa, ← IH]","start":1427,"end":1433},"axioms":["Quot.sound","propext"]}