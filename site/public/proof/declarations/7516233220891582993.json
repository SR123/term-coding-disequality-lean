apply",513,8],["apply",514,3],["apply",512,515],["apply",118,20],["apply",189,517],["apply",518,8],["lambda","x._@.Mathlib.Topology.Order.3530168379._hygCtx.226.Mathlib.Topology.Order.3530168379._hygCtx._hyg.235",516,519,"explicit"],["apply",505,520],["apply",521,1],["apply",258,13],["apply",523,8],["apply",1,16],["apply",525,3],["lambda","hUo",524,526,"explicit"],["lambda","haU",511,527,"explicit"],["apply",522,528],["lambda","x._@.Mathlib.Topology.Order.3530168379._hygCtx._hyg.226",473,529,"explicit"],["lambda","U",113,530,"explicit"],["apply",500,531],["apply",451,532],["let","t",98,82,533,false],["lambda","a",74,534,"explicit"],["lambda","hopen",73,535,"explicit"],["lambda","hpure",46,536,"explicit"],["lambda","hb",29,537,"explicit"],["lambda","s",19,538,"implicit"],["lambda","p",12,539,"implicit"],["lambda","ι",7,540,"implicit"],["lambda","n",5,541,"implicit"],["lambda","α",0,542,"implicit"]],"project":false,"range":{"column":0,"endColumn":68,"endLine":115,"line":104},"type":96,"typeText":"∀ {α : Type u} {n : α → Filter.{u} α} {ι : α → Sort u_1} {p : (a : α) → ι a → Prop} {s : (a : α) → ι a → Set.{u} α},\n  (∀ (a : α), Filter.HasBasis.{u, u_1} (n a) (p a) (s a)) →\n    (∀ (a : α) (i : ι a), p a i → Membership.mem.{u, u} (s a i) a) →\n      (∀ (a : α) (i : ι a), p a i → ∀ᶠ (x : α) in n a, Membership.mem.{u, u} (n x) (s a i)) →\n        ∀ (a : α), Eq.{u + 1} (nhds.{u} a) (n a)","unsafe":false,"value":543,"source":{"code":"theorem nhds_mkOfNhds_of_hasBasis {n : α → Filter α} {ι : α → Sort*} {p : ∀ a, ι a → Prop}\n    {s : ∀ a, ι a → Set α} (hb : ∀ a, (n a).HasBasis (p a) (s a))\n    (hpure : ∀ a i, p a i → a ∈ s a i) (hopen : ∀ a i, p a i → ∀ᶠ x in n a, s a i ∈ n x) (a : α) :\n    @nhds α (.mkOfNhds n) a = n a := by\n  let t : TopologicalSpace α := .mkOfNhds n\n  apply le_antisymm\n  · intro U hU\n    replace hpure : pure ≤ n := fun x ↦ (hb x).ge_iff.2 (hpure x)\n    refine mem_nhds_iff.2 ⟨{x | U ∈ n x}, fun x hx ↦ hpure x hx, fun x hx ↦ ?_, hU⟩\n    rcases (hb x).mem_iff.1 hx with ⟨i, hpi, hi⟩\n    exact (hopen x i hpi).mono fun y hy ↦ mem_of_superset hy hi\n  · exact (nhds_basis_opens a).ge_iff.2 fun U ⟨haU, hUo⟩ ↦ hUo a haU","start":104,"end":115},"axioms":["Classical.choice","Quot.sound","propext"]}