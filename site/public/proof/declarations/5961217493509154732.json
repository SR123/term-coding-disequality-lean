"explicit"],["lambda","t",0,376,"explicit"],["lambda","motive",2,377,"implicit"]],"project":true,"range":{"column":0,"endColumn":51,"endLine":362,"line":312},"type":32,"typeText":"{motive : Lean.Expr → Sort u} →\n  (t : Lean.Expr) →\n    ((fn arg : Lean.Expr) → motive (Lean.Expr.app fn arg)) → (Ne.{1} (Lean.Expr.ctorIdx t) 5 → motive t) → motive t","unsafe":false,"value":378,"source":{"code":"/-- Close a goal `PolyB (fun n => e)` by the closure lemmas, following the syntax of `e`;\napplications `g n` of named bound functions are closed by hypotheses `PolyB g`. -/\npartial def polybCore (goal : MVarId) : TacticM Unit := goal.withContext do\n  let t := (← instantiateMVars (← goal.getType)).consumeMData\n  let some f := t.app1? ``PolyB | throwError \"polyb: goal is not `PolyB _`: {t}\"\n  let f := (← instantiateMVars f).consumeMData\n  let .lam nm dom body bi := f | throwError \"polyb: not a lambda: {f}\"\n  let mkFun (e : Expr) : Expr := .lam nm dom e bi\n  if !body.hasLooseBVars then\n    let gs ← goal.apply (mkApp (mkConst ``PolyB.const) body)\n    unless gs.isEmpty do throwError \"polyb: const left goals\"\n    return\n  if body == .bvar 0 then\n    let gs ← goal.apply (mkConst ``PolyB.id)\n    unless gs.isEmpty do throwError \"polyb: id left goals\"\n    return\n  -- a hypothesis with syntactically the same body\n  for h in ← getLCtx do\n    if h.isImplementationDetail then continue\n    let ht := (← instantiateMVars h.type).consumeMData\n    if let some f' := ht.app1? ``PolyB then\n      if let .lam _ _ body' _ := f'.consumeMData then\n        if body' == body then\n          let gs ← goal.apply h.toExpr\n          unless gs.isEmpty do throwError \"polyb: hypothesis left goals\"\n          return\n  match body.getAppFnArgs with\n  | (``HAdd.hAdd, #[_, _, _, _, a, b]) =>\n      let gs ← goal.apply (mkAppN (mkConst ``PolyB.add) #[mkFun a, mkFun b])\n      for g in gs do polybCore g\n  | (``HMul.hMul, #[_, _, _, _, a, b]) =>\n      let gs ← goal.apply (mkAppN (mkConst ``PolyB.mul) #[mkFun a, mkFun b])\n      for g in gs do polybCore g\n  | (``HSub.hSub, #[_, _, _, _, a, b]) =>\n      let gs ← goal.apply (mkAppN (mkConst ``PolyB.sub_left) #[mkFun a, mkFun b])\n      for g in gs do polybCore g\n  | (``HPow.hPow, #[_, _, _, _, _, e]) =>\n      if e.hasLooseBVars then throwError \"polyb: exponent depends on n\"\n      let gs ← goal.apply (mkApp (mkConst ``PolyB.pow_succ) e)\n      unless gs.isEmpty do throwError \"polyb: pow left goals\"\n  | (_, _) =>\n      let .app g (.bvar 0) := body | throwError \"polyb: unsupported body {body}\"\n      if g.hasLooseBVars then throwError \"polyb: unsupported body {body}\"\n      let target := mkApp (mkConst ``PolyB) g\n      for h in ← getLCtx do\n        if h.isImplementationDetail then continue\n        if ← isDefEq (← instantiateMVars h.type).consumeMData target then\n          let gs ← goal.apply (mkAppN (mkConst ``PolyB.eta) #[g, h.toExpr])\n          unless gs.isEmpty do throwError \"polyb: eta left goals\"\n          return\n      throwError \"polyb: no hypothesis `PolyB {g}`\"","start":312,"end":362,"lines":[[{"text":"/-- Close a goal `PolyB (fun n => e)` by the closure lemmas, following the syntax of `e`;"}],[{"text":"applications `g n` of named bound functions are closed by hypotheses `PolyB g`. -/"}],[{"text":"partial def polybCore (goal : MVarId) : TacticM Unit := goal.withContext do"}],[{"text":"  let t := (← instantiateMVars (← goal.getType)).consumeMData"}],[{"text":"  let some f := t.app1? ``PolyB | throwError \"polyb: goal is not `PolyB _`: {t}\""}],[{"text":"  let f := (← instantiateMVars f).consumeMData"}],[{"text":"  let .lam nm dom body bi := f | throwError \"polyb: not a lambda: {f}\""}],[{"text":"  let mkFun (e : Expr) : Expr := .lam nm dom e bi"}],[{"text":"  if !body.hasLooseBVars then"}],[{"text":"    let gs ← goal.apply (mkApp (mkConst ``PolyB.const) body)"}],[{"text":"    unless gs.isEmpty do throwError \"polyb: const left goals\""}],[{"text":"    return"}],[{"text":"  if body == .bvar 0 then"}],[{"text":"    let gs ← goal.apply (mkConst ``PolyB.id)"}],[{"text":"    unless gs.isEmpty do throwError \"polyb: id left goals\""}],[{"text":"    return"}],[{"text":"  -- a hypothesis with syntactically the same body"}],[{"text":"  for h in ← getLCtx do"}],[{"text":"    if h.isImplementationDetail then continue"}],[{"text":"    let ht := (← instantiateMVars h.type).consumeMData"}],[{"text":"    if let some f' := ht.app1? ``PolyB then"}],[{"text":"      if let .lam _ _ body' _ := f'.consumeMData then"}],[{"text":"        if body' == body then"}],[{"text":"          let gs ← goal.apply h.toExpr"}],[{"text":"          unless gs.isEmpty do throwError \"polyb: hypothesis left goals\""}],[{"text":"          return"}],[{"text":"  match body.getAppFnArgs with"}],[{"text":"  | (``HAdd.hAdd, #[_, _, _, _, a, b]) =>"}],[{"text":"      let gs ← goal.apply (mkAppN (mkConst ``PolyB.add) #[mkFun a, mkFun b])"}],[{"text":"      for g in gs do polybCore g"}],[{"text":"  | (``HMul.hMul, #[_, _, _, _, a, b]) =>"}],[{"text":"      let gs ← goal.apply (mkAppN (mkConst ``PolyB.mul) #[mkFun a, mkFun b])"}],[{"text":"      for g in gs do polybCore g"}],[{"text":"  | (``HSub.hSub, #[_, _, _, _, a, b]) =>"}],[{"text":"      let gs ← goal.apply (mkAppN (mkConst ``PolyB.sub_left) #[mkFun a, mkFun b])"}],[{"text":"      for g in gs do polybCore g"}],[{"text":"  | (``HPow.hPow, #[_, _, _, _, _, e]) =>"}],[{"text":"      if e.hasLooseBVars then throwError \"polyb: exponent depends on n\""}],[{"text":"      let gs ← goal.apply (mkApp (mkConst ``PolyB.pow_succ) e)"}],[{"text":"      unless gs.isEmpty do throwError \"polyb: pow left goals\""}],[{"text":"  | (_, _) =>"}],[{"text":"      let .app g (.bvar 0) := body | throwError \"polyb: unsupported body {body}\""}],[{"text":"      if g.hasLooseBVars then throwError \"polyb: unsupported body {body}\""}],[{"text":"      let target := mkApp (mkConst ``PolyB) g"}],[{"text":"      for h in ← getLCtx do"}],[{"text":"        if h.isImplementationDetail then continue"}],[{"text":"        if ← isDefEq (← instantiateMVars h.type).consumeMData target then"}],[{"text":"          let gs ← goal.apply (mkAppN (mkConst ``PolyB.eta) #[g, h.toExpr])"}],[{"text":"          unless gs.isEmpty do throwError \"polyb: eta left goals\""}],[{"text":"          return"}],[{"text":"      throwError \"polyb: no hypothesis `PolyB {g}`\""}]]},"steps":[],"stepGoalPool":[],"references":[],"axioms":[]}