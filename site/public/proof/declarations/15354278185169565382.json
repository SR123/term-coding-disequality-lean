persion.Flow.Network.nodes N)\n                    (DisequalityDispersion.Flow.Network.s N)) →\n                (t_mem :\n                    Membership.mem.{0, 0} (DisequalityDispersion.Flow.Network.nodes N)\n                      (DisequalityDispersion.Flow.Network.t N)) →\n                  (arcs_mem :\n                      ∀ (a : Prod.{0, 0} ν ν),\n                        Membership.mem.{0, 0} (DisequalityDispersion.Flow.Network.arcs N) a →\n                          And (Membership.mem.{0, 0} (DisequalityDispersion.Flow.Network.nodes N) a.1)\n                            (Membership.mem.{0, 0} (DisequalityDispersion.Flow.Network.nodes N) a.2)) →\n                    (no_anti :\n                        ∀ (a : Prod.{0, 0} ν ν),\n                          Membership.mem.{0, 0} (DisequalityDispersion.Flow.Network.arcs N) a →\n                            Prod.mk.{0, 0} a.2 a.1 ∉ DisequalityDispersion.Flow.Network.arcs N) →\n                      (no_into_s :\n                          ∀ (a : Prod.{0, 0} ν ν),\n                            Membership.mem.{0, 0} (DisequalityDispersion.Flow.Network.arcs N) a →\n                              Ne.{1} a.2 (DisequalityDispersion.Flow.Network.s N)) →\n                        (no_out_t :\n                            ∀ (a : Prod.{0, 0} ν ν),\n                              Membership.mem.{0, 0} (DisequalityDispersion.Flow.Network.arcs N) a →\n                                Ne.{1} a.1 (DisequalityDispersion.Flow.Network.t N)) →\n                          motive ⋯) →\n        (t : DisequalityDispersion.Flow.Network.Ok N) → motive t","unsafe":false,"value":null,"source":{"code":"/-- Well-formedness: no antiparallel arcs, nothing enters `s`, nothing leaves `t`. -/\nstructure Ok : Prop where\n  nodes_nodup : N.nodes.Nodup\n  arcs_nodup : N.arcs.Nodup\n  st : N.s ≠ N.t\n  s_mem : N.s ∈ N.nodes\n  t_mem : N.t ∈ N.nodes\n  arcs_mem : ∀ a ∈ N.arcs, a.1 ∈ N.nodes ∧ a.2 ∈ N.nodes\n  no_anti : ∀ a ∈ N.arcs, (a.2, a.1) ∉ N.arcs\n  no_into_s : ∀ a ∈ N.arcs, a.2 ≠ N.s\n  no_out_t : ∀ a ∈ N.arcs, a.1 ≠ N.t","start":30,"end":40,"lines":[[{"text":"/-- Well-formedness: no antiparallel arcs, nothing enters `s`, nothing leaves `t`. -/"}],[{"text":"structure Ok : Prop where"}],[{"text":"  nodes_nodup : N.nodes.Nodup"}],[{"text":"  arcs_nodup : N.arcs.Nodup"}],[{"text":"  st : N.s ≠ N.t"}],[{"text":"  s_mem : N.s ∈ N.nodes"}],[{"text":"  t_mem : N.t ∈ N.nodes"}],[{"text":"  arcs_mem : ∀ a ∈ N.arcs, a.1 ∈ N.nodes ∧ a.2 ∈ N.nodes"}],[{"text":"  no_anti : ∀ a ∈ N.arcs, (a.2, a.1) ∉ N.arcs"}],[{"text":"  no_into_s : ∀ a ∈ N.arcs, a.2 ≠ N.s"}],[{"text":"  no_out_t : ∀ a ∈ N.arcs, a.1 ≠ N.t"}]]},"steps":[],"stepGoalPool":[],"references":[],"axioms":[]}