2,1030],["apply",966,1031],["apply",960,1032],["apply",948,1033],["apply",401,999],["apply",1035,1014],["apply",1036,5],["apply",1037,2],["apply",4,1038],["lambda","h._@.Mathlib.Topology.Inseparable.1284107925._hygCtx._hyg.415",941,1039,"explicit"],["apply",1034,1040],["let","tfae_5_to_1",400,888,1041,true],["let","tfae_5_iff_7",315,385,1042,true],["let","tfae_6_iff_5",279,297,1043,true],["let","tfae_4_to_5",252,269,1044,true],["let","tfae_3_to_4",214,241,1045,true],["let","tfae_2_to_3",184,197,1046,true],["let","tfae_1_to_2",145,161,1047,true],["lambda","y",5,1048,"explicit"],["lambda","x",4,1049,"explicit"],["lambda","inst._@.Mathlib.Topology.Inseparable.1284107925._hygCtx._hyg.10",3,1050,"instance"],["lambda","X",0,1051,"implicit"]],"project":false,"range":{"column":0,"endColumn":13,"endLine":75,"line":53},"type":129,"typeText":"∀ {X : Type u_1} [inst : TopologicalSpace.{u_1} X] (x y : X),\n  List.TFAE\n    (List.cons.{0} (Specializes.{u_1} x y)\n      (List.cons.{0} (LE.le.{u_1} (Pure.pure.{u_1, u_1} x) (nhds.{u_1} y))\n        (List.cons.{0}\n          (∀ (s : Set.{u_1} X), IsOpen.{u_1} s → Membership.mem.{u_1, u_1} s y → Membership.mem.{u_1, u_1} s x)\n          (List.cons.{0}\n            (∀ (s : Set.{u_1} X), IsClosed.{u_1} s → Membership.mem.{u_1, u_1} s x → Membership.mem.{u_1, u_1} s y)\n            (List.cons.{0} (Membership.mem.{u_1, u_1} (closure.{u_1} (Singleton.singleton.{u_1, u_1} x)) y)\n              (List.cons.{0}\n                (HasSubset.Subset.{u_1} (closure.{u_1} (Singleton.singleton.{u_1, u_1} y))\n                  (closure.{u_1} (Singleton.singleton.{u_1, u_1} x)))\n                (List.cons.{0} (ClusterPt.{u_1} y (Pure.pure.{u_1, u_1} x)) List.nil.{0})))))))","unsafe":false,"value":1052,"source":{"code":"/-- A collection of equivalent definitions of `x ⤳ y`. The public API is given by `iff` lemmas\nbelow. -/\ntheorem specializes_TFAE (x y : X) :\n    List.TFAE [x ⤳ y,\n      pure x ≤ 𝓝 y,\n      ∀ s : Set X, IsOpen s → y ∈ s → x ∈ s,\n      ∀ s : Set X, IsClosed s → x ∈ s → y ∈ s,\n      y ∈ closure ({ x } : Set X),\n      closure ({ y } : Set X) ⊆ closure { x },\n      ClusterPt y (pure x)] := by\n  tfae_have 1 → 2 := (pure_le_nhds _).trans\n  tfae_have 2 → 3 := fun h s hso hy => h (hso.mem_nhds hy)\n  tfae_have 3 → 4 := fun h s hsc hx => of_not_not fun hy => h sᶜ hsc.isOpen_compl hy hx\n  tfae_have 4 → 5 := fun h => h _ isClosed_closure (subset_closure <| mem_singleton _)\n  tfae_have 6 ↔ 5 := isClosed_closure.closure_subset_iff.trans singleton_subset_iff\n  tfae_have 5 ↔ 7 := by\n    rw [mem_closure_iff_clusterPt, principal_singleton]\n  tfae_have 5 → 1 := by\n    refine fun h => (nhds_basis_opens _).ge_iff.2 ?_\n    rintro s ⟨hy, ho⟩\n    rcases mem_closure_iff.1 h s ho hy with ⟨z, hxs, rfl : z = x⟩\n    exact ho.mem_nhds hxs\n  tfae_finish","start":53,"end":75},"axioms":["Classical.choice","Quot.sound","propext"]}