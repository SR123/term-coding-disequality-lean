["apply",42,50],["apply",70,13],["apply",69,71],["apply",68,72],["apply",67,73],["apply",66,74],["apply",64,75],["constant","AddUnits.mk",[["param","u"]]],["bound",6],["apply",77,78],["apply",79,50],["apply",80,11],["apply",81,10],["apply",82,5],["apply",83,2],["apply",13,84],["forall","neg_val",76,85,"explicit"],["forall","val_neg",49,86,"explicit"],["forall","neg",11,87,"explicit"],["forall","val",10,88,"explicit"],["apply",4,11],["apply",90,10],["apply",10,2],["forall","t",91,92,"explicit"],["forall","mk",89,93,"explicit"],["forall","motive",9,94,"implicit"],["forall","inst._@.Mathlib.Algebra.Group.Units.Defs.784886155._hygCtx._hyg.5",3,95,"instance"],["forall","α",0,96,"implicit"],["apply",62,2],["apply",51,98],["apply",99,75],["apply",12,78],["apply",15,78],["apply",102,78],["apply",103,78],["apply",19,78],["apply",21,78],["apply",23,78],["apply",107,50],["apply",106,108],["apply",105,109],["apply",104,110],["apply",111,5],["apply",112,10],["apply",101,113],["apply",32,78],["apply",115,34],["apply",36,78],["apply",38,78],["apply",40,78],["apply",42,78],["apply",120,50],["apply",119,121],["apply",118,122],["apply",117,123],["apply",116,124],["apply",114,125],["apply",13,11],["apply",127,10],["apply",128,5],["apply",129,2],["lambda","neg_val",126,130,"explicit"],["lambda","val_neg",100,131,"explicit"],["lambda","neg",13,132,"explicit"],["lambda","val",11,133,"explicit"],["lambda","mk",89,134,"explicit"],["lambda","motive",9,135,"explicit"],["lambda","inst._@.Mathlib.Algebra.Group.Units.Defs.784886155._hygCtx._hyg.5",3,136,"instance"],["lambda","α",0,137,"explicit"]],"project":false,"range":{"column":0,"endColumn":25,"endLine":77,"line":64},"type":97,"typeText":"{α : Type u} →\n  [inst : AddMonoid.{u} α] →\n    {motive : AddUnits.{u} α → Sort u_1} →\n      ((val neg : α) →\n          (val_neg : Eq.{u + 1} (HAdd.hAdd.{u, u, u} val neg) 0) →\n            (neg_val : Eq.{u + 1} (HAdd.hAdd.{u, u, u} neg val) 0) → motive (AddUnits.mk.{u} val neg val_neg neg_val)) →\n        (t : AddUnits.{u} α) → motive t","unsafe":false,"value":null,"source":{"code":"/-- Units of an `AddMonoid`, bundled version.\n\nAn element of an `AddMonoid` is a unit if it has a two-sided additive inverse.\nThis version bundles the inverse element so that it can be computed.\nFor a predicate see `isAddUnit`. -/\nstructure AddUnits (α : Type u) [AddMonoid α] where\n  /-- The underlying value in the base `AddMonoid`. -/\n  val : α\n  /-- The additive inverse value of `val` in the base `AddMonoid`. -/\n  neg : α\n  /-- `neg` is the right additive inverse of `val` in the base `AddMonoid`. -/\n  val_neg : val + neg = 0\n  /-- `neg` is the left additive inverse of `val` in the base `AddMonoid`. -/\n  neg_val : neg + val = 0","start":64,"end":77},"axioms":[]}