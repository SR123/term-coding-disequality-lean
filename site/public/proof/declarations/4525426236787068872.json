xplicit"],["lambda","hl",145,341,"explicit"],["lambda","r",133,342,"explicit"],["lambda","l",131,343,"explicit"],["lambda","v",129,344,"explicit"],["lambda","k",68,345,"explicit"],["lambda","sz",128,346,"explicit"],["apply",127,347],["apply",348,5],["lambda","hl",62,349,"explicit"],["lambda","f",61,350,"explicit"],["lambda","t",35,351,"explicit"],["apply",46,352],["apply",353,1],["lambda","hl",20,354,"explicit"],["lambda","t",15,355,"explicit"],["lambda","f",11,356,"explicit"],["lambda","inst._@.Std.Data.DTreeMap.Internal.Operations.2342288710._hygCtx._hyg.10",6,357,"instance"],["lambda","β",3,358,"implicit"],["lambda","α",0,359,"implicit"]],"project":false,"range":{"column":0,"endColumn":36,"endLine":760,"line":743},"type":30,"typeText":"{α : Type u} →\n  {β : α → Type v} →\n    [Ord.{u} α] →\n      ((a : α) → β a → Bool) →\n        (t : Std.DTreeMap.Internal.Impl.{u, v} α β) →\n          Std.DTreeMap.Internal.Impl.Balanced.{u, v} t → Std.DTreeMap.Internal.Impl.BalancedTree.{u, v} α β","unsafe":false,"value":360,"source":{"code":"/--\nReturns the tree consisting of the mapping `(k, v)` where `(k, v)` was a mapping in the\noriginal tree and `f k v = true`.\n-/\n@[specialize]\ndef filter [Ord α] (f : (a : α) → β a → Bool) (t : Impl α β) (hl : Balanced t) : BalancedTree α β :=\n  match t with\n  | .leaf => ⟨.leaf, ✓⟩\n  | .inner sz k v l r =>\n    match f k v with\n    | false =>\n      let ⟨l', hl'⟩ := filter f l ✓\n      let ⟨r', hr'⟩ := filter f r ✓\n      ⟨(link2 l' r'  ✓ ✓).impl, ✓⟩\n    | true =>\n      let ⟨l', hl'⟩ := filter f l ✓\n      let ⟨r', hr'⟩ := filter f r ✓\n      ⟨(link k v l' r' ✓ ✓).impl, ✓⟩","start":743,"end":760},"axioms":["Classical.choice","Quot.sound","propext"]}