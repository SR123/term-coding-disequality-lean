da","i",41,888,"explicit"],["lambda","h",96,889,"explicit"],["apply",263,890],["apply",165,891],["lambda","H",35,892,"explicit"],["lambda","s",21,893,"implicit"],["lambda","p",16,894,"implicit"],["lambda","u",14,895,"implicit"],["lambda","inst._@.Mathlib.Topology.UniformSpace.Cauchy.1943082235._hygCtx._hyg.10",11,896,"instance"],["lambda","inst._@.Mathlib.Topology.UniformSpace.Cauchy.1943082235._hygCtx._hyg.7",8,897,"instance"],["lambda","γ",5,898,"implicit"],["lambda","uniformSpace",4,899,"instance"],["lambda","β",1,900,"implicit"],["lambda","α",0,901,"implicit"]],"project":false,"range":{"column":0,"endColumn":29,"endLine":301,"line":293},"type":107,"typeText":"∀ {α : Type u} {β : Type v} [uniformSpace : UniformSpace.{u} α] {γ : Sort u_1} [Nonempty.{v + 1} β]\n  [inst : SemilatticeSup.{v} β] {u : β → α} {p : γ → Prop} {s : γ → SetRel.{u, u} α α},\n  Filter.HasBasis.{u, u_1} (uniformity.{u} α) p s →\n    Iff (CauchySeq.{u, v} u)\n      (∀ (i : γ), p i → ∃ N, ∀ (n : β), GE.ge.{v} n N → Membership.mem.{u, u} (s i) (Prod.mk.{u, u} (u n) (u N)))","unsafe":false,"value":902,"source":{"code":"theorem Filter.HasBasis.cauchySeq_iff' {γ} [Nonempty β] [SemilatticeSup β] {u : β → α}\n    {p : γ → Prop} {s : γ → SetRel α α} (H : (𝓤 α).HasBasis p s) :\n    CauchySeq u ↔ ∀ i, p i → ∃ N, ∀ n ≥ N, (u n, u N) ∈ s i := by\n  refine H.cauchySeq_iff.trans ⟨fun h i hi => ?_, fun h i hi => ?_⟩\n  · exact (h i hi).imp fun N hN n hn => hN n hn N le_rfl\n  · rcases comp_symm_of_uniformity (H.mem_of_mem hi) with ⟨t, ht, ht', hts⟩\n    rcases H.mem_iff.1 ht with ⟨j, hj, hjt⟩\n    refine (h j hj).imp fun N hN m hm n hn => hts ⟨u N, hjt ?_, ht' <| hjt ?_⟩\n    exacts [hN m hm, hN n hn]","start":293,"end":301},"axioms":["Classical.choice","Quot.sound","propext"]}