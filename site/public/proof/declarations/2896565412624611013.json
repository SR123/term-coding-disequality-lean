a","mul",81,126,"explicit"],["lambda","one",45,127,"explicit"],["lambda","hf",17,128,"explicit"],["lambda","f",12,129,"explicit"],["lambda","inst._@.Mathlib.Algebra.Group.InjSurj.4120732672._hygCtx._hyg.10",10,130,"instance"],["lambda","inst._@.Mathlib.Algebra.Group.InjSurj.4120732672._hygCtx._hyg.7",7,131,"instance"],["lambda","inst._@.Mathlib.Algebra.Group.InjSurj.4120732672._hygCtx._hyg.4",4,132,"instance"],["lambda","M₂",1,133,"implicit"],["lambda","M₁",0,134,"implicit"]],"project":false,"range":{"column":0,"endColumn":67,"endLine":353,"line":344},"type":92,"typeText":"{M₁ : Type u_1} →\n  {M₂ : Type u_2} →\n    [inst : Mul.{u_2} M₂] →\n      [inst_1 : One.{u_2} M₂] →\n        [inst_2 : MulOneClass.{u_1} M₁] →\n          (f : M₁ → M₂) →\n            Function.Surjective.{u_1 + 1, u_2 + 1} f →\n              Eq.{u_2 + 1} (f 1) 1 →\n                (∀ (x y : M₁),\n                    Eq.{u_2 + 1} (f (HMul.hMul.{u_1, u_1, u_1} x y)) (HMul.hMul.{u_2, u_2, u_2} (f x) (f y))) →\n                  MulOneClass.{u_2} M₂","unsafe":false,"value":135,"source":{"code":"/-- A type endowed with `1` and `*` is a `MulOneClass`, if it admits a surjective map that preserves\n`1` and `*` from a `MulOneClass`. See note [reducible non-instances]. -/\n@[to_additive\n/-- A type endowed with `0` and `+` is an `AddZeroClass`, if it admits a\nsurjective map that preserves `0` and `+` to an `AddZeroClass`. -/]\nprotected abbrev mulOneClass [MulOneClass M₁] (f : M₁ → M₂) (hf : Surjective f) (one : f 1 = 1)\n    (mul : ∀ x y, f (x * y) = f x * f y) : MulOneClass M₂ :=\n  { ‹One M₂›, ‹Mul M₂› with\n    one_mul := hf.forall.2 fun x => by rw [← one, ← mul, one_mul],\n    mul_one := hf.forall.2 fun x => by rw [← one, ← mul, mul_one] }","start":344,"end":353},"axioms":[]}