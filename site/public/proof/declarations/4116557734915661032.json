_1} c) → (right : IsRightRegular.{u_1} c) → motive ⋯) →\n          (t : IsRegular.{u_1} c) → motive t","unsafe":false,"value":null,"source":{"code":"/-- A regular element is an element `c` such that multiplication by `c` both on the left and\non the right is injective. -/\nstructure IsRegular (c : R) : Prop where\n  /-- A regular element `c` is left-regular -/\n  left : IsLeftRegular c\n  /-- A regular element `c` is right-regular -/\n  right : IsRightRegular c","start":45,"end":51},"axioms":[]}