yg.17",47,98,"explicit"],["constant","ite",[["succ",["zero"]]]],["apply",100,6],["constant","Eq",[["succ",["zero"]]]],["apply",102,39],["apply",103,92],["constant","Bool.true",[]],["apply",104,105],["apply",101,106],["constant","instDecidableEqBool",[]],["apply",108,92],["apply",109,105],["apply",107,110],["apply",20,47],["apply",112,5],["apply",88,47],["constant","PUnit.unit",[["succ",["zero"]]]],["apply",114,115],["apply",113,116],["apply",92,12],["lambda","y._@.Lean.Meta.SynthInstance.1852723259._hygCtx._hyg.27",47,118,"explicit"],["apply",117,119],["apply",111,120],["constant","Option.none",[["zero"]]],["apply",122,0],["apply",89,123],["apply",121,124],["let","__do_jp._@.Lean.Meta.SynthInstance.1852723259._hygCtx._hyg.26",48,99,125,true],["lambda","__do_lift._@.Lean.Meta.SynthInstance.1852723259._hygCtx._hyg.24.0",39,126,"explicit"],["apply",46,127],["lambda","result",0,128,"explicit"],["lambda","fst._@.Lean.Meta.SynthInstance.1852723259._hygCtx._hyg.84",26,129,"explicit"],["lambda","fst._@.Lean.Meta.SynthInstance.1852723259._hygCtx._hyg.83",23,130,"explicit"],["apply",38,131],["lambda","__discr._@.Lean.Meta.SynthInstance.1852723259._hygCtx._hyg.17",29,132,"explicit"],["apply",34,133],["lambda","abstResult",2,134,"explicit"],["apply",13,135],["lambda","x._@.Lean.Meta.SynthInstance.1852723259._hygCtx._hyg.176",3,124,"explicit"],["apply",136,137],["lambda","abstResult?",3,138,"explicit"],["lambda","type",0,139,"explicit"]],"project":false,"range":{"column":0,"endColumn":20,"endLine":751,"line":717},"type":8,"typeText":"Lean.Expr → Option.{0} Lean.Meta.AbstractMVarsResult → Lean.Meta.MetaM (Option.{0} Lean.Expr)","unsafe":false,"value":140,"source":{"code":"/--\nAuxiliary function for converting the `AbstractMVarsResult` returned by `SynthInstance.main` into an `Expr`.\n-/\nprivate def applyAbstractResult? (type : Expr) (abstResult? : Option AbstractMVarsResult) : MetaM (Option Expr) := do\n  let some abstResult := abstResult? | return none\n  let (_, _, result) ← openAbstractMVarsResult abstResult\n  unless (← assignOutParams type result) do return none\n  let result ← instantiateMVars result\n  /- We use `check` to propagate universe constraints implied by the `result`.\n      Recall that we use `allowLevelAssignments := true` which allows universe metavariables in the current depth to be assigned,\n      but these assignments are discarded by `withNewMCtxDepth`.\n\n      TODO: If this `check` is a performance bottleneck, we can improve performance by tracking whether\n            a universe metavariable from previous universe levels have been assigned or not during TC resolution.\n            We only need to perform the `check` if this kind of assignment have been performed.\n\n      The example in the issue #796 exposed this issue.\n      ```\n      structure A\n      class B (a : outParam A) (α : Sort u)\n      class C {a : A} (α : Sort u) [B a α]\n      class D {a : A} (α : Sort u) [B a α] [c : C α]\n      class E (a : A) where [c (α : Sort u) [B a α] : C α]\n      instance c {a : A} [e : E a] (α : Sort u) [B a α] : C α := e.c α\n\n      def d {a : A} [e : E a] (α : Sort u) [b : B a α] : D α := ⟨⟩\n      ```\n      The term `D α` has two instance implicit arguments. The second one has type `C α`, and TC\n      resolution produces the result `@c.{u} a e α b`.\n      Note that the `e` has type `E.{?v} a`, and `E` is universe polymorphic,\n      but the universe does not occur in the parameter `a`. We have that `?v := u` is implied by `@c.{u} a e α b`,\n      but this assignment is lost.\n  -/\n  check result\n  return some result","start":717,"end":751},"axioms":["Classical.choice","Quot.sound","propext"]}