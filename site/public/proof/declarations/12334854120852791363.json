) ∈ tests) :\n    ¬ LowerT k outputs tests := by\n  rintro ⟨n, hn, h⟩\n  rw [identical_test_dispersionTuple_zero outputs u tests hu, threshold_eq k n hk] at h\n  have : 0 < n ^ (k - 1) * (n - 1) := Nat.mul_pos (Nat.pow_pos (by omega)) (by omega)\n  omega","start":179,"end":187,"lines":[[{"text":"/-- An identical-side test makes every degree a `Lower` no-instance. -/"}],[{"text":"theorem identical_test_not_lower ["},{"text":"Fintype","name":"Fintype"},{"text":" V] ["},{"text":"Fintype","name":"Fintype"},{"text":" F] (k : "},{"text":"ℕ","name":"Nat"},{"text":") (hk : "},{"text":"1","name":"OfNat.ofNat"},{"text":" ≤ k)"}],[{"text":"    (outputs : "},{"text":"List","name":"List"},{"text":" "},{"text":"(Term V F arity)","name":"DisequalityDispersion.Term"},{"text":") (u : "},{"text":"Term","name":"DisequalityDispersion.Term"},{"text":" V F arity)"}],[{"text":"    (tests : "},{"text":"List","name":"List"},{"text":" "},{"text":"(Term V F arity × Term V F arity)","name":"Prod"},{"text":") (hu : "},{"text":"(u, u)","name":"Prod.mk"},{"text":" ∈ tests) :"}],[{"text":"    "},{"text":"¬ LowerT k outputs tests","name":"Not"},{"text":" := by"}],[{"text":"  rintro ⟨n, hn, h⟩"}],[{"text":"  rw ["},{"text":"identical_test_dispersionTuple_zero","name":"DisequalityDispersion.identical_test_dispersionTuple_zero"},{"text":" outputs u tests hu, "},{"text":"threshold_eq","name":"DisequalityDispersion.threshold_eq"},{"text":" k n hk] at h"}],[{"text":"  have : "},{"text":"0","name":"OfNat.ofNat"},{"text":" < "},{"text":"n ^ (k - 1)","name":"HPow.hPow"},{"text":" * ("},{"text":"n - 1","name":"HSub.hSub"},{"text":") := "},{"text":"Nat.mul_pos","name":"Nat.mul_pos"},{"text":" "},{"text":"(Nat.pow_pos (by omega))","name":"Nat.pow_pos"},{"text":" (by omega)"}],[{"text":"  omega"}]]},"steps":[{"after":[],"before":[0],"declaration":"DisequalityDispersion.identical_test_not_lower","elaborator":"[anonymous]","id":1439,"kind":"tactic","parent":0,"range":{"end":{"byte":8575,"column":7,"line":187},"st