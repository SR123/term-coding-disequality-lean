nge":{"column":0,"endColumn":16,"endLine":134,"line":131},"type":97,"typeText":"∀ {α : Type u_1} [inst : DecidableEq.{u_1 + 1} α] {β : α → Type u_2} (m : Multiset.{u_1} α)\n  (t : (a : α) → Multiset.{u_2} (β a)) (a : α),\n  Eq.{max (u_1 + 1) (u_2 + 1)} (Multiset.pi.{u_1, u_2} (Multiset.cons.{u_1} a m) t)\n    (Multiset.bind.{max u_1 u_2, u_2} (t a) fun b =>\n      Multiset.map.{max u_1 u_2, max u_1 u_2} (Multiset.Pi.cons.{u_1, u_2 + 1} m a b) (Multiset.pi.{u_1, u_2} m t))","unsafe":false,"value":212,"source":{"code":"@[simp]\ntheorem pi_cons (m : Multiset α) (t : ∀ a, Multiset (β a)) (a : α) :\n    pi (a ::ₘ m) t = (t a).bind fun b => (pi m t).map <| Pi.cons m a b :=\n  recOn_cons a m","start":131,"end":134},"axioms":["Classical.choice","Quot.sound","propext"]}