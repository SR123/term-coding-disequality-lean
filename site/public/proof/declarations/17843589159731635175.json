achine.Mem) →\n        (a_3 : Nat) → DisequalityDispersion.Machine.Cmd.Exec a a_1 a_2 a_3 → Prop},\n  (∀ (p : DisequalityDispersion.Machine.Prim) (m : DisequalityDispersion.Machine.Mem),\n      motive (DisequalityDispersion.Machine.Cmd.prim p) m (DisequalityDispersion.Machine.Prim.exec p m) 1 ⋯) →\n    (∀ {c₁ c₂ : DisequalityDispersion.Machine.Cmd} {m m₁ m₂ : DisequalityDispersion.Machine.Mem} {k₁ k₂ : Nat}\n        (a : DisequalityDispersion.Machine.Cmd.Exec c₁ m m₁ k₁)\n        (a_1 : DisequalityDispersion.Machine.Cmd.Exec c₂ m₁ m₂ k₂),\n        motive c₁ m m₁ k₁ a →\n          motive c₂ m₁ m₂ k₂ a_1 →\n            motive (DisequalityDispersion.Machine.Cmd.seq c₁ c₂) m m₂ (HAdd.hAdd.{0, 0, 0} k₁ k₂) ⋯) →\n      (∀ {b : DisequalityDispersion.Machine.Cond} {c₁ c₂ : DisequalityDispersion.Machine.Cmd}\n          {m m' : DisequalityDispersion.Machine.Mem} {k : Nat}\n          (a : Eq.{1} (DisequalityDispersion.Machine.Cond.eval b m) Bool.true)\n          (a_1 : DisequalityDispersion.Machine.Cmd.Exec c₁ m m' k),\n          motive c₁ m m' k a_1 →\n            motive (DisequalityDispersion.Machine.Cmd.ite b c₁ c₂) m m'\n              (HAdd.hAdd.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} 1 k) 1) ⋯) →\n        (∀ {b : DisequalityDispersion.Machine.Cond} {c₁ c₂ : DisequalityDispersion.Machine.Cmd}\n            {m m' : DisequalityDispersion.Machine.Mem} {k : Nat}\n            (a : Eq.{1} (DisequalityDispersion.Machine.Cond.eval b m) Bool.false)\n            (a_1 : DisequalityDispersion.Machine.Cmd.Exec c₂ m m' k),\n            motive c₂ m m' k a_1 →\n              motive (DisequalityDispersion.Machine.Cmd.ite b c₁ c₂) m m'\n                (HAdd.hAdd.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} 1 1) k) ⋯) →\n          (∀ {b : DisequalityDispersion.Machine.Cond} {c : DisequalityDispersion.Machine.Cmd}\n              {m m₁ m₂ : DisequalityDispersion.Machine.Mem} {k₁ k₂ : Nat}\n              (a : Eq.{1} (DisequalityDispersion.Machine.Cond.eval b m) Bool.true)\n              (a_1 : DisequalityDispersion.Machine.Cmd.Exec c m m₁ k₁)\n              (a_2 : DisequalityDispersion.Machine.Cmd.Exec (DisequalityDispersion.Machine.Cmd.loop b c) m₁ m₂ k₂),\n              motive c m m₁ k₁ a_1 →\n                motive (DisequalityDispersion.Machine.Cmd.loop b c) m₁ m₂ k₂ a_2 →\n                  motive (DisequalityDispersion.Machine.Cmd.loop b c) m m₂\n                    (HAdd.hAdd.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} 1 k₁) 1) k₂) ⋯) →\n            (∀ {b : DisequalityDispersion.Machine.Cond} {c : DisequalityDispersion.Machine.Cmd}\n                {m : DisequalityDispersion.Machine.Mem}\n                (a : Eq.{1} (DisequalityDispersion.Machine.Cond.eval b m) Bool.false),\n                motive (DisequalityDispersion.Machine.Cmd.loop b c) m m (HAdd.hAdd.{0, 0, 0} 1 1) ⋯) →\n              ∀ {a : DisequalityDispersion.Machine.Cmd} {a_1 a_2 : DisequalityDispersion.Machine.Mem} {a_3 : Nat}\n                (t : DisequalityDispersion.Machine.Cmd.Exec a a_1 a_2 a_3), motive a a_1 a_2 a_3 t","unsafe":false,"value":null,"source":{"code":"/-- Big-step semantics counting machine steps. -/\ninductive Exec : Cmd → Mem → Mem → ℕ → Prop\n  | prim (p : Prim) (m : Mem) : Exec (.prim p) m (p.exec m) 1\n  | seq {c₁ c₂ : Cmd} {m m₁ m₂ : Mem} {k₁ k₂ : ℕ} :\n      Exec c₁ m m₁ k₁ → Exec c₂ m₁ m₂ k₂ → Exec (.seq c₁ c₂) m m₂ (k₁ + k₂)\n  | ite_true {b : Cond} {c₁ c₂ : Cmd} {m m' : Mem} {k : ℕ} :\n      b.eval m = true → Exec c₁ m m' k → Exec (.ite b c₁ c₂) m m' (1 + k + 1)\n  | ite_false {b : Cond} {c₁ c₂ : Cmd} {m m' : Mem} {k : ℕ} :\n      b.eval m = false → Exec c₂ m m' k → Exec (.ite b c₁ c₂) m m' (1 + 1 + k)\n  | loop_true {b : Cond} {c : Cmd} {m m₁ m₂ : Mem} {k₁ k₂ : ℕ} :\n      b.eval m = true → Exec c m m₁ k₁ → Exec (.loop b c) m₁ m₂ k₂ →\n      Exec (.loop b c) m m₂ (1 + k₁ + 1 + k₂)\n  | loop_false {b : Cond} {c : Cmd} {m : Mem} :\n      b.eval m = false → Exec (.loop b c) m m (1 + 1)","start":29,"end":42,"lines":[[{"text":"/-- Big-step semantics counting machine steps. -/"}],[{"text":"inductive Exec : Cmd → Mem → Mem → ℕ → Prop"}],[{"text":"  | prim (p : Prim) (m : Mem) : Exec (.prim p) m (p.exec m) 1"}],[{"text":"  | seq {c₁ c₂ : Cmd} {m m₁ m₂ : Mem} {k₁ k₂ : ℕ} :"}],[{"text":"      Exec c₁ m m₁ k₁ → Exec c₂ m₁ m₂ k₂ → Exec (.seq c₁ c₂) m m₂ (k₁ + k₂)"}],[{"text":"  | ite_true {b : Cond} {c₁ c₂ : Cmd} {m m' : Mem} {k : ℕ} :"}],[{"text":"      b.eval m = true → Exec c₁ m m' k → Exec (.ite b c₁ c₂) m m' (1 + k + 1)"}],[{"text":"  | ite_false {b : Cond} {c₁ c₂ : Cmd} {m m' : Mem} {k : ℕ} :"}],[{"text":"      b.eval m = false → Exec c₂ m m' k → Exec (.ite b c₁ c₂) m m' (1 + 1 + k)"}],[{"text":"  | loop_true {b : Cond} {c : Cmd} {m m₁ m₂ : Mem} {k₁ k₂ : ℕ} :"}],[{"text":"      b.eval m = true → Exec c m m₁ k₁ → Exec (.loop b c) m₁ m₂ k₂ →"}],[{"text":"      Exec (.loop b c) m m₂ (1 + k₁ + 1 + k₂)"}],[{"text":"  | loop_false {b : Cond} {c : Cmd} {m : Mem} :"}],[{"text":"      b.eval m = false → Exec (.loop b c) m m (1 + 1)"}]]},"steps":[],"stepGoalPool":[],"references":[],"axioms":[]}