hyg.0",15,71,"implicit"],["forall","motive",14,72,"implicit"],["forall","R",5,73,"implicit"],["forall","α",0,74,"implicit"],["constant","List.Pairwise.rec",[["param","u"]]],["apply",76,29],["apply",77,28],["apply",78,21],["apply",79,2],["apply",6,31],["apply",32,50],["apply",6,50],["apply",82,83],["apply",37,50],["apply",84,85],["apply",86,2],["apply",87,1],["apply",50,16],["apply",89,2],["forall","a._@._internal._hyg.0",88,90,"explicit"],["forall","a'",33,91,"explicit"],["apply",8,50],["apply",93,33],["apply",94,2],["apply",33,9],["apply",96,1],["apply",28,21],["apply",98,16],["apply",99,9],["apply",100,2],["lambda","a_ih._@._internal._hyg.0",97,101,"explicit"],["lambda","a._@._internal._hyg.0",95,102,"explicit"],["lambda","a._@._internal._hyg.0",92,103,"explicit"],["lambda","l",81,104,"implicit"],["lambda","a",29,105,"implicit"],["apply",80,106],["apply",107,16],["apply",108,9],["lambda","cons",66,109,"explicit"],["lambda","nil",27,110,"explicit"],["lambda","t",19,111,"explicit"],["lambda","a._@._internal._hyg.0",15,112,"implicit"],["lambda","motive",14,113,"implicit"],["lambda","R",5,114,"implicit"],["lambda","α",0,115,"implicit"]],"project":false,"range":{"column":0,"endColumn":91,"endLine":1335,"line":1310},"type":75,"typeText":"∀ {α : Type u} {R : α → α → Prop} {motive : (a : List.{u} α) → List.Pairwise.{u} R a → Prop} {a : List.{u} α}\n  (t : List.Pairwise.{u} R a),\n  motive List.nil.{u} ⋯ →\n    (∀ {a : α} {l : List.{u} α} (a_1 : ∀ (a' : α), Membership.mem.{u, u} l a' → R a a') (a_2 : List.Pairwise.{u} R l),\n        motive (List.cons.{u} a l) ⋯) →\n      motive a t","unsafe":false,"value":116,"source":{"code":"/--\nEach element of a list is related to all later elements of the list by `R`.\n\n`Pairwise R l` means that all the elements of `l` with earlier indexes are `R`-related to all the\nelements with later indexes.\n\nFor example, `Pairwise (· ≠ ·) l` asserts that `l` has no duplicates, and `Pairwise (· < ·) l`\nasserts that `l` is (strictly) sorted.\n\nExamples:\n * `Pairwise (· < ·) [1, 2, 3] ↔ (1 < 2 ∧ 1 < 3) ∧ 2 < 3`\n * `Pairwise (· = ·) [1, 2, 3] = False`\n * `Pairwise (· ≠ ·) [1, 2, 3] = True`\n-/\ninductive Pairwise : List α → Prop\n  /-- All elements of the empty list are vacuously pairwise related. -/\n  | nil : Pairwise []\n  /--\n  A nonempty list is pairwise related with `R` if the head is related to every element of the tail\n  and the tail is itself pairwise related.\n\n  That is, `a :: l` is `Pairwise R` if:\n   * `R` relates `a` to every element of `l`\n   * `l` is `Pairwise R`.\n  -/\n  | cons : ∀ {a : α} {l : List α}, (∀ a', a' ∈ l → R a a') → Pairwise l → Pairwise (a :: l)","start":1310,"end":1335},"axioms":[]}