icit"],["lambda","X",0,586,"implicit"]],"project":false,"range":{"column":0,"endColumn":60,"endLine":54,"line":47},"type":349,"typeText":"∀ {X : Type u_1} {M : Type u_2} [inst : AddCommMonoid.{u_2} M] [inst_1 : LinearOrder.{u_2} M],\n  (∃ x, LT.lt.{u_2} 0 x) →\n    ∀ (d : X → X → M) (refl : ∀ (x : X), Eq.{u_2 + 1} (d x x) 0) (symm : ∀ (x y : X), Eq.{u_2 + 1} (d x y) (d y x))\n      (triangle : ∀ (x y z : X), LE.le.{u_2} (d x z) (HAdd.hAdd.{u_2, u_2, u_2} (d x y) (d y z)))\n      (half :\n        ∀ (ε : M),\n          GT.gt.{u_2} ε 0 →\n            ∃ δ,\n              And (GT.gt.{u_2} δ 0)\n                (∀ (x : M),\n                  LT.lt.{u_2} x δ → ∀ (y : M), LT.lt.{u_2} y δ → LT.lt.{u_2} (HAdd.hAdd.{u_2, u_2, u_2} x y) ε)),\n      Filter.HasBasis.{u_1, u_2 + 1} (uniformity.{u_1} X) (fun x => LT.lt.{u_2} 0 x) fun ε =>\n        setOf.{u_1} fun x => LT.lt.{u_2} (d x.1 x.2) ε","unsafe":false,"value":587,"source":{"code":"theorem hasBasis_ofFun [AddCommMonoid M] [LinearOrder M]\n    (h₀ : ∃ x : M, 0 < x) (d : X → X → M) (refl : ∀ x, d x x = 0) (symm : ∀ x y, d x y = d y x)\n    (triangle : ∀ x y z, d x z ≤ d x y + d y z)\n    (half : ∀ ε > (0 : M), ∃ δ > (0 : M), ∀ x < δ, ∀ y < δ, x + y < ε) :\n    𝓤[.ofFun d refl symm triangle half].HasBasis ((0 : M) < ·) (fun ε => { x | d x.1 x.2 < ε }) :=\n  hasBasis_biInf_principal'\n    (fun ε₁ h₁ ε₂ h₂ => ⟨min ε₁ ε₂, lt_min h₁ h₂, fun _x hx => lt_of_lt_of_le hx (min_le_left _ _),\n      fun _x hx => lt_of_lt_of_le hx (min_le_right _ _)⟩) h₀","start":47,"end":54},"axioms":["Classical.choice","Quot.sound","propext"]}