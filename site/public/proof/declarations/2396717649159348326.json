,2],["lambda","f",28,1448,"explicit"],["lambda","t",14,1449,"explicit"],["lambda","m",9,1450,"explicit"],["lambda","β",6,1451,"implicit"],["lambda","inst._@.Mathlib.Data.Multiset.Pi.997992974._hygCtx._hyg.3",3,1452,"instance"],["lambda","α",0,1453,"implicit"]],"project":false,"range":{"column":0,"endColumn":20,"endLine":176,"line":158},"type":78,"typeText":"∀ {α : Type u_1} [inst : DecidableEq.{u_1 + 1} α] {β : α → Type u_2} (m : Multiset.{u_1} α)\n  (t : (a : α) → Multiset.{u_2} (β a)) (f : (a : α) → Membership.mem.{u_1, u_1} m a → β a),\n  Iff (Membership.mem.{max u_1 u_2, max u_1 u_2} (Multiset.pi.{u_1, u_2} m t) f)\n    (∀ (a : α) (h : Membership.mem.{u_1, u_1} m a), Membership.mem.{u_2, u_2} (t a) (f a h))","unsafe":false,"value":1454,"source":{"code":"theorem mem_pi (m : Multiset α) (t : ∀ a, Multiset (β a)) (f : ∀ a ∈ m, β a) :\n    f ∈ pi m t ↔ ∀ (a) (h : a ∈ m), f a h ∈ t a := by\n  induction m using Multiset.induction_on with\n  | empty =>\n    have : f = Pi.empty β := funext (fun _ => funext fun h => (notMem_zero _ h).elim)\n    simp only [this, pi_zero, mem_singleton, true_iff]\n    intro _ h; exact (notMem_zero _ h).elim\n  | cons a m ih => ?_\n  simp_rw [pi_cons, mem_bind, mem_map, ih]\n  constructor\n  · rintro ⟨b, hb, f', hf', rfl⟩ a' ha'\n    by_cases h : a' = a\n    · subst h\n      rwa [Pi.cons_same]\n    · rw [Pi.cons_ne _ h]\n      apply hf'\n  · intro hf\n    refine ⟨_, hf a (mem_cons_self _ _), _, fun a ha => hf a (mem_cons_of_mem ha), ?_⟩\n    rw [Pi.cons_eta]","start":158,"end":176},"axioms":["Classical.choice","Quot.sound","propext"]}