n  · obtain ⟨K, _, hK, hc⟩ := exists_min_cut outputs tests\n    rw [← hc]\n    exact cutSize_le_card_of_isCut outputs tests' K hK","start":81,"end":92,"lines":[[{"text":"/-- All cuts can be shrunk to the sources and output subterms. -/"}],[{"text":"theorem cutSize_tests_irrelevant ["},{"text":"Fintype","name":"Fintype"},{"text":" V] (outputs : "},{"text":"List","name":"List"},{"text":" "},{"text":"(Term V F arity)","name":"DisequalityDispersion.Term"},{"text":")"}],[{"text":"    (tests tests' : "},{"text":"List","name":"List"},{"text":" "},{"text":"(Term V F arity × Term V F arity)","name":"Prod"},{"text":") :"}],[{"text":"    "},{"text":"cutSize","name":"DisequalityDispersion.cutSize"},{"text":" outputs tests = "},{"text":"cutSize","name":"DisequalityDispersion.cutSize"},{"text":" outputs tests' := by"}],[{"text":"  -- a minimum cut for `tests` is a cut, hence bounds `cutSize outputs tests'`, and symmetrically"}],[{"text":"  apply "},{"text":"le_antisymm","name":"le_antisymm"}],[{"text":"  · obtain ⟨K, _, hK, hc⟩ := "},{"text":"exists_min_cut","name":"DisequalityDispersion.exists_min_cut"},{"text":" outputs tests'"}],[{"text":"    rw [← hc]"}],[{"text":"    exact "},{"text":"cutSize_le_card_of_isCut","name":"DisequalityDispersion.cutSize_le_card_of_isCut"},{"text":" outputs tests K hK"}],[{"text":"  · obtain ⟨K, _, hK, hc⟩ := "},{"text":"exists_min_cut","name":"DisequalityDispersion.exists_min_cut"},{"text":" outputs tests"}],[{"text":"    rw [← hc]"}],[{"text":"    exact "},{"text":"cutSize_le_card_of_isCut","name":"DisequalityDispersion.cutSize_le_card_of_isCut"},{"text":" outputs tests' K hK"}]]},"steps":[{"after":[],"before":[0],"declaration":"DisequalityDispersion.cutSize_tests_irrelevant","elaborator":"[anonymous]","id":484,"kind":"tactic","parent":0,"range":{"end":{"byte":4195,"column":54,"line":92},"start":{"byte":3807,"column":54,"line":84}},"syntax":"Lean.Parser.Term.byTactic","code":"by\n  -- a minimum cut for `tests` is a cut, hence bounds `cutSize outp