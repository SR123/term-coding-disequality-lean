value":130,"source":{"code":"theorem div_sat' {c : Constraint} {x y} (h : Coeffs.gcd x ≠ 0) (w : c.sat (Coeffs.dot x y)) :\n    (c.div (Coeffs.gcd x)).sat' (Coeffs.sdiv x (Coeffs.gcd x)) y := by\n  dsimp [sat']\n  rw [Coeffs.dot_sdiv_left _ _ (Int.dvd_refl _)]\n  exact div_sat c _ (Coeffs.gcd x) h (Coeffs.gcd_dvd_dot_left x y) w","start":232,"end":236},"axioms":["Quot.sound","propext"]}