,164,338],["lambda","a._@._internal._hyg.0",59,339,"explicit"],["lambda","guess",0,340,"explicit"],["apply",48,341],["lambda","n",0,342,"explicit"]],"project":false,"range":{"column":0,"endColumn":9,"endLine":58,"line":51},"type":24,"typeText":"∀ (n guess : Nat), LE.le.{0} (HMul.hMul.{0, 0, 0} (Nat.sqrt.iter n guess) (Nat.sqrt.iter n guess)) n","unsafe":false,"value":343,"source":{"code":"lemma sqrt.iter_sq_le (n guess : ℕ) : sqrt.iter n guess * sqrt.iter n guess ≤ n := by\n  unfold sqrt.iter\n  let next := (guess + n / guess) / 2\n  if h : next < guess then\n    simpa only [next, dif_pos h] using sqrt.iter_sq_le n next\n  else\n    apply Nat.mul_le_of_le_div\n    grind","start":51,"end":58},"axioms":["Classical.choice","Quot.sound","propext"]}