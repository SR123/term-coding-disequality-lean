pply",26,1154],["apply",1155,103],["apply",5,1156],["apply",1157,1156],["apply",1153,1158],["apply",1159,171],["apply",308,1146],["apply",1161,1157],["apply",1162,1150],["apply",1163,1156],["apply",314,1145],["apply",1165,1156],["apply",1166,5],["apply",178,1145],["apply",35,1141],["apply",1169,335],["apply",26,1170],["apply",1171,103],["apply",1168,1172],["apply",1173,1156],["apply",1174,406],["apply",184,1170],["apply",1176,1154],["apply",1177,189],["apply",600,10],["apply",1179,335],["apply",1178,1180],["apply",1175,1181],["apply",1167,1182],["apply",1164,1183],["apply",184,1148],["apply",1185,1154],["apply",1186,189],["constant","Int.mul_neg",[]],["apply",1188,10],["apply",1189,335],["apply",1187,1190],["apply",1184,1191],["apply",1160,1192],["apply",219,1156],["apply",1193,1194],["apply",1152,1195],["lambda","p",1,1196,"implicit"],["lambda","ih",1140,1197,"explicit"],["lambda","a",3,1198,"explicit"],["lambda","k",0,1199,"explicit"],["apply",1128,1200],["apply",1201,10],["apply",1202,12],["apply",1203,14],["lambda","e",3,1204,"explicit"],["lambda","ctx",2,1205,"explicit"],["lambda","p",1,1206,"implicit"],["lambda","k",0,1207,"implicit"]],"project":false,"range":{"column":0,"endColumn":68,"endLine":516,"line":490},"type":48,"typeText":"∀ {k : Int} {p : Int.Linear.Poly} (ctx : Int.Linear.Context) (e : Int.Linear.Expr),\n  Eq.{1} (Int.Linear.Poly.denote ctx (Int.Linear.Expr.toPoly'.go k e p))\n    (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} k (Int.Linear.Expr.denote ctx e)) (Int.Linear.Poly.denote ctx p))","unsafe":false,"value":1208,"source":{"code":"theorem Expr.denote_toPoly'_go (ctx : Context) (e : Expr) :\n  (toPoly'.go k e p).denote ctx = k * e.denote ctx + p.denote ctx := by\n    induction k, e using Expr.toPoly'.go.induct generalizing p with\n  | case1 k k' h =>\n    simp only [toPoly'.go, h, cond_true]\n    simp [eq_of_beq h]\n  | case2 k k' h =>\n    simp only [toPoly'.go, h, cond_false]\n    simp\n  | case3 k i => simp [toPoly'.go]\n  | case4 k a b iha ihb => simp [toPoly'.go, iha, ihb]\n  | case5 k a b iha ihb =>\n    simp [toPoly'.go, iha, ihb, Int.mul_sub]\n    rw [Int.sub_eq_add_neg, ←Int.neg_mul, Int.add_assoc]\n  | case6 k k' a h\n  | case8 k a k' h =>\n    simp only [toPoly'.go, h]\n    simp [eq_of_beq h]\n  | case7 k a k' h ih =>\n    simp only [toPoly'.go, h, cond_false]\n    simpa [denote, ← Int.mul_assoc] using ih\n  | case9 k a h h ih =>\n    simp only [toPoly'.go, h, cond_false]\n    simp only [mul_def, denote]\n    rw [Int.mul_comm (denote _ _) _]\n    simpa [Int.mul_assoc] using ih\n  | case10 k a ih => simp [toPoly'.go, ih, Int.neg_mul, Int.mul_neg]","start":490,"end":516},"axioms":["Quot.sound","propext"]}