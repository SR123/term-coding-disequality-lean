in ⟨_, hs, step, h', rfl⟩ := h\n    cases step using PlausibleIterStep.casesOn\n    · simp only [IterStep.successor, Monadic.modifyStep, Option.some.injEq] at hs\n      simp only [← hs]\n      exact ⟨_, rfl, ‹_›⟩\n    · simp only [IterStep.successor, Monadic.modifyStep, Option.some.injEq] at hs\n      simp only [← hs]\n      exact ⟨_, rfl, ‹_›⟩\n    · simp [IterStep.successor, Monadic.modifyStep, reduceCtorEq] at hs","start":47,"end":62},"axioms":["propext"]}