 [directedOn_iff_directed] at this\n    rwa [IsDirectedOrder, ← directed_id_iff]\n  refine map_atTop_eq_of_gc_preorder (Subtype.mono_coe _) a fun c hc ↦ ?_\n  exact ⟨⟨c, h hc⟩, rfl, fun _ ↦ .rfl⟩","start":310,"end":319},"axioms":["Classical.choice","Quot.sound","propext"]}