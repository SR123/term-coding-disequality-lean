da","l",3,317,"explicit"],["lambda","α",0,318,"implicit"]],"project":false,"range":{"column":0,"endColumn":48,"endLine":177,"line":171},"type":33,"typeText":"∀ {α : Type u} (l : List.{u} α), List.Sublist.{u} (List.map.{u, u} Pure.pure.{u, u} l) (List.sublists.{u} l)","unsafe":false,"value":319,"source":{"code":"theorem map_pure_sublist_sublists (l : List α) : map pure l <+ sublists l := by\n  induction l using reverseRecOn <;> simp only [map, map_append, sublists_concat]\n  · simp only [sublists_nil, sublist_cons_self]\n  case append_singleton l a ih =>\n    exact ((append_sublist_append_left _).2 <|\n              singleton_sublist.2 <| mem_map.2 ⟨[], mem_sublists.2 (nil_sublist _), by rfl⟩).trans\n          ((append_sublist_append_right _).2 ih)","start":171,"end":177},"axioms":["Quot.sound","propext"]}