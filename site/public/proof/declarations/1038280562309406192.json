f_lt (abs_lt.1 <| (H _ le_rfl).2.2 _ ij).1)\n  rwa [← sub_eq_add_neg, sub_self_div_two, sub_apply, sub_add_sub_cancel] at this","start":510,"end":521},"axioms":["Classical.choice","Quot.sound","propext"]}