lambda","self",113,139,"explicit"],["lambda","of_succ",109,140,"explicit"],["lambda","motive",98,141,"implicit"],["lambda","ih",86,142,"explicit"],["lambda","h._@.Mathlib.Data.Nat.Init.3315777484._hygCtx._hyg.91",66,143,"explicit"],["lambda","k",0,144,"strictImplicit"],["apply",93,145],["apply",146,71],["apply",147,5],["apply",148,43],["apply",149,39],["apply",150,17],["lambda","mn",54,151,"explicit"],["lambda","m",0,152,"implicit"],["lambda","self",53,153,"explicit"],["lambda","of_succ",49,154,"explicit"],["lambda","motive",11,155,"implicit"],["lambda","n",0,156,"implicit"]],"project":false,"range":{"column":0,"endColumn":89,"endLine":314,"line":302},"type":62,"typeText":"{n : Nat} →\n  {motive : (m : Nat) → LE.le.{0} m n → Sort u_1} →\n    ((k : Nat) → (h : LT.lt.{0} k n) → motive (HAdd.hAdd.{0, 0, 0} k 1) h → motive k ⋯) →\n      motive n ⋯ → {m : Nat} → (mn : LE.le.{0} m n) → motive m mn","unsafe":false,"value":157,"source":{"code":"/-- Decreasing induction: if `P (k+1)` implies `P k` for all `k < n`, then `P n` implies `P m` for\nall `m ≤ n`.\nAlso works for functions to `Sort*`.\n\nFor a version also assuming `m ≤ k`, see `Nat.decreasingInduction'`. -/\n@[elab_as_elim]\ndef decreasingInduction {n} {motive : (m : ℕ) → m ≤ n → Sort*}\n    (of_succ : ∀ k (h : k < n), motive (k + 1) h → motive k (le_of_succ_le h))\n    (self : motive n (Nat.le_refl _)) {m} (mn : m ≤ n) : motive m mn := by\n  induction mn using leRec with\n  | refl => exact self\n  | @le_succ_of_le k _ ih =>\n    apply ih (fun i hi => of_succ i (le_succ_of_le hi)) (of_succ k (lt_succ_self _) self)","start":302,"end":314},"axioms":[]}