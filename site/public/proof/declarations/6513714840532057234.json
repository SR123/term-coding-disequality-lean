q.{1} (Lean.Data.AC.ContextInformation.isIdem.{u_1 + 1} ctx) Bool.true →\n    ∀ (e : List.{0} Nat),\n      Eq.{u_1} (Lean.Data.AC.evalList.{u_1, u_1 + 1} α ctx (Lean.Data.AC.mergeIdem e))\n        (Lean.Data.AC.evalList.{u_1, u_1 + 1} α ctx e)","unsafe":false,"value":1437,"source":{"code":"theorem Context.evalList_mergeIdem (ctx : Context α) (h : ContextInformation.isIdem ctx) (e : List Nat) : evalList α ctx (mergeIdem e) = evalList α ctx e := by\n  have h : IdempotentOp ctx.op := by\n    simp [ContextInformation.isIdem, Option.isSome] at h;\n    match h₂ : ctx.idem with\n    | none =>\n      simp [h₂] at h\n    | some val =>\n      simp [h₂] at h\n      exact val.down\n  induction e using List.two_step_induction with\n  | empty => rfl\n  | single => rfl\n  | step x y ys ih =>\n    cases ys with\n    | nil =>\n      simp [mergeIdem, mergeIdem.loop]\n      split\n      next h₂ => simp [evalList, h₂, h.1, EvalInformation.evalOp]\n      next => rfl\n    | cons z zs =>\n      by_cases h₂ : x = y\n      case pos =>\n        rw [h₂, mergeIdem_head, ih]\n        simp [evalList, ←ctx.assoc.1, h.1, EvalInformation.evalOp]\n      case neg =>\n        rw [mergeIdem_head2]\n        by_cases h₃ : y = z\n        case pos =>\n          simp [mergeIdem_head, h₃, evalList]\n          cases h₄ : mergeIdem (z :: zs) with\n          | nil => apply absurd h₄; apply mergeIdem_nonEmpty; simp\n          | cons u us => simp_all [mergeIdem, mergeIdem.loop, evalList]\n        case neg =>\n          simp [mergeIdem_head2, h₃, evalList] at *\n          rw [ih]\n        assumption","start":135,"end":170},"axioms":["propext"]}