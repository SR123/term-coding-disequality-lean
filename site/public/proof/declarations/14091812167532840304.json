3,171],["constant","Nat.Partrec.Code.comp",[]],["apply",173,162],["apply",174,169],["lambda","_",32,175,"explicit"],["apply",172,176],["constant","Nat.Partrec.Code.prec",[]],["apply",178,162],["apply",179,169],["lambda","_",32,180,"explicit"],["apply",177,181],["constant","Nat.Partrec.Code.rfind'",[]],["apply",148,135],["constant","Nat.Partrec.Code.ofNatCode._proof_7",[]],["apply",185,159],["apply",186,122],["apply",184,187],["apply",183,188],["lambda","_",32,189,"explicit"],["apply",182,190],["let","_m2",138,141,191,true],["let","_m1",125,128,192,true],["let","hm",112,114,193,true],["let","m",0,90,194,false],["lambda","x._@.Mathlib.Computability.PartrecCode.3235492885._hygCtx._hyg.175",87,195,"explicit"],["lambda","n",0,196,"explicit"],["apply",79,197],["apply",198,10],["lambda","a._@._internal._hyg.0",26,199,"explicit"],["lambda","a._@._internal._hyg.0",0,200,"explicit"],["apply",21,201]],"project":false,"range":{"column":0,"endColumn":40,"endLine":151,"line":130},"type":2,"typeText":"Nat → Nat.Partrec.Code","unsafe":false,"value":202,"source":{"code":"/--\nA decoder for `Nat.Partrec.Code.encodeCode`, taking any ℕ to the `Nat.Partrec.Code` it represents.\n-/\ndef ofNatCode : ℕ → Code\n  | 0 => zero\n  | 1 => succ\n  | 2 => left\n  | 3 => right\n  | n + 4 =>\n    let m := n.div2.div2\n    have hm : m < n + 4 := by\n      simp only [m, div2_val]\n      exact\n        lt_of_le_of_lt (le_trans (Nat.div_le_self _ _) (Nat.div_le_self _ _))\n          (Nat.succ_le_succ (Nat.le_add_right _ _))\n    have _m1 : m.unpair.1 < n + 4 := lt_of_le_of_lt m.unpair_left_le hm\n    have _m2 : m.unpair.2 < n + 4 := lt_of_le_of_lt m.unpair_right_le hm\n    match n.bodd, n.div2.bodd with\n    | false, false => pair (ofNatCode m.unpair.1) (ofNatCode m.unpair.2)\n    | false, true => comp (ofNatCode m.unpair.1) (ofNatCode m.unpair.2)\n    | true, false => prec (ofNatCode m.unpair.1) (ofNatCode m.unpair.2)\n    | true, true => rfind' (ofNatCode m)","start":130,"end":151},"axioms":["Classical.choice","Quot.sound","propext"]}