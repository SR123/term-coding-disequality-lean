",81,2],["apply",16,82],["forall","inv_val",74,83,"explicit"],["forall","val_inv",49,84,"explicit"],["forall","inv",14,85,"explicit"],["forall","val",13,86,"explicit"],["apply",10,5],["forall","mk",87,88,"explicit"],["forall","t",12,89,"explicit"],["forall","motive",9,90,"implicit"],["forall","inst._@.Mathlib.Algebra.Group.Units.Defs.805054321._hygCtx._hyg.5",3,91,"instance"],["forall","α",0,92,"implicit"],["constant","Units.rec",[["param","u_1"],["param","u"]]],["apply",94,14],["apply",95,13],["apply",96,10],["apply",64,2],["apply",51,98],["apply",99,73],["apply",15,76],["apply",18,76],["apply",102,76],["apply",103,76],["apply",22,76],["apply",24,76],["apply",26,76],["apply",28,76],["apply",108,50],["apply",107,109],["apply",106,110],["apply",105,111],["apply",104,112],["apply",113,5],["apply",114,10],["apply",101,115],["apply",38,76],["apply",117,40],["apply",42,76],["apply",44,76],["apply",120,110],["apply",119,121],["apply",118,122],["apply",116,123],["apply",14,13],["apply",125,10],["apply",126,5],["apply",127,2],["lambda","inv_val",124,128,"explicit"],["lambda","val_inv",100,129,"explicit"],["lambda","inv",16,130,"explicit"],["lambda","val",14,131,"explicit"],["apply",97,132],["apply",133,5],["lambda","mk",87,134,"explicit"],["lambda","t",12,135,"explicit"],["lambda","motive",9,136,"implicit"],["lambda","inst._@.Mathlib.Algebra.Group.Units.Defs.805054321._hygCtx._hyg.5",3,137,"instance"],["lambda","α",0,138,"implicit"]],"project":false,"range":{"column":0,"endColumn":25,"endLine":56,"line":43},"type":93,"typeText":"{α : Type u} →\n  [inst : Monoid.{u} α] →\n    {motive : Units.{u} α → Sort u_1} →\n      (t : Units.{u} α) →\n        ((val inv : α) →\n            (val_inv : Eq.{u + 1} (HMul.hMul.{u, u, u} val inv) 1) →\n              (inv_val : Eq.{u + 1} (HMul.hMul.{u, u, u} inv val) 1) → motive (Units.mk.{u} val inv val_inv inv_val)) →\n          motive t","unsafe":false,"value":139,"source":{"code":"/-- Units of a `Monoid`, bundled version. Notation: `αˣ`.\n\nAn element of a `Monoid` is a unit if it has a two-sided inverse.\nThis version bundles the inverse element so that it can be computed.\nFor a predicate see `IsUnit`. -/\nstructure Units (α : Type u) [Monoid α] where\n  /-- The underlying value in the base `Monoid`. -/\n  val : α\n  /-- The inverse value of `val` in the base `Monoid`. -/\n  inv : α\n  /-- `inv` is the right inverse of `val` in the base `Monoid`. -/\n  val_inv : val * inv = 1\n  /-- `inv` is the left inverse of `val` in the base `Monoid`. -/\n  inv_val : inv * val = 1","start":43,"end":56},"axioms":[]}