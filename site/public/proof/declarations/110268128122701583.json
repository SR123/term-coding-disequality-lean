":41,"endLine":3445,"line":3438},"type":45,"typeText":"∀ {α : Type u_1} [inst : BEq.{u_1} α] [LawfulBEq.{u_1} α] {b a : α} {l : List.{u_1} α},\n  Iff (Membership.mem.{u_1, u_1} (List.insert.{u_1} b l) a) (Or (Eq.{u_1 + 1} a b) (Membership.mem.{u_1, u_1} l a))","unsafe":false,"value":247,"source":{"code":"@[simp, grind =] theorem mem_insert_iff {l : List α} : a ∈ l.insert b ↔ a = b ∨ a ∈ l := by\n  if h : b ∈ l then\n    rw [insert_of_mem h]\n    constructor; {apply Or.inr}\n    intro\n    | Or.inl h' => rw [h']; exact h\n    | Or.inr h' => exact h'\n  else rw [insert_of_not_mem h, mem_cons]","start":3438,"end":3445},"axioms":["propext"]}