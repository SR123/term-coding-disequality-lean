cit"]],"project":false,"range":{"column":0,"endColumn":39,"endLine":156,"line":150},"type":71,"typeText":"∀ {α : Type u_1} {f : Nat → Option.{u_1} α},\n  (∀ {a : α} {m n : Nat}, LE.le.{0} m n → Membership.mem.{u_1, u_1} (f m) a → Membership.mem.{u_1, u_1} (f n) a) →\n    ∀ {a : α}, Iff (Membership.mem.{u_1, u_1} (Nat.rfindOpt.{u_1} f) a) (∃ n, Membership.mem.{u_1, u_1} (f n) a)","unsafe":false,"value":322,"source":{"code":"theorem rfindOpt_mono {α} {f : ℕ → Option α} (H : ∀ {a m n}, m ≤ n → a ∈ f m → a ∈ f n) {a} :\n    a ∈ rfindOpt f ↔ ∃ n, a ∈ f n :=\n  ⟨rfindOpt_spec, fun ⟨n, h⟩ => by\n    have h' := rfindOpt_dom.2 ⟨_, _, h⟩\n    obtain ⟨k, hk⟩ := rfindOpt_spec ⟨h', rfl⟩\n    have := (H (le_max_left _ _) h).symm.trans (H (le_max_right _ _) hk)\n    simp at this; simp [this, get_mem]⟩","start":150,"end":156},"axioms":["Classical.choice","Quot.sound","propext"]}