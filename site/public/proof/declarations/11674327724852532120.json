,240,344,"explicit"],["lambda","k",0,345,"explicit"],["apply",234,346],["apply",60,347],["lambda","hn",46,348,"explicit"],["lambda","hp",29,349,"explicit"],["lambda","motive",5,350,"explicit"],["lambda","n",0,351,"explicit"],["lambda","m",0,352,"explicit"]],"project":false,"range":{"column":0,"endColumn":34,"endLine":128,"line":116},"type":58,"typeText":"∀ (m n : Nat) (motive : Nat → Nat → Int → Prop),\n  (∀ (i n : Nat), motive (HAdd.hAdd.{0, 0, 0} n i) n ↑i) →\n    (∀ (i m : Nat), motive m (HAdd.hAdd.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} m i) 1) (Int.negSucc i)) →\n      motive m n (Int.subNatNat m n)","unsafe":false,"value":353,"source":{"code":"@[elab_as_elim]\ntheorem subNatNat_elim (m n : Nat) (motive : Nat → Nat → Int → Prop)\n    (hp : ∀ i n, motive (n + i) n i)\n    (hn : ∀ i m, motive m (m + i + 1) -[i+1]) :\n    motive m n (subNatNat m n) := by\n  unfold subNatNat\n  match h : n - m with\n  | 0 =>\n    have ⟨k, h⟩ := Nat.le.dest (Nat.le_of_sub_eq_zero h)\n    rw [h.symm, Nat.add_sub_cancel_left]; apply hp\n  | succ k =>\n    rw [Nat.sub_eq_iff_eq_add (Nat.le_of_lt (Nat.lt_of_sub_eq_succ h))] at h\n    rw [h, Nat.add_comm]; apply hn","start":116,"end":128},"axioms":["propext"]}