ases p.castSucc_lt_or_lt_succ i with (h | h)\n  · rw [succAbove_of_castSucc_lt _ _ h]\n    exact Fin.ne_of_lt h\n  · rw [succAbove_of_lt_succ _ _ h]\n    exact Fin.ne_of_gt h","start":538,"end":546},"axioms":["Classical.choice","Quot.sound","propext"]}