"],["apply",415,748],["lambda","hU",351,749,"explicit"],["lambda","U_mem",269,750,"explicit"],["apply",316,751],["lambda","h._@.Mathlib.Topology.UniformSpace.Cauchy.801174898._hygCtx._hyg.109",191,752,"explicit"],["lambda","U",48,753,"explicit"],["apply",256,754],["lambda","hs",138,755,"explicit"],["lambda","s",126,756,"strictImplicit"],["lambda","adhs",99,757,"explicit"],["lambda","x",7,758,"implicit"],["lambda","f",6,759,"implicit"],["lambda","uniformSpace",3,760,"instance"],["lambda","α",0,761,"implicit"]],"project":false,"range":{"column":0,"endColumn":81,"endLine":136,"line":122},"type":125,"typeText":"∀ {α : Type u} [uniformSpace : UniformSpace.{u} α] {f : Filter.{u} α} {x : α},\n  (∀ (s : Set.{u} (Prod.{u, u} α α)),\n      Membership.mem.{u, u} (uniformity.{u} α) s →\n        ∃ t,\n          And (Membership.mem.{u, u} f t)\n            (And (HasSubset.Subset.{u} (SProd.sprod.{u, u, u} t t) s)\n              (∃ y, And (Membership.mem.{u, u} s (Prod.mk.{u, u} x y)) (Membership.mem.{u, u} t y)))) →\n    LE.le.{u} f (nhds.{u} x)","unsafe":false,"value":762,"source":{"code":"/-- The common part of the proofs of `le_nhds_of_cauchy_adhp` and\n`SequentiallyComplete.le_nhds_of_seq_tendsto_nhds`: if for any entourage `s`\none can choose a set `t ∈ f` of diameter `s` such that it contains a point `y`\nwith `(x, y) ∈ s`, then `f` converges to `x`. -/\ntheorem le_nhds_of_cauchy_adhp_aux {f : Filter α} {x : α}\n    (adhs : ∀ s ∈ 𝓤 α, ∃ t ∈ f, t ×ˢ t ⊆ s ∧ ∃ y, (x, y) ∈ s ∧ y ∈ t) : f ≤ 𝓝 x := by\n  -- Consider a neighborhood `s` of `x`\n  intro s hs\n  -- Take an entourage twice smaller than `s`\n  rcases comp_mem_uniformity_sets (mem_nhds_uniformity_iff_right.1 hs) with ⟨U, U_mem, hU⟩\n  -- Take a set `t ∈ f`, `t × t ⊆ U`, and a point `y ∈ t` such that `(x, y) ∈ U`\n  rcases adhs U U_mem with ⟨t, t_mem, ht, y, hxy, hy⟩\n  apply mem_of_superset t_mem\n  -- Given a point `z ∈ t`, we have `(x, y) ∈ U` and `(y, z) ∈ t × t ⊆ U`, hence `z ∈ s`\n  exact fun z hz => hU (SetRel.prodMk_mem_comp hxy (ht <| mk_mem_prod hy hz)) rfl","start":122,"end":136},"axioms":["Classical.choice","Quot.sound","propext"]}