2,"explicit"],["lambda","add",157,833,"explicit"],["lambda","one",106,834,"explicit"],["lambda","zero",66,835,"explicit"],["lambda","f",21,836,"explicit"],["lambda","inst._@.Mathlib.Algebra.Order.Ring.InjSurj.899997306._hygCtx._hyg.16",18,837,"instance"],["lambda","inst._@.Mathlib.Algebra.Order.Ring.InjSurj.899997306._hygCtx._hyg.13",15,838,"instance"],["lambda","inst._@.Mathlib.Algebra.Order.Ring.InjSurj.899997306._hygCtx._hyg.10",13,839,"instance"],["lambda","inst._@.Mathlib.Algebra.Order.Ring.InjSurj.899997306._hygCtx._hyg.7",7,840,"instance"],["lambda","inst._@.Mathlib.Algebra.Order.Ring.InjSurj.899997306._hygCtx._hyg.4",4,841,"instance"],["lambda","S",1,842,"implicit"],["lambda","R",0,843,"implicit"]],"project":false,"range":{"column":0,"endColumn":90,"endLine":33,"line":22},"type":251,"typeText":"∀ {R : Type u_1} {S : Type u_2} [inst : Semiring.{u_1} R] [inst_1 : PartialOrder.{u_1} R] [IsOrderedRing.{u_1} R]\n  [inst_3 : Semiring.{u_2} S] [inst_4 : PartialOrder.{u_2} S] (f : S → R),\n  Eq.{u_1 + 1} (f 0) 0 →\n    Eq.{u_1 + 1} (f 1) 1 →\n      (∀ (x y : S), Eq.{u_1 + 1} (f (HAdd.hAdd.{u_2, u_2, u_2} x y)) (HAdd.hAdd.{u_1, u_1, u_1} (f x) (f y))) →\n        (∀ (x y : S), Eq.{u_1 + 1} (f (HMul.hMul.{u_2, u_2, u_2} x y)) (HMul.hMul.{u_1, u_1, u_1} (f x) (f y))) →\n          (∀ {x y : S}, Iff (LE.le.{u_1} (f x) (f y)) (LE.le.{u_2} x y)) → IsOrderedRing.{u_2} S","unsafe":false,"value":844,"source":{"code":"/-- Pullback an `IsOrderedRing` under an injective map. -/\nprotected lemma isOrderedRing [IsOrderedRing R] [Semiring S] [PartialOrder S]\n    (f : S → R) (zero : f 0 = 0) (one : f 1 = 1)\n    (add : ∀ x y, f (x + y) = f x + f y) (mul : ∀ x y, f (x * y) = f x * f y)\n    (le : ∀ {x y}, f x ≤ f y ↔ x ≤ y) :\n    IsOrderedRing S where\n  __ := Function.Injective.isOrderedAddMonoid f add le\n  zero_le_one := by simp only [← le, zero, one, zero_le_one]\n  mul_le_mul_of_nonneg_left a ha b c hbc := by\n    rw [← le, mul, mul]; refine mul_le_mul_of_nonneg_left (le.2 hbc) ?_; rwa [← zero, le]\n  mul_le_mul_of_nonneg_right a ha b c hbc := by\n    rw [← le, mul, mul]; refine mul_le_mul_of_nonneg_right (le.2 hbc) ?_; rwa [← zero, le]","start":22,"end":33},"axioms":["Quot.sound","propext"]}