,["constant","Eq",[["succ",["param","v"]]]],["apply",76,37],["apply",77,17],["apply",78,17],["forall","val_eq",79,37,"explicit"],["constant","Eq.refl",[["succ",["param","v"]]]],["apply",81,43],["apply",82,6],["apply",17,83],["lambda","k",80,84,"explicit"],["lambda","val",20,85,"explicit"],["apply",75,86],["lambda","h11",54,87,"explicit"],["apply",51,88],["apply",89,6],["apply",90,17],["apply",91,17],["lambda","h12",18,92,"explicit"],["lambda","x2",10,93,"implicit"],["lambda","x1",7,94,"implicit"],["lambda","P",2,95,"implicit"],["lambda","β",1,96,"implicit"],["lambda","α",0,97,"implicit"]],"project":false,"range":{"column":0,"endColumn":27,"endLine":208,"line":196},"type":31,"typeText":"{α : Type u} →\n  {β : Type v} →\n    {P : Sort u_1} → {x1 x2 : Sum.{u, v} α β} → Eq.{max (u + 1) (v + 1)} x1 x2 → Sum.noConfusionType.{u_1, u, v} P x1 x2","unsafe":false,"value":98,"source":{"code":"/--\nThe disjoint union of types `α` and `β`, ordinarily written `α ⊕ β`.\n\nAn element of `α ⊕ β` is either an `a : α` wrapped in `Sum.inl` or a `b : β` wrapped in `Sum.inr`.\n`α ⊕ β` is not equivalent to the set-theoretic union of `α` and `β` because its values include an\nindication of which of the two types was chosen. The union of a singleton set with itself contains\none element, while `Unit ⊕ Unit` contains distinct values `inl ()` and `inr ()`.\n-/\ninductive Sum (α : Type u) (β : Type v) where\n  /-- Left injection into the sum type `α ⊕ β`. -/\n  | inl (val : α) : Sum α β\n  /-- Right injection into the sum type `α ⊕ β`. -/\n  | inr (val : β) : Sum α β","start":196,"end":208},"axioms":[]}