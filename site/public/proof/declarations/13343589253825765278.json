hyg.20",0,210,"explicit"]],"project":false,"range":{"column":0,"endColumn":41,"endLine":1935,"line":1927},"type":25,"typeText":"∀ {n m : Nat}, LE.le.{0} n m → Or (Eq.{1} n m) (LT.lt.{0} n m)","unsafe":false,"value":211,"source":{"code":"protected def Nat.eq_or_lt_of_le : {n m: Nat} → LE.le n m → Or (Eq n m) (LT.lt n m)\n  | zero,   zero,   _ => Or.inl rfl\n  | zero,   succ _, _ => Or.inr (Nat.succ_le_succ (Nat.zero_le _))\n  | succ _, zero,   h => absurd h (not_succ_le_zero _)\n  | succ n, succ m, h =>\n    have : LE.le n m := Nat.le_of_succ_le_succ h\n    match Nat.eq_or_lt_of_le this with\n    | Or.inl h => Or.inl (h ▸ rfl)\n    | Or.inr h => Or.inr (succ_le_succ h)","start":1927,"end":1935},"axioms":[]}