,129,"explicit"],["lambda","i",1,130,"explicit"],["apply",45,131],["lambda","p",4,132,"explicit"],["lambda","stopPos",1,133,"explicit"],["lambda","s",0,134,"explicit"]],"project":false,"range":{"column":0,"endColumn":30,"endLine":2651,"line":2644},"type":8,"typeText":"String → String.Pos.Raw → (Char → Bool) → String.Pos.Raw → Bool","unsafe":false,"value":135,"source":{"code":"@[specialize] def anyAux (s : String) (stopPos : Pos.Raw) (p : Char → Bool) (i : Pos.Raw) : Bool :=\n  if h : i < stopPos then\n    if p (i.get s) then true\n    else\n      have := Nat.sub_lt_sub_left h (Pos.Raw.lt_next s i)\n      anyAux s stopPos p (i.next s)\n  else false\ntermination_by stopPos.1 - i.1","start":2644,"end":2651},"axioms":["Classical.choice","Quot.sound","propext"]}