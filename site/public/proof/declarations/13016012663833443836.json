; ⟨b, mem_cons.2 (Or.inr hb), hlt⟩\n  · exact fun ⟨b, hb, hlt⟩ => lt_of_lt_of_le hlt (le_sup hb)","start":596,"end":606},"axioms":["Classical.choice","Quot.sound","propext"]}