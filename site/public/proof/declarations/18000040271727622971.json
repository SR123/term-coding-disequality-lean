,"type":13,"typeText":"{α : Type u_1} → [DecidableEq.{u_1 + 1} α] → [MulZeroClass.{u_1} α] → MulZeroClass.{u_1} (WithTop.{u_1} α)","unsafe":false,"value":115,"source":{"code":"instance instMulZeroClass : MulZeroClass (WithTop α) where\n  mul\n    | (a : α), (b : α) => ↑(a * b)\n    | (a : α), ⊤ => if a = 0 then 0 else ⊤\n    | ⊤, (b : α) => if b = 0 then 0 else ⊤\n    | ⊤, ⊤ => ⊤\n  mul_zero\n    | (a : α) => congr_arg some <| mul_zero _\n    | ⊤ => if_pos rfl\n  zero_mul\n    | (b : α) => congr_arg some <| zero_mul _\n    | ⊤ => if_pos rfl","start":29,"end":40},"axioms":[]}