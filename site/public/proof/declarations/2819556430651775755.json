["apply",103,433],["lambda","m₂",1,434,"explicit"],["lambda","m₁",1,435,"explicit"],["lambda","fuel",0,436,"explicit"]],"project":false,"range":null,"type":101,"typeText":"∀ (fuel : Nat) (m₁ m₂ : Lean.Grind.CommRing.Mon),\n  Eq.{1} (Lean.Grind.CommRing.Mon.revlexFuel fuel m₁ m₂)\n    (match fuel with\n    | 0 => Lean.Grind.CommRing.Mon.revlexWF m₁ m₂\n    | Nat.succ fuel =>\n      match m₁, m₂ with\n      | Lean.Grind.CommRing.Mon.unit, Lean.Grind.CommRing.Mon.unit => Ordering.eq\n      | Lean.Grind.CommRing.Mon.unit, Lean.Grind.CommRing.Mon.mult p m => Ordering.gt\n      | Lean.Grind.CommRing.Mon.mult p m, Lean.Grind.CommRing.Mon.unit => Ordering.lt\n      | Lean.Grind.CommRing.Mon.mult pw₁ m₁, Lean.Grind.CommRing.Mon.mult pw₂ m₂ =>\n        bif BEq.beq.{0} (Lean.Grind.CommRing.Power.x pw₁) (Lean.Grind.CommRing.Power.x pw₂) then\n          Ordering.then (Lean.Grind.CommRing.Mon.revlexFuel fuel m₁ m₂)\n            (Lean.Grind.CommRing.powerRevlex (Lean.Grind.CommRing.Power.k pw₁) (Lean.Grind.CommRing.Power.k pw₂))\n        else\n          bif Nat.blt (Lean.Grind.CommRing.Power.x pw₁) (Lean.Grind.CommRing.Power.x pw₂) then\n            Ordering.then (Lean.Grind.CommRing.Mon.revlexFuel fuel m₁ (Lean.Grind.CommRing.Mon.mult pw₂ m₂)) Ordering.lt\n          else\n            Ordering.then (Lean.Grind.CommRing.Mon.revlexFuel fuel (Lean.Grind.CommRing.Mon.mult pw₁ m₁) m₂)\n              Ordering.gt)","unsafe":false,"value":437,"axioms":["Quot.sound","propext"]}