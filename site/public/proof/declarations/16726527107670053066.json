lumn":55,"endLine":381,"line":377},"type":54,"typeText":"{α : Type u} →\n  {β : α → Type v} →\n    [Ord.{u} α] →\n      (k : α) →\n        β k →\n          (t : Std.DTreeMap.Internal.Impl.{u, v} α β) →\n            Std.DTreeMap.Internal.Impl.Balanced.{u, v} t →\n              Std.DTreeMap.Internal.Impl.SizedBalancedTree.{u, v} α β (Std.DTreeMap.Internal.Impl.size.{u, v} t)\n                (HAdd.hAdd.{0, 0, 0} (Std.DTreeMap.Internal.Impl.size.{u, v} t) 1)","unsafe":false,"value":112,"source":{"code":"/-- Adds a new mapping to the tree, leaving the tree unchanged if the key is already present. -/\n@[inline]\ndef insertIfNew [Ord α] (k : α) (v : β k) (t : Impl α β) (hl : t.Balanced) :\n    SizedBalancedTree α β t.size (t.size + 1) :=\n  if t.contains k then ⟨t, ✓, ✓, ✓⟩ else t.insert k v ✓","start":377,"end":381},"axioms":["Classical.choice","Quot.sound","propext"]}