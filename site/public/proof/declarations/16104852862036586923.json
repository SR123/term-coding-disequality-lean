],["lambda","h",24,48,"explicit"],["apply",41,49],["constant","Not",[]],["apply",51,24],["constant","Decidable.isFalse",[]],["apply",53,31],["constant","Int.decEq._proof_2",[]],["apply",55,27],["apply",56,5],["apply",57,7],["apply",54,58],["lambda","h",52,59,"explicit"],["apply",50,60],["lambda","b",18,61,"explicit"],["lambda","a",18,62,"explicit"],["apply",17,63],["apply",4,30],["constant","Int.negSucc",[]],["apply",66,7],["apply",65,67],["apply",53,68],["constant","Int.decEq._proof_3",[]],["apply",70,5],["apply",71,7],["apply",69,72],["lambda","a._@._internal.0.Init.Data.Int.Basic.18944134._hygCtx._hyg.89",18,73,"explicit"],["lambda","a._@._internal.0.Init.Data.Int.Basic.18944134._hygCtx._hyg.90",18,74,"explicit"],["apply",64,75],["apply",66,5],["apply",4,77],["apply",26,7],["apply",78,79],["apply",53,80],["constant","Int.decEq._proof_4",[]],["apply",82,5],["apply",83,7],["apply",81,84],["lambda","a._@._internal.0.Init.Data.Int.Basic.18944134._hygCtx._hyg.109",18,85,"explicit"],["lambda","a._@._internal.0.Init.Data.Int.Basic.18944134._hygCtx._hyg.110",18,86,"explicit"],["apply",76,87],["apply",66,27],["apply",4,89],["apply",90,77],["apply",2,91],["lambda","x._@.Init.Data.Int.Basic.18944134._hygCtx._hyg.136",25,92,"explicit"],["apply",21,93],["apply",94,40],["apply",42,91],["constant","Int.decEq._proof_5",[]],["apply",97,27],["apply",98,5],["apply",99,7],["apply",96,100],["lambda","h",24,101,"explicit"],["apply",95,102],["apply",53,91],["constant","Int.decEq._proof_6",[]],["apply",105,27],["apply",106,5],["apply",107,7],["apply",104,108],["lambda","h",52,109,"explicit"],["apply",103,110],["lambda","b",18,111,"explicit"],["lambda","a",18,112,"explicit"],["apply",88,113],["lambda","b",0,114,"explicit"],["lambda","a",0,115,"explicit"]],"project":false,"range":{"column":0,"endColumn":82,"endLine":262,"line":241},"type":11,"typeText":"(a b : Int) → Decidable (Eq.{1} a b)","unsafe":false,"value":116,"source":{"code":"/--\nDecides whether two integers are equal. Usually accessed via the `DecidableEq Int` instance.\n\nThis function is overridden by the compiler with an efficient implementation. This definition is the\nlogical model.\n\nExamples:\n* `show (7 : Int) = (3 : Int) + (4 : Int) by decide`\n* `if (6 : Int) = (3 : Int) * (2 : Int) then \"yes\" else \"no\" = \"yes\"`\n* `(¬ (6 : Int) = (3 : Int)) = true`\n-/\n@[extern \"lean_int_dec_eq\"]\nprotected def decEq (a b : @& Int) : Decidable (a = b) :=\n  match a, b with\n  | ofNat a, ofNat b => match decEq a b with\n    | isTrue h  => isTrue  <| h ▸ rfl\n    | isFalse h => isFalse <| fun h' => Int.noConfusion h' (fun h' => absurd h' h)\n  | ofNat _, -[_ +1] => isFalse <| fun h => Int.noConfusion h\n  | -[_ +1], ofNat _ => isFalse <| fun h => Int.noConfusion h\n  | -[a +1], -[b +1] => match decEq a b with\n    | isTrue h  => isTrue  <| h ▸ rfl\n    | isFalse h => isFalse <| fun h' => Int.noConfusion h' (fun h' => absurd h' h)","start":241,"end":262},"axioms":[]}