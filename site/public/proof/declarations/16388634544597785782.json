lumn":0,"endColumn":45,"endLine":90,"line":85},"type":31,"typeText":"∀ {α : Type u_1} {a : α} {l₁ l₂ : List.{u_1} α},\n  List.Perm.{u_1} l₁ l₂ → Iff (Membership.mem.{u_1, u_1} l₁ a) (Membership.mem.{u_1, u_1} l₂ a)","unsafe":false,"value":347,"source":{"code":"theorem Perm.mem_iff {a : α} {l₁ l₂ : List α} (p : l₁ ~ l₂) : a ∈ l₁ ↔ a ∈ l₂ := by\n  induction p with\n  | nil => rfl\n  | cons _ _ ih => simp only [mem_cons, ih]\n  | swap => simp only [mem_cons, or_left_comm]\n  | trans _ _ ih₁ ih₂ => simp only [ih₁, ih₂]","start":85,"end":90},"axioms":["propext"]}