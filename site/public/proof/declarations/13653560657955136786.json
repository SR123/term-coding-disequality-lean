e":644,"line":637},"type":43,"typeText":"∀ {x : Real}, Ne.{1} x 0 → LT.lt.{0} (HAdd.hAdd.{0, 0, 0} x 1) (Real.exp x)","unsafe":false,"value":1220,"source":{"code":"theorem add_one_lt_exp {x : ℝ} (hx : x ≠ 0) : x + 1 < Real.exp x := by\n  obtain hx | hx := hx.symm.lt_or_gt\n  · exact add_one_lt_exp_of_pos hx\n  obtain h' | h' := le_or_gt 1 (-x)\n  · linarith [x.exp_pos]\n  have hx' : 0 < x + 1 := by linarith\n  simpa [add_comm, exp_neg, inv_lt_inv₀ (exp_pos _) hx']\n    using exp_bound_div_one_sub_of_interval' (neg_pos.2 hx) h'","start":637,"end":644},"axioms":["Classical.choice","Quot.sound","propext"]}