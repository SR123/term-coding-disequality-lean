,"implicit"]],"project":false,"range":{"column":0,"endColumn":55,"endLine":219,"line":214},"type":46,"typeText":"∀ {α : Type u_1} [inst : Preorder.{u_1} α] [DenselyOrdered.{u_1} α] {s : Set.{u_1} α} [hs : Set.OrdConnected.{u_1} s],\n  DenselyOrdered.{u_1} ↑s","unsafe":false,"value":235,"source":{"code":"/-- In a dense order `α`, the subtype from an `OrdConnected` set is also densely ordered. -/\ninstance instDenselyOrdered [DenselyOrdered α] {s : Set α} [hs : OrdConnected s] :\n    DenselyOrdered s :=\n  ⟨fun a b (h : (a : α) < b) =>\n    let ⟨x, H⟩ := exists_between h\n    ⟨⟨x, (hs.out a.2 b.2) (Ioo_subset_Icc_self H)⟩, H⟩⟩","start":214,"end":219},"axioms":[]}