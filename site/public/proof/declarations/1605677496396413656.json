      (HasSubset.Subset.{ua} (SetRel.comp.{ua, ua, ua} t t) s))","unsafe":false,"value":478,"source":{"code":"theorem comp_symm_of_uniformity {s : SetRel α α} (hs : s ∈ 𝓤 α) :\n    ∃ t ∈ 𝓤 α, (∀ {a b}, (a, b) ∈ t → (b, a) ∈ t) ∧ t ○ t ⊆ s :=\n  let ⟨_t, ht₁, ht₂⟩ := comp_mem_uniformity_sets hs\n  let ⟨t', ht', ht'₁, ht'₂⟩ := symm_of_uniformity ht₁\n  ⟨t', ht', ht'₁ _ _, Subset.trans (monotone_id.relComp monotone_id ht'₂) ht₂⟩","start":517,"end":521},"axioms":["Classical.choice","Quot.sound","propext"]}