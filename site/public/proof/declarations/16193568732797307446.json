cit"],["apply",104,140],["apply",61,67],["apply",142,7],["apply",143,84],["apply",141,144],["lambda","a",56,145,"explicit"],["apply",65,146],["apply",44,147],["lambda","f",15,148,"explicit"],["lambda","x",10,149,"explicit"],["lambda","β",0,150,"implicit"],["lambda","α",0,151,"implicit"],["lambda","inst._@.Init.Data.Iterators.PostconditionMonad.3640351540._hygCtx._hyg.5",5,152,"instance"],["lambda","m",2,153,"implicit"]],"project":false,"range":{"column":0,"endColumn":68,"endLine":92,"line":82},"type":21,"typeText":"{m : Type w → Type w'} →\n  [Monad.{w, w'} m] →\n    {α β : Type w} →\n      Std.Iterators.PostconditionT.{w, w'} m α →\n        (α → Std.Iterators.PostconditionT.{w, w'} m β) → Std.Iterators.PostconditionT.{w, w'} m β","unsafe":false,"value":154,"source":{"code":"/--\nGiven a function `α → PostconditionT m β`, returns a a function\n`PostconditionT m α → PostconditionT m β`, turning `PostconditionT m` into a monad.\n-/\n@[always_inline, inline, expose]\nprotected def PostconditionT.bind {m : Type w → Type w'} [Monad m] {α : Type w} {β : Type w}\n    (x : PostconditionT m α) (f : α → PostconditionT m β) : PostconditionT m β :=\n  ⟨fun b => ∃ a, x.Property a ∧ (f a).Property b,\n    x.operation >>= fun a =>\n      (fun b =>\n        ⟨b.val, a.val, a.property, b.property⟩) <$> (f a).operation⟩","start":82,"end":92},"axioms":[]}