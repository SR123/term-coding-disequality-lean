"],["lambda","inst._@.Mathlib.Data.Multiset.UnionInter.2901579625._hygCtx._hyg.5",3,442,"instance"],["lambda","α",0,443,"implicit"]],"project":false,"range":{"column":0,"endColumn":65,"endLine":126,"line":119},"type":62,"typeText":"∀ {α : Type u_1} [inst : DecidableEq.{u_1 + 1} α] {s t u : Multiset.{u_1} α},\n  LE.le.{u_1} s t → LE.le.{u_1} s u → LE.le.{u_1} s (Inter.inter.{u_1} t u)","unsafe":false,"value":444,"source":{"code":"lemma le_inter (h₁ : s ≤ t) (h₂ : s ≤ u) : s ≤ t ∩ u := by\n  revert s u; refine @(Multiset.induction_on t ?_ fun a t IH => ?_) <;> intro s u h₁ h₂\n  · simpa only [zero_inter] using h₁\n  by_cases h : a ∈ u\n  · rw [cons_inter_of_pos _ h, ← erase_le_iff_le_cons]\n    exact IH (erase_le_iff_le_cons.2 h₁) (erase_le_erase _ h₂)\n  · rw [cons_inter_of_neg _ h]\n    exact IH ((le_cons_of_notMem <| mt (mem_of_le h₂) h).1 h₁) h₂","start":119,"end":126},"axioms":["Classical.choice","Quot.sound","propext"]}