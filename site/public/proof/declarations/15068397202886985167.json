ram","u_1"]]],["apply",829,163],["apply",828,830],["apply",831,129],["constant","SetLike.coe",[["param","u_1"],["param","u_1"]]],["apply",833,295],["apply",834,163],["apply",835,300],["apply",836,2],["apply",832,837],["apply",826,838],["constant","Subgroup.closure_le",[["param","u_1"]]],["apply",840,163],["apply",841,199],["apply",842,2],["apply",843,129],["apply",839,844],["apply",320,199],["apply",846,2],["apply",336,5],["apply",556,848],["apply",163,7],["apply",850,2],["lambda","hx",848,851,"explicit"],["apply",849,852],["apply",42,322],["apply",854,150],["apply",855,163],["apply",856,5],["apply",857,2],["apply",853,858],["apply",859,310],["lambda","hy",847,860,"explicit"],["lambda","y",163,861,"explicit"],["apply",845,862],["apply",863,7],["apply",864,5],["apply",804,865],["constant","id",[["zero"]]],["apply",129,9],["apply",868,2],["apply",867,869],["lambda","x._@.Mathlib.Algebra.Group.Subgroup.Lattice.540624867._hygCtx._hyg.223",799,870,"explicit"],["apply",866,871],["let","K",232,797,872,false],["lambda","hx",260,873,"explicit"],["lambda","x",113,874,"implicit"],["lambda","inv",259,875,"explicit"],["lambda","mul",212,876,"explicit"],["lambda","one",111,877,"explicit"],["lambda","mem",51,878,"explicit"],["lambda","p",31,879,"implicit"],["lambda","k",6,880,"implicit"],["lambda","inst._@.Mathlib.Algebra.Group.Subgroup.Lattice.540624867._hygCtx._hyg.3",3,881,"instance"],["lambda","G",0,882,"implicit"]],"project":false,"range":{"column":0,"endColumn":93,"endLine":390,"line":368},"type":272,"typeText":"∀ {G : Type u_1} [inst : Group.{u_1} G] {k : Set.{u_1} G}\n  {p : (g : G) → Membership.mem.{u_1, u_1} (Subgroup.closure.{u_1} k) g → Prop},\n  (∀ (x : G) (hx : Membership.mem.{u_1, u_1} k x), p x ⋯) →\n    p 1 ⋯ →\n      (∀ (x y : G) (hx : Membership.mem.{u_1, u_1} (Subgroup.closure.{u_1} k) x)\n          (hy : Membership.mem.{u_1, u_1} (Subgroup.closure.{u_1} k) y),\n          p x hx → p y hy → p (HMul.hMul.{u_1, u_1, u_1} x y) ⋯) →\n        (∀ (x : G) (hx : Membership.mem.{u_1, u_1} (Subgroup.closure.{u_1} k) x), p x hx → p (Inv.inv.{u_1} x) ⋯) →\n          ∀ {x : G} (hx : Membership.mem.{u_1, u_1} (Subgroup.closure.{u_1} k) x), p x hx","unsafe":false,"value":883,"source":{"code":"/-- An induction principle for closure membership. If `p` holds for `1` and all elements of `k`, and\nis preserved under multiplication and inverse, then `p` holds for all elements of the closure\nof `k`.\n\nSee also `Subgroup.closure_induction_left` and `Subgroup.closure_induction_right` for versions that\nonly require showing `p` is preserved by multiplication by elements in `k`. -/\n@[to_additive (attr := elab_as_elim)\n      /-- An induction principle for additive closure membership. If `p`\n      holds for `0` and all elements of `k`, and is preserved under addition and inverses, then `p`\n      holds for all elements of the additive closure of `k`.\n\n      See also `AddSubgroup.closure_induction_left` and `AddSubgroup.closure_induction_left` for\n      versions that only require showing `p` is preserved by addition by elements in `k`. -/]\ntheorem closure_induction {p : (g : G) → g ∈ closure k → Prop}\n    (mem : ∀ x (hx : x ∈ k), p x (subset_closure hx)) (one : p 1 (one_mem _))\n    (mul : ∀ x y hx hy, p x hx → p y hy → p (x * y) (mul_mem hx hy))\n    (inv : ∀ x hx, p x hx → p x⁻¹ (inv_mem hx)) {x} (hx : x ∈ closure k) : p x hx :=\n  let K : Subgroup G :=\n    { carrier := { x | ∃ hx, p x hx }\n      mul_mem' := fun ⟨_, ha⟩ ⟨_, hb⟩ ↦ ⟨_, mul _ _ _ _ ha hb⟩\n      one_mem' := ⟨_, one⟩\n      inv_mem' := fun ⟨_, hb⟩ ↦ ⟨_, inv _ _ hb⟩ }\n  closure_le (K := K) |>.mpr (fun y hy ↦ ⟨subset_closure hy, mem y hy⟩) hx |>.elim fun _ ↦ id","start":368,"end":390},"axioms":["Classical.choice","Quot.sound","propext"]}