coe_inv.mul_pow]; simp\n        inv_val := by rw [← a.commute_inv_coe.mul_pow]; simp }\n    npow_zero := fun a ↦ by ext; simp\n    npow_succ := fun n a ↦ by ext; simp [pow_succ] }","start":228,"end":238},"axioms":["propext"]}