,\n  Eq.{1} (Lean.Omega.IntList.sum (HAdd.hAdd.{0, 0, 0} xs ys))\n    (HAdd.hAdd.{0, 0, 0} (Lean.Omega.IntList.sum xs) (Lean.Omega.IntList.sum ys))","unsafe":false,"value":437,"source":{"code":"theorem sum_add (xs ys : IntList) : (xs + ys).sum = xs.sum + ys.sum := by\n  induction xs generalizing ys with\n  | nil => simp [List.map_id']\n  | cons x xs ih =>\n    cases ys with\n    | nil => simp [List.map_id']\n    | cons y ys => simp_all [Int.add_assoc, Int.add_left_comm]","start":248,"end":254},"axioms":["Quot.sound","propext"]}