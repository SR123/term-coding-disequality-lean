3],["apply",164,43],["apply",162,165],["constant","Rat.add._proof_4",[]],["bound",7],["apply",167,168],["apply",169,149],["constant","Rat.maybeNormalize",[]],["apply",171,43],["apply",172,75],["apply",173,27],["constant","Rat.normalize.dvd_num",[]],["apply",175,43],["apply",176,75],["apply",177,27],["apply",178,9],["apply",174,179],["constant","Rat.normalize.dvd_den",[]],["apply",181,43],["apply",182,75],["apply",183,27],["apply",184,9],["apply",180,185],["constant","Rat.normalize.den_nz",[]],["apply",187,43],["apply",188,75],["apply",189,27],["apply",190,6],["apply",191,9],["apply",186,192],["constant","Rat.normalize.reduced",[]],["apply",194,43],["apply",195,75],["apply",196,27],["apply",197,6],["apply",198,9],["apply",193,199],["let","e",166,170,200,true],["let","den_nz",158,161,201,true],["let","g1",3,148,202,false],["let","num",58,145,203,false],["let","den",3,136,204,false],["lambda","hg",123,205,"explicit"],["apply",121,206],["let","g",3,11,207,false],["lambda","b",0,208,"explicit"],["lambda","a",0,209,"explicit"]],"project":false,"range":{"column":0,"endColumn":62,"endLine":263,"line":245},"type":2,"typeText":"Rat → Rat → Rat","unsafe":false,"value":210,"source":{"code":"/--\nAddition of rational numbers. (This definition is `@[irreducible]` because you don't want to\nunfold it. Use `Rat.add_def` instead.)\n-/\n@[irreducible] protected def add (a b : Rat) : Rat :=\n  let g := a.den.gcd b.den\n  if hg : g = 1 then\n    have den_nz := Nat.ne_of_gt <| Nat.mul_pos a.den_pos b.den_pos\n    have reduced := add.aux a b hg.symm (Nat.div_one _).symm (Nat.div_one _).symm\n      |>.symm.trans (Nat.gcd_one_right _)\n    { num := a.num * b.den + b.num * a.den, den := a.den * b.den, den_nz, reduced }\n  else\n    let den := (a.den / g) * b.den\n    let num := a.num * ↑(b.den / g) + b.num * ↑(a.den / g)\n    let g1  := num.natAbs.gcd g\n    have den_nz := Nat.ne_of_gt <| Nat.mul_pos (Nat.div_gcd_pos_of_pos_left _ a.den_pos) b.den_pos\n    have e : g1 = num.natAbs.gcd den := add.aux a b rfl rfl rfl\n    Rat.maybeNormalize num den g1 (normalize.dvd_num e) (normalize.dvd_den e)\n      (normalize.den_nz den_nz e) (normalize.reduced den_nz e)","start":245,"end":263},"axioms":["Classical.choice","Quot.sound","propext"]}