α",0,224,"implicit"]],"project":false,"range":{"column":0,"endColumn":68,"endLine":313,"line":310},"type":56,"typeText":"∀ {α : Type u} {β : Type v} {l : α → β} {u : β → α} [inst : Preorder.{u} α] [inst_1 : Preorder.{v} β]\n  (gi : GaloisInsertion.{u, v} l u) {s : Set.{v} β} {a : α}, IsLUB.{u} (Set.image.{v, u} u s) a → IsLUB.{v} s (l a)","unsafe":false,"value":225,"source":{"code":"theorem isLUB_of_u_image [Preorder α] [Preorder β] (gi : GaloisInsertion l u) {s : Set β} {a : α}\n    (hs : IsLUB (u '' s) a) : IsLUB s (l a) :=\n  ⟨fun x hx => (gi.le_l_u x).trans <| gi.gc.monotone_l <| hs.1 <| mem_image_of_mem _ hx, fun _ hx =>\n    gi.gc.l_le <| hs.2 <| gi.gc.monotone_u.mem_upperBounds_image hx⟩","start":310,"end":313},"axioms":["Quot.sound","propext"]}