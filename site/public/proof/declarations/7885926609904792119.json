,1414,"explicit"],["lambda","f",17,1415,"implicit"],["lambda","inst._@.Mathlib.Topology.Order.Basic.40435578._hygCtx._hyg.14",15,1416,"instance"],["lambda","inst._@.Mathlib.Topology.Order.Basic.40435578._hygCtx._hyg.11",9,1417,"instance"],["lambda","inst._@.Mathlib.Topology.Order.Basic.40435578._hygCtx._hyg.8",6,1418,"instance"],["lambda","inst._@.Mathlib.Topology.Order.Basic.40435578._hygCtx._hyg.5",4,1419,"instance"],["lambda","β",1,1420,"implicit"],["lambda","α",0,1421,"implicit"]],"project":false,"range":{"column":0,"endColumn":44,"endLine":290,"line":271},"type":151,"typeText":"∀ {α : Type u} {β : Type v} [inst : Preorder.{u} α] [inst_1 : Preorder.{v} β] [inst_2 : TopologicalSpace.{v} β]\n  [OrderTopology.{v} β] {f : α → β},\n  (∀ {x y : α}, Iff (LT.lt.{v} (f x) (f y)) (LT.lt.{u} x y)) →\n    (∀ {a : α} {b : β} {x : α},\n        LT.lt.{v} b (f a) → Not (LT.lt.{v} b (f x)) → ∃ y, And (LT.lt.{u} y a) (LE.le.{v} b (f y))) →\n      (∀ {a : α} {b : β} {x : α},\n          LT.lt.{v} (f a) b → Not (LT.lt.{v} (f x) b) → ∃ y, And (LT.lt.{u} a y) (LE.le.{v} (f y) b)) →\n        Eq.{u + 1} (TopologicalSpace.induced.{u, v} f inst_2) (Preorder.topology.{u} α)","unsafe":false,"value":1422,"source":{"code":"theorem induced_topology_eq_preorder [Preorder α] [Preorder β] [TopologicalSpace β]\n    [OrderTopology β] {f : α → β} (hf : ∀ {x y}, f x < f y ↔ x < y)\n    (H₁ : ∀ {a b x}, b < f a → ¬(b < f x) → ∃ y, y < a ∧ b ≤ f y)\n    (H₂ : ∀ {a b x}, f a < b → ¬(f x < b) → ∃ y, a < y ∧ f y ≤ b) :\n    induced f ‹TopologicalSpace β› = Preorder.topology α := by\n  let _ := Preorder.topology α; have : OrderTopology α := ⟨rfl⟩\n  refine le_antisymm (induced_topology_le_preorder hf) ?_\n  refine le_of_nhds_le_nhds fun a => ?_\n  simp only [nhds_eq_order, nhds_induced, comap_inf, comap_iInf, comap_principal]\n  refine inf_le_inf (le_iInf₂ fun b hb => ?_) (le_iInf₂ fun b hb => ?_)\n  · by_cases! h : ∃ x, ¬(b < f x)\n    · rcases h with ⟨x, hx⟩\n      rcases H₁ hb hx with ⟨y, hya, hyb⟩\n      exact iInf₂_le_of_le y hya (principal_mono.2 fun z hz => hyb.trans_lt (hf.2 hz))\n    · exact le_principal_iff.2 (univ_mem' h)\n  · by_cases! h : ∃ x, ¬(f x < b)\n    · rcases h with ⟨x, hx⟩\n      rcases H₂ hb hx with ⟨y, hya, hyb⟩\n      exact iInf₂_le_of_le y hya (principal_mono.2 fun z hz => (hf.2 hz).trans_le hyb)\n    · exact le_principal_iff.2 (univ_mem' h)","start":271,"end":290},"axioms":["Classical.choice","Quot.sound","propext"]}