5,"typeText":"∀ {a b : Int}, LT.lt.{0} a 0 → LE.le.{0} b a → Eq.{1} (HDiv.hDiv.{0, 0, 0} a b) 1","unsafe":false,"value":394,"source":{"code":"theorem ediv_eq_one_of_neg_of_le {a b : Int} (H1 : a < 0) (H2 : b ≤ a) : a / b = 1 := by\n  match a, b, H1, H2 with\n  | negSucc a', ofNat n', H1, H2 => simp [Int.negSucc_eq] at H2; omega\n  | negSucc a', negSucc b', H1, H2 =>\n    rw [Int.div_def, ediv, ofNat_eq_natCast]\n    norm_cast\n    rw [Nat.succ_eq_add_one, Nat.add_eq_right, Nat.div_eq_zero_iff_lt (by omega)]\n    simp [Int.negSucc_eq] at H2\n    omega","start":564,"end":572},"axioms":["Classical.choice","Quot.sound","propext"]}