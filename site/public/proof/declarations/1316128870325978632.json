:498},"type":30,"typeText":"{α : Type u} →\n  {β : Type v} →\n    [BEq.{u} α] →\n      [Hashable.{u + 1} α] →\n        (Std.DHashMap.Internal.Raw₀.{u, v} α fun x => β) →\n          α → β → Prod.{v, max v u} (Option.{v} β) (Std.DHashMap.Internal.Raw₀.{u, v} α fun x => β)","unsafe":false,"value":292,"source":{"code":"/-- Internal implementation detail of the hash map -/\n@[inline] def Const.getThenInsertIfNew? [BEq α] [Hashable α] (m : Raw₀ α (fun _ => β)) (a : α)\n    (b : β) : Option β × Raw₀ α (fun _ => β) :=\n  let ⟨⟨size, buckets⟩, hm⟩ := m\n  let ⟨i, h⟩ := mkIdx buckets.size hm (hash a)\n  let bkt := buckets[i]\n  match bkt.get? a with\n  | none =>\n    let size'    := size + 1\n    let buckets' := buckets.uset i (AssocList.cons a b bkt) h\n    (none, expandIfNecessary ⟨⟨size', buckets'⟩, by simpa [buckets']⟩)\n  | some v => (some v, ⟨⟨size, buckets⟩, hm⟩)","start":498,"end":509},"axioms":["Quot.sound","propext"]}