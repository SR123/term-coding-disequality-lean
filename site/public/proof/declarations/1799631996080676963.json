on h with h; subst h; rw [Nat.add_sub_self_left]; decide\n    | Or.inr h =>\n      have : 0 < a - i := ih (Nat.lt_of_succ_lt_succ h)\n      exact Nat.lt_of_lt_of_le this (Nat.sub_le_succ_sub _ _)","start":947,"end":955},"axioms":["propext"]}