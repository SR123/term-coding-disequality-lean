3,"source":{"code":"@[simp]\ntheorem cpow_one (x : ℂ) : x ^ (1 : ℂ) = x :=\n  if hx : x = 0 then by simp [hx, cpow_def]\n  else by rw [cpow_def, if_neg (one_ne_zero : (1 : ℂ) ≠ 0), if_neg hx, mul_one, exp_log hx]","start":71,"end":74},"axioms":["Classical.choice","Quot.sound","propext"]}