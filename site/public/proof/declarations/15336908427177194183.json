tant","Fintype.truncEquivFin",[["param","u_1"]]],["apply",54,19],["apply",55,13],["apply",56,11],["apply",53,57],["lambda","h",16,58,"explicit"],["lambda","n",7,59,"implicit"],["lambda","inst._@.Mathlib.Data.Fintype.EquivFin.2256270779._hygCtx._hyg.11",6,60,"instance"],["lambda","inst._@.Mathlib.Data.Fintype.EquivFin.2256270779._hygCtx._hyg.5",3,61,"instance"],["lambda","α",0,62,"implicit"]],"project":false,"range":{"column":0,"endColumn":53,"endLine":117,"line":111},"type":29,"typeText":"{α : Type u_1} →\n  [inst : Fintype.{u_1} α] →\n    [DecidableEq.{u_1 + 1} α] →\n      {n : Nat} → Eq.{1} (Fintype.card.{u_1} α) n → Trunc.{max 1 (u_1 + 1)} (Equiv.{u_1 + 1, 1} α (Fin n))","unsafe":false,"value":63,"source":{"code":"/-- If the cardinality of `α` is `n`, there is computably a bijection between `α` and `Fin n`.\n\nSee `Fintype.equivFinOfCardEq` for the noncomputable definition,\nand `Fintype.truncEquivFin` and `Fintype.equivFin` for the bijection `α ≃ Fin (card α)`.\n-/\ndef truncEquivFinOfCardEq [DecidableEq α] {n : ℕ} (h : Fintype.card α = n) : Trunc (α ≃ Fin n) :=\n  (truncEquivFin α).map fun e => e.trans (finCongr h)","start":111,"end":117},"axioms":["Classical.choice","Quot.sound","propext"]}