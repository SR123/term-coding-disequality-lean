"text":"  out : m (OUT_ L) = hdr"}],[{"text":"  arr : arrAt m hdr = pre ++ l.take j"}],[{"text":"  room : hdr + 1 + tot ≤ m HP"}],[{"text":"  src : m ONE = 1 ∧ a + 1 + l.length ≤ m HP ∧ (∀ i, (h : i < l.length) → m (a + 1 + i) = l[i])"}]]},"steps":[],"stepGoalPool":[],"references":[],"axioms":[]}