:"ℕ","name":"Nat"},{"text":"} {g : "},{"text":"GInstance","name":"DisequalityDispersion.Encoded.GInstance"},{"text":"} {m : "},{"text":"Mem","name":"DisequalityDispersion.Machine.Mem"},{"text":"} (hm : "},{"text":"InstCtx","name":"DisequalityDispersion.Machine.InstCtx"},{"text":" k g m) (q : "},{"text":"ℕ","name":"Nat"},{"text":")"}],[{"text":"    (hq : "},{"text":"q ∈ arrAt m (m TESTS)","name":"Membership.mem"},{"text":") : "},{"text":"IN","name":"DisequalityDispersion.Machine.IN"},{"text":" ≤ q ∧ "},{"text":"q + 2","name":"HAdd.hAdd"},{"text":" ≤ m "},{"text":"HP","name":"DisequalityDispersion.Machine.HP"},{"text":" ∧ "},{"text":"(m q, m (q + 1))","name":"Prod.mk"},{"text":" ∈ "},{"text":"g.base.tests","name":"DisequalityDispersion.Encoded.Instance.tests"},{"text":" := by"}],[{"text":"  obtain ⟨_, _, hrec⟩ := "},{"text":"hm.tests_wf","name":"DisequalityDispersion.Machine.InstCtx.tests_wf"}],[{"text":"  refine "},{"text":"⟨(hrec q hq).1, (hrec q hq).2, ?_⟩","name":"And.intro"}],[{"text":"  rw [← "},{"text":"hm.pairs_tests","name":"DisequalityDispersion.Machine.InstCtx.pairs_tests"},{"text":"]"}],[{"text":"  unfold "},{"text":"pairsAt","name":"DisequalityDispersion.Machine.pairsAt"}],[{"text":"  exact "},{"text":"List.mem_map","name":"List.mem_map"},{"text":"."},{"text":"mpr","name":"Iff.mpr"},{"text":" "},{"text":"⟨q, hq, rfl⟩","name":"Exists.intro"}]]},"steps":[{"after":[],"before":[0],"declaration":"DisequalityDispersion.Machine.InstCtx.test_rec","elaborator":"[anonymous]","id":45920,"kind":"tactic","parent":0,"range":{"end":{"byte":52929,"column":37,"line":830},"start":{"byte":52753,"column":94,"line":825}},"syntax":"Lean.Parser.Term.byTactic","code":"by\n  obtain ⟨_, _, hrec⟩ := hm.tests_wf\n  refine ⟨(hrec q hq).1, (hrec q hq).2, ?_⟩\n  rw [← hm.pairs_tests]\n  unfold pairsAt\n  exact List.mem_map.mpr ⟨q, hq, rfl⟩"},{"after":[],"before":[0],"declaration":"DisequalityDispersion.Machine.InstCtx.test_rec","elaborator":"[anonymous]","id":45921,"kind":"tactic","par