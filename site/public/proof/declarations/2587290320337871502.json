] {a₁ a₂ : α},\n  LT.lt.{u} a₁ a₂ →\n    ∃ u v,\n      And (IsOpen.{u} u)\n        (And (IsOpen.{u} v)\n          (And (Membership.mem.{u, u} u a₁)\n            (And (Membership.mem.{u, u} v a₂)\n              (∀ (b₁ : α), Membership.mem.{u, u} u b₁ → ∀ (b₂ : α), Membership.mem.{u, u} v b₂ → LT.lt.{u} b₁ b₂))))","unsafe":false,"value":521,"source":{"code":"theorem order_separated {a₁ a₂ : α} (h : a₁ < a₂) :\n    ∃ u v : Set α, IsOpen u ∧ IsOpen v ∧ a₁ ∈ u ∧ a₂ ∈ v ∧ ∀ b₁ ∈ u, ∀ b₂ ∈ v, b₁ < b₂ :=\n  let ⟨x, hx, y, hy, h⟩ := h.exists_disjoint_Iio_Ioi\n  ⟨Iio x, Ioi y, isOpen_gt' _, isOpen_lt' _, hx, hy, h⟩","start":427,"end":430},"axioms":["Classical.choice","Quot.sound","propext"]}