"column":0,"endColumn":81,"endLine":173,"line":169},"type":42,"typeText":"∀ (x : Complex) {r : Real}, LT.lt.{0} 0 r → Eq.{1} (Complex.arg (HMul.hMul.{0, 0, 0} (↑r) x)) (Complex.arg x)","unsafe":false,"value":451,"source":{"code":"theorem arg_real_mul (x : ℂ) {r : ℝ} (hr : 0 < r) : arg (r * x) = arg x := by\n  rcases eq_or_ne x 0 with (rfl | hx); · rw [mul_zero]\n  conv_lhs =>\n    rw [← norm_mul_cos_add_sin_mul_I x, ← mul_assoc, ← ofReal_mul,\n      arg_mul_cos_add_sin_mul_I (mul_pos hr (norm_pos_iff.mpr hx)) x.arg_mem_Ioc]","start":169,"end":173},"axioms":["Classical.choice","Quot.sound","propext"]}