5,159,"explicit"],["lambda","symm",112,160,"explicit"],["lambda","uniformity",105,161,"explicit"],["lambda","toTopologicalSpace",104,162,"instance"],["apply",103,163],["apply",164,6],["lambda","mk",95,165,"explicit"],["lambda","t",7,166,"explicit"],["lambda","motive",5,167,"implicit"],["lambda","α",0,168,"implicit"]],"project":false,"range":{"column":0,"endColumn":81,"endLine":380,"line":364},"type":100,"typeText":"{α : Type u} →\n  {motive : UniformSpace.{u} α → Sort u_1} →\n    (t : UniformSpace.{u} α) →\n      ([toTopologicalSpace : TopologicalSpace.{u} α] →\n          (uniformity : Filter.{u} (Prod.{u, u} α α)) →\n            (symm : Filter.Tendsto.{u, u} Prod.swap.{u, u} uniformity uniformity) →\n              (comp : LE.le.{u} (Filter.lift'.{u, u} uniformity fun s => SetRel.comp.{u, u, u} s s) uniformity) →\n                (nhds_eq_comap_uniformity :\n                    ∀ (x : α), Eq.{u + 1} (nhds.{u} x) (Filter.comap.{u, u} (Prod.mk.{u, u} x) uniformity)) →\n                  motive (UniformSpace.mk.{u} uniformity symm comp nhds_eq_comap_uniformity)) →\n        motive t","unsafe":false,"value":169,"source":{"code":"/-- A uniform space is a generalization of the \"uniform\" topological aspects of a\n  metric space. It consists of a filter on `α × α` called the \"uniformity\", which\n  satisfies properties analogous to the reflexivity, symmetry, and triangle properties\n  of a metric.\n\n  A metric space has a natural uniformity, and a uniform space has a natural topology.\n  A topological group also has a natural uniformity, even when it is not metrizable. -/\nclass UniformSpace (α : Type u) extends TopologicalSpace α where\n  /-- The uniformity filter. -/\n  protected uniformity : Filter (α × α)\n  /-- If `s ∈ uniformity`, then `Prod.swap ⁻¹' s ∈ uniformity`. -/\n  protected symm : Tendsto Prod.swap uniformity uniformity\n  /-- For every set `u ∈ uniformity`, there exists `v ∈ uniformity` such that `v ○ v ⊆ u`. -/\n  protected comp : (uniformity.lift' fun s => s ○ s) ≤ uniformity\n  /-- The uniformity agrees with the topology: the neighborhoods filter of each point `x`\n  is equal to `Filter.comap (Prod.mk x) (𝓤 α)`. -/\n  protected nhds_eq_comap_uniformity (x : α) : 𝓝 x = comap (Prod.mk x) uniformity","start":364,"end":380},"axioms":["Quot.sound","propext"]}