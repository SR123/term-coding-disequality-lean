.Meta.Match.MatcherInfo","unsafe":false,"value":97,"source":{"code":"def getMatcherInfo? (env : Environment) (declName : Name) : Option MatcherInfo := do\n  -- avoid blocking on async decls whose names look nothing like matchers\n  let .str _ s := declName.eraseMacroScopes | none\n  guard <| s.startsWith \"match_\"\n  (extension.getState (asyncDecl := declName) env).map.find? declName","start":99,"end":103},"axioms":["Classical.choice","Quot.sound","propext"]}