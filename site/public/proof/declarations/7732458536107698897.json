ange":{"column":0,"endColumn":38,"endLine":51,"line":47},"type":19,"typeText":"{α : Type u_1} →\n  {β : Type u_2} → [Fintype.{u_1} α] → (f : α → β) → Function.Bijective.{u_1 + 1, u_2 + 1} f → Fintype.{u_2} β","unsafe":false,"value":53,"source":{"code":"/-- If `f : α → β` is a bijection and `α` is a fintype, then `β` is also a fintype. -/\ndef ofBijective [Fintype α] (f : α → β) (H : Function.Bijective f) : Fintype β :=\n  ⟨univ.map ⟨f, H.1⟩, fun b =>\n    let ⟨_, e⟩ := H.2 b\n    e ▸ mem_map_of_mem _ (mem_univ _)⟩","start":47,"end":51},"axioms":["Quot.sound","propext"]}