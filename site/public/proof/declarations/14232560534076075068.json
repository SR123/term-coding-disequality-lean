cted theorem Periodic.zsmul [AddGroup α] (h : Periodic f c) (n : ℤ) : Periodic f (n • c) := by\n  rcases n with n | n\n  · simpa only [Int.ofNat_eq_natCast, natCast_zsmul] using h.nsmul n\n  · simpa only [negSucc_zsmul] using (h.nsmul (n + 1)).neg","start":155,"end":158},"axioms":["Quot.sound","propext"]}