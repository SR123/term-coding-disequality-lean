v2 n.div2]\n    simp only [ofNatCode.eq_5]\n    cases n.bodd <;> cases n.div2.bodd <;>\n      simp [m, encodeCode, IH, IH1, IH2, Nat.bit_val]","start":153,"end":174},"axioms":["Classical.choice","Quot.sound","propext"]}