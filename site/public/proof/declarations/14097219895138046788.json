0,836,"implicit"]],"project":false,"range":{"column":0,"endColumn":24,"endLine":1620,"line":1602},"type":50,"typeText":"∀ {a b : Nat},\n  Iff (Eq.{1} (HMod.hMod.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} a 1) (HAdd.hAdd.{0, 0, 0} b 1)) 0)\n    (Eq.{1} (HMod.hMod.{0, 0, 0} a (HAdd.hAdd.{0, 0, 0} b 1)) b)","unsafe":false,"value":837,"source":{"code":"theorem succ_mod_succ_eq_zero_iff {a b : Nat} :\n    (a + 1) % (b + 1) = 0 ↔ a % (b + 1) = b := by\n  symm\n  rw [mod_eq_iff, mod_eq_iff]\n  simp only [add_one_ne_zero, false_and, Nat.lt_add_one, true_and, false_or, and_self, zero_lt_succ,\n    Nat.add_zero]\n  constructor\n  · rintro ⟨k, rfl⟩\n    refine ⟨k + 1, ?_⟩\n    simp [Nat.add_mul, Nat.mul_add, Nat.add_assoc]\n  · rintro ⟨k, h⟩\n    cases k with\n    | zero => simp at h\n    | succ k =>\n      refine ⟨k, ?_⟩\n      simp only [Nat.mul_add, Nat.add_mul, Nat.one_mul, Nat.mul_one, ← Nat.add_assoc,\n        Nat.add_right_cancel_iff] at h\n      subst h\n      simp [Nat.add_mul]","start":1602,"end":1620},"axioms":["propext"]}