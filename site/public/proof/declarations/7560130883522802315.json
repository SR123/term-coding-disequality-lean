:55,"endLine":1112,"line":1102},"type":45,"typeText":"∀ {α : Type u_1} [inst : Lean.Grind.Ring.{u_1} α] (ctx : Lean.Grind.CommRing.Context.{u_1} α)\n  (p₁ p₂ : Lean.Grind.CommRing.Poly),\n  Eq.{u_1 + 1} (Lean.Grind.CommRing.Poly.denote.{u_1} ctx (Lean.Grind.CommRing.Poly.combine p₁ p₂))\n    (HAdd.hAdd.{u_1, u_1, u_1} (Lean.Grind.CommRing.Poly.denote.{u_1} ctx p₁)\n      (Lean.Grind.CommRing.Poly.denote.{u_1} ctx p₂))","unsafe":false,"value":1572,"source":{"code":"theorem Poly.denote_combine {α} [Ring α] (ctx : Context α) (p₁ p₂ : Poly)\n    : (combine p₁ p₂).denote ctx = p₁.denote ctx + p₂.denote ctx := by\n  unfold combine; generalize hugeFuel = fuel\n  fun_induction combine.go\n    <;> simp [*, denote_concat, denote_addConst, denote, intCast_add, add_comm, add_left_comm, add_assoc, zsmul_eq_intCast_mul]\n  case case5 hg _ h _ =>\n    simp +zetaDelta at h\n    rw [← add_assoc, Mon.eq_of_grevlex hg, ← right_distrib, ← intCast_add, h, intCast_zero, zero_mul, zero_add]\n  case case6 hg k h _ =>\n    simp +zetaDelta [intCast_add]\n    rw [right_distrib, Mon.eq_of_grevlex hg, add_assoc]","start":1102,"end":1112},"axioms":["Quot.sound","propext"]}