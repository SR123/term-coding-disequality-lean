sequalityDispersion.Machine.LInv bs l A n j p m) → motive t","unsafe":false,"value":null,"source":{"code":"/-- State of the list loop: array at `A` with `n` slots, `j` filled, cursor `p`. -/\nstructure LInv (bs : List Bool) (l : ℕ) (A n j p : ℕ) (m : Mem) : Prop where\n  st : PState m bs\n  a : m (A_ l) = A\n  nel : m (NEL l) = n\n  jj : m (JJ l) = j\n  pos : m POS = p\n  hpN : p ≤ bs.length\n  ok : m OK = 1\n  cc : m (CC l) = if j < n then 1 else 0\n  hj : j ≤ n\n  region : A + 1 + n ≤ m HP\n  hA : IN + 1 + bs.length ≤ A","start":235,"end":247,"lines":[[{"text":"/-- State of the list loop: array at `A` with `n` slots, `j` filled, cursor `p`. -/"}],[{"text":"structure LInv (bs : List Bool) (l : ℕ) (A n j p : ℕ) (m : Mem) : Prop where"}],[{"text":"  st : PState m bs"}],[{"text":"  a : m (A_ l) = A"}],[{"text":"  nel : m (NEL l) = n"}],[{"text":"  jj : m (JJ l) = j"}],[{"text":"  pos : m POS = p"}],[{"text":"  hpN : p ≤ bs.length"}],[{"text":"  ok : m OK = 1"}],[{"text":"  cc : m (CC l) = if j < n then 1 else 0"}],[{"text":"  hj : j ≤ n"}],[{"text":"  region : A + 1 + n ≤ m HP"}],[{"text":"  hA : IN + 1 + bs.length ≤ A"}]]},"steps":[],"stepGoalPool":[],"references":[],"axioms":[]}