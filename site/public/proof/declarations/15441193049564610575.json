d.Data.DHashMap.Internal.Defs.4132535615._hygCtx._hyg.13",6,253,"instance"],["lambda","β",3,254,"implicit"],["lambda","α",0,255,"implicit"]],"project":false,"range":{"column":0,"endColumn":25,"endLine":422,"line":413},"type":23,"typeText":"{α : Type u} →\n  {β : α → Type v} →\n    [BEq.{u} α] →\n      [Hashable.{u + 1} α] → Std.DHashMap.Internal.Raw₀.{u, v} α β → α → Std.DHashMap.Internal.Raw₀.{u, v} α β","unsafe":false,"value":256,"source":{"code":"/-- Internal implementation detail of the hash map -/\ndef erase [BEq α] [Hashable α] (m : Raw₀ α β) (a : α) : Raw₀ α β :=\n  let ⟨⟨size, buckets⟩, hb⟩ := m\n  let ⟨i, h⟩ := mkIdx buckets.size hb (hash a)\n  let bkt := buckets[i]\n  if bkt.contains a then\n    let buckets' := buckets.uset i .nil h\n    ⟨⟨size - 1, buckets'.uset i (bkt.erase a) (by simpa [buckets'])⟩, by simpa [buckets']⟩\n  else\n    ⟨⟨size, buckets⟩, hb⟩","start":413,"end":422},"axioms":["Quot.sound","propext"]}