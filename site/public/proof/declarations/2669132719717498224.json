ypeText":"∀ (x y : Nat),\n  Eq.{1} (Nat.modCore x y) (ite.{1} (And (LT.lt.{0} 0 y) (LE.le.{0} y x)) (Nat.modCore (HSub.hSub.{0, 0, 0} x y) y) x)","unsafe":false,"value":544,"source":{"code":"protected theorem modCore_eq (x y : Nat) : Nat.modCore x y =\n  if 0 < y ∧ y ≤ x then\n    Nat.modCore (x - y) y\n  else\n    x := by\n  unfold Nat.modCore\n  split\n  next =>\n    rw [Nat.modCore.go]\n    split\n    next =>\n      simp only [and_self, ↓reduceIte, *]\n      apply modCore.go.fuel_congr\n    next =>\n      simp only [and_false, ↓reduceIte, *]\n  next =>\n    simp only [false_and, ↓reduceIte, *]","start":126,"end":142},"axioms":["propext"]}