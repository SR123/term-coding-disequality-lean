],["apply",62,23],["apply",63,10],["apply",64,7],["apply",65,13],["apply",66,16],["apply",3,67],["forall","comap_uniformity",60,68,"explicit"],["apply",9,38],["apply",70,23],["apply",71,10],["apply",72,7],["apply",73,13],["apply",13,16],["forall","t",74,75,"explicit"],["forall","mk",69,76,"explicit"],["forall","motive",19,77,"implicit"],["forall","f",8,78,"implicit"],["forall","inst._@.Mathlib.Topology.UniformSpace.UniformEmbedding.4282810528._hygCtx._hyg.23",6,79,"instance"],["forall","inst._@.Mathlib.Topology.UniformSpace.UniformEmbedding.4282810528._hygCtx._hyg.20",4,80,"instance"],["forall","β",1,81,"implicit"],["forall","α",0,82,"implicit"],["apply",22,38],["apply",84,38],["apply",21,85],["apply",20,86],["apply",28,85],["apply",30,23],["apply",89,23],["apply",88,90],["apply",34,38],["apply",92,38],["bound",7],["apply",37,94],["apply",95,94],["apply",96,16],["apply",7,97],["apply",93,98],["apply",44,94],["apply",100,94],["apply",101,16],["apply",7,102],["apply",99,103],["lambda","x",85,104,"explicit"],["apply",91,105],["apply",52,23],["apply",107,7],["apply",106,108],["apply",87,109],["apply",57,38],["apply",111,10],["apply",110,112],["apply",3,16],["lambda","comap_uniformity",113,114,"explicit"],["lambda","mk",69,115,"explicit"],["lambda","motive",19,116,"explicit"],["lambda","f",8,117,"explicit"],["lambda","inst._@.Mathlib.Topology.UniformSpace.UniformEmbedding.4282810528._hygCtx._hyg.23",6,118,"instance"],["lambda","inst._@.Mathlib.Topology.UniformSpace.UniformEmbedding.4282810528._hygCtx._hyg.20",4,119,"instance"],["lambda","β",1,120,"implicit"],["lambda","α",0,121,"implicit"]],"project":false,"range":{"column":0,"endColumn":72,"endLine":41,"line":34},"type":83,"typeText":"{α : Type u} →\n  {β : Type v} →\n    [inst : UniformSpace.{u} α] →\n      [inst_1 : UniformSpace.{v} β] →\n        {f : α → β} →\n          {motive : IsUniformInducing.{u, v} f → Sort u_1} →\n            ((comap_uniformity :\n                  Eq.{u + 1} (Filter.comap.{u, v} (fun x => Prod.mk.{v, v} (f x.1) (f x.2)) (uniformity.{v} β))\n                    (uniformity.{u} α)) →\n                motive ⋯) →\n              (t : IsUniformInducing.{u, v} f) → motive t","unsafe":false,"value":null,"source":{"code":"/-- A map `f : α → β` between uniform spaces is called *uniform inducing* if the uniformity filter\non `α` is the pullback of the uniformity filter on `β` under `Prod.map f f`. If `α` is a separated\nspace, then this implies that `f` is injective, hence it is a `IsUniformEmbedding`. -/\n@[mk_iff]\nstructure IsUniformInducing (f : α → β) : Prop where\n  /-- The uniformity filter on the domain is the pullback of the uniformity filter on the codomain\n  under `Prod.map f f`. -/\n  comap_uniformity : comap (fun x : α × α => (f x.1, f x.2)) (𝓤 β) = 𝓤 α","start":34,"end":41},"axioms":["Quot.sound","propext"]}