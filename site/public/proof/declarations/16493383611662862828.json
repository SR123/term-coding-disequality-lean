q",0,72,"implicit"],["lambda","p",0,73,"implicit"]],"project":false,"range":{"column":0,"endColumn":57,"endLine":1160,"line":1149},"type":13,"typeText":"{p q : Prop} → [Decidable p] → [Decidable q] → Decidable (Iff p q)","unsafe":false,"value":74,"source":{"code":"@[inline]\ninstance {p q} [Decidable p] [Decidable q] : Decidable (p ↔ q) :=\n  if hp : p then\n    if hq : q then\n      isTrue ⟨fun _ => hq, fun _ => hp⟩\n    else\n      isFalse fun h => hq (h.1 hp)\n  else\n    if hq : q then\n      isFalse fun h => hp (h.2 hq)\n    else\n      isTrue ⟨fun h => absurd h hp, fun h => absurd h hq⟩","start":1149,"end":1160},"axioms":[]}