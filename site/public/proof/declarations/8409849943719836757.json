Class.{u_2} N] →\n        {S : Type u_5} →\n          [inst_2 : SetLike.{u_5, u_2} S N] →\n            [inst_3 : SubmonoidClass.{u_5, u_2} S N] →\n              (f : MonoidHom.{u_1, u_2} M N) →\n                (s : S) → (∀ (x : M), Membership.mem.{u_2, u_5} s (f x)) → MonoidHom.{u_1, u_2} M ↥s","unsafe":false,"value":189,"source":{"code":"/-- Restriction of a monoid hom to a submonoid of the codomain. -/\n@[to_additive (attr := simps apply)\n  /-- Restriction of an `AddMonoid` hom to an `AddSubmonoid` of the codomain. -/]\ndef codRestrict {S} [SetLike S N] [SubmonoidClass S N] (f : M →* N) (s : S) (h : ∀ x, f x ∈ s) :\n    M →* s where\n  toFun n := ⟨f n, h n⟩\n  map_one' := Subtype.ext f.map_one\n  map_mul' x y := Subtype.ext (f.map_mul x y)","start":725,"end":732},"axioms":[]}