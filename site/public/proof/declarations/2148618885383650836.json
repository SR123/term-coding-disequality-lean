implicit"],["lambda","s",0,623,"implicit"]],"project":false,"range":{"column":0,"endColumn":35,"endLine":301,"line":289},"type":30,"typeText":"∀ {s : Lean.Omega.Constraint} {x v : Lean.Omega.Coeffs},\n  Eq.{1} (Lean.Omega.Constraint.sat' s x v) Bool.true →\n    Eq.{1} (Lean.Omega.Constraint.sat' (Lean.Omega.normalizeConstraint s x) (Lean.Omega.normalizeCoeffs s x) v)\n      Bool.true","unsafe":false,"value":624,"source":{"code":"theorem normalize_sat {s x v} (w : s.sat' x v) :\n    (normalizeConstraint s x).sat' (normalizeCoeffs s x) v := by\n  dsimp [normalizeConstraint, normalizeCoeffs, normalize, normalize?]\n  split <;> rename_i h\n  · split\n    · simp\n    · dsimp [Constraint.sat'] at w\n      simp only [IntList.gcd_eq_zero] at h\n      simp only [IntList.dot_eq_zero_of_left_eq_zero h] at w\n      simp_all\n  · split\n    · exact w\n    · exact Constraint.div_sat' h w","start":289,"end":301},"axioms":["Quot.sound","propext"]}