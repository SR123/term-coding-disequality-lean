licit"]],"project":false,"range":{"column":0,"endColumn":65,"endLine":262,"line":254},"type":62,"typeText":"∀ {α : Type u_1} {β : Type v} {s : Multiset.{u_1} α} {f : α → Multiset.{v} β},\n  Iff (Multiset.Nodup.{v} (Multiset.bind.{v, u_1} s f))\n    (And (∀ (a : α), Membership.mem.{u_1, u_1} s a → Multiset.Nodup.{v} (f a))\n      (Multiset.Pairwise.{u_1} (Function.onFun.{u_1 + 1, v + 1, 1} Disjoint.{v} f) s))","unsafe":false,"value":632,"source":{"code":"@[simp] lemma nodup_bind :\n    Nodup (bind s f) ↔ (∀ a ∈ s, Nodup (f a)) ∧ s.Pairwise (Disjoint on f) := by\n  have : ∀ a, ∃ l : List β, f a = l := fun a => Quot.induction_on (f a) fun l => ⟨l, rfl⟩\n  choose f' h' using this\n  have : f = fun a ↦ ofList (f' a) := funext h'\n  have hd : Symmetric fun a b ↦ List.Disjoint (f' a) (f' b) := fun a b h ↦ h.symm\n  exact Quot.induction_on s <| by\n    unfold Function.onFun\n    simp [this, List.nodup_flatMap, pairwise_coe_iff_pairwise hd]","start":254,"end":262},"axioms":["Classical.choice","Quot.sound","propext"]}