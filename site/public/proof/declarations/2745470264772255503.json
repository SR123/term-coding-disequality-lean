30,516],["apply",1185,1231],["apply",1232,575],["apply",1172,1233],["lambda","ih",948,1234,"explicit"],["lambda","i",302,1235,"explicit"],["apply",954,1236],["lambda","right._@.Mathlib.Data.Real.Archimedean.917145263._hygCtx._hyg.312",941,1237,"explicit"],["lambda","ε0",377,1238,"explicit"],["apply",932,1239],["lambda","h._@.Mathlib.Data.Real.Archimedean.917145263._hygCtx._hyg.311",911,1240,"explicit"],["lambda","ε",1,1241,"explicit"],["apply",918,1242],["lambda","h",246,1243,"explicit"],["apply",901,1244],["apply",232,1245],["let","ub",204,219,1246,true],["let","ub'",125,199,1247,true],["let","lb",101,107,1248,true],["let","s",59,91,1249,false],["lambda","f",18,1250,"explicit"]],"project":false,"range":{"column":0,"endColumn":17,"endLine":324,"line":308},"type":57,"typeText":"∀ (f : CauSeq.{0, 0} Real abs.{0}), ∃ x, HasEquiv.Equiv.{1, 0} f (CauSeq.const.{0, 0} abs.{0} x)","unsafe":false,"value":1251,"source":{"code":"theorem cauSeq_converges (f : CauSeq ℝ abs) : ∃ x, f ≈ const abs x := by\n  let s := {x : ℝ | const abs x < f}\n  have lb : ∃ x, x ∈ s := exists_lt f\n  have ub' : ∀ x, f < const abs x → ∀ y ∈ s, y ≤ x := fun x h y yS =>\n    le_of_lt <| const_lt.1 <| CauSeq.lt_trans yS h\n  have ub : ∃ x, ∀ y ∈ s, y ≤ x := (exists_gt f).imp ub'\n  refine ⟨sSup s, ((lt_total _ _).resolve_left fun h => ?_).resolve_right fun h => ?_⟩\n  · rcases h with ⟨ε, ε0, i, ih⟩\n    refine (csSup_le lb (ub' _ ?_)).not_gt (sub_lt_self _ (half_pos ε0))\n    refine ⟨_, half_pos ε0, i, fun j ij => ?_⟩\n    rw [sub_apply, const_apply, sub_right_comm, le_sub_iff_add_le, add_halves]\n    exact ih _ ij\n  · rcases h with ⟨ε, ε0, i, ih⟩\n    refine (le_csSup ub ?_).not_gt ((lt_add_iff_pos_left _).2 (half_pos ε0))\n    refine ⟨_, half_pos ε0, i, fun j ij => ?_⟩\n    rw [sub_apply, const_apply, add_comm, ← sub_sub, le_sub_iff_add_le, add_halves]\n    exact ih _ ij","start":308,"end":324},"axioms":["Classical.choice","Quot.sound","propext"]}