l",81,126,"explicit"],["lambda","one",45,127,"explicit"],["lambda","hf",17,128,"explicit"],["lambda","f",11,129,"explicit"],["lambda","inst._@.Mathlib.Algebra.Group.InjSurj.4120732671._hygCtx._hyg.10",9,130,"instance"],["lambda","inst._@.Mathlib.Algebra.Group.InjSurj.4120732671._hygCtx._hyg.7",7,131,"instance"],["lambda","inst._@.Mathlib.Algebra.Group.InjSurj.4120732671._hygCtx._hyg.4",4,132,"instance"],["lambda","M₂",1,133,"implicit"],["lambda","M₁",0,134,"implicit"]],"project":false,"range":{"column":0,"endColumn":57,"endLine":128,"line":119},"type":92,"typeText":"{M₁ : Type u_1} →\n  {M₂ : Type u_2} →\n    [inst : Mul.{u_1} M₁] →\n      [inst_1 : One.{u_1} M₁] →\n        [inst_2 : MulOneClass.{u_2} M₂] →\n          (f : M₁ → M₂) →\n            Function.Injective.{u_1 + 1, u_2 + 1} f →\n              Eq.{u_2 + 1} (f 1) 1 →\n                (∀ (x y : M₁),\n                    Eq.{u_2 + 1} (f (HMul.hMul.{u_1, u_1, u_1} x y)) (HMul.hMul.{u_2, u_2, u_2} (f x) (f y))) →\n                  MulOneClass.{u_1} M₁","unsafe":false,"value":135,"source":{"code":"/-- A type endowed with `1` and `*` is a `MulOneClass`, if it admits an injective map that\npreserves `1` and `*` to a `MulOneClass`.  See note [reducible non-instances]. -/\n@[to_additive\n/-- A type endowed with `0` and `+` is an `AddZeroClass`, if it admits an\ninjective map that preserves `0` and `+` to an `AddZeroClass`. -/]\nprotected abbrev mulOneClass [MulOneClass M₂] (f : M₁ → M₂) (hf : Injective f) (one : f 1 = 1)\n    (mul : ∀ x y, f (x * y) = f x * f y) : MulOneClass M₁ :=\n  { ‹One M₁›, ‹Mul M₁› with\n    one_mul := fun x => hf <| by rw [mul, one, one_mul],\n    mul_one := fun x => hf <| by rw [mul, one, mul_one] }","start":119,"end":128},"axioms":[]}