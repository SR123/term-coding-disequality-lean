n    · simpa [LawfulUpwardEnumerableLT.lt_iff] using hu\n  · intro hu\n    obtain ⟨init, hi, hia⟩ := LawfulUpwardEnumerableLeast?.least?_le a\n    simpa [iter, hi] using ⟨hia, hu⟩","start":632,"end":646},"axioms":["Classical.choice","Quot.sound","propext"]}