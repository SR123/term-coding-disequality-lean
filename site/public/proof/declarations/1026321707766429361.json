⟨y :: _, .rfl, (s.cons₂ _).cons _⟩\n    | .cons₂ _ (.cons₂ _ s) => exact ⟨x :: y :: _, .swap .., (s.cons₂ _).cons₂ _⟩\n  | trans _ _ IH₁ IH₂ =>\n    let ⟨_, pm, sm⟩ := IH₁ s\n    let ⟨r₁, pr, sr⟩ := IH₂ sm\n    exact ⟨r₁, pr.trans pm, sr⟩","start":243,"end":260},"axioms":[]}