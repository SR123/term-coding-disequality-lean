 x)) - exp x‖ := by nth_rw 1 [hy_eq]\n    _ ≤ ‖y - x‖ * ‖exp x‖ + ‖exp x‖ * ‖y - x‖ ^ 2 := h_sq (y - x) (hyx.le.trans hr_le)\n    _ ≤ ‖y - x‖ * ‖exp x‖ + ‖exp x‖ * (r * ‖y - x‖) := by grw [hyx_sq_le]\n    _ = (1 + r) * ‖exp x‖ * ‖y - x‖ := by ring","start":47,"end":62},"axioms":["Classical.choice","Quot.sound","propext"]}