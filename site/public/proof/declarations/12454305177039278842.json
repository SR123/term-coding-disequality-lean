78,1280],["apply",1178,691],["apply",1281,1282],["apply",1273,1283],["apply",1270,1284],["lambda","y",1,1285,"explicit"],["apply",1264,1286],["apply",1129,1287],["lambda","e",1205,1288,"explicit"],["lambda","k",1,1289,"explicit"],["apply",1211,1290],["lambda","h._@.Mathlib.Computability.Halting.3640257766._hygCtx._hyg.359",1196,1291,"explicit"],["lambda","x",1,1292,"explicit"],["apply",1202,1293],["lambda","h._@.Mathlib.Computability.Halting.3640257766._hygCtx._hyg.357",937,1294,"explicit"],["apply",1191,1295],["apply",922,1296],["lambda","h",828,1297,"explicit"],["apply",896,1298],["apply",831,1299],["let","this",467,810,1300,true],["lambda","n",1,1301,"explicit"],["apply",482,1302],["apply",440,1303],["let","this",223,416,1304,true],["lambda","hg",138,1305,"explicit"],["apply",194,1306],["apply",1307,26],["apply",1308,10],["apply",1309,45],["lambda","h._@.Mathlib.Computability.Halting.3640257766._hygCtx._hyg.96",139,1310,"explicit"],["lambda","cg",64,1311,"explicit"],["apply",171,1312],["lambda","hf",138,1313,"explicit"],["apply",137,1314],["apply",1315,45],["apply",1316,10],["apply",1317,98],["lambda","h._@.Mathlib.Computability.Halting.3640257766._hygCtx._hyg.91",71,1318,"explicit"],["lambda","cf",64,1319,"explicit"],["apply",106,1320],["lambda","hg",6,1321,"explicit"],["lambda","hf",6,1322,"explicit"],["lambda","g",3,1323,"implicit"],["lambda","f",3,1324,"implicit"]],"project":false,"range":{"column":0,"endColumn":91,"endLine":65,"line":33},"type":62,"typeText":"∀ {f g : PFun.{0, 0} Nat Nat},\n  Nat.Partrec f →\n    Nat.Partrec g →\n      ∃ h,\n        And (Nat.Partrec h)\n          (∀ (a : Nat),\n            And\n              (∀ (x : Nat),\n                Membership.mem.{0, 0} (h a) x → Or (Membership.mem.{0, 0} (f a) x) (Membership.mem.{0, 0} (g a) x))\n              (Iff (Part.Dom.{0} (h a)) (Or (Part.Dom.{0} (f a)) (Part.Dom.{0} (g a)))))","unsafe":false,"value":1325,"source":{"code":"theorem merge' {f g} (hf : Nat.Partrec f) (hg : Nat.Partrec g) :\n    ∃ h, Nat.Partrec h ∧\n      ∀ a, (∀ x ∈ h a, x ∈ f a ∨ x ∈ g a) ∧ ((h a).Dom ↔ (f a).Dom ∨ (g a).Dom) := by\n  obtain ⟨cf, rfl⟩ := Code.exists_code.1 hf\n  obtain ⟨cg, rfl⟩ := Code.exists_code.1 hg\n  have : Nat.Partrec fun n => Nat.rfindOpt fun k => cf.evaln k n <|> cg.evaln k n :=\n    Partrec.nat_iff.1\n      (Partrec.rfindOpt <|\n        Primrec.option_orElse.to_comp.comp\n          (Code.primrec_evaln.to_comp.comp <| (snd.pair (const cf)).pair fst)\n          (Code.primrec_evaln.to_comp.comp <| (snd.pair (const cg)).pair fst))\n  refine ⟨_, this, fun n => ?_⟩\n  have : ∀ x ∈ rfindOpt fun k ↦ HOrElse.hOrElse (Code.evaln k cf n) fun _x ↦ Code.evaln k cg n,\n      x ∈ Code.eval cf n ∨ x ∈ Code.eval cg n := by\n    intro x h\n    obtain ⟨k, e⟩ := Nat.rfindOpt_spec h\n    revert e\n    simp only [Option.mem_def]\n    rcases e' : cf.evaln k n with - | y <;> simp <;> intro e\n    · exact Or.inr (Code.evaln_sound e)\n    · subst y\n      exact Or.inl (Code.evaln_sound e')\n  refine ⟨this, ⟨fun h => (this _ ⟨h, rfl⟩).imp Exists.fst Exists.fst, ?_⟩⟩\n  intro h\n  rw [Nat.rfindOpt_dom]\n  simp only [dom_iff_mem, Code.evaln_complete, Option.mem_def] at h\n  obtain ⟨x, k, e⟩ | ⟨x, k, e⟩ := h\n  · refine ⟨k, x, ?_⟩\n    simp only [e, Option.orElse_some, Option.mem_def, Option.orElse_eq_orElse]\n  · refine ⟨k, ?_⟩\n    rcases cf.evaln k n with - | y\n    · exact ⟨x, by simp only [e, Option.mem_def, Option.orElse_eq_orElse, Option.orElse_none]⟩\n    · exact ⟨y, by simp only [Option.orElse_eq_orElse, Option.orElse_some, Option.mem_def]⟩","start":33,"end":65},"axioms":["Classical.choice","Quot.sound","propext"]}