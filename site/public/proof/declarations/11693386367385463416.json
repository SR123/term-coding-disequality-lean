775,"explicit"],["apply",202,776],["apply",777,14],["lambda","f",93,778,"explicit"],["lambda","p",3,779,"explicit"],["apply",72,780],["lambda","p",3,781,"explicit"],["lambda","v",2,782,"explicit"],["lambda","k",1,783,"explicit"],["lambda","ctx",0,784,"explicit"]],"project":false,"range":{"column":0,"endColumn":28,"endLine":224,"line":213},"type":48,"typeText":"∀ (ctx : Nat.Linear.Context) (k : Nat) (v : Nat.Linear.Var) (p : Nat.Linear.Poly),\n  Eq.{1} (Nat.Linear.Poly.denote ctx (Nat.Linear.Poly.insert k v p))\n    (HAdd.hAdd.{0, 0, 0} (Nat.Linear.Poly.denote ctx p) (HMul.hMul.{0, 0, 0} k (Nat.Linear.Var.denote ctx v)))","unsafe":false,"value":785,"source":{"code":"theorem Poly.denote_insert (ctx : Context) (k : Nat) (v : Var) (p : Poly) :\n    (p.insert k v).denote ctx = p.denote ctx + k * v.denote ctx := by\n  match p with\n  | [] => simp\n  | (k', v') :: p =>\n    by_cases h₁ : Nat.blt v v'\n    · simp [h₁]\n    · by_cases h₂ : Nat.beq v v'\n      · simp only [insert, h₁, h₂, cond_false, cond_true]\n        simp [Nat.eq_of_beq_eq_true h₂]\n      · simp only [insert, h₁, h₂, cond_false]\n        simp [denote_insert]","start":213,"end":224},"axioms":["propext"]}