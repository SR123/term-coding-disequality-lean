":{"column":0,"endColumn":70,"endLine":179,"line":177},"type":104,"typeText":"∀ {X : Type u} [inst : TopologicalSpace.{u} X] {α : Type u_1} (x : X) (f : Set.{u} X → Set.{u_1} α),\n  (∀ (s t : Set.{u} X), HasSubset.Subset.{u} s t → HasSubset.Subset.{u_1} (f s) (f t)) →\n    ∀ (l : Filter.{u_1} α),\n      Iff (∀ (s : Set.{u} X), Membership.mem.{u, u} (nhds.{u} x) s → Membership.mem.{u_1, u_1} l (f s))\n        (∀ (s : Set.{u} X), IsOpen.{u} s → Membership.mem.{u, u} s x → Membership.mem.{u_1, u_1} l (f s))","unsafe":false,"value":147,"source":{"code":"theorem all_mem_nhds_filter (x : X) (f : Set X → Set α) (hf : ∀ s t, s ⊆ t → f s ⊆ f t)\n    (l : Filter α) : (∀ s ∈ 𝓝 x, f s ∈ l) ↔ ∀ s, IsOpen s → x ∈ s → f s ∈ l :=\n  all_mem_nhds _ _ fun s t ssubt h => mem_of_superset h (hf s t ssubt)","start":177,"end":179},"axioms":["Quot.sound","propext"]}