cit"],["lambda","P",4,124,"explicit"],["lambda","β",1,125,"implicit"],["lambda","α",0,126,"implicit"]],"project":false,"range":{"column":0,"endColumn":25,"endLine":807,"line":800},"type":46,"typeText":"{α : Sort u_1} →\n  {β : Sort u_4} →\n    (P : α → Sort u_9) →\n      (e : Equiv.{u_1, u_4} α β) →\n        Equiv.{imax u_1 u_9, imax u_4 u_9} ((a : α) → P a) ((b : β) → P ((Equiv.symm.{u_1, u_4} e) b))","unsafe":false,"value":127,"source":{"code":"/-- Transport dependent functions through an equivalence of the base space.\n-/\n@[simps apply, simps -isSimp symm_apply]\ndef piCongrLeft' (P : α → Sort*) (e : α ≃ β) : (∀ a, P a) ≃ ∀ b, P (e.symm b) where\n  toFun f x := f (e.symm x)\n  invFun f x := (e.symm_apply_apply x).ndrec (f (e x))\n  left_inv f := by grind\n  right_inv f := by grind","start":800,"end":807},"axioms":["Classical.choice","Quot.sound","propext"]}