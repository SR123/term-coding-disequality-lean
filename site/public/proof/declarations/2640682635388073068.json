j",1,241,"explicit"],["apply",73,242],["apply",243,9],["apply",244,11],["lambda","h",27,245,"explicit"],["lambda","L",2,246,"explicit"]],"project":false,"range":{"column":0,"endColumn":90,"endLine":519,"line":512},"type":50,"typeText":"∀ (L : List.{0} Nat),\n  (∀ (i : Nat), Membership.mem.{0, 0} L i → LE.le.{0} 1 i) → LE.le.{0} (List.length.{0} L) (List.sum.{0} L)","unsafe":false,"value":247,"source":{"code":"/-- If all elements in a list are bounded below by `1`, then the length of the list is bounded\nby the sum of the elements. -/\ntheorem length_le_sum_of_one_le (L : List ℕ) (h : ∀ i ∈ L, 1 ≤ i) : L.length ≤ L.sum := by\n  induction L with\n  | nil => simp\n  | cons j L IH =>\n    rw [sum_cons, length, add_comm]\n    exact Nat.add_le_add (h _ mem_cons_self) (IH fun i hi => h i (mem_cons.2 (Or.inr hi)))","start":512,"end":519},"axioms":["propext"]}