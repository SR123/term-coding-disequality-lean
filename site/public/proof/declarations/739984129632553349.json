e":"theorem le_of_mul_le_mul_left {a b c : Int} (w : a * b ≤ a * c) (h : 0 < a) : b ≤ c := by\n  have w := Int.sub_nonneg_of_le w\n  rw [← Int.mul_sub] at w\n  have w := Int.ediv_nonneg w (Int.le_of_lt h)\n  rw [Int.mul_ediv_cancel_left _ (Int.ne_of_gt h)] at w\n  exact Int.le_of_sub_nonneg w","start":1092,"end":1097},"axioms":["propext"]}