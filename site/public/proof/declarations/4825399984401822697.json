,0,62,"implicit"]],"project":false,"range":{"column":0,"endColumn":100,"endLine":573,"line":567},"type":10,"typeText":"{α : Type u} → α → Filter.{u} α → TopologicalSpace.{u} α","unsafe":false,"value":63,"source":{"code":"/-- This construction is left adjoint to the operation sending a topology on `α`\n  to its neighborhood filter at a fixed point `a : α`. -/\ndef nhdsAdjoint (a : α) (f : Filter α) : TopologicalSpace α where\n  IsOpen s := a ∈ s → s ∈ f\n  isOpen_univ _ := univ_mem\n  isOpen_inter := fun _s _t hs ht ⟨has, hat⟩ => inter_mem (hs has) (ht hat)\n  isOpen_sUnion := fun _k hk ⟨u, hu, hau⟩ => mem_of_superset (hk u hu hau) (subset_sUnion_of_mem hu)","start":567,"end":573},"axioms":["Classical.choice","Quot.sound","propext"]}