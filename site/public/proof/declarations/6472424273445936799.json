ambda","α",0,224,"implicit"]],"project":false,"range":{"column":0,"endColumn":97,"endLine":318,"line":315},"type":56,"typeText":"∀ {α : Type u} {β : Type v} {l : α → β} {u : β → α} [inst : Preorder.{u} α] [inst_1 : Preorder.{v} β]\n  (gi : GaloisInsertion.{u, v} l u) {s : Set.{v} β} {a : α}, IsGLB.{u} (Set.image.{v, u} u s) a → IsGLB.{v} s (l a)","unsafe":false,"value":225,"source":{"code":"theorem isGLB_of_u_image [Preorder α] [Preorder β] (gi : GaloisInsertion l u) {s : Set β} {a : α}\n    (hs : IsGLB (u '' s) a) : IsGLB s (l a) :=\n  ⟨fun _ hx => gi.gc.l_le <| hs.1 <| mem_image_of_mem _ hx, fun x hx =>\n    (gi.le_l_u x).trans <| gi.gc.monotone_l <| hs.2 <| gi.gc.monotone_u.mem_lowerBounds_image hx⟩","start":315,"end":318},"axioms":["Quot.sound","propext"]}