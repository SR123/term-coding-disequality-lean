Setoid._@.Mathlib.GroupTheory.QuotientGroup.Defs.1658552293._hygCtx._hyg.26",37,41,62,false],["lambda","nN",12,63,"instance"],["lambda","N",7,64,"explicit"],["lambda","inst._@.Mathlib.GroupTheory.QuotientGroup.Defs.1658552293._hygCtx._hyg.6",3,65,"instance"],["lambda","G",0,66,"implicit"]],"project":false,"range":{"column":0,"endColumn":63,"endLine":69,"line":59},"type":35,"typeText":"{G : Type u_1} → [inst : Group.{u_1} G] → (N : Subgroup.{u_1} G) → [nN : Subgroup.Normal.{u_1} N] → Con.{u_1} G","unsafe":false,"value":67,"source":{"code":"/-- The congruence relation generated by a normal subgroup. -/\n@[to_additive /-- The additive congruence relation generated by a normal additive subgroup. -/]\nprotected def con : Con G where\n  toSetoid := leftRel N\n  mul' := fun {a b c d} hab hcd => by\n    rw [leftRel_eq] at hab hcd ⊢\n    dsimp only\n    calc\n      c⁻¹ * (a⁻¹ * b) * c⁻¹⁻¹ * (c⁻¹ * d) ∈ N := N.mul_mem (nN.conj_mem _ hab _) hcd\n      _ = (a * c)⁻¹ * (b * d) := by\n        simp only [mul_inv_rev, mul_assoc, inv_mul_cancel_left]","start":59,"end":69},"axioms":["Quot.sound","propext"]}