,9],["apply",68,3],["apply",65,69],["constant","Filter.instInf._proof_2",[["param","u_1"]]],["apply",71,12],["apply",72,9],["apply",73,3],["apply",70,74],["constant","Filter.instInf._proof_3",[["param","u_1"]]],["apply",76,12],["apply",77,9],["apply",78,3],["apply",75,79],["lambda","g",10,80,"explicit"],["lambda","f",4,81,"explicit"],["apply",8,82],["lambda","α",0,83,"implicit"]],"project":false,"range":{"column":0,"endColumn":17,"endLine":237,"line":223},"type":6,"typeText":"{α : Type u_1} → Min.{u_1} (Filter.{u_1} α)","unsafe":false,"value":84,"source":{"code":"/-- The infimum of filters is the filter generated by intersections\n  of elements of the two filters. -/\ninstance instInf : Min (Filter α) :=\n  ⟨fun f g : Filter α =>\n    { sets := { s | ∃ a ∈ f, ∃ b ∈ g, s = a ∩ b }\n      univ_sets := ⟨_, univ_mem, _, univ_mem, by simp⟩\n      sets_of_superset := by\n        rintro x y ⟨a, ha, b, hb, rfl⟩ xy\n        refine ⟨a ∪ y, mem_of_superset ha subset_union_left, b ∪ y,\n          mem_of_superset hb subset_union_left, ?_⟩\n        rw [← inter_union_distrib_right, union_eq_self_of_subset_left xy]\n      inter_sets := by\n        rintro x y ⟨a, ha, b, hb, rfl⟩ ⟨c, hc, d, hd, rfl⟩\n        refine ⟨a ∩ c, inter_mem ha hc, b ∩ d, inter_mem hb hd, ?_⟩\n        ac_rfl }⟩","start":223,"end":237},"axioms":["Quot.sound","propext"]}