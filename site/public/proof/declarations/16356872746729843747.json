:{"code":"theorem add (hf : IsCauSeq abv f) (hg : IsCauSeq abv g) : IsCauSeq abv (f + g) := fun _ ε0 =>\n  let ⟨_, δ0, Hδ⟩ := rat_add_continuous_lemma abv ε0\n  let ⟨i, H⟩ := exists_forall_ge_and (hf.cauchy₃ δ0) (hg.cauchy₃ δ0)\n  ⟨i, fun _ ij =>\n    let ⟨H₁, H₂⟩ := H _ le_rfl\n    Hδ (H₁ _ ij) (H₂ _ ij)⟩","start":133,"end":138},"axioms":["Classical.choice","Quot.sound","propext"]}