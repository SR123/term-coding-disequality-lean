{"dependencies":["Lean.Grind.CommRing.Mon","PSigma.mk","Ordering","Lean.Grind.CommRing.Mon.revlexWF._unary"],"doc":null,"extra":null,"kind":"definition","levels":[],"module":"Init.Grind.Ring.CommSolver","name":"Lean.Grind.CommRing.Mon.revlexWF","nodes":[["constant","Lean.Grind.CommRing.Mon",[]],["constant","Ordering",[]],["forall","m₂",0,1,"explicit"],["forall","m₁",0,2,"explicit"],["constant","Lean.Grind.CommRing.Mon.revlexWF._unary",[]],["constant","PSigma.mk",[["succ",["zero"]],["succ",["zero"]]]],["apply",5,0],["lambda","m₁",0,0,"explicit"],["apply",6,7],["bound",1],["apply",8,9],["bound",0],["apply",10,11],["apply",4,12],["lambda","m₂",0,13,"explicit"],["lambda","m₁",0,14,"explicit"]],"project":false,"range":{"column":0,"endColumn":44,"endLine":224,"line":213},"type":3,"typeText":"Lean.Grind.CommRing.Mon → Lean.Grind.CommRing.Mon → Ordering","unsafe":false,"value":15,"source":{"code":"def Mon.revlexWF (m₁ m₂ : Mon) : Ordering :=\n  match m₁, m₂ with\n  | .unit, .unit => .eq\n  | .unit, .mult .. => .gt\n  | .mult .., .unit => .lt\n  | .mult pw₁ m₁, .mult pw₂ m₂ =>\n    bif pw₁.x == pw₂.x then\n      revlexWF m₁ m₂ |>.then (powerRevlex pw₁.k pw₂.k)\n    else bif pw₁.x.blt pw₂.x then\n      revlexWF m₁ (.mult pw₂ m₂) |>.then .lt\n    else\n      revlexWF (.mult pw₁ m₁) m₂ |>.then .gt","start":213,"end":224},"axioms":["Quot.sound","propext"]}