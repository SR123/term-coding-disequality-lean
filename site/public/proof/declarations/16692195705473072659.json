Poly.denote_div_eq_of_divCoeffs (ctx : Context) (p : Poly) (k : Int) : p.divCoeffs k → (p.div k).denote ctx * k + cmod p.getConst k = p.denote ctx := by\n  induction p with\n  | num k' => simp; rw [Int.mul_comm, cdiv_add_cmod]\n  | add k' v p ih =>\n    simp; intro h₁ h₂\n    replace h₁ := div_mul_cancel_of_mod_zero h₁\n    rw [← ih h₂]\n    rw [Int.mul_right_comm, h₁, Int.add_assoc]","start":479,"end":486},"axioms":["Quot.sound","propext"]}