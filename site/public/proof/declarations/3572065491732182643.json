  have : k₁ ≤ k₂ := Nat.le_of_mul_le_mul_right this h'\n      refine ⟨k₂ - k₁, ?_⟩\n      simp [Nat.mul_sub, Nat.mul_comm p k₁, Nat.mul_comm p k₂]\n      omega","start":459,"end":477},"axioms":["Classical.choice","Quot.sound","propext"]}