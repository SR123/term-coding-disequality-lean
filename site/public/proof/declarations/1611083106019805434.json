2,"implicit"],["lambda","l₂._@.Init.Data.List.Perm.397885839._hygCtx._hyg.247",29,573,"implicit"],["lambda","l₁._@.Init.Data.List.Perm.397885839._hygCtx._hyg.246",74,574,"implicit"],["apply",476,575],["apply",576,2],["apply",577,13],["lambda","init",26,578,"explicit"],["lambda","comm",53,579,"explicit"],["lambda","p",14,580,"explicit"],["lambda","l₂",9,581,"implicit"],["lambda","l₁",7,582,"implicit"],["lambda","f",5,583,"implicit"],["lambda","α",1,584,"implicit"],["lambda","β",0,585,"implicit"]],"project":false,"range":{"column":0,"endColumn":62,"endLine":319,"line":305},"type":71,"typeText":"∀ {β : Type u_1} {α : Type u_2} {f : β → α → β} {l₁ l₂ : List.{u_2} α},\n  List.Perm.{u_2} l₁ l₂ →\n    (∀ (x : α),\n        Membership.mem.{u_2, u_2} l₁ x →\n          ∀ (y : α), Membership.mem.{u_2, u_2} l₁ y → ∀ (z : β), Eq.{u_1 + 1} (f (f z x) y) (f (f z y) x)) →\n      ∀ (init : β), Eq.{u_1 + 1} (List.foldl.{u_1, u_2} f init l₁) (List.foldl.{u_1, u_2} f init l₂)","unsafe":false,"value":586,"source":{"code":"theorem Perm.foldl_eq' {f : β → α → β} {l₁ l₂ : List α} (p : l₁ ~ l₂)\n    (comm : ∀ x ∈ l₁, ∀ y ∈ l₁, ∀ (z), f (f z x) y = f (f z y) x)\n    (init) : foldl f init l₁ = foldl f init l₂ := by\n  induction p using recOnSwap' generalizing init with\n  | nil => simp\n  | cons x _p IH =>\n    simp only [foldl]\n    apply IH; intros; apply comm <;> exact .tail _ ‹_›\n  | swap' x y _p IH =>\n    simp only [foldl]\n    rw [comm x (.tail _ <| .head _) y (.head _)]\n    apply IH; intros; apply comm <;> exact .tail _ (.tail _ ‹_›)\n  | trans p₁ _p₂ IH₁ IH₂ =>\n    refine (IH₁ comm init).trans (IH₂ ?_ _)\n    intros; apply comm <;> apply p₁.symm.subset <;> assumption","start":305,"end":319},"axioms":["propext"]}