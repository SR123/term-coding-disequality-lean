"endColumn":10,"endLine":1152,"line":1147},"type":34,"typeText":"∀ {α : Type u_1} {β : Type u_2} {f : α → β} {xs : Array.{u_1} α},\n  Eq.{u_2 + 1} (Array.toList.{u_2} (Array.map.{u_1, u_2} f xs)) (List.map.{u_1, u_2} f (Array.toList.{u_1} xs))","unsafe":false,"value":606,"source":{"code":"@[simp] theorem toList_map {f : α → β} {xs : Array α} : (xs.map f).toList = xs.toList.map f := by\n  rw [map, mapM_eq_foldlM]\n  apply congrArg toList (foldl_toList fun bs a => push bs (f a)).symm |>.trans\n  have H (l xs) : List.foldl (fun bs a => push bs (f a)) xs l = ⟨xs.toList ++ l.map f⟩ := by\n    induction l generalizing xs <;> simp [*]\n  simp [H]","start":1147,"end":1152},"axioms":["Quot.sound","propext"]}