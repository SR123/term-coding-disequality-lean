["apply",316,81],["apply",317,40],["apply",318,26],["apply",319,22],["apply",320,18],["apply",321,15],["apply",322,8],["apply",313,323],["apply",310,324],["let","buckets'",294,305,325,false],["let","size'",46,291,326,true],["lambda","b",268,327,"explicit"],["apply",280,328],["apply",263,329],["let","bkt",118,139,330,false],["lambda","h",96,331,"explicit"],["lambda","i",86,332,"explicit"],["apply",115,333],["lambda","hm",79,334,"explicit"],["lambda","buckets",51,335,"explicit"],["lambda","size",46,336,"explicit"],["apply",45,337],["lambda","f",25,338,"explicit"],["lambda","a",18,339,"explicit"],["lambda","m",17,340,"explicit"],["lambda","inst._@.Std.Data.DHashMap.Internal.Defs.3553935046._hygCtx._hyg.19",13,341,"instance"],["lambda","inst._@.Std.Data.DHashMap.Internal.Defs.3553935046._hygCtx._hyg.16",9,342,"instance"],["lambda","inst._@.Std.Data.DHashMap.Internal.Defs.3553935046._hygCtx._hyg.13",6,343,"instance"],["lambda","β",3,344,"implicit"],["lambda","α",0,345,"implicit"]],"project":false,"range":{"column":0,"endColumn":64,"endLine":279,"line":262},"type":36,"typeText":"{α : Type u} →\n  {β : α → Type v} →\n    [inst : BEq.{u} α] →\n      [Hashable.{u + 1} α] →\n        [LawfulBEq.{u} α] →\n          Std.DHashMap.Internal.Raw₀.{u, v} α β →\n            (a : α) → (Option.{v} (β a) → Option.{v} (β a)) → Std.DHashMap.Internal.Raw₀.{u, v} α β","unsafe":false,"value":346,"source":{"code":"/-- Internal implementation detail of the hash map -/\n@[specialize] def alter [BEq α] [Hashable α] [LawfulBEq α] (m : Raw₀ α β) (a : α)\n    (f : Option (β a) → Option (β a)) : Raw₀ α β :=\n  let ⟨⟨size, buckets⟩, hm⟩ := m\n  let ⟨i, h⟩ := mkIdx buckets.size hm (hash a)\n  let bkt := buckets[i]\n  if bkt.contains a then\n    let buckets' := buckets.uset i .nil h\n    let bkt' := bkt.alter a f\n    let size' := if bkt'.contains a then size else size - 1\n    ⟨⟨size', buckets'.uset i bkt' (by simpa [buckets'])⟩, by simpa [buckets']⟩\n  else\n    match f none with\n    | none => m\n    | some b =>\n      let size'    := size + 1\n      let buckets' := buckets.uset i (.cons a b bkt) h\n      expandIfNecessary ⟨⟨size', buckets'⟩, by simpa [buckets']⟩","start":262,"end":279},"axioms":["Quot.sound","propext"]}