"y",0,832,"explicit"],["apply",576,833],["apply",834,13],["apply",835,74],["lambda","k0",14,836,"explicit"],["lambda","y",0,837,"implicit"],["lambda","x",0,838,"implicit"],["lambda","k",0,839,"implicit"]],"project":false,"range":{"column":0,"endColumn":87,"endLine":278,"line":269},"type":53,"typeText":"∀ {k x y : Nat}, LT.lt.{0} 0 k → Iff (LE.le.{0} x (HDiv.hDiv.{0, 0, 0} y k)) (LE.le.{0} (HMul.hMul.{0, 0, 0} x k) y)","unsafe":false,"value":840,"source":{"code":"theorem le_div_iff_mul_le (k0 : 0 < k) : x ≤ y / k ↔ x * k ≤ y := by\n  induction y, k using mod.inductionOn generalizing x with\n    (rw [div_eq]; simp [h]; cases x with | zero => simp [zero_le] | succ x => ?_)\n  | base y k h =>\n    simp only [add_one, succ_mul, false_iff, Nat.not_le, Nat.succ_ne_zero]\n    refine Nat.lt_of_lt_of_le ?_ (Nat.le_add_left ..)\n    exact Nat.not_le.1 fun h' => h ⟨k0, h'⟩\n  | ind y k h IH =>\n    rw [Nat.add_le_add_iff_right, IH k0, succ_mul,\n        ← Nat.add_sub_cancel (x*k) k, Nat.sub_le_sub_iff_right h.2, Nat.add_sub_cancel]","start":269,"end":278},"axioms":["propext"]}