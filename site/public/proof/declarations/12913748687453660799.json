he most significant bit.\n-/\n@[expose]\ndef cons {n} (msb : Bool) (lsbs : BitVec n) : BitVec (n+1) :=\n  ((ofBool msb) ++ lsbs).cast (Nat.add_comm ..)","start":705,"end":712},"axioms":["Quot.sound","propext"]}