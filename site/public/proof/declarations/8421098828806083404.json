theorem mul_eq_zero {a b : Int} : a * b = 0 ↔ a = 0 ∨ b = 0 := by\n  refine ⟨fun h => ?_, fun h => h.elim (by simp [·, Int.zero_mul]) (by simp [·, Int.mul_zero])⟩\n  exact match a, b, h with\n  | .ofNat 0, _, _ => by simp\n  | _, .ofNat 0, _ => by simp\n  | .ofNat (_+1), .negSucc _, h => by cases h","start":550,"end":555},"axioms":["propext"]}