"apply",1745,1753],["apply",1601,696],["apply",1755,1607],["apply",1756,1428],["apply",1617,279],["apply",1757,1758],["apply",1759,46],["apply",1754,1760],["apply",1741,1761],["apply",844,1762],["apply",783,1763],["apply",782,1764],["lambda","hj",678,1765,"explicit"],["lambda","j",23,1766,"explicit"],["apply",677,1767],["apply",599,1768],["apply",561,1769],["apply",553,1770],["apply",508,1771],["apply",443,1772],["apply",365,1773],["apply",298,1774],["apply",256,1775],["lambda","hn",35,1776,"explicit"],["lambda","n",23,1777,"implicit"],["lambda","hx",22,1778,"explicit"],["lambda","x",0,1779,"implicit"]],"project":false,"range":{"column":0,"endColumn":39,"endLine":404,"line":376},"type":167,"typeText":"∀ {x : Complex},\n  LE.le.{0} (Norm.norm.{0} x) 1 →\n    ∀ {n : Nat},\n      LT.lt.{0} 0 n →\n        LE.le.{0}\n          (Norm.norm.{0}\n            (HSub.hSub.{0, 0, 0} (Complex.exp x)\n              (∑ m ∈ Finset.range n, HDiv.hDiv.{0, 0, 0} (HPow.hPow.{0, 0, 0} x m) ↑(Nat.factorial m))))\n          (HMul.hMul.{0, 0, 0} (HPow.hPow.{0, 0, 0} (Norm.norm.{0} x) n)\n            (HMul.hMul.{0, 0, 0} (↑(Nat.succ n)) (Inv.inv.{0} (HMul.hMul.{0, 0, 0} ↑(Nat.factorial n) ↑n))))","unsafe":false,"value":1780,"source":{"code":"theorem exp_bound {x : ℂ} (hx : ‖x‖ ≤ 1) {n : ℕ} (hn : 0 < n) :\n    ‖exp x - ∑ m ∈ range n, x ^ m / m.factorial‖ ≤\n      ‖x‖ ^ n * ((n.succ : ℝ) * (n.factorial * n : ℝ)⁻¹) := by\n  rw [← lim_const (abv := norm) (∑ m ∈ range n, _), exp, sub_eq_add_neg,\n    ← lim_neg, lim_add, ← lim_norm]\n  refine lim_le (CauSeq.le_of_exists ⟨n, fun j hj => ?_⟩)\n  simp_rw [← sub_eq_add_neg]\n  change\n    ‖(∑ m ∈ range j, x ^ m / m.factorial) - ∑ m ∈ range n, x ^ m / m.factorial‖ ≤\n      ‖x‖ ^ n * ((n.succ : ℝ) * (n.factorial * n : ℝ)⁻¹)\n  rw [sum_range_sub_sum_range hj]\n  calc\n    ‖∑ m ∈ range j with n ≤ m, (x ^ m / m.factorial : ℂ)‖\n      = ‖∑ m ∈ range j with n ≤ m, (x ^ n * (x ^ (m - n) / m.factorial) : ℂ)‖ := by\n      refine congr_arg norm (sum_congr rfl fun m hm => ?_)\n      rw [mem_filter, mem_range] at hm\n      rw [← mul_div_assoc, ← pow_add, add_tsub_cancel_of_le hm.2]\n    _ ≤ ∑ m ∈ range j with n ≤ m, ‖x ^ n * (x ^ (m - n) / m.factorial)‖ :=\n      IsAbsoluteValue.abv_sum norm ..\n    _ ≤ ∑ m ∈ range j with n ≤ m, ‖x‖ ^ n * (1 / m.factorial) := by\n      simp_rw [Complex.norm_mul, Complex.norm_pow, Complex.norm_div, norm_natCast]\n      gcongr\n      rw [Complex.norm_pow]\n      exact pow_le_one₀ (norm_nonneg _) hx\n    _ = ‖x‖ ^ n * ∑ m ∈ range j with n ≤ m, (1 / m.factorial : ℝ) := by\n      simp [← mul_sum]\n    _ ≤ ‖x‖ ^ n * (n.succ * (n.factorial * n : ℝ)⁻¹) := by\n      gcongr\n      exact sum_div_factorial_le _ _ hn","start":376,"end":404},"axioms":["Classical.choice","Quot.sound","propext"]}