licit"],["lambda","x",13,846,"implicit"],["apply",90,847],["lambda","h",52,848,"explicit"],["lambda","lt_trans",34,849,"explicit"],["lambda","inst._@.Init.Data.Order.Ord.1464249649._hygCtx._hyg.9",10,850,"instance"],["lambda","inst._@.Init.Data.Order.Ord.1464249649._hygCtx._hyg.6",7,851,"instance"],["lambda","inst._@.Init.Data.Order.Ord.1464249649._hygCtx._hyg.3",3,852,"instance"],["lambda","α",0,853,"implicit"]],"project":false,"range":{"column":0,"endColumn":14,"endLine":494,"line":480},"type":72,"typeText":"∀ {α : Type u} [inst : LT.{u} α] [inst_1 : DecidableLT.{u} α] [inst_2 : DecidableEq.{u + 1} α],\n  (∀ {a b c : α}, LT.lt.{u} a b → LT.lt.{u} b c → LT.lt.{u} a c) →\n    (∀ (x y : α), Iff (LT.lt.{u} x y) (And (Not (LT.lt.{u} y x)) (Ne.{u + 1} x y))) →\n      Std.TransCmp.{u} fun x y => compareOfLessAndEq.{u} x y","unsafe":false,"value":854,"source":{"code":"theorem Std.TransOrd.compareOfLessAndEq_of_lt_trans_of_lt_iff\n    {α : Type u} [LT α] [DecidableLT α] [DecidableEq α]\n    (lt_trans : ∀ {a b c : α}, a < b → b < c → a < c)\n    (h : ∀ x y : α, x < y ↔ ¬ y < x ∧ x ≠ y) :\n    TransCmp (fun x y : α => compareOfLessAndEq x y) where\n  eq_swap := compareOfLessAndEq_eq_swap_of_lt_iff_not_gt_and_ne h\n  isLE_trans {x y z} h₁ h₂ := by\n    simp only [compareOfLessAndEq, apply_ite Ordering.isLE,\n      Ordering.isLE_lt, Ordering.isLE_eq, Ordering.isLE_gt] at h₁ h₂ ⊢\n    simp only [Bool.if_true_left, Bool.or_false, Bool.or_eq_true, decide_eq_true_eq] at h₁ h₂ ⊢\n    rcases h₁ with (h₁ | rfl)\n    · rcases h₂ with (h₂ | rfl)\n      · exact .inl (lt_trans h₁ h₂)\n      · exact .inl h₁\n    · exact h₂","start":480,"end":494},"axioms":["propext"]}