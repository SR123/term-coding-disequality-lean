c _, zero,   h => absurd h (not_succ_le_zero _)\n  | succ n, succ m, h =>\n    have : n ≤ m := Nat.le_of_succ_le_succ h\n    have : Exists (fun k => n + k = m) := dest this\n    match this with\n    | ⟨k, h⟩ => ⟨k, show succ n + k = succ m from ((succ_add n k).symm ▸ h ▸ rfl)⟩","start":409,"end":417},"axioms":[]}