 theorem pow_le_pow_of_le {a n m : Nat} (h : 1 < a) (w : n ≤ m) : a ^ n ≤ a ^ m := by\n  cases Nat.lt_or_eq_of_le w\n  case inl lt =>\n    exact Nat.le_of_lt (Nat.pow_lt_pow_of_lt h lt)\n  case inr eq =>\n    subst eq\n    exact Nat.le_refl _","start":1141,"end":1147},"axioms":["propext"]}