"apply",855,899],["lambda","hrsd",582,900,"explicit"],["apply",587,901],["constant","Not",[]],["apply",903,582],["apply",530,154],["apply",529,905],["apply",906,25],["apply",366,907],["apply",908,237],["apply",909,212],["apply",910,199],["apply",366,25],["apply",912,19],["apply",913,15],["apply",914,11],["apply",915,7],["apply",911,916],["lambda","hrsd",904,917,"explicit"],["apply",902,918],["lambda","hlr",562,919,"explicit"],["lambda","hrb",548,920,"explicit"],["lambda","rr",201,921,"explicit"],["lambda","rl",197,922,"explicit"],["lambda","rv",542,923,"explicit"],["lambda","rk",193,924,"explicit"],["lambda","rs",126,925,"explicit"],["apply",541,926],["lambda","hlr",469,927,"explicit"],["lambda","hlb",460,928,"explicit"],["lambda","r._@.Std.Data.DTreeMap.Internal.Balancing.4243250799._hygCtx._hyg.358",454,929,"explicit"],["lambda","l._@.Std.Data.DTreeMap.Internal.Balancing.4243250799._hygCtx._hyg.357",61,930,"explicit"],["lambda","v._@.Std.Data.DTreeMap.Internal.Balancing.4243250799._hygCtx._hyg.356",452,931,"explicit"],["lambda","k._@.Std.Data.DTreeMap.Internal.Balancing.4243250799._hygCtx._hyg.355",48,932,"explicit"],["lambda","ls",126,933,"explicit"],["apply",451,934],["lambda","hlr",31,935,"explicit"],["lambda","hrb",22,936,"explicit"],["lambda","hlb",18,937,"explicit"],["lambda","r",13,938,"explicit"],["lambda","l",10,939,"explicit"],["lambda","v",5,940,"explicit"],["lambda","k",4,941,"explicit"],["lambda","β",3,942,"implicit"],["lambda","α",0,943,"implicit"]],"project":false,"range":{"column":0,"endColumn":60,"endLine":214,"line":186},"type":43,"typeText":"{α : Type u} →\n  {β : α → Type v} →\n    (k : α) →\n      β k →\n        (l r : Std.DTreeMap.Internal.Impl.{u, v} α β) →\n          Std.DTreeMap.Internal.Impl.Balanced.{u, v} l →\n            Std.DTreeMap.Internal.Impl.Balanced.{u, v} r →\n              Std.DTreeMap.Internal.Impl.BalanceLPrecond (Std.DTreeMap.Internal.Impl.size.{u, v} r)\n                  (Std.DTreeMap.Internal.Impl.size.{u, v} l) →\n                Std.DTreeMap.Internal.Impl.{u, v} α β","unsafe":false,"value":944,"source":{"code":"/--\nRebalances a tree after at most one element was added to the right subtree. Uses balancing\ninformation to show that some cases are impossible.\n-/\n@[inline]\ndef balanceR (k : α) (v : β k) (l r : Impl α β) (hlb : Balanced l) (hrb : Balanced r)\n    (hlr : BalanceLPrecond r.size l.size) : Impl α β :=\n  match l with\n  | leaf => match r with\n    | leaf => .inner 1 k v .leaf .leaf\n    | (inner _ _ _ .leaf .leaf) => .inner 2 k v .leaf r\n    | inner _ rk rv .leaf rr@(.inner _ _ _ _ _) => .inner 3 rk rv (.inner 1 k v .leaf .leaf) rr\n    | inner _ rk rv (.inner _ rlk rlv _ _) .leaf => .inner 3 rlk rlv (.inner 1 k v .leaf .leaf)\n        (.inner 1 rk rv .leaf .leaf)\n    | inner rs rk rv (.inner rls rlk rlv rll rlr) (.inner rrs _ _ _ _) =>\n      False.elim ✓\n  | inner ls _ _ _ _ => match r with\n    | leaf => .inner (1 + ls) k v l .leaf\n    | inner rs rk rv rl rr =>\n      if hrsd : rs > delta * ls then match rl, rr with\n        | inner rls rlk rlv rll rlr, .inner rrs _ _ _ _ =>\n          if rls < ratio * rrs then\n            .inner (1 + ls + rs) rk rv (.inner (1 + ls + rls) k v l (.inner rls rlk rlv rll rlr)) rr\n          else\n            .inner (1 + ls + rs) rlk rlv (.inner (1 + ls + rll.size) k v l rll)\n              (.inner (1 + rrs + rlr.size) rk rv rlr rr)\n        | inner _ _ _ _ _, leaf => False.elim ✓\n        | leaf, _ => False.elim ✓\n      else .inner (1 + ls + rs) k v l (inner rs rk rv rl rr)","start":186,"end":214},"axioms":["Quot.sound","propext"]}