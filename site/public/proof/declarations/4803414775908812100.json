ply",892,4],["apply",893,1],["apply",878,894],["lambda","hlr",877,895,"explicit"],["lambda","hlb",862,896,"explicit"],["lambda","x._@.Std.Data.DTreeMap.Internal.Balancing.1459205638._hygCtx._hyg.641",600,897,"explicit"],["apply",854,898],["lambda","hlsd",582,899,"explicit"],["apply",587,900],["constant","Not",[]],["apply",902,582],["apply",530,25],["apply",529,904],["apply",905,154],["apply",366,906],["apply",907,304],["apply",908,236],["apply",366,25],["apply",910,19],["apply",911,15],["apply",912,11],["apply",913,7],["apply",909,914],["apply",915,197],["lambda","hlsd",903,916,"explicit"],["apply",901,917],["lambda","hlr",562,918,"explicit"],["lambda","hlb",548,919,"explicit"],["lambda","lr",275,920,"explicit"],["lambda","ll",272,921,"explicit"],["lambda","lv",542,922,"explicit"],["lambda","lk",191,923,"explicit"],["lambda","ls",126,924,"explicit"],["apply",541,925],["lambda","hlr",469,926,"explicit"],["lambda","hrb",460,927,"explicit"],["lambda","r._@.Std.Data.DTreeMap.Internal.Balancing.1459205638._hygCtx._hyg.365",454,928,"explicit"],["lambda","l._@.Std.Data.DTreeMap.Internal.Balancing.1459205638._hygCtx._hyg.364",61,929,"explicit"],["lambda","v._@.Std.Data.DTreeMap.Internal.Balancing.1459205638._hygCtx._hyg.363",452,930,"explicit"],["lambda","k._@.Std.Data.DTreeMap.Internal.Balancing.1459205638._hygCtx._hyg.362",48,931,"explicit"],["lambda","rs",126,932,"explicit"],["apply",451,933],["lambda","hlr",31,934,"explicit"],["lambda","hrb",22,935,"explicit"],["lambda","hlb",18,936,"explicit"],["lambda","r",13,937,"explicit"],["lambda","l",10,938,"explicit"],["lambda","v",5,939,"explicit"],["lambda","k",4,940,"explicit"],["lambda","β",3,941,"implicit"],["lambda","α",0,942,"implicit"]],"project":false,"range":{"column":0,"endColumn":63,"endLine":119,"line":91},"type":43,"typeText":"{α : Type u} →\n  {β : α → Type v} →\n    (k : α) →\n      β k →\n        (l r : Std.DTreeMap.Internal.Impl.{u, v} α β) →\n          Std.DTreeMap.Internal.Impl.Balanced.{u, v} l →\n            Std.DTreeMap.Internal.Impl.Balanced.{u, v} r →\n              Std.DTreeMap.Internal.Impl.BalanceLPrecond (Std.DTreeMap.Internal.Impl.size.{u, v} l)\n                  (Std.DTreeMap.Internal.Impl.size.{u, v} r) →\n                Std.DTreeMap.Internal.Impl.{u, v} α β","unsafe":false,"value":943,"source":{"code":"/--\nRebalances a tree after at most one element was added to the left subtree. Uses balancing\ninformation to show that some cases are impossible.\n-/\n@[inline]\ndef balanceL (k : α) (v : β k) (l r : Impl α β) (hlb : Balanced l) (hrb : Balanced r)\n    (hlr : BalanceLPrecond l.size r.size) : Impl α β :=\n  match r with\n  | leaf => match l with\n    | leaf => .inner 1 k v .leaf .leaf\n    | inner _ _ _ .leaf .leaf => .inner 2 k v l .leaf\n    | inner _ lk lv .leaf (.inner _ lrk lrv _ _) =>\n      .inner 3 lrk lrv (.inner 1 lk lv .leaf .leaf) (.inner 1 k v .leaf .leaf)\n    | inner _ lk lv ll@(.inner _ _ _ _ _) .leaf =>\n      .inner 3 lk lv ll (.inner 1 k v .leaf .leaf)\n    | inner ls lk lv (.inner lls _ _ _ _) (.inner lrs _ _ _ _) => False.elim ✓\n  | inner rs _ _ _ _ => match l with\n    | leaf => .inner (1 + rs) k v .leaf r\n    | inner ls lk lv ll lr =>\n      if hlsd : delta * rs < ls then match ll, lr with\n        | inner lls _ _ _ _, inner lrs lrk lrv lrl lrr =>\n          if lrs < ratio * lls then\n            .inner (1 + ls + rs) lk lv ll (.inner (1 + rs + lrs) k v (inner lrs lrk lrv lrl lrr) r)\n          else\n            .inner (1 + ls + rs) lrk lrv (.inner (1 + lls + lrl.size) lk lv ll lrl)\n              (.inner (1 + rs + lrr.size) k v lrr r)\n        | inner _ _ _ _ _, leaf => False.elim ✓\n        | leaf, _ => False.elim ✓\n        else .inner (1 + ls + rs) k v (.inner ls lk lv ll lr) r","start":91,"end":119},"axioms":["Quot.sound","propext"]}