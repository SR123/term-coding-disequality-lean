"explicit"],["lambda","n",0,346,"explicit"]],"project":false,"range":{"column":0,"endColumn":96,"endLine":83,"line":77},"type":45,"typeText":"∀ (n : Nat) (a b c : Fin n),\n  Eq.{1} (HMul.hMul.{0, 0, 0} a (HAdd.hAdd.{0, 0, 0} b c))\n    (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} a b) (HMul.hMul.{0, 0, 0} a c))","unsafe":false,"value":347,"source":{"code":"private theorem left_distrib_aux (n : ℕ) : ∀ a b c : Fin n, a * (b + c) = a * b + a * c :=\n  fun ⟨a, _⟩ ⟨b, _⟩ ⟨c, _⟩ =>\n  Fin.eq_of_val_eq <|\n    calc\n      a * ((b + c) % n) ≡ a * (b + c) [MOD n] := (Nat.mod_modEq _ _).mul_left _\n      _ ≡ a * b + a * c [MOD n] := by rw [mul_add]\n      _ ≡ a * b % n + a * c % n [MOD n] := (Nat.mod_modEq _ _).symm.add (Nat.mod_modEq _ _).symm","start":77,"end":83},"axioms":["propext"]}