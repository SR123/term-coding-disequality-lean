ter]\n    exact (hs ⟨x, hxs⟩).union (ht ⟨x, hxt⟩)\n  isOpen_sUnion := by\n    rintro s h ⟨x, t, hts, hzt⟩\n    rw [compl_sUnion]\n    exact Finite.sInter (mem_image_of_mem _ hts) (h t hts ⟨x, hzt⟩)","start":279,"end":289},"axioms":["Classical.choice","Quot.sound","propext"]}