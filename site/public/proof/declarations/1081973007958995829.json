m","u_1"]]],["apply",729,83],["apply",730,67],["apply",731,31],["apply",732,11],["apply",733,2],["apply",734,1],["apply",728,735],["lambda","hb",727,736,"explicit"],["lambda","b",31,737,"explicit"],["lambda","h",53,738,"explicit"],["apply",724,739],["lambda","l",28,740,"explicit"],["lambda","a",11,741,"explicit"],["lambda","neg_trans",26,742,"explicit"],["lambda","inst._@.Batteries.Data.List.Pairwise.632355254._hygCtx._hyg.9",9,743,"instance"],["lambda","R",5,744,"implicit"],["lambda","α",0,745,"implicit"]],"project":false,"range":{"column":0,"endColumn":51,"endLine":118,"line":101},"type":60,"typeText":"∀ {α : Type u_1} {R : α → α → Prop} [inst : DecidableRel.{u_1 + 1, u_1 + 1} R],\n  (∀ {x y z : α}, R x z → Or (R x y) (R y z)) →\n    ∀ (a : α) (l : List.{u_1} α),\n      Iff (∀ (b : α), Membership.mem.{u_1, u_1} (List.pwFilter.{u_1} R l) b → R a b)\n        (∀ (b : α), Membership.mem.{u_1, u_1} l b → R a b)","unsafe":false,"value":746,"source":{"code":"theorem forall_mem_pwFilter [DecidableRel (α := α) R]\n    (neg_trans : ∀ {x y z}, R x z → R x y ∨ R y z) (a : α) (l : List α) :\n    (∀ b ∈ pwFilter R l, R a b) ↔ ∀ b ∈ l, R a b := by\n  refine ⟨?_, fun h b hb => h _ <| pwFilter_subset (R := R) _ hb⟩\n  induction l with\n  | nil => exact fun _ _ h => (not_mem_nil h).elim\n  | cons x l IH =>\n    simp only [forall_mem_cons]\n    if h : ∀ y ∈ pwFilter R l, R x y then\n      simpa [pwFilter_cons_of_pos h] using fun r H => ⟨r, IH H⟩\n    else\n      refine pwFilter_cons_of_neg h ▸ fun H => ⟨?_, IH H⟩\n      match e : find? (fun y => ¬R x y) (pwFilter R l) with\n      | none => exact h.elim fun y hy => by simpa using find?_eq_none.1 e y hy\n      | some k =>\n        have := find?_some e\n        apply (neg_trans (H k (mem_of_find?_eq_some e))).resolve_right\n        rw [decide_eq_true_iff] at this; exact this","start":101,"end":118},"axioms":["Quot.sound","propext"]}