877],["apply",861,878],["apply",858,879],["constant","Int.sub_zero",[]],["apply",881,354],["apply",880,882],["apply",854,883],["apply",230,354],["apply",884,885],["apply",849,886],["apply",842,887],["apply",814,888],["lambda","h._@.Init.Data.Int.DivMod.Lemmas.937729365._hygCtx._hyg.151",83,889,"explicit"],["apply",797,890],["apply",450,891],["apply",432,892],["apply",408,893],["apply",374,894],["apply",333,895],["lambda","hb",236,896,"explicit"],["apply",235,897],["lambda","b",0,898,"implicit"],["lambda","a",0,899,"implicit"]],"project":false,"range":{"column":0,"endColumn":15,"endLine":836,"line":813},"type":62,"typeText":"∀ {a b : Int},\n  Eq.{1} (HDiv.hDiv.{0, 0, 0} (Neg.neg.{0} a) b)\n    (HSub.hSub.{0, 0, 0} (Neg.neg.{0} (HDiv.hDiv.{0, 0, 0} a b)) (ite.{1} (Dvd.dvd.{0} b a) 0 (Int.sign b)))","unsafe":false,"value":900,"source":{"code":"theorem neg_ediv {a b : Int} : (-a) / b = -(a / b) - if b ∣ a then 0 else b.sign := by\n  if hb : b = 0 then\n    simp [hb]\n  else\n    conv => lhs; rw [← mul_ediv_add_emod a b]\n    rw [Int.neg_add, ← Int.mul_neg, mul_add_ediv_left _ _ hb, Int.add_comm]\n    split <;> rename_i h\n    · rw [emod_eq_zero_of_dvd h]\n      simp\n    · if hb : 0 < b then\n        rw [Int.sign_eq_one_of_pos hb, ediv_eq_neg_one_of_neg_of_le]\n        · omega\n        · have : 0 < a % b := (emod_pos_of_not_dvd h).resolve_left (by omega)\n          omega\n        · have := emod_lt_of_pos a hb\n          omega\n      else\n        replace hb : b < 0 := by omega\n        rw [Int.sign_eq_neg_one_of_neg hb, Int.ediv_eq_one_of_neg_of_le]\n        · omega\n        · have : 0 < a % b := (emod_pos_of_not_dvd h).resolve_left (by omega)\n          omega\n        · have := emod_lt_of_neg a hb\n          omega","start":813,"end":836},"axioms":["Classical.choice","Quot.sound","propext"]}