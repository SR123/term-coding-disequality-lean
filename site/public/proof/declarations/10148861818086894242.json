["apply",715,5],["apply",716,2],["lambda","H",32,717,"explicit"],["apply",47,718],["lambda","l₂",12,719,"implicit"],["lambda","l₁",10,720,"implicit"],["lambda","inst._@.Init.Data.List.Perm.2467090109._hygCtx._hyg.8",7,721,"instance"],["lambda","inst._@.Init.Data.List.Perm.2467090109._hygCtx._hyg.5",3,722,"instance"],["lambda","α",0,723,"implicit"]],"project":false,"range":{"column":0,"endColumn":70,"endLine":435,"line":420},"type":38,"typeText":"∀ {α : Type u_1} [inst : BEq.{u_1} α] [LawfulBEq.{u_1} α] {l₁ l₂ : List.{u_1} α},\n  Iff (List.Perm.{u_1} l₁ l₂) (∀ (a : α), Eq.{1} (List.count.{u_1} a l₁) (List.count.{u_1} a l₂))","unsafe":false,"value":724,"source":{"code":"@[grind =]\ntheorem perm_iff_count {l₁ l₂ : List α} : l₁ ~ l₂ ↔ ∀ a, count a l₁ = count a l₂ := by\n  refine ⟨Perm.count_eq, fun H => ?_⟩\n  induction l₁ generalizing l₂ with\n  | nil =>\n    match l₂ with\n    | nil => rfl\n    | cons b l₂ =>\n      specialize H b\n      simp at H\n  | cons a l₁ IH =>\n    have : a ∈ l₂ := count_pos_iff.mp (by rw [← H]; simp)\n    refine ((IH fun b => ?_).cons a).trans (perm_cons_erase this).symm\n    specialize H b\n    rw [(perm_cons_erase this).count_eq] at H\n    by_cases h : b = a <;> simpa [h, count_cons, Nat.succ_inj] using H","start":420,"end":435},"axioms":["Classical.choice","Quot.sound","propext"]}