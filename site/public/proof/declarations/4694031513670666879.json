thlib.Topology.Connected.Basic.3851729634._hygCtx._hyg.47",158,1578,"explicit"],["apply",197,1579],["lambda","h._@.Mathlib.Topology.Connected.Basic.3851729634._hygCtx._hyg.46",115,1580,"explicit"],["lambda","w._@.Mathlib.Topology.Connected.Basic.3851729634._hygCtx._hyg.45",86,1581,"explicit"],["apply",151,1582],["lambda","a._@._internal.0.Mathlib.Topology.Connected.Basic.3851729634._hygCtx._hyg.44",93,1583,"explicit"],["lambda","huv",77,1584,"explicit"],["lambda","hv",56,1585,"explicit"],["lambda","hu",52,1586,"explicit"],["lambda","v",47,1587,"explicit"],["lambda","u",46,1588,"explicit"],["lambda","hf",26,1589,"explicit"],["lambda","f",18,1590,"explicit"],["lambda","H",16,1591,"explicit"],["lambda","s",9,1592,"implicit"],["lambda","inst._@.Mathlib.Topology.Connected.Basic.3851729634._hygCtx._hyg.19",6,1593,"instance"],["lambda","inst._@.Mathlib.Topology.Connected.Basic.3851729634._hygCtx._hyg.8",4,1594,"instance"],["lambda","β",1,1595,"implicit"],["lambda","α",0,1596,"implicit"]],"project":false,"range":{"column":0,"endColumn":47,"endLine":298,"line":279},"type":44,"typeText":"∀ {α : Type u} {β : Type v} [inst : TopologicalSpace.{u} α] [inst_1 : TopologicalSpace.{v} β] {s : Set.{u} α},\n  IsPreconnected.{u} s → ∀ (f : α → β), ContinuousOn.{u, v} f s → IsPreconnected.{v} (Set.image.{u, v} f s)","unsafe":false,"value":1597,"source":{"code":"/-- The image of a preconnected set is preconnected as well. -/\nprotected theorem IsPreconnected.image [TopologicalSpace β] {s : Set α} (H : IsPreconnected s)\n    (f : α → β) (hf : ContinuousOn f s) : IsPreconnected (f '' s) := by\n  -- Unfold/destruct definitions in hypotheses\n  rintro u v hu hv huv ⟨_, ⟨x, xs, rfl⟩, xu⟩ ⟨_, ⟨y, ys, rfl⟩, yv⟩\n  rcases continuousOn_iff'.1 hf u hu with ⟨u', hu', u'_eq⟩\n  rcases continuousOn_iff'.1 hf v hv with ⟨v', hv', v'_eq⟩\n  -- Reformulate `huv : f '' s ⊆ u ∪ v` in terms of `u'` and `v'`\n  replace huv : s ⊆ u' ∪ v' := by\n    rw [image_subset_iff, preimage_union] at huv\n    replace huv := subset_inter huv Subset.rfl\n    rw [union_inter_distrib_right, u'_eq, v'_eq, ← union_inter_distrib_right] at huv\n    exact (subset_inter_iff.1 huv).1\n  -- Now `s ⊆ u' ∪ v'`, so we can apply `‹IsPreconnected s›`\n  obtain ⟨z, hz⟩ : (s ∩ (u' ∩ v')).Nonempty := by\n    refine H u' v' hu' hv' huv ⟨x, ?_⟩ ⟨y, ?_⟩ <;> rw [inter_comm]\n    exacts [u'_eq ▸ ⟨xu, xs⟩, v'_eq ▸ ⟨yv, ys⟩]\n  rw [← inter_self s, inter_assoc, inter_left_comm s u', ← inter_assoc, inter_comm s, inter_comm s,\n    ← u'_eq, ← v'_eq] at hz\n  exact ⟨f z, ⟨z, hz.1.2, rfl⟩, hz.1.1, hz.2.1⟩","start":279,"end":298},"axioms":["Classical.choice","Quot.sound","propext"]}