st 2 bits\n  let key : UInt64 := ((ctx.configKey >>> (2 : UInt64)) <<< 2) ||| transparency.toUInt64\n  { ctx with keyedConfig := { config, key } }","start":1237,"end":1241},"axioms":["Classical.choice","Quot.sound","propext"]}