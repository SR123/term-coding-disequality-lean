mbda","m",2,51,"implicit"]],"project":false,"range":{"column":0,"endColumn":7,"endLine":286,"line":270},"type":27,"typeText":"{m : Type w → Type w'} →\n  [Monad.{w, w'} m] →\n    {σ : Type w} →\n      {α : Type u_1} → {β : Type u_2} → (σ → α → β → m σ) → Lean.PersistentHashMap.Node.{u_1, u_2} α β → σ → m σ","unsafe":false,"value":52,"source":{"code":"partial def foldlMAux (f : σ → α → β → m σ) : Node α β → σ → m σ\n  | Node.collision keys vals heq, acc =>\n    let rec traverse (i : Nat) (acc : σ) : m σ := do\n      if h : i < keys.size then\n        let k := keys[i]\n        have : i < vals.size := heq ▸ h\n        let v := vals[i]\n        traverse (i+1) (← f acc k v)\n      else\n        pure acc\n    traverse 0 acc\n  | Node.entries entries, acc => entries.foldlM (fun acc entry =>\n    match entry with\n    | Entry.null      => pure acc\n    | Entry.entry k v => f acc k v\n    | Entry.ref node  => foldlMAux f node acc)\n    acc","start":270,"end":286},"axioms":[]}