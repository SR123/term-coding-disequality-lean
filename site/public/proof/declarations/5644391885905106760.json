e":{"code":"theorem Context.evalList_sort_congr\n  (ctx : Context α)\n  (h : Commutative ctx.op)\n  (h₂ : evalList α ctx a = evalList α ctx b)\n  (h₃ : a ≠ [])\n  (h₄ : b ≠ [])\n  : evalList α ctx (sort.loop a c) = evalList α ctx (sort.loop b c) := by\n  induction c generalizing a b with\n  | nil => simp [sort.loop, h₂]\n  | cons c _  ih =>\n    simp [sort.loop]; apply ih; simp [evalList_insert ctx h]\n    cases a with\n    | nil => apply absurd h₃; simp\n    | cons a as =>\n      cases b with\n      | nil => apply absurd h₄; simp\n      | cons b bs => simp [evalList, h₂]\n    all_goals apply insert_nonEmpty","start":203,"end":220},"axioms":["propext"]}