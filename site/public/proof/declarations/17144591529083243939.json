Mathlib.Algebra.Ring.InjSurj.401502262._hygCtx._hyg.27",28,555,"instance"],["lambda","inst._@.Mathlib.Algebra.Ring.InjSurj.401502262._hygCtx._hyg.24",23,556,"instance"],["lambda","inst._@.Mathlib.Algebra.Ring.InjSurj.401502262._hygCtx._hyg.21",20,557,"instance"],["lambda","inst._@.Mathlib.Algebra.Ring.InjSurj.401502262._hygCtx._hyg.18",17,558,"instance"],["lambda","inst._@.Mathlib.Algebra.Ring.InjSurj.401502262._hygCtx._hyg.15",14,559,"instance"],["lambda","inst._@.Mathlib.Algebra.Ring.InjSurj.401502262._hygCtx._hyg.9",11,560,"instance"],["lambda","hf",9,561,"explicit"],["lambda","f",3,562,"explicit"],["lambda","S",1,563,"implicit"],["lambda","R",0,564,"implicit"]],"project":false,"range":{"column":0,"endColumn":54,"endLine":332,"line":319},"type":334,"typeText":"{R : Type u_1} →\n  {S : Type u_2} →\n    (f : R → S) →\n      Function.Surjective.{u_1 + 1, u_2 + 1} f →\n        [inst : Add.{u_2} S] →\n          [inst_1 : Zero.{u_2} S] →\n            [inst_2 : One.{u_2} S] →\n              [inst_3 : Neg.{u_2} S] →\n                [inst_4 : Sub.{u_2} S] →\n                  [inst_5 : SMul.{0, u_2} Nat S] →\n                    [inst_6 : SMul.{0, u_2} Int S] →\n                      [inst_7 : NatCast.{u_2} S] →\n                        [inst_8 : IntCast.{u_2} S] →\n                          [inst_9 : AddGroupWithOne.{u_1} R] →\n                            Eq.{u_2 + 1} (f 0) 0 →\n                              Eq.{u_2 + 1} (f 1) 1 →\n                                (∀ (x y : R),\n                                    Eq.{u_2 + 1} (f (HAdd.hAdd.{u_1, u_1, u_1} x y))\n                                      (HAdd.hAdd.{u_2, u_2, u_2} (f x) (f y))) →\n                                  (∀ (x : R), Eq.{u_2 + 1} (f (Neg.neg.{u_1} x)) (Neg.neg.{u_2} (f x))) →\n                                    (∀ (x y : R),\n                                        Eq.{u_2 + 1} (f (HSub.hSub.{u_1, u_1, u_1} x y))\n                                          (HSub.hSub.{u_2, u_2, u_2} (f x) (f y))) →\n                                      (∀ (n : Nat) (x : R),\n                                          Eq.{u_2 + 1} (f (HSMul.hSMul.{0, u_1, u_1} n x))\n                                            (HSMul.hSMul.{0, u_2, u_2} n (f x))) →\n                                        (∀ (n : Int) (x : R),\n                                            Eq.{u_2 + 1} (f (HSMul.hSMul.{0, u_1, u_1} n x))\n                                              (HSMul.hSMul.{0, u_2, u_2} n (f x))) →\n                                          (∀ (n : Nat), Eq.{u_2 + 1} (f ↑n) ↑n) →\n                                            (∀ (n : Int), Eq.{u_2 + 1} (f ↑n) ↑n) → AddGroupWithOne.{u_2} S","unsafe":false,"value":565,"source":{"code":"/-- A type endowed with `0`, `1`, `+` is an additive group with one,\nif it admits a surjective map that preserves `0`, `1`, and `+` to an additive group with one.\nSee note [reducible non-instances]. -/\nprotected abbrev addGroupWithOne [AddGroupWithOne R]\n    (zero : f 0 = 0) (one : f 1 = 1) (add : ∀ x y, f (x + y) = f x + f y) (neg : ∀ x, f (-x) = -f x)\n    (sub : ∀ x y, f (x - y) = f x - f y) (nsmul : ∀ (n : ℕ) (x), f (n • x) = n • f x)\n    (zsmul : ∀ (n : ℤ) (x), f (n • x) = n • f x) (natCast : ∀ n : ℕ, f n = n)\n    (intCast : ∀ n : ℤ, f n = n) : AddGroupWithOne S :=\n  { hf.addMonoidWithOne f zero one add nsmul natCast,\n    hf.addGroup f zero add neg sub (swap nsmul) (swap zsmul) with\n    intCast := Int.cast,\n    intCast_ofNat := fun n => by rw [← intCast, Int.cast_natCast, natCast],\n    intCast_negSucc := fun n => by\n      rw [← intCast, Int.cast_negSucc, neg, natCast] }","start":319,"end":332},"axioms":["propext"]}