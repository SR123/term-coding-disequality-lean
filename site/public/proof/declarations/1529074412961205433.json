y",731,1],["apply",732,11],["apply",733,703],["apply",734,113],["apply",735,117],["apply",736,144],["constant","Lean.MessageData.arrayExpr.toMessageData",[]],["constant","Array.map",[["zero"],["zero"]]],["apply",739,3],["apply",740,0],["constant","Lean.Meta.SynthInstance.Instance.val",[]],["apply",742,57],["lambda","x._@.Lean.Meta.SynthInstance.2988813138._hygCtx._hyg.739",3,743,"explicit"],["apply",741,744],["apply",745,193],["apply",738,746],["apply",747,366],["constant","Function.comp",[["succ",["zero"]],["succ",["zero"]],["succ",["zero"]]]],["apply",749,133],["constant","Std.Format",[]],["apply",750,751],["apply",752,123],["constant","Lean.MessageData.ofFormat",[]],["apply",753,754],["constant","Std.ToFormat.format",[["zero"]]],["apply",756,133],["constant","Std.instToFormatString",[]],["apply",757,758],["apply",755,759],["string","#["],["apply",760,761],["apply",748,762],["apply",737,763],["apply",730,764],["lambda","y._@.Lean.Meta.SynthInstance.2988813138._hygCtx._hyg.58",64,644,"explicit"],["apply",765,766],["apply",728,767],["apply",639,4],["apply",769,642],["apply",770,645],["apply",768,771],["let","__do_jp._@.Lean.Meta.SynthInstance.2988813138._hygCtx._hyg.57",718,721,772,true],["lambda","__do_lift._@.Lean.Meta.SynthInstance.2988813138._hygCtx._hyg.55.0",259,773,"explicit"],["apply",717,774],["let","cls._@.Lean.Meta.SynthInstance.2988813138._hygCtx._hyg.54",52,688,775,true],["let","result",4,57,776,true],["lambda","r._@.Lean.Meta.SynthInstance.2988813138._hygCtx._hyg.44",4,777,"explicit"],["apply",681,778],["lambda","result",4,779,"explicit"],["apply",372,780],["lambda","env",230,781,"explicit"],["apply",237,782],["lambda","erasedInstances",223,783,"explicit"],["apply",229,784],["let","result",187,217,785,true],["lambda","result",187,786,"explicit"],["apply",195,787],["lambda","globalInstances",153,788,"explicit"],["apply",186,789],["lambda","className",52,790,"explicit"],["apply",150,791],["lambda","className?",53,792,"explicit"],["apply",59,793],["lambda","type",0,794,"explicit"],["lambda","x._@.Lean.Meta.SynthInstance.2988813138._hygCtx._hyg.33",50,795,"explicit"],["apply",49,796],["apply",797,652],["apply",798,652],["lambda","localInstances",14,799,"explicit"],["apply",18,800],["lambda","type",0,801,"explicit"]],"project":false,"range":{"column":0,"endColumn":19,"endLine":242,"line":202},"type":6,"typeText":"Lean.Expr → Lean.Meta.MetaM (Array.{0} Lean.Meta.SynthInstance.Instance)","unsafe":false,"value":802,"source":{"code":"/-- Return globals and locals instances that may unify with `type` -/\ndef getInstances (type : Expr) : MetaM (Array Instance) := do\n  -- We must retrieve `localInstances` before we use `forallTelescopeReducing` because it will update the set of local instances\n  let localInstances ← getLocalInstances\n  forallTelescopeReducing type fun _ type => do\n    let className? ← isClass? type\n    match className? with\n    | none   => throwError \"type class instance expected{indentExpr type}\"\n    | some className =>\n      let globalInstances ← getGlobalInstancesIndex\n      let result ← globalInstances.getUnify type\n      -- Using insertion sort because it is stable and the array `result` should be mostly sorted.\n      -- Most instances have default priority.\n      let result := result.insertionSort fun e₁ e₂ => e₁.priority < e₂.priority\n      let erasedInstances ← getErasedInstances\n      let env ← getEnv\n      let mut result ← result.filterMapM fun e => match e.val with\n        | .const constName us =>\n          if erasedInstances.contains constName then\n            return none\n          else if env.isExporting && !env.contains constName then\n            -- private instances must not leak into public scope\n            return none\n          else\n            return some {\n              val := e.val.updateConst! (← us.mapM (fun _ => mkFreshLevelMVar))\n              synthOrder := e.synthOrder\n            }\n        | _ => panic! \"global instance is not a constant\"\n      for linst in localInstances do\n        if linst.className == className then\n          let synthOrder ← forallTelescopeReducing (← inferType linst.fvar) fun xs _ => do\n            if xs.isEmpty then return #[]\n            let mut order := #[]\n            for i in *...xs.size, x in xs do\n              if (← getFVarLocalDecl x).binderInfo == .instImplicit then\n                order := order.push i\n            return order\n          result := result.push { val := linst.fvar, synthOrder }\n      trace[Meta.synthInstance.instances] result.map (·.val)\n      return result","start":202,"end":242},"axioms":["Classical.choice","Quot.sound","propext"]}