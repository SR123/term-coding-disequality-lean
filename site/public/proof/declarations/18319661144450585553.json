bs",2,503,"explicit"]],"project":true,"range":{"column":0,"endColumn":76,"endLine":231,"line":224},"type":64,"typeText":"∀ (bs : List.{0} Bool),\n  ∃ m' n t,\n    And\n      (DisequalityDispersion.Machine.Run DisequalityDispersion.Machine.program\n        (DisequalityDispersion.Machine.initCfg bs)\n        { pc := DisequalityDispersion.Machine.Cmd.len DisequalityDispersion.Machine.mainM, mem := m' } n t)\n      (And\n        (DisequalityDispersion.Machine.Halted DisequalityDispersion.Machine.program\n          { pc := DisequalityDispersion.Machine.Cmd.len DisequalityDispersion.Machine.mainM, mem := m' })\n        (And\n          (Eq.{1} (m' DisequalityDispersion.Machine.RES)\n            (DisequalityDispersion.Machine.bitv (DisequalityDispersion.Encoded.decideBits bs)))\n          (LE.le.{0} n (DisequalityDispersion.Machine.mainB (List.length.{0} bs)))))","unsafe":false,"value":504,"source":{"code":"/-- **The program halts on every input with the decision in `RES`**, within `mainB bs.length`\nsteps. -/\ntheorem program_run (bs : List Bool) :\n    ∃ (m' : Mem) (n t : ℕ), Run program (initCfg bs) ⟨Cmd.len mainM, m'⟩ n t ∧\n      Halted program ⟨Cmd.len mainM, m'⟩ ∧ m' RES = bitv (decideBits bs) ∧ n ≤ mainB bs.length := by\n  obtain ⟨m', kk, e, hk, hres⟩ := mainM_spec bs (inputMem bs) (inputMem_input bs)\n  obtain ⟨t, r⟩ := Cmd.compile_correct e program 0 program_codeAt\n  exact ⟨m', kk, t, by simpa [initCfg] using r, program_halted m', hres, hk⟩","start":224,"end":231,"lines":[[{"text":"/-- **The program halts on every input with the decision in `RES`**, within `mainB bs.length`"}],[{"text":"steps. -/"}],[{"text":"theorem program_run (bs : "},{"text":"List","name":"List"},{"text":" "},{"text":"Bool","name":"Bool"},{"text":") :"}],[{"text":"    ∃ (m' : "},{"text":"Mem","name":"DisequalityDispersion.Machine.Mem"},{"text":") (n t : "},{"text":"ℕ","name":"Nat"},{"text":"), "},{"text":"Run","name":"DisequalityDispersion.Machine.Run"},{"text":" "},{"text":"program","name":"DisequalityDispersion.Machine.program"},{"text":" "},{"text":"(initCfg bs)","name":"DisequalityDispersion.Machine.initCfg"},{"text":" "},{"text":"⟨Cmd.len mainM, m'⟩","name":"DisequalityDispersion.Machine.Cfg.mk"},{"text":" n t ∧"}],[{"text":"      "},{"text":"Halted","name":"DisequalityDispersion.Machine.Halted"},{"text":" "},{"text":"program","name":"DisequalityDispersion.Machine.program"},{"text":" "},{"text":"⟨Cmd.len mainM, m'⟩","name":"DisequalityDispersion.Machine.Cfg.mk"},{"text":" ∧ "},{"text":"m' RES = bitv (decideBits bs)","name":"Eq"},{"text":" ∧ "},{"text":"n ≤ mainB bs.length","name":"LE.le"},{"text":" := by"}],[{"text":"  obtain ⟨m', kk, e, hk, hres⟩ := "},{"text":"mainM_spec","name":"DisequalityDispersion.Machine.mainM_spec"},{"text":" bs "},{"text":"(inputMem bs)","name":"DisequalityDispersion.Machine.inputMem"},{"text":" "},{"text":"(inputMem_input bs)","name":"DisequalityDispersion.Machine.inputMem_input"}],[{"text":"  obtain ⟨t, r⟩ := "},{"text":"Cmd.compile_correct","name":"DisequalityDispersion.Machine.Cmd.compile_correct"},{"text":" e "},{"text":"program","name":"DisequalityDispersion.Machine.program"},{"text":" "},{"text":"0","name":"OfNat.ofNat"},{"text":" "},{"text":"program_codeAt","name":"DisequalityDispersion.Machine.program_codeAt"}],[{"text":"  exact "},{"text":"⟨m', kk, t, by simpa [initCfg] using r, program_halted m', hres, hk⟩","name":"Exists.intro"}]]},"steps":[{"after":[],"before":[0],"declaration":"DisequalityDispersion.Machine.program_run","elaborator":"[anonymous]","id":5964,"kind":"tactic","parent":0,"range":{"end":{"byte":12662,"column":76,"line":231},"start":{"byte":12423,"column":98,"line":228}},"syntax":"Lean.Parser.Term.byTactic","code":"by\n  obtain ⟨m', kk, e, hk, hres⟩ := mainM_spec bs (inputMem bs) (inputMem_input bs)\n  obtain ⟨t, r⟩ := Cmd.compile_correct e program 0 program_codeAt\n  exact ⟨m', kk, t, by simpa [initCfg] using r, program_halted m', hres, hk⟩"},{"after":[],"before":[0],"declaration":"DisequalityDispe