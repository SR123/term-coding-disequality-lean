ine":546,"line":539},"type":157,"typeText":"{L : Nat} →\n  {m0 : DisequalityDispersion.Machine.Mem} →\n    {hdr tot : Nat} →\n      {l : List.{0} Nat} →\n        {j : Nat} →\n          {m : DisequalityDispersion.Machine.Mem} →\n            {motive : DisequalityDispersion.Machine.FlatInv L m0 hdr tot l j m → Sort u} →\n              (t : DisequalityDispersion.Machine.FlatInv L m0 hdr tot l j m) →\n                ((agree :\n                      DisequalityDispersion.Machine.Agree m0 m\n                        (HAppend.hAppend.{0, 0, 0} (DisequalityDispersion.Machine.Lvars L)\n                          (DisequalityDispersion.Machine.Lvars (HAdd.hAdd.{0, 0, 0} L 1)))) →\n                    (i : Eq.{1} (m (DisequalityDispersion.Machine.I_ L)) j) →\n                      (cnt : Eq.{1} (m (DisequalityDispersion.Machine.CNT_ L)) (List.length.{0} l)) →\n                        (out : Eq.{1} (m (DisequalityDispersion.Machine.OUT_ L)) hdr) →\n                          (arr :\n                              Eq.{1} (DisequalityDispersion.Machine.arrAt m hdr)\n                                (List.flatten.{0}\n                                  (List.map.{0, 0} (fun q => DisequalityDispersion.Machine.arrAt m0 q)\n                                    (List.take.{0} j l)))) →\n                            (room :\n                                LE.le.{0} (HAdd.hAdd.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} hdr 1) tot)\n                                  (m DisequalityDispersion.Machine.HP)) →\n                              motive ⋯) →\n                  motive t","unsafe":false,"value":231,"source":{"code":"/-- The outer invariant of `flattenM`. -/\nstructure FlatInv (L : ℕ) (m0 : Mem) (hdr tot : ℕ) (l : List ℕ) (j : ℕ) (m : Mem) : Prop where\n  agree : Agree m0 m (Lvars L ++ Lvars (L + 1))\n  i : m (I_ L) = j\n  cnt : m (CNT_ L) = l.length\n  out : m (OUT_ L) = hdr\n  arr : arrAt m hdr = ((l.take j).map (fun q => arrAt m0 q)).flatten\n  room : hdr + 1 + tot ≤ m HP","start":539,"end":546,"lines":[[{"text":"/-- The outer invariant of `flattenM`. -/"}],[{"text":"structure FlatInv (L : ℕ) (m0 : Mem) (hdr tot : ℕ) (l : List ℕ) (j : ℕ) (m : Mem) : Prop where"}],[{"text":"  agree : Agree m0 m (Lvars L ++ Lvars (L + 1))"}],[{"text":"  i : m (I_ L) = j"}],[{"text":"  cnt : m (CNT_ L) = l.length"}],[{"text":"  out : m (OUT_ L) = hdr"}],[{"text":"  arr : arrAt m hdr = ((l.take j).map (fun q => arrAt m0 q)).flatten"}],[{"text":"  room : hdr + 1 + tot ≤ m HP"}]]},"steps":[],"stepGoalPool":[],"references":[],"axioms":[]}