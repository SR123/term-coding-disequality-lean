1,144,"implicit"],["lambda","α",0,145,"implicit"]],"project":false,"range":{"column":0,"endColumn":73,"endLine":98,"line":95},"type":36,"typeText":"∀ {α : Type u_1} {β : Type u_2} {m₁ m₂ : α → β} {f : Filter.{u_1} α},\n  Filter.EventuallyEq.{u_1, u_2} f m₁ m₂ → Eq.{u_2 + 1} (Filter.map.{u_1, u_2} m₁ f) (Filter.map.{u_1, u_2} m₂ f)","unsafe":false,"value":146,"source":{"code":"/-- If functions `m₁` and `m₂` are eventually equal at a filter `f`, then\nthey map this filter to the same filter. -/\ntheorem map_congr {m₁ m₂ : α → β} {f : Filter α} (h : m₁ =ᶠ[f] m₂) : map m₁ f = map m₂ f :=\n  Filter.ext' fun _ => eventually_congr (h.mono fun _ hx => hx ▸ Iff.rfl)","start":95,"end":98},"axioms":["Quot.sound","propext"]}