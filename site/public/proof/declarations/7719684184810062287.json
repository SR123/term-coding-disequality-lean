2,950],["lambda","h",95,951,"explicit"],["lambda","g",52,952,"explicit"],["lambda","f",33,953,"explicit"],["lambda","inst._@.Mathlib.GroupTheory.FreeGroup.Basic.3054158298._hygCtx._hyg.44",4,954,"instance"],["lambda","M",1,955,"implicit"],["lambda","α",0,956,"implicit"]],"project":false,"range":{"column":0,"endColumn":26,"endLine":644,"line":632},"type":105,"typeText":"∀ {α : Type u} {M : Type u_1} [inst : Monoid.{u_1} M] (f g : MonoidHom.{u, u_1} (FreeGroup.{u} α) M),\n  (∀ (a : α), Eq.{u_1 + 1} (f (FreeGroup.of.{u} a)) (g (FreeGroup.of.{u} a))) → Eq.{max (u + 1) (u_1 + 1)} f g","unsafe":false,"value":957,"source":{"code":"/-- Two homomorphisms out of a free group are equal if they are equal on generators.\n\nSee note [partially-applied ext lemmas]. -/\n@[to_additive (attr := ext) /-- Two homomorphisms out of a free additive group are equal if they are\n  equal on generators. See note [partially-applied ext lemmas]. -/]\nlemma ext_hom {M : Type*} [Monoid M] (f g : FreeGroup α →* M) (h : ∀ a, f (of a) = g (of a)) :\n    f = g := by\n  ext x\n  have this (x) : f (of x)⁻¹ = g (of x)⁻¹ := by\n    trans f (of x)⁻¹ * f (of x) * g (of x)⁻¹\n    · simp_rw [mul_assoc, h, ← _root_.map_mul, mul_inv_cancel, _root_.map_one, mul_one]\n    · simp_rw [← _root_.map_mul, inv_mul_cancel, _root_.map_one, one_mul]\n  induction x <;> simp [*]","start":632,"end":644},"axioms":["Quot.sound","propext"]}