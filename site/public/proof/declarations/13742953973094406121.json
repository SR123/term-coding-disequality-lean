it"],["lambda","x",0,738,"explicit"]],"project":false,"range":{"column":0,"endColumn":87,"endLine":279,"line":272},"type":43,"typeText":"∀ (x : Real) (n : Nat), Eq.{1} (Real.log (HPow.hPow.{0, 0, 0} x n)) (HMul.hMul.{0, 0, 0} (↑n) (Real.log x))","unsafe":false,"value":739,"source":{"code":"@[simp, push]\ntheorem log_pow (x : ℝ) (n : ℕ) : log (x ^ n) = n * log x := by\n  induction n with\n  | zero => simp\n  | succ n ih =>\n    rcases eq_or_ne x 0 with (rfl | hx)\n    · simp\n    · rw [pow_succ, log_mul (pow_ne_zero _ hx) hx, ih, Nat.cast_succ, add_mul, one_mul]","start":272,"end":279},"axioms":["Classical.choice","Quot.sound","propext"]}