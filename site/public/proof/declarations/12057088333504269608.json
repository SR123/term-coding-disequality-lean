"apply",60,6],["apply",61,2],["apply",57,62],["lambda","S₂",16,63,"explicit"],["lambda","S₁",8,64,"explicit"],["apply",13,65],["lambda","inst._@.Mathlib.Algebra.Group.Submonoid.Defs.1017350226._hygCtx._hyg.4",3,66,"instance"],["lambda","M",0,67,"implicit"]],"project":false,"range":{"column":0,"endColumn":86,"endLine":249,"line":243},"type":11,"typeText":"{M : Type u_1} → [inst : MulOneClass.{u_1} M] → Min.{u_1} (Submonoid.{u_1} M)","unsafe":false,"value":68,"source":{"code":"/-- The inf of two submonoids is their intersection. -/\n@[to_additive /-- The inf of two `AddSubmonoid`s is their intersection. -/]\ninstance : Min (Submonoid M) :=\n  ⟨fun S₁ S₂ =>\n    { carrier := S₁ ∩ S₂\n      one_mem' := ⟨S₁.one_mem, S₂.one_mem⟩\n      mul_mem' := fun ⟨hx, hx'⟩ ⟨hy, hy'⟩ => ⟨S₁.mul_mem hx hy, S₂.mul_mem hx' hy'⟩ }⟩","start":243,"end":249},"axioms":[]}