→\n    (∀ {m : Nat} (a : Nat.le n m), motive m a → motive (Nat.succ m) ⋯) → ∀ {a : Nat} (t : Nat.le n a), motive a t","unsafe":false,"value":null,"source":{"code":"/--\nNon-strict, or weak, inequality of natural numbers, usually accessed via the `≤` operator.\n-/\nprotected inductive Nat.le (n : Nat) : Nat → Prop\n  /-- Non-strict inequality is reflexive: `n ≤ n` -/\n  | refl     : Nat.le n n\n  /-- If `n ≤ m`, then `n ≤ m + 1`. -/\n  | step {m} : Nat.le n m → Nat.le n (succ m)","start":1838,"end":1845},"axioms":[]}