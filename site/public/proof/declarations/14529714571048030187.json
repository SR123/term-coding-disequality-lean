","n",0,69,"implicit"]],"project":false,"range":{"column":0,"endColumn":58,"endLine":1790,"line":1787},"type":22,"typeText":"{n : Nat} → (P : Fin n → Prop) → [DecidablePred.{1} P] → Decidable (∃ i, P i)","unsafe":false,"value":70,"source":{"code":"instance decidableExistsFin (P : Fin n → Prop) [DecidablePred P] : Decidable (∃ i, P i) :=\n  decidable_of_iff (∃ k, k < n ∧ ((h: k < n) → P ⟨k, h⟩))\n    ⟨fun ⟨k, a⟩ => Exists.intro ⟨k, a.left⟩ (a.right a.left),\n    fun ⟨i, e⟩ => Exists.intro i.val ⟨i.isLt, fun _ => e⟩⟩","start":1787,"end":1790},"axioms":["Quot.sound","propext"]}