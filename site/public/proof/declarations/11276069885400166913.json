],["constant","Semiring.toGrindSemiring._proof_15",[["param","u_1"]]],["apply",231,5],["apply",232,2],["apply",230,233],["lambda","s",3,234,"instance"],["lambda","α",0,235,"explicit"]],"project":false,"range":{"column":0,"endColumn":50,"endLine":48,"line":23},"type":8,"typeText":"(α : Type u_1) → [s : Semiring.{u_1} α] → Lean.Grind.Semiring.{u_1} α","unsafe":false,"value":236,"source":{"code":"instance (priority := 100) Semiring.toGrindSemiring [s : Semiring α] :\n    Grind.Semiring α :=\n  { s with\n    nsmul := ⟨s.nsmul⟩\n    npow := ⟨fun a n => a^n⟩\n    ofNat | 0 | 1 | n + 2 => inferInstance\n    natCast := inferInstance\n    add_zero := by simp [add_zero]\n    mul_one := by simp [mul_one]\n    zero_mul := by simp [zero_mul]\n    pow_zero a := by simp\n    pow_succ a n := by simp [pow_succ]\n    ofNat_eq_natCast\n    | 0 => Nat.cast_zero.symm\n    | 1 => Nat.cast_one.symm\n    | n + 2 => rfl\n    ofNat_succ\n    | 0 => by simp [zero_add]\n    | 1 => by\n      change Nat.cast 2 = 1 + 1\n      rw [one_add_one_eq_two]\n      rfl\n    | n + 2 => by\n      change Nat.cast (n + 2 + 1) = Nat.cast (n + 2) + 1\n      rw [← AddMonoidWithOne.natCast_succ]\n    nsmul_eq_natCast_mul n a := nsmul_eq_mul n a }","start":23,"end":48},"axioms":["Quot.sound","propext"]}