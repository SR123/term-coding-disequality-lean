"lambda","acc",4,222,"explicit"],["lambda","i",1,223,"explicit"],["lambda","fuel",1,224,"explicit"],["lambda","b",0,225,"explicit"]],"project":false,"range":{"column":2,"endColumn":92,"endLine":79,"line":69},"type":42,"typeText":"(b : ByteArray) →\n  (fuel i : Nat) →\n    Array.{0} Char →\n      LE.le.{0} i (ByteArray.size b) →\n        LT.lt.{0} (HSub.hSub.{0, 0, 0} (ByteArray.size b) i) fuel → Option.{0} (Array.{0} Char)","unsafe":false,"value":226,"source":{"code":"  go (fuel : Nat) (i : Nat) (acc : Array Char) (hi : i ≤ b.size) (hf : b.size - i < fuel) : Option (Array Char) :=\n    match fuel, hf with\n    | fuel + 1, _ =>\n      if i = b.size then\n        some acc\n      else\n        match h : utf8DecodeChar? b i with\n        | none => none\n        | some c => go fuel (i + c.utf8Size) (acc.push c)\n            (le_size_of_utf8DecodeChar?_eq_some h)\n            (have := c.utf8Size_pos; have := le_size_of_utf8DecodeChar?_eq_some h; by omega)","start":69,"end":79},"axioms":["Classical.choice","Quot.sound","propext"]}