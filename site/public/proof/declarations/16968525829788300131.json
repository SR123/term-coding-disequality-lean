xception m] [MonadLiftT BaseIO m] (cls : Name)\n    (k : m (α × MessageData)) (collapsed := true) (tag := \"\") : m α :=\n  let msg := fun\n    | .ok (_, msg) => return msg\n    | .error err => return err.toMessageData\n  Prod.fst <$> withTraceNode cls msg k collapsed tag","start":291,"end":297},"axioms":["Classical.choice","Quot.sound","propext"]}