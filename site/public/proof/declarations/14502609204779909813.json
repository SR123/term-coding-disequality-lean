y [maybeNormalize_eq, mk_eq_normalize, Int.divExact_eq_ediv]\n  have : g ≠ 0 := mt (by simp [·]) den_nz\n  rw [← normalize_mul_right _ this, Int.ediv_mul_cancel hn]\n  congr 1; exact Nat.div_mul_cancel hd","start":91,"end":98},"axioms":["Classical.choice","Quot.sound","propext"]}