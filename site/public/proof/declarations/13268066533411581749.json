n.Flow.Network.s N) →\n          DisequalityDispersion.Flow.Network.t N ∉ S →\n            LE.le.{0}\n              (DisequalityDispersion.Flow.Network.value N\n                (List.toFinset.{0} (DisequalityDispersion.Flow.Network.maxflow N)))\n              (DisequalityDispersion.Flow.Network.cap N S))\n      (∃ S,\n        And (Membership.mem.{0, 0} S (DisequalityDispersion.Flow.Network.s N))\n          (And (DisequalityDispersion.Flow.Network.t N ∉ S)\n            (Eq.{1}\n              (DisequalityDispersion.Flow.Network.value N\n                (List.toFinset.{0} (DisequalityDispersion.Flow.Network.maxflow N)))\n              (DisequalityDispersion.Flow.Network.cap N S))))","unsafe":false,"value":825,"source":{"code":"/-- **Max-flow min-cut** for unit capacities: the value of `maxflow` is the minimum capacity\nof an `s`–`t` cut, and it is attained by the reachable cut. -/\ntheorem maxflow_minCut (hN : N.Ok) :\n    (∀ S : Finset ν, N.s ∈ S → N.t ∉ S → N.value N.maxflow.toFinset ≤ N.cap S) ∧\n      ∃ S : Finset ν, N.s ∈ S ∧ N.t ∉ S ∧ N.value N.maxflow.toFinset = N.cap S := by\n  obtain ⟨hg, -, hs, ht, hv⟩ := N.maxflow_spec hN\n  exact ⟨fun S hsS htS => N.value_le_cap hN hg.flow S hsS htS, _, hs, ht, hv⟩","start":903,"end":909,"lines":[[{"text":"/-- **Max-flow min-cut** for unit capacities: the value of `maxflow` is the minimum capacity"}],[{"text":"of an `s`–`t` cut, and it is attained by the reachable cut. -/"}],[{"text":"theorem maxflow_minCut (hN : "},{"text":"N.Ok","name":"DisequalityDispersion.Flow.Network.Ok"},{"text":") :"}],[{"text":"    (∀ S : "},{"text":"Finset","name":"Finset"},{"text":" ν, "},{"text":"N.s","name":"DisequalityDispersion.Flow.Network.s"},{"text":" ∈ S → "},{"text":"N.t","name":"DisequalityDispersion.Flow.Network.t"},{"text":" ∉ S → "},{"text":"N.value N.maxflow.toFinset","name":"DisequalityDispersion.Flow.Network.value"},{"text":" ≤ "},{"text":"N.cap S","name":"DisequalityDispersion.Flow.Network.cap"},{"text":") ∧"}],[{"text":"      "}