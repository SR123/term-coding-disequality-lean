705,710],["apply",7,711],["apply",712,413],["apply",704,713],["apply",123,690],["apply",715,713],["apply",122,716],["apply",129,688],["apply",718,711],["apply",132,448],["lambda","_a",1,720,"explicit"],["apply",719,721],["apply",148,688],["apply",723,711],["apply",14,11],["apply",724,725],["apply",722,726],["apply",717,727],["apply",714,728],["constant","_private.Mathlib.Data.Nat.Find.0.Nat.findGreatest_eq_iff._proof_1_6",[]],["apply",730,107],["apply",731,39],["apply",732,17],["apply",733,14],["apply",734,11],["apply",735,5],["apply",729,736],["apply",703,737],["lambda","hk",685,738,"explicit"],["apply",684,739],["lambda","m",0,740,"implicit"],["lambda","ihk",91,741,"explicit"],["lambda","k",0,742,"explicit"],["apply",350,743],["apply",744,14],["apply",745,17],["lambda","inst._@.Mathlib.Data.Nat.Find.4043618914._hygCtx._hyg.31",6,746,"instance"],["lambda","P",2,747,"implicit"],["lambda","k",0,748,"implicit"],["lambda","m",0,749,"implicit"]],"project":false,"range":{"column":0,"endColumn":11,"endLine":201,"line":183},"type":63,"typeText":"∀ {m k : Nat} {P : Nat → Prop} [inst : DecidablePred.{1} P],\n  Iff (Eq.{1} (Nat.findGreatest P k) m)\n    (And (LE.le.{0} m k) (And (Ne.{1} m 0 → P m) (∀ ⦃n : Nat⦄, LT.lt.{0} m n → LE.le.{0} n k → Not (P n))))","unsafe":false,"value":750,"source":{"code":"lemma findGreatest_eq_iff :\n    Nat.findGreatest P k = m ↔ m ≤ k ∧ (m ≠ 0 → P m) ∧ ∀ ⦃n⦄, m < n → n ≤ k → ¬P n := by\n  induction k generalizing m with\n  | zero =>\n    rw [eq_comm, Iff.comm]\n    simp only [Nat.le_zero, ne_eq, findGreatest_zero, and_iff_left_iff_imp]\n    rintro rfl\n    exact ⟨fun h ↦ (h rfl).elim, fun n hlt heq ↦ by lia⟩\n  | succ k ihk =>\n    by_cases hk : P (k + 1)\n    · rw [findGreatest_eq hk]\n      constructor\n      · rintro rfl\n        exact ⟨le_refl _, fun _ ↦ hk, fun n hlt hle ↦ by lia⟩\n      · rintro ⟨hle, h0, hm⟩\n        rcases Decidable.lt_or_eq_of_le hle with hlt | rfl\n        exacts [(hm hlt (le_refl _) hk).elim, rfl]\n    · rw [findGreatest_of_not hk, ihk]\n      grind","start":183,"end":201},"axioms":["Classical.choice","Quot.sound","propext"]}