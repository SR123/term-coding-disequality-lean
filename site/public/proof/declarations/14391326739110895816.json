xplicit"],["forall","p",48,66,"explicit"],["forall","x",0,67,"implicit"],["constant","BitVec.shiftLeftZeroExtend._proof_1",[]],["apply",69,61],["apply",70,13],["bound",1],["apply",71,72],["apply",73,2],["lambda","m",0,74,"explicit"],["lambda","p",48,75,"explicit"],["lambda","x",0,76,"implicit"],["constant","BitVec.ofNatLT",[]],["apply",12,46],["apply",79,72],["apply",78,80],["constant","BitVec.toNat",[]],["apply",82,46],["apply",83,13],["apply",57,84],["apply",85,72],["apply",81,86],["constant","BitVec.shiftLeftZeroExtend._proof_2",[]],["apply",88,46],["apply",89,13],["apply",90,72],["apply",87,91],["let","shiftLeftLt",68,77,92,true],["lambda","m",0,93,"explicit"],["lambda","msbs",3,94,"explicit"],["lambda","w",0,95,"implicit"]],"project":false,"range":{"column":0,"endColumn":47,"endLine":471,"line":462},"type":19,"typeText":"{w : Nat} → BitVec w → (m : Nat) → BitVec (HAdd.hAdd.{0, 0, 0} w m)","unsafe":false,"value":96,"source":{"code":"/--\nReturns `zeroExtend (w+n) x <<< n` without needing to compute `x % 2^(2+n)`.\n-/\n@[expose]\ndef shiftLeftZeroExtend (msbs : BitVec w) (m : Nat) : BitVec (w + m) :=\n  let shiftLeftLt {x : Nat} (p : x < 2^w) (m : Nat) : x <<< m < 2^(w + m) := by\n        simp [Nat.shiftLeft_eq, Nat.pow_add]\n        apply Nat.mul_lt_mul_of_pos_right p\n        exact (Nat.two_pow_pos m)\n  (msbs.toNat <<< m)#'(shiftLeftLt msbs.isLt m)","start":462,"end":471},"axioms":["propext"]}