 (hy : 0 < y) (h1 : x < fuel1) (h2 : x < fuel2) :\n    Nat.div.go y hy fuel1 x h1 = Nat.div.go y hy fuel2 x h2 := by\n  match fuel1, fuel2 with\n  | 0, _ => contradiction\n  | _, 0 => contradiction\n  | succ fuel1, succ fuel2  =>\n    simp only [Nat.div.go]\n    split\n    next => rw [Nat.div.go.fuel_congr]\n    next => rfl\ntermination_by structural fuel1","start":25,"end":35},"axioms":[]}