type":2,"typeText":"Char → Nat","unsafe":false,"value":78,"source":{"code":"/-- Returns the number of bytes required to encode this `Char` in UTF-8. -/\ndef Char.utf8Size (c : Char) : Nat :=\n  let v := c.val\n  ite (LE.le v (UInt32.ofNatLT 0x7F (of_decide_eq_true rfl))) 1\n    (ite (LE.le v (UInt32.ofNatLT 0x7FF (of_decide_eq_true rfl))) 2\n      (ite (LE.le v (UInt32.ofNatLT 0xFFFF (of_decide_eq_true rfl))) 3 4))","start":2831,"end":2836},"axioms":[]}