pply",148,8],["apply",149,5],["apply",150,2],["apply",151,23],["apply",152,20],["lambda","sUnion",132,153,"explicit"],["lambda","inter",90,154,"explicit"],["lambda","univ",49,155,"explicit"],["lambda","basic",42,156,"explicit"],["lambda","t",19,157,"explicit"],["lambda","a._@._internal._hyg.0",15,158,"implicit"],["lambda","motive",14,159,"implicit"],["lambda","g",4,160,"implicit"],["lambda","α",0,161,"implicit"]],"project":false,"range":{"column":0,"endColumn":83,"endLine":64,"line":59},"type":143,"typeText":"∀ {α : Type u} {g : Set.{u} (Set.{u} α)} {motive : (a : Set.{u} α) → TopologicalSpace.GenerateOpen.{u} g a → Prop}\n  {a : Set.{u} α} (t : TopologicalSpace.GenerateOpen.{u} g a),\n  (∀ (s : Set.{u} α) (a : Membership.mem.{u, u} g s), motive s ⋯) →\n    motive Set.univ.{u} ⋯ →\n      (∀ (s t : Set.{u} α) (a : TopologicalSpace.GenerateOpen.{u} g s) (a_1 : TopologicalSpace.GenerateOpen.{u} g t),\n          motive s a → motive t a_1 → motive (Inter.inter.{u} s t) ⋯) →\n        (∀ (S : Set.{u} (Set.{u} α))\n            (a : ∀ (s : Set.{u} α), Membership.mem.{u, u} S s → TopologicalSpace.GenerateOpen.{u} g s),\n            (∀ (s : Set.{u} α) (a_1 : Membership.mem.{u, u} S s), motive s ⋯) → motive (Set.sUnion.{u} S) ⋯) →\n          motive a t","unsafe":false,"value":162,"source":{"code":"/-- The open sets of the least topology containing a collection of basic sets. -/\ninductive GenerateOpen (g : Set (Set α)) : Set α → Prop\n  | basic : ∀ s ∈ g, GenerateOpen g s\n  | univ : GenerateOpen g univ\n  | inter : ∀ s t, GenerateOpen g s → GenerateOpen g t → GenerateOpen g (s ∩ t)\n  | sUnion : ∀ S : Set (Set α), (∀ s ∈ S, GenerateOpen g s) → GenerateOpen g (⋃₀ S)","start":59,"end":64},"axioms":[]}