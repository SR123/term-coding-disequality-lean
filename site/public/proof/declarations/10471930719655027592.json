roup.Lattice.1017350226._hygCtx._hyg.3",3,57,"instance"],["lambda","G",0,58,"implicit"]],"project":false,"range":{"column":0,"endColumn":69,"endLine":226,"line":221},"type":11,"typeText":"{G : Type u_1} → [inst : Group.{u_1} G] → Min.{u_1} (Subgroup.{u_1} G)","unsafe":false,"value":59,"source":{"code":"/-- The inf of two subgroups is their intersection. -/\n@[to_additive /-- The inf of two `AddSubgroup`s is their intersection. -/]\ninstance : Min (Subgroup G) :=\n  ⟨fun H₁ H₂ =>\n    { H₁.toSubmonoid ⊓ H₂.toSubmonoid with\n      inv_mem' := fun ⟨hx, hx'⟩ => ⟨H₁.inv_mem hx, H₂.inv_mem hx'⟩ }⟩","start":221,"end":226},"axioms":["propext"]}