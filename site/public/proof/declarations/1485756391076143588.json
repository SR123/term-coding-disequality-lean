]'h₁ = l₂[i]'h₂) : l₁ = l₂ :=\n  ext_getElem? fun n =>\n    if h₁ : n < length l₁ then by\n      simp_all\n    else by\n      have h₁ := Nat.le_of_not_lt h₁\n      rw [getElem?_eq_none h₁, getElem?_eq_none]; rwa [← hl]","start":292,"end":299},"axioms":["Quot.sound","propext"]}