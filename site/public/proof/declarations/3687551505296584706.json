mbda","f",8,66,"explicit"],["lambda","tY",6,67,"instance"],["lambda","tX",4,68,"instance"],["lambda","Y",1,69,"implicit"],["lambda","X",0,70,"implicit"]],"project":false,"range":{"column":0,"endColumn":32,"endLine":109,"line":103},"type":54,"typeText":"{X : Type u_1} →\n  {Y : Type u_2} →\n    [tX : TopologicalSpace.{u_1} X] →\n      [tY : TopologicalSpace.{u_2} Y] →\n        {f : X → Y} →\n          {motive : Topology.IsInducing.{u_1, u_2} f → Sort u} →\n            ((eq_induced : Eq.{u_1 + 1} tX (TopologicalSpace.induced.{u_1, u_2} f tY)) → motive ⋯) →\n              (t : Topology.IsInducing.{u_1, u_2} f) → motive t","unsafe":false,"value":null,"source":{"code":"/-- A function `f : X → Y` between topological spaces is inducing if the topology on `X` is induced\nby the topology on `Y` through `f`, meaning that a set `s : Set X` is open iff it is the preimage\nunder `f` of some open set `t : Set Y`. -/\n@[fun_prop, mk_iff]\nstructure IsInducing (f : X → Y) : Prop where\n  /-- The topology on the domain is equal to the induced topology. -/\n  eq_induced : tX = tY.induced f","start":103,"end":109},"axioms":["Classical.choice","Quot.sound","propext"]}