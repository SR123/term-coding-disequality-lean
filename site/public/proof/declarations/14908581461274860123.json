se,"value":247,"source":{"code":"theorem Coprime.coprime_div_left (cmn : Coprime m n) (dvd : a ∣ m) : Coprime (m / a) n := by\n  match eq_zero_or_pos a with\n  | .inl h0 =>\n    rw [h0] at dvd\n    rw [Nat.eq_zero_of_zero_dvd dvd] at cmn ⊢\n    simp; assumption\n  | .inr hpos =>\n    let ⟨k, hk⟩ := dvd\n    rw [hk, Nat.mul_div_cancel_left _ hpos]\n    rw [hk] at cmn\n    exact cmn.coprime_mul_left","start":113,"end":123},"axioms":["propext"]}