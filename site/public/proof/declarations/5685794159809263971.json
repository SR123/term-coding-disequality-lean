87,23],["apply",188,19],["apply",189,18],["apply",190,9],["apply",186,191],["constant","LinearOrder.lift._proof_2",[["param","u_3"],["param","u_2"]]],["apply",193,23],["apply",194,19],["apply",195,18],["apply",196,9],["apply",192,197],["apply",198,3],["apply",199,26],["constant","LinearOrder.lift._proof_3",[["param","u_3"],["param","u_2"]]],["apply",201,23],["apply",202,19],["apply",203,18],["apply",204,9],["apply",200,205],["lambda","hinf",65,206,"explicit"],["lambda","hsup",43,207,"explicit"],["lambda","inj",17,208,"explicit"],["lambda","f",12,209,"explicit"],["lambda","inst._@.Mathlib.Order.Basic.1136412007._hygCtx._hyg.14",10,210,"instance"],["lambda","inst._@.Mathlib.Order.Basic.1136412007._hygCtx._hyg.11",7,211,"instance"],["lambda","inst._@.Mathlib.Order.Basic.1136412007._hygCtx._hyg.8",4,212,"instance"],["lambda","β",1,213,"implicit"],["lambda","α",0,214,"implicit"]],"project":false,"range":{"column":0,"endColumn":56,"endLine":893,"line":874},"type":76,"typeText":"{α : Type u_2} →\n  {β : Type u_3} →\n    [inst : LinearOrder.{u_3} β] →\n      [inst_1 : Max.{u_2} α] →\n        [inst_2 : Min.{u_2} α] →\n          (f : α → β) →\n            Function.Injective.{u_2 + 1, u_3 + 1} f →\n              (∀ (x y : α), Eq.{u_3 + 1} (f (x ⊔ y)) (Max.max.{u_3} (f x) (f y))) →\n                (∀ (x y : α), Eq.{u_3 + 1} (f (x ⊓ y)) (Min.min.{u_3} (f x) (f y))) → LinearOrder.{u_2} α","unsafe":false,"value":215,"source":{"code":"/-- Transfer a `LinearOrder` on `β` to a `LinearOrder` on `α` using an injective\nfunction `f : α → β`. This version takes `[Max α]` and `[Min α]` as arguments, then uses\nthem for `max` and `min` fields. See `LinearOrder.lift'` for a version that autogenerates `min` and\n`max` fields, and `LinearOrder.liftWithOrd` for one that does not auto-generate `compare`\nfields.\n\nSee also `Function.Injective.linearOrder` when only the proof fields need to be transferred.\n\nSee note [reducible non-instances]. -/\n@[to_dual self (reorder := 4 5, hsup hinf)]\nabbrev LinearOrder.lift [LinearOrder β] [Max α] [Min α] (f : α → β) (inj : Injective f)\n    (hsup : ∀ x y, f (x ⊔ y) = max (f x) (f y)) (hinf : ∀ x y, f (x ⊓ y) = min (f x) (f y)) :\n    LinearOrder α :=\n  letI _instLE : LE α := ⟨fun a b ↦ f a ≤ f b⟩\n  letI _instLT : LT α := ⟨fun a b ↦ f a < f b⟩\n  letI _instOrdα : Ord α := ⟨fun a b ↦ compare (f a) (f b)⟩\n  letI _decidableLE := fun x y ↦ (inferInstance : Decidable (f x ≤ f y))\n  letI _decidableLT := fun x y ↦ (inferInstance : Decidable (f x < f y))\n  letI _decidableEq := fun x y ↦ decidable_of_iff (f x = f y) inj.eq_iff\n  inj.linearOrder _ .rfl .rfl hinf hsup (fun _ _ => rfl)","start":874,"end":893},"axioms":["propext"]}