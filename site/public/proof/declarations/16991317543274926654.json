mas.1984644472._hygCtx._hyg.117",33,267,"explicit"],["apply",203,268],["lambda","b",0,269,"implicit"],["lambda","a",0,270,"implicit"]],"project":false,"range":{"column":0,"endColumn":31,"endLine":530,"line":522},"type":36,"typeText":"∀ {a b : Rat}, Iff (Eq.{1} (HMul.hMul.{0, 0, 0} a b) 0) (Or (Eq.{1} a 0) (Eq.{1} b 0))","unsafe":false,"value":271,"source":{"code":"protected theorem mul_eq_zero {a b : Rat} : a * b = 0 ↔ a = 0 ∨ b = 0 := by\n  constructor\n  · intro h\n    replace h := congrArg (· * b⁻¹) h\n    apply Decidable.byContradiction fun h' => ?_\n    rw [not_or] at h'\n    simp only [Rat.zero_mul, Rat.mul_assoc, Rat.mul_inv_cancel _ h'.2, Rat.mul_one] at h\n    exact absurd h h'.1\n  · rintro (h | h) <;> simp [h]","start":522,"end":530},"axioms":["Classical.choice","Quot.sound","propext"]}