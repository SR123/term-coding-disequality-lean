":75,"endLine":404,"line":401},"type":20,"typeText":"∀ (x y : Nat), Eq.{1} (Min.min.{0} (Nat.succ x) (Nat.succ y)) (Nat.succ (Min.min.{0} x y))","unsafe":false,"value":179,"source":{"code":"theorem succ_min_succ (x y) : min (succ x) (succ y) = succ (min x y) := by\n  cases Nat.le_total x y with\n  | inl h => rw [Nat.min_eq_left h, Nat.min_eq_left (Nat.succ_le_succ h)]\n  | inr h => rw [Nat.min_eq_right h, Nat.min_eq_right (Nat.succ_le_succ h)]","start":401,"end":404},"axioms":["propext"]}