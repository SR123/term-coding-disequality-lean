.Tactic.FieldSimp.NF.{u_1} M},\n      Eq.{u_1 + 1}\n          (HMul.hMul.{u_1, u_1, u_1} (Mathlib.Tactic.FieldSimp.NF.eval.{u_1} L)\n            (Mathlib.Tactic.FieldSimp.NF.eval.{u_1} l))\n          (Mathlib.Tactic.FieldSimp.NF.eval.{u_1} l') →\n        Eq.{u_1 + 1}\n          (HMul.hMul.{u_1, u_1, u_1}\n            (Mathlib.Tactic.FieldSimp.NF.eval.{u_1} (Mathlib.Tactic.FieldSimp.NF.cons.{u_1} (Prod.mk.{0, u_1} n e) L))\n            (Mathlib.Tactic.FieldSimp.NF.eval.{u_1}\n              (Mathlib.Tactic.FieldSimp.NF.cons.{u_1} (Prod.mk.{0, u_1} (Neg.neg.{0} n) e) l)))\n          (Mathlib.Tactic.FieldSimp.NF.eval.{u_1} l')","unsafe":false,"value":361,"source":{"code":"theorem eval_cons_mul_eval_cons_neg [CommGroupWithZero M] (n : ℤ) {e : M} (he : e ≠ 0)\n    {L l l' : NF M} (h : L.eval * l.eval = l'.eval) :\n    ((n, e) ::ᵣ L).eval * ((-n, e) ::ᵣ l).eval = l'.eval := by\n  rw [mul_eq_eval₂ n (-n) e h]\n  simp [zpow'_zero_of_ne_zero he]","start":291,"end":295},"axioms":["Classical.choice","Quot.sound","propext"]}