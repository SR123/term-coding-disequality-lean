oZeroDivisors (M₀ : Type*) [Mul M₀] [Zero M₀] : Prop where\n  /-- For all `a` and `b` of `M₀`, `a * b = 0` implies `a = 0` or `b = 0`. -/\n  eq_zero_or_eq_zero_of_mul_eq_zero : ∀ {a b : M₀}, a * b = 0 → a = 0 ∨ b = 0","start":88,"end":93},"axioms":[]}