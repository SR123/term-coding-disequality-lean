lumn":0,"endColumn":32,"endLine":482,"line":474},"type":83,"typeText":"∀ {α : Type u_1} {β : Type u_2} {σ : Type u_3} [inst : Primcodable.{u_1} α] [inst_1 : Primcodable.{u_2} β]\n  [inst_2 : Primcodable.{u_3} σ] {f : α → β → σ},\n  Iff (Primrec₂.{u_1, u_2, u_3} f)\n    (Nat.Primrec\n      (Nat.unpaired.{1} fun m n =>\n        Encodable.encode.{u_3}\n          (Option.bind.{u_1, u_3} (Encodable.decode.{u_1} m) fun a =>\n            Option.map.{u_2, u_3} (f a) (Encodable.decode.{u_2} n))))","unsafe":false,"value":732,"source":{"code":"theorem nat_iff {f : α → β → σ} : Primrec₂ f ↔ Nat.Primrec\n    (.unpaired fun m n => encode <| (@decode α _ m).bind fun a => (@decode β _ n).map (f a)) := by\n  have :\n    ∀ (a : Option α) (b : Option β),\n      Option.map (fun p : α × β => f p.1 p.2)\n          (Option.bind a fun a : α => Option.map (Prod.mk a) b) =\n        Option.bind a fun a => Option.map (f a) b := fun a b => by\n          cases a <;> cases b <;> rfl\n  simp [Primrec₂, Primrec, this]","start":474,"end":482},"axioms":["Classical.choice","Quot.sound","propext"]}