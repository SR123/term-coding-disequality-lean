2,764],["lambda","_",223,765,"explicit"],["apply",643,766],["lambda","x._@.Std.Data.DTreeMap.Internal.Operations.3553935047._hygCtx._hyg.4064",326,767,"explicit"],["lambda","hl",291,768,"explicit"],["lambda","r'",279,769,"explicit"],["lambda","l'",277,770,"explicit"],["lambda","v'",129,771,"explicit"],["lambda","k'",129,772,"explicit"],["lambda","sz",29,773,"explicit"],["apply",275,774],["apply",775,3],["lambda","hl",123,776,"explicit"],["lambda","f",122,777,"explicit"],["lambda","t",75,778,"explicit"],["apply",97,779],["apply",780,21],["lambda","hl",22,781,"explicit"],["lambda","t",15,782,"explicit"],["lambda","f",10,783,"explicit"],["lambda","k",5,784,"explicit"],["lambda","inst._@.Std.Data.DTreeMap.Internal.Operations.3553935047._hygCtx._hyg.11",4,785,"instance"],["lambda","β",1,786,"implicit"],["lambda","α",0,787,"implicit"]],"project":false,"range":{"column":0,"endColumn":48,"endLine":907,"line":882},"type":70,"typeText":"{α : Type u} →\n  {β : Type v} →\n    [Ord.{u} α] →\n      α →\n        (Option.{v} β → Option.{v} β) →\n          (t : Std.DTreeMap.Internal.Impl.{u, v} α fun x => β) →\n            Std.DTreeMap.Internal.Impl.Balanced.{u, v} t →\n              Std.DTreeMap.Internal.Impl.SizedBalancedTree.{u, v} α (fun x => β)\n                (HSub.hSub.{0, 0, 0} (Std.DTreeMap.Internal.Impl.size.{u, v} t) 1)\n                (HAdd.hAdd.{0, 0, 0} (Std.DTreeMap.Internal.Impl.size.{u, v} t) 1)","unsafe":false,"value":788,"source":{"code":"/--\nChanges the mapping of the key `k` by applying the function `f` to the current mapped value\n(if any). This function can be used to insert a new mapping, modify an existing one or delete it.\nThis version of the function requires `LawfulEqOrd α`. There is an alternative non-dependent version\ncalled `Const.alter`.\n-/\n@[specialize]\ndef alter [Ord α] (k : α) (f : Option β → Option β) (t : Impl α β)\n    (hl : t.Balanced) : SizedBalancedTree α β (t.size - 1) (t.size + 1) :=\n  match t with\n  | .leaf =>\n    match f none with\n    | none => ⟨.leaf, ✓, ✓, ✓⟩\n    | some v => ⟨.inner 1 k v .leaf .leaf, ✓, ✓, ✓⟩\n  | .inner sz k' v' l' r' =>\n    match compare k k' with\n    | .lt =>\n      let ⟨d, hd, hd'₁, hd'₂⟩ := alter k f l' ✓\n      ⟨balance k' v' d r' ✓ ✓ (hl.at_root.adjust_left hd'₁ hd'₂), ✓, ✓, ✓⟩\n    | .gt =>\n      let ⟨d, hd, hd'₁, hd'₂⟩ := alter k f r' ✓\n      ⟨balance k' v' l' d ✓ ✓ (hl.at_root.adjust_right hd'₁ hd'₂), ✓, ✓, ✓⟩\n    | .eq =>\n      match f (some v') with\n      | none => ⟨glue l' r' ✓ ✓ ✓, ✓, ✓, ✓⟩\n      | some v => ⟨.inner sz k v l' r', ✓, ✓, ✓⟩","start":882,"end":907},"axioms":["Classical.choice","Quot.sound","propext"]}