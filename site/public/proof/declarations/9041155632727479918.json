Type u} →\n  (u : UniformSpace.Core.{u} α) →\n    (t : TopologicalSpace.{u} α) → Eq.{u + 1} t (UniformSpace.Core.toTopologicalSpace.{u} u) → UniformSpace.{u} α","unsafe":false,"value":50,"source":{"code":"/-- Construct a `UniformSpace` from a `u : UniformSpace.Core` and a `TopologicalSpace` structure\nthat is equal to `u.toTopologicalSpace`. -/\nabbrev UniformSpace.ofCoreEq {α : Type u} (u : UniformSpace.Core α) (t : TopologicalSpace α)\n    (h : t = u.toTopologicalSpace) : UniformSpace α where\n  __ := u\n  toTopologicalSpace := t\n  nhds_eq_comap_uniformity x := by rw [h, u.nhds_toTopologicalSpace]","start":395,"end":401},"axioms":["Classical.choice","Quot.sound","propext"]}