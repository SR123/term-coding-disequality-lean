47._hygCtx._hyg.466",575,1407,"explicit"],["lambda","x",178,1408,"explicit"],["lambda","h",529,1409,"explicit"],["lambda","f",166,1410,"explicit"],["lambda","l",145,1411,"explicit"],["lambda","a",85,1412,"explicit"],["apply",515,1413],["apply",1414,11],["lambda","x._@.Mathlib.Data.Fintype.Perm.74439947._hygCtx._hyg.43",80,1415,"explicit"],["lambda","x._@.Mathlib.Data.Fintype.Perm.74439947._hygCtx._hyg.42",160,1416,"explicit"],["lambda","x._@.Mathlib.Data.Fintype.Perm.74439947._hygCtx._hyg.41",68,1417,"explicit"],["lambda","f",157,1418,"explicit"],["lambda","x._@.Mathlib.Data.Fintype.Perm.74439947._hygCtx._hyg.40",65,1419,"explicit"],["apply",112,1420],["apply",1421,8],["apply",1422,5],["apply",1423,2],["lambda","x._@.Mathlib.Data.Fintype.Perm.74439947._hygCtx._hyg.43",25,1424,"explicit"],["lambda","x._@.Mathlib.Data.Fintype.Perm.74439947._hygCtx._hyg.42",24,1425,"explicit"],["lambda","x._@.Mathlib.Data.Fintype.Perm.74439947._hygCtx._hyg.41",9,1426,"explicit"],["lambda","x._@.Mathlib.Data.Fintype.Perm.74439947._hygCtx._hyg.40",6,1427,"explicit"],["lambda","inst._@.Mathlib.Data.Fintype.Perm.74439947._hygCtx._hyg.5",3,1428,"instance"],["lambda","α",0,1429,"implicit"]],"project":false,"range":{"column":0,"endColumn":76,"endLine":91,"line":76},"type":62,"typeText":"∀ {α : Type u_1} [inst : DecidableEq.{u_1 + 1} α] {l : List.{u_1} α} {f : Equiv.Perm.{u_1 + 1} α},\n  Membership.mem.{u_1, u_1} (permsOfList.{u_1} l) f → ∀ {x : α}, Ne.{u_1 + 1} (f x) x → Membership.mem.{u_1, u_1} l x","unsafe":false,"value":1430,"source":{"code":"theorem mem_of_mem_permsOfList :\n    ∀ {l : List α} {f : Perm α}, f ∈ permsOfList l → {x : α} → f x ≠ x → x ∈ l\n  | [], f, h, heq_iff_eq => by\n    have : f = 1 := by simpa [permsOfList] using h\n    rw [this]; simp\n  | a :: l, f, h, x =>\n    (mem_append.1 h).elim (fun h hx => mem_cons_of_mem _ (mem_of_mem_permsOfList h hx))\n      fun h hx =>\n      let ⟨y, hy, hy'⟩ := List.mem_flatMap.1 h\n      let ⟨g, hg₁, hg₂⟩ := List.mem_map.1 hy'\n      if hxa : x = a then by simp [hxa]\n      else\n        if hxy : x = y then mem_cons_of_mem _ <| by rwa [hxy]\n        else mem_cons_of_mem a <| mem_of_mem_permsOfList hg₁ <| by\n              rw [eq_inv_mul_iff_mul_eq.2 hg₂, mul_apply, swap_inv, swap_apply_def]\n              split_ifs <;> [exact Ne.symm hxy; exact Ne.symm hxa; exact hx]","start":76,"end":91},"axioms":["Classical.choice","Quot.sound","propext"]}