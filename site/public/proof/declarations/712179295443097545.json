:false,"range":{"column":0,"endColumn":26,"endLine":174,"line":170},"type":24,"typeText":"∀ (a : Nat), Eq.{1} (HMod.hMod.{0, 0, 0} a 0) a","unsafe":false,"value":154,"source":{"code":"@[simp] theorem mod_zero (a : Nat) : a % 0 = a :=\n  have : (if 0 < 0 ∧ 0 ≤ a then (a - 0) % 0 else a) = a :=\n    have h : ¬ (0 < 0 ∧ 0 ≤ a) := fun ⟨h₁, _⟩ => absurd h₁ (Nat.lt_irrefl _)\n    if_neg h\n  (mod_eq a 0).symm ▸ this","start":170,"end":174},"axioms":["propext"]}