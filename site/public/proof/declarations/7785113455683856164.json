  go (fuel : Nat) (m₁ m₂ : Mon) : Mon :=\n    match fuel with\n    | 0 => concat m₁ m₂\n    | fuel + 1 =>\n      match m₁, m₂ with\n      | m₁, .unit => m₁\n      | .unit, m₂ => m₂\n      | .mult pw₁ m₁, .mult pw₂ m₂ =>\n        bif pw₁.varLt pw₂ then\n          .mult pw₁ (go fuel m₁ (.mult pw₂ m₂))\n        else bif pw₂.varLt pw₁ then\n          .mult pw₂ (go fuel (.mult pw₁ m₁) m₂)\n        else\n          .mult { x := pw₁.x, k := pw₁.k + pw₂.k } (go fuel m₁ m₂)","start":168,"end":181},"axioms":[]}