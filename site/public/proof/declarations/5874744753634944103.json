line":441},"type":47,"typeText":"∀ {α : Type u_1} [inst : DecidableEq.{u_1 + 1} α] (a : α) {s : Multiset.{u_1} α},\n  Multiset.Nodup.{u_1} s → Eq.{u_1 + 1} (Multiset.erase.{u_1} s a) (Multiset.filter.{u_1} (fun x => Ne.{u_1 + 1} x a) s)","unsafe":false,"value":220,"source":{"code":"theorem Nodup.erase_eq_filter [DecidableEq α] (a : α) {s} :\n    Nodup s → s.erase a = Multiset.filter (· ≠ a) s :=\n  Quot.induction_on s fun _ d =>\n    congr_arg ((↑) : List α → Multiset α) <| by simpa using List.Nodup.erase_eq_filter d a","start":441,"end":444},"axioms":["Classical.choice","Quot.sound","propext"]}