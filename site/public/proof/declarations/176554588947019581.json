eded?\n    focus\n      rw [Nat.mul_sub_right_distrib, Nat.mul_comm]\n      exact Nat.sub_le_sub_left (div_mul_le_self ..) _\n    focus\n      rwa [div_lt_iff_lt_mul npos, Nat.mul_comm]","start":378,"end":393},"axioms":["propext"]}