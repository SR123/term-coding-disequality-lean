 BEq.beq.{0} a 0 then Lean.Grind.Linarith.Poly.combine' fuel p₁ p₂\n          else Lean.Grind.Linarith.Poly.add a x₁ (Lean.Grind.Linarith.Poly.combine' fuel p₁ p₂)\n        else\n          bif Nat.blt x₂ x₁ then\n            Lean.Grind.Linarith.Poly.add a₁ x₁\n              (Lean.Grind.Linarith.Poly.combine' fuel p₁ (Lean.Grind.Linarith.Poly.add a₂ x₂ p₂))\n          else\n            Lean.Grind.Linarith.Poly.add a₂ x₂\n              (Lean.Grind.Linarith.Poly.combine' fuel (Lean.Grind.Linarith.Poly.add a₁ x₁ p₁) p₂))","unsafe":false,"value":507,"axioms":[]}