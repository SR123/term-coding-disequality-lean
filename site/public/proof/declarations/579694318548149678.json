:false,"value":451,"source":{"code":"@[simp]\ntheorem sin_pi_div_two : sin (π / 2) = 1 :=\n  have : sin (π / 2) = 1 ∨ sin (π / 2) = -1 := by\n    simpa [sq, mul_self_eq_one_iff] using sin_sq_add_cos_sq (π / 2)\n  this.resolve_right fun h =>\n    show ¬(0 : ℝ) < -1 by simp <|\n      h ▸ sin_pos_of_pos_of_lt_pi pi_div_two_pos (half_lt_self pi_pos)","start":437,"end":443},"axioms":["Classical.choice","Quot.sound","propext"]}