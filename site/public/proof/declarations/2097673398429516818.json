",9,710,"explicit"],["lambda","s",4,711,"explicit"],["lambda","ι",1,712,"implicit"],["lambda","α",0,713,"implicit"]],"project":false,"range":{"column":0,"endColumn":92,"endLine":213,"line":207},"type":63,"typeText":"∀ {α : Type u} {ι : Type w} (s : Finset.{w} ι) (f : ι → Set.{u} α),\n  Eq.{u + 1} (⨅ i, ⨅ (_ : Membership.mem.{w, w} s i), Filter.principal.{u} (f i))\n    (Filter.principal.{u} (⋂ i, ⋂ (_ : Membership.mem.{w, w} s i), f i))","unsafe":false,"value":714,"source":{"code":"@[simp]\ntheorem iInf_principal_finset {ι : Type w} (s : Finset ι) (f : ι → Set α) :\n    ⨅ i ∈ s, 𝓟 (f i) = 𝓟 (⋂ i ∈ s, f i) := by\n  classical\n  induction s using Finset.induction_on with\n  | empty => simp\n  | insert i s _ hs => rw [Finset.iInf_insert, Finset.set_biInter_insert, hs, inf_principal]","start":207,"end":213},"axioms":["Classical.choice","Quot.sound","propext"]}