6,579],["lambda","h._@.Init.Data.Int.Lemmas.234863821._hygCtx._hyg.48",485,580,"explicit"],["lambda","h'",64,581,"explicit"],["apply",480,582],["constant","Eq.refl",[["zero"]]],["apply",584,67],["apply",585,20],["apply",583,586],["let","h",54,57,587,true],["lambda","k",0,588,"explicit"],["lambda","n",0,589,"explicit"],["lambda","m",0,590,"explicit"]],"project":false,"range":{"column":0,"endColumn":19,"endLine":191,"line":177},"type":39,"typeText":"∀ (m n k : Nat),\n  Eq.{1} (HAdd.hAdd.{0, 0, 0} (Int.subNatNat m n) (Int.negSucc k))\n    (Int.subNatNat m (HAdd.hAdd.{0, 0, 0} n (Nat.succ k)))","unsafe":false,"value":591,"source":{"code":"theorem subNatNat_add_negSucc (m n k : Nat) :\n    subNatNat m n + -[k+1] = subNatNat m (n + succ k) := by\n  have h := Nat.lt_or_ge m n\n  cases h with\n  | inr h' =>\n    rw [subNatNat_of_le h']\n    simp\n    rw [subNatNat_sub h', Nat.add_comm]\n  | inl h' =>\n    have h₂ : m < n + succ k := Nat.lt_of_lt_of_le h' (le_add_right _ _)\n    rw [subNatNat_of_lt h', subNatNat_of_lt h₂]\n    simp only [pred_eq_sub_one, negSucc_add_negSucc, succ_eq_add_one, negSucc.injEq]\n    rw [Nat.add_right_comm, sub_one_add_one_eq_of_pos (Nat.sub_pos_of_lt h'), Nat.sub_sub,\n      ← Nat.add_assoc, succ_sub_succ_eq_sub, Nat.add_comm n,Nat.add_sub_assoc (Nat.le_of_lt h'),\n      Nat.add_comm]","start":177,"end":191},"axioms":["propext"]}