],["apply",59,61],["constant","nhds",[["param","u"]]],["apply",63,60],["apply",64,28],["apply",65,2],["apply",62,66],["constant","Filter.comap",[["param","u"],["param","u"]]],["apply",68,60],["apply",10,60],["apply",70,60],["apply",69,71],["constant","Prod.mk",[["param","u"],["param","u"]]],["apply",73,60],["apply",74,60],["apply",75,2],["apply",72,76],["apply",77,16],["apply",67,78],["forall","x",49,79,"explicit"],["constant","UniformSpace.mk",[["param","u"]]],["apply",81,60],["apply",82,28],["apply",83,16],["apply",84,11],["apply",85,7],["apply",86,2],["apply",49,87],["forall","nhds_eq_comap_uniformity",80,88,"explicit"],["forall","comp",58,89,"explicit"],["forall","symm",26,90,"explicit"],["forall","uniformity",14,91,"explicit"],["forall","toTopologicalSpace",8,92,"instance"],["apply",1,11],["apply",11,2],["forall","t",94,95,"explicit"],["forall","mk",93,96,"explicit"],["forall","motive",5,97,"implicit"],["forall","α",0,98,"implicit"],["apply",6,11],["apply",9,18],["apply",15,30],["apply",102,30],["apply",21,28],["apply",104,28],["apply",103,105],["apply",106,2],["apply",107,2],["apply",10,49],["apply",109,49],["apply",9,110],["apply",27,111],["apply",33,111],["apply",35,111],["apply",37,110],["apply",114,115],["apply",113,116],["apply",112,117],["apply",42,110],["apply",119,110],["apply",120,7],["apply",46,110],["apply",48,60],["apply",123,60],["apply",124,60],["apply",125,2],["apply",126,2],["lambda","s",122,127,"explicit"],["apply",121,128],["apply",118,129],["apply",130,7],["bound",7],["apply",9,132],["apply",59,133],["apply",63,132],["apply",135,28],["apply",136,2],["apply",134,137],["apply",68,132],["apply",10,132],["apply",140,132],["apply",139,141],["apply",73,132],["apply",143,132],["apply",144,2],["apply",142,145],["apply",146,16],["apply",138,147],["forall","x",60,148,"explicit"],["apply",49,28],["apply",150,16],["apply",151,11],["apply",152,7],["apply",153,2],["lambda","nhds_eq_comap_uniformity",149,154,"explicit"],["lambda","comp",131,155,"explicit"],["lambda","symm",108,156,"explicit"],["lambda","uniformity",101,157,"explicit"],["lambda","toTopologicalSpace",100,158,"instance"],["lambda","mk",93,159,"explicit"],["lambda","motive",5,160,"explicit"],["lambda","α",0,161,"explicit"]],"project":false,"range":{"column":0,"endColumn":81,"endLine":380,"line":364},"type":99,"typeText":"{α : Type u} →\n  {motive : UniformSpace.{u} α → Sort u_1} →\n    ([toTopologicalSpace : TopologicalSpace.{u} α] →\n        (uniformity : Filter.{u} (Prod.{u, u} α α)) →\n          (symm : Filter.Tendsto.{u, u} Prod.swap.{u, u} uniformity uniformity) →\n            (comp : LE.le.{u} (Filter.lift'.{u, u} uniformity fun s => SetRel.comp.{u, u, u} s s) uniformity) →\n              (nhds_eq_comap_uniformity :\n                  ∀ (x : α), Eq.{u + 1} (nhds.{u} x) (Filter.comap.{u, u} (Prod.mk.{u, u} x) uniformity)) →\n                motive (UniformSpace.mk.{u} uniformity symm comp nhds_eq_comap_uniformity)) →\n      (t : UniformSpace.{u} α) → motive t","unsafe":false,"value":null,"source":{"code":"/-- A uniform space is a generalization of the \"uniform\" topological aspects of a\n  metric space. It consists of a filter on `α × α` called the \"uniformity\", which\n  satisfies properties analogous to the reflexivity, symmetry, and triangle properties\n  of a metric.\n\n  A metric space has a natural uniformity, and a uniform space has a natural topology.\n  A topological group also has a natural uniformity, even when it is not metrizable. -/\nclass UniformSpace (α : Type u) extends TopologicalSpace α where\n  /-- The uniformity filter. -/\n  protected uniformity : Filter (α × α)\n  /-- If `s ∈ uniformity`, then `Prod.swap ⁻¹' s ∈ uniformity`. -/\n  protected symm : Tendsto Prod.swap uniformity uniformity\n  /-- For every set `u ∈ uniformity`, there exists `v ∈ uniformity` such that `v ○ v ⊆ u`. -/\n  protected comp : (uniformity.lift' fun s => s ○ s) ≤ uniformity\n  /-- The uniformity agrees with the topology: the neighborhoods filter of each point `x`\n  is equal to `Filter.comap (Prod.mk x) (𝓤 α)`. -/\n  protected nhds_eq_comap_uniformity (x : α) : 𝓝 x = comap (Prod.mk x) uniformity","start":364,"end":380},"axioms":["Quot.sound","propext"]}