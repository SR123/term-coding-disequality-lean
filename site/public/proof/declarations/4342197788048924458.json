,33],["apply",56,21],["apply",57,13],["apply",54,58],["constant","nhds",[["param","u"]]],["apply",60,33],["apply",61,21],["apply",62,11],["apply",59,63],["forall","a._@._internal._hyg.0",30,64,"explicit"],["forall","a._@._internal._hyg.0",18,65,"explicit"],["forall","a",13,66,"implicit"],["forall","s",12,67,"implicit"],["constant","RegularSpace.mk",[["param","u"]]],["apply",69,13],["apply",70,11],["apply",71,2],["apply",5,72],["forall","regular",68,73,"explicit"],["apply",4,13],["apply",75,11],["apply",11,2],["forall","t",76,77,"explicit"],["forall","mk",74,78,"explicit"],["forall","motive",9,79,"implicit"],["forall","inst._@.Mathlib.Topology.Separation.Regular.2895940595._hygCtx._hyg.13",3,80,"instance"],["forall","X",0,81,"implicit"],["apply",10,13],["apply",14,21],["apply",84,15],["apply",85,5],["apply",20,33],["apply",10,33],["apply",87,88],["apply",25,33],["apply",89,90],["apply",91,11],["apply",92,5],["apply",19,93],["bound",7],["apply",32,95],["apply",31,96],["apply",36,95],["apply",97,98],["apply",39,96],["apply",41,96],["apply",43,96],["apply",102,98],["apply",101,103],["apply",100,104],["apply",48,96],["apply",50,95],["apply",106,107],["apply",105,108],["apply",99,109],["apply",55,95],["apply",111,33],["apply",112,13],["apply",110,113],["apply",60,95],["apply",115,33],["apply",116,11],["apply",114,117],["forall","a._@._internal._hyg.0",94,118,"explicit"],["forall","a._@._internal._hyg.0",86,119,"explicit"],["forall","a",15,120,"implicit"],["forall","s",83,121,"implicit"],["apply",5,2],["lambda","regular",122,123,"explicit"],["lambda","mk",74,124,"explicit"],["lambda","motive",9,125,"explicit"],["lambda","inst._@.Mathlib.Topology.Separation.Regular.2895940595._hygCtx._hyg.13",3,126,"instance"],["lambda","X",0,127,"explicit"]],"project":false,"range":{"column":0,"endColumn":73,"endLine":82,"line":75},"type":82,"typeText":"{X : Type u} →\n  [inst : TopologicalSpace.{u} X] →\n    {motive : RegularSpace.{u} X → Sort u_1} →\n      ((regular : ∀ {s : Set.{u} X} {a : X}, IsClosed.{u} s → a ∉ s → Disjoint.{u} (nhdsSet.{u} s) (nhds.{u} a)) →\n          motive ⋯) →\n        (t : RegularSpace.{u} X) → motive t","unsafe":false,"value":null,"source":{"code":"/-- A topological space is called a *regular space* if for any closed set `s` and `a ∉ s`, there\nexist disjoint open sets `U ⊇ s` and `V ∋ a`. We formulate this condition in terms of `Disjoint`ness\nof filters `𝓝ˢ s` and `𝓝 a`. -/\n@[mk_iff]\nclass RegularSpace (X : Type u) [TopologicalSpace X] : Prop where\n  /-- If `a` is a point that does not belong to a closed set `s`, then `a` and `s` admit disjoint\n  neighborhoods. -/\n  regular : ∀ {s : Set X} {a}, IsClosed s → a ∉ s → Disjoint (𝓝ˢ s) (𝓝 a)","start":75,"end":82},"axioms":["Quot.sound","propext"]}