it.768750409._hygCtx._hyg.84",0,269,"explicit"],["apply",70,270],["apply",271,7],["lambda","x._@.Mathlib.Data.Nat.Init.768750409._hygCtx._hyg.85",52,272,"explicit"],["lambda","x._@.Mathlib.Data.Nat.Init.768750409._hygCtx._hyg.84",0,273,"explicit"],["lambda","le_succ_of_le",50,274,"explicit"],["lambda","refl",15,275,"explicit"],["lambda","motive",11,276,"implicit"],["lambda","n",0,277,"implicit"]],"project":false,"range":{"column":0,"endColumn":36,"endLine":167,"line":147},"type":60,"typeText":"{n : Nat} →\n  {motive : (m : Nat) → LE.le.{0} n m → Sort u_1} →\n    motive n ⋯ →\n      (⦃k : Nat⦄ → (h : LE.le.{0} n k) → motive k h → motive (HAdd.hAdd.{0, 0, 0} k 1) ⋯) →\n        {m : Nat} → (h : LE.le.{0} n m) → motive m h","unsafe":false,"value":278,"source":{"code":"/-- Recursion starting at a non-zero number: given a map `C k → C (k+1)` for each `k ≥ n`,\nthere is a map from `C n` to each `C m`, `n ≤ m`.\n\nThis is a version of `Nat.le.rec` that works for `Sort u`.\nSimilarly to `Nat.le.rec`, it can be used as\n```\ninduction hle using Nat.leRec with\n| refl => sorry\n| le_succ_of_le hle ih => sorry\n```\n-/\n@[elab_as_elim]\ndef leRec {n} {motive : (m : ℕ) → n ≤ m → Sort*}\n    (refl : motive n (Nat.le_refl _))\n    (le_succ_of_le : ∀ ⦃k⦄ (h : n ≤ k), motive k h → motive (k + 1) (le_succ_of_le h)) :\n    ∀ {m} (h : n ≤ m), motive m h\n  | 0, H => Nat.eq_zero_of_le_zero H ▸ refl\n  | m + 1, H =>\n    (le_succ_iff.1 H).by_cases\n      (fun h : n ≤ m ↦ le_succ_of_le h <| leRec refl le_succ_of_le h)\n      (fun h : n = m + 1 ↦ h ▸ refl)","start":147,"end":167},"axioms":[]}