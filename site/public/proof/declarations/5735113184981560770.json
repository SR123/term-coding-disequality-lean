976,"line":970},"type":38,"typeText":"∀ {a b : Nat}, LE.le.{0} a b → Eq.{1} (HAdd.hAdd.{0, 0, 0} a (HSub.hSub.{0, 0, 0} b a)) b","unsafe":false,"value":271,"source":{"code":"theorem add_sub_of_le {a b : Nat} (h : a ≤ b) : a + (b - a) = b := by\n  induction a with\n  | zero => simp\n  | succ a ih =>\n    have hne : b - a ≠ 0 := Nat.sub_ne_zero_of_lt h\n    have : a ≤ b := Nat.le_of_succ_le h\n    rw [sub_succ, Nat.succ_add, ← Nat.add_succ, Nat.succ_pred hne, ih this]","start":970,"end":976},"axioms":["propext"]}