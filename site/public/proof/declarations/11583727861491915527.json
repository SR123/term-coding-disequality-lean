ne] protected def Core.tryCatch (x : CoreM α) (h : Exception → CoreM α) : CoreM α := do\n  try\n    x\n  catch ex =>\n    if ex.isInterrupt || ex.isRuntime then\n      throw ex\n    else\n      h ex","start":763,"end":776},"axioms":["Classical.choice","Quot.sound","propext"]}