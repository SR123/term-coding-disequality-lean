ly",866,160],["apply",8,2],["lambda","h._@.Mathlib.Topology.Order.LeftRightNhds.74906653._hygCtx._hyg.377",602,868,"explicit"],["apply",867,869],["constant","List.IsChain.singleton",[["zero"]]],["apply",871,53],["apply",872,798],["apply",873,491],["apply",870,874],["apply",864,875],["apply",847,876],["apply",830,877],["apply",793,878],["apply",841,855],["apply",880,27],["apply",881,2],["lambda","h._@.Mathlib.Topology.Order.LeftRightNhds.74906653._hygCtx._hyg.381",491,882,"explicit"],["apply",879,883],["let","tfae_5_to_4",603,758,884,true],["let","tfae_4_to_5",440,592,885,true],["let","tfae_1_iff_5",340,368,886,true],["let","tfae_1_iff_3",241,304,887,true],["let","tfae_1_iff_2",177,236,888,true],["lambda","s",50,889,"explicit"],["lambda","hab",47,890,"explicit"],["lambda","b",28,891,"implicit"],["lambda","a",27,892,"implicit"],["lambda","inst._@.Mathlib.Topology.Order.LeftRightNhds.74906653._hygCtx._hyg.11",26,893,"instance"],["lambda","inst._@.Mathlib.Topology.Order.LeftRightNhds.74906653._hygCtx._hyg.8",6,894,"instance"],["lambda","inst._@.Mathlib.Topology.Order.LeftRightNhds.74906653._hygCtx._hyg.5",3,895,"instance"],["lambda","α",0,896,"implicit"]],"project":false,"range":{"column":0,"endColumn":13,"endLine":243,"line":220},"type":174,"typeText":"∀ {α : Type u_1} [inst : TopologicalSpace.{u_1} α] [inst_1 : LinearOrder.{u_1} α] [OrderTopology.{u_1} α] {a b : α},\n  LT.lt.{u_1} a b →\n    ∀ (s : Set.{u_1} α),\n      List.TFAE\n        (List.cons.{0} (Membership.mem.{u_1, u_1} (nhdsWithin.{u_1} a (Set.Ici.{u_1} a)) s)\n          (List.cons.{0} (Membership.mem.{u_1, u_1} (nhdsWithin.{u_1} a (Set.Icc.{u_1} a b)) s)\n            (List.cons.{0} (Membership.mem.{u_1, u_1} (nhdsWithin.{u_1} a (Set.Ico.{u_1} a b)) s)\n              (List.cons.{0}\n                (∃ u,\n                  And (Membership.mem.{u_1, u_1} (Set.Ioc.{u_1} a b) u) (HasSubset.Subset.{u_1} (Set.Ico.{u_1} a u) s))\n                (List.cons.{0}\n                  (∃ u,\n                    And (Membership.mem.{u_1, u_1} (Set.Ioi.{u_1} a) u) (HasSubset.Subset.{u_1} (Set.Ico.{u_1} a u) s))\n                  List.nil.{0})))))","unsafe":false,"value":897,"source":{"code":"/-- The following statements are equivalent:\n\n0. `s` is a neighborhood of `a` within `[a, +∞)`;\n1. `s` is a neighborhood of `a` within `[a, b]`;\n2. `s` is a neighborhood of `a` within `[a, b)`;\n3. `s` includes `[a, u)` for some `u ∈ (a, b]`;\n4. `s` includes `[a, u)` for some `u > a`.\n-/\ntheorem TFAE_mem_nhdsGE {a b : α} (hab : a < b) (s : Set α) :\n    TFAE [s ∈ 𝓝[≥] a,\n      s ∈ 𝓝[Icc a b] a,\n      s ∈ 𝓝[Ico a b] a,\n      ∃ u ∈ Ioc a b, Ico a u ⊆ s,\n      ∃ u ∈ Ioi a, Ico a u ⊆ s] := by\n  tfae_have 1 ↔ 2 := by\n    rw [nhdsWithin_Icc_eq_nhdsGE hab]\n  tfae_have 1 ↔ 3 := by\n    rw [nhdsWithin_Ico_eq_nhdsGE hab]\n  tfae_have 1 ↔ 5 := (nhdsGE_basis_of_exists_gt ⟨b, hab⟩).mem_iff\n  tfae_have 4 → 5 := fun ⟨u, umem, hu⟩ => ⟨u, umem.1, hu⟩\n  tfae_have 5 → 4\n  | ⟨u, hua, hus⟩ => ⟨min u b, ⟨lt_min hua hab, min_le_right _ _⟩,\n      (Ico_subset_Ico_right <| min_le_left _ _).trans hus⟩\n  tfae_finish","start":220,"end":243},"axioms":["Classical.choice","Quot.sound","propext"]}