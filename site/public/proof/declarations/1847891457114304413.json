    (pred : ∀ i : ℕ, motive (-i) → motive (-i - 1)) : motive i := by\n  cases i with\n  | ofNat i =>\n    induction i with\n    | zero => exact zero\n    | succ i ih => exact succ _ ih\n  | negSucc i =>\n    suffices ∀ n : ℕ, motive (-n) from this (i + 1)\n    intro n; induction n with\n    | zero => simp [zero]\n    | succ n ih => simpa [natCast_succ, Int.neg_add, Int.sub_eq_add_neg] using pred _ ih","start":70,"end":88},"axioms":["propext"]}