 i with\n  | zero => simp at h\n  | succ n ih =>\n    match i with\n    | 0 => simp [Fin.foldr_succ]\n    | i+1 =>\n      simp only [Fin.foldr_succ]\n      apply ih\n      simp_all","start":46,"end":58},"axioms":["propext"]}