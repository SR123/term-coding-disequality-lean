"],["apply",255,341],["constant","Eq.refl",[["zero"]]],["apply",343,59],["apply",344,90],["apply",342,345],["lambda","k",0,346,"explicit"],["lambda","n",0,347,"explicit"],["lambda","m",0,348,"explicit"]],"project":false,"range":{"column":0,"endColumn":93,"endLine":175,"line":168},"type":41,"typeText":"∀ (m n k : Nat), Eq.{1} (Int.subNatNat (HAdd.hAdd.{0, 0, 0} m n) k) (HAdd.hAdd.{0, 0, 0} (↑m) (Int.subNatNat n k))","unsafe":false,"value":349,"source":{"code":"theorem subNatNat_add (m n k : Nat) : subNatNat (m + n) k = m + subNatNat n k := by\n  cases n.lt_or_ge k with\n  | inl h' =>\n    simp [subNatNat_of_lt h', sub_one_add_one_eq_of_pos (Nat.sub_pos_of_lt h')]\n    conv => lhs; rw [← Nat.sub_add_cancel (Nat.le_of_lt h')]\n    apply subNatNat_add_add\n  | inr h' => simp [subNatNat_of_le h',\n      subNatNat_of_le (Nat.le_trans h' (le_add_left ..)), Nat.add_sub_assoc h', -natCast_add]","start":168,"end":175},"axioms":["propext"]}