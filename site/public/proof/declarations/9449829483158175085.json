08,"instance"],["lambda","inst._@.Init.Data.Ord.Basic.807215360._hygCtx._hyg.9",10,309,"instance"],["lambda","inst._@.Init.Data.Ord.Basic.807215360._hygCtx._hyg.6",6,310,"instance"],["lambda","inst._@.Init.Data.Ord.Basic.807215360._hygCtx._hyg.3",3,311,"instance"],["lambda","α",0,312,"implicit"]],"project":false,"range":{"column":0,"endColumn":29,"endLine":376,"line":365},"type":86,"typeText":"∀ {α : Type u} [inst : LT.{u} α] [inst_1 : LE.{u} α] [DecidableLT.{u} α] [DecidableEq.{u + 1} α],\n  (∀ {x y : α}, LE.le.{u} x y → LE.le.{u} y x → Eq.{u + 1} x y) →\n    (∀ (x y : α), Or (LE.le.{u} x y) (LE.le.{u} y x)) →\n      (∀ {x y : α}, Iff (Not (LE.le.{u} x y)) (LT.lt.{u} y x)) →\n        ∀ (x y : α), Iff (LT.lt.{u} x y) (And (Not (LT.lt.{u} y x)) (Ne.{u + 1} x y))","unsafe":false,"value":313,"source":{"code":"theorem lt_iff_not_gt_and_ne_of_antisymm_of_total_of_not_le\n    {α : Type u} [LT α] [LE α] [DecidableLT α] [DecidableEq α]\n    (antisymm : ∀ {x y : α}, x ≤ y → y ≤ x → x = y)\n    (total : ∀ (x y : α), x ≤ y ∨ y ≤ x) (not_le : ∀ {x y : α}, ¬ x ≤ y ↔ y < x) (x y : α) :\n    x < y ↔ ¬ y < x ∧ x ≠ y := by\n  simp only [← not_le, Classical.not_not]\n  constructor\n  · intro h\n    have refl := by cases total y y <;> assumption\n    exact ⟨(total _ _).resolve_left h, fun h' => (h' ▸ h) refl⟩\n  · intro ⟨h₁, h₂⟩ h₃\n    exact h₂ (antisymm h₁ h₃)","start":365,"end":376},"axioms":["Classical.choice","Quot.sound","propext"]}