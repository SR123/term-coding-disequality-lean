da","l₁",40,745,"explicit"],["lambda","a",7,746,"explicit"],["apply",258,747],["apply",748,4],["apply",214,749],["lambda","l₂",5,750,"explicit"],["lambda","l₁",3,751,"explicit"],["lambda","α",0,752,"implicit"]],"project":false,"range":{"column":0,"endColumn":59,"endLine":132,"line":125},"type":64,"typeText":"∀ {α : Type u} (l₁ l₂ : List.{u} α),\n  Eq.{u + 1} (List.sublists.{u} (HAppend.hAppend.{u, u, u} l₁ l₂)) do\n    let x ← List.sublists.{u} l₂\n    List.map.{u, u} (fun x_1 => HAppend.hAppend.{u, u, u} x_1 x) (List.sublists.{u} l₁)","unsafe":false,"value":753,"source":{"code":"theorem sublists_append (l₁ l₂ : List α) :\n    sublists (l₁ ++ l₂) = (sublists l₂) >>= (fun x => (sublists l₁).map (· ++ x)) := by\n  simp only [sublists, foldr_append]\n  induction l₁ with\n  | nil => simp\n  | cons a l₁ ih =>\n    rw [foldr_cons, ih]\n    simp [List.flatMap, flatten_flatten, Function.comp_def]","start":125,"end":132},"axioms":["Quot.sound","propext"]}