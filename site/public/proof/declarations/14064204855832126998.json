:277},"type":36,"typeText":"{α : Type u} →\n  (xs ys : Array.{u} α) →\n    Eq.{1} (Array.size.{u} xs) (Array.size.{u} ys) → (α → α → Bool) → (i : Nat) → LE.le.{0} i (Array.size.{u} xs) → Bool","unsafe":false,"value":184,"source":{"code":"@[specialize]\ndef isEqvAux (xs ys : Array α) (hsz : xs.size = ys.size) (p : α → α → Bool) :\n    ∀ (i : Nat) (_ : i ≤ xs.size), Bool\n  | 0, _ => true\n  | i+1, h =>\n    p xs[i] (ys[i]'(hsz ▸ h)) && isEqvAux xs ys hsz p i (Nat.le_trans (Nat.le_add_right i 1) h)","start":277,"end":282},"axioms":[]}