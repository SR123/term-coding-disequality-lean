332,1518,"explicit"],["lambda","y",0,1519,"implicit"],["lambda","x",0,1520,"implicit"],["lambda","hyp",66,1521,"explicit"],["lambda","n",0,1522,"explicit"],["apply",328,1523],["apply",1524,43],["apply",1525,39],["apply",1526,8],["apply",1527,53],["apply",1528,191],["lambda","right",36,1529,"explicit"],["lambda","left",33,1530,"explicit"],["lambda","f",3,1531,"implicit"],["lambda","y",0,1532,"implicit"],["lambda","n",0,1533,"implicit"],["lambda","x",0,1534,"implicit"]],"project":false,"range":{"column":0,"endColumn":43,"endLine":458,"line":433},"type":51,"typeText":"∀ {x n y : Nat} {f : Bool → Bool → Bool},\n  LT.lt.{0} x (HPow.hPow.{0, 0, 0} 2 n) →\n    LT.lt.{0} y (HPow.hPow.{0, 0, 0} 2 n) → LT.lt.{0} (Nat.bitwise f x y) (HPow.hPow.{0, 0, 0} 2 n)","unsafe":false,"value":1535,"source":{"code":"/-- This provides a bound on bitwise operations. -/\ntheorem bitwise_lt_two_pow (left : x < 2^n) (right : y < 2^n) : (Nat.bitwise f x y) < 2^n := by\n  induction n generalizing x y with\n  | zero =>\n    simp only [eq_0_of_lt] at left right\n    unfold bitwise\n    simp [left, right]\n  | succ n hyp =>\n    unfold bitwise\n    if x_zero : x = 0 then\n      simp only [x_zero, if_pos]\n      by_cases p : f false true = true <;> simp [p, right]\n    else if y_zero : y = 0 then\n      simp only [x_zero, y_zero, if_pos]\n      by_cases p : f true false = true <;> simp [p, left]\n    else\n      simp only [x_zero, y_zero]\n      have hyp1 := hyp (div_two_le_of_lt_two left) (div_two_le_of_lt_two right)\n      by_cases p : f (decide (x % 2 = 1)) (decide (y % 2 = 1)) = true <;>\n        simp [p, Nat.pow_succ, mul_succ, Nat.add_assoc]\n      case pos =>\n        apply lt_of_succ_le\n        simp only [← Nat.succ_add]\n        apply Nat.add_le_add <;> exact hyp1\n      case neg =>\n        apply Nat.add_lt_add <;> exact hyp1","start":433,"end":458},"axioms":["Quot.sound","propext"]}