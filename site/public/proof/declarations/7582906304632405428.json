 Nat) : Nat → Nat → List Char → List Char\n  | 0,      _, ds => ds\n  | fuel+1, n, ds =>\n    let d  := digitChar <| n % base;\n    let n' := n / base;\n    if n' = 0 then d::ds\n    else toDigitsCore base fuel n' (d::ds)","start":196,"end":202},"axioms":[]}