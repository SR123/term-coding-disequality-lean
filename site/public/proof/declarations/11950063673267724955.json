.2521505187._hygCtx._hyg.4",4,1042,"instance"],["lambda","β",1,1043,"implicit"],["lambda","α",0,1044,"implicit"]],"project":false,"range":{"column":0,"endColumn":98,"endLine":183,"line":172},"type":179,"typeText":"∀ {α : Type u_1} {β : Type u_2} [inst : NormedDivisionRing.{u_1} α] [inst_1 : SeminormedAddGroup.{u_2} β]\n  [inst_2 : MulActionWithZero.{u_1, u_2} α β] [IsBoundedSMul.{u_1, u_2} α β], NormSMulClass.{u_1, u_2} α β","unsafe":false,"value":1045,"source":{"code":"/-- For a normed division ring, a sub-multiplicative norm is actually strictly multiplicative.\n\nThis is not an instance as it forms a loop with `NormSMulClass.toIsBoundedSMul`. -/\nlemma NormedDivisionRing.toNormSMulClass : NormSMulClass α β where\n  norm_smul r x := by\n    by_cases h : r = 0\n    · simp [h, zero_smul α x]\n    · refine le_antisymm (norm_smul_le r x) ?_\n      calc\n      ‖r‖ * ‖x‖ = ‖r‖ * ‖r⁻¹ • r • x‖ := by rw [inv_smul_smul₀ h]\n      _ ≤ ‖r‖ * (‖r⁻¹‖ * ‖r • x‖) := by gcongr; apply norm_smul_le\n      _ = ‖r • x‖ := by rw [norm_inv, ← mul_assoc, mul_inv_cancel₀ (mt norm_eq_zero.1 h), one_mul]","start":172,"end":183},"axioms":["Classical.choice","Quot.sound","propext"]}