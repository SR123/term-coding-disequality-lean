t"],["lambda","L",0,225,"implicit"]],"project":true,"range":{"column":0,"endColumn":94,"endLine":197,"line":188},"type":201,"typeText":"{L : Nat} →\n  {m0 : DisequalityDispersion.Machine.Mem} →\n    {hdr a : Nat} →\n      {pre l : List.{0} Nat} →\n        {tot j : Nat} →\n          {m : DisequalityDispersion.Machine.Mem} →\n            {motive : DisequalityDispersion.Machine.AppInv L m0 hdr a pre l tot j m → Sort u} →\n              (t : DisequalityDispersion.Machine.AppInv L m0 hdr a pre l tot j m) →\n                ((agree : DisequalityDispersion.Machine.Agree m0 m (DisequalityDispersion.Machine.Lvars L)) →\n                    (i : Eq.{1} (m (DisequalityDispersion.Machine.I_ L)) j) →\n                      (cnt : Eq.{1} (m (DisequalityDispersion.Machine.CNT_ L)) (List.length.{0} l)) →\n                        (out : Eq.{1} (m (DisequalityDispersion.Machine.OUT_ L)) hdr) →\n                          (arr :\n                              Eq.{1} (DisequalityDispersion.Machine.arrAt m hdr)\n                                (HAppend.hAppend.{0, 0, 0} pre (List.take.{0} j l))) →\n                            (room :\n                                LE.le.{0} (HAdd.hAdd.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} hdr 1) tot)\n                                  (m DisequalityDispersion.Machine.HP)) →\n                              (src :\n                                  And (Eq.{1} (m DisequalityDispersion.Machine.ONE) 1)\n                                    (And\n                                      (LE.le.{0} (HAdd.hAdd.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} a 1) (List.length.{0} l))\n                                        (m DisequalityDispersion.Machine.HP))\n                                      (∀ (i : Nat) (h : LT.lt.{0} i (List.length.{0} l)),\n                                        Eq.{1} (m (HAdd.hAdd.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} a 1) i))\n                                          (GetElem.getElem.{0, 0, 0} l i h)))) →\n                                motive ⋯) →\n                  motive t","unsafe":false,"value":226,"source":{"code":"/-- The invariant of the copying loops of `appendM`: `pre ++ l.take j` has been pushed. -/\nstructure AppInv (L : ℕ) (m0 : Mem) (hdr a : ℕ) (pre l : List ℕ) (tot : ℕ) (j : ℕ) (m : Mem) :\n    Prop where\n  agree : Agree m0 m (Lvars L)\n  i : m (I_ L) = j\n  cnt : m (CNT_ L) = l.length\n  out : m (OUT_ L) = hdr\n  arr : arrAt m hdr = pre ++ l.take j\n  room : hdr + 1 + tot ≤ m HP\n  src : m ONE = 1 ∧ a + 1 + l.length ≤ m HP ∧ (∀ i, (h : i < l.length) → m (a + 1 + i) = l[i])","start":188,"end":197,"lines":[[{"text":"/-- The invariant of the copying loops of `appendM`: `pre ++ l.take j` has been pushed. -/"}],[{"text":"structure AppInv (L : ℕ) (m0 : Mem) (hdr a : ℕ) (pre l : List ℕ) (tot : ℕ) (j : ℕ) (m : Mem) :"}],[{"text":"    Prop where"}],[{"text":"  agree : Agree m0 m (Lvars L)"}],[{"text":"  i : m (I_ L) = j"}],[{"text":"  cnt : m (CNT_ L) = l.length"}],[{"text":"  out : m (OUT_ L) = hdr"}],[{"text":"  arr : arrAt m hdr = pre ++ l.take j"}],[{"text":"  room : hdr + 1 + tot ≤ m HP"}],[{"text":"  src : m ONE = 1 ∧ a + 1 + l.length ≤ m HP ∧ (∀ i, (h : i < l.length) → m (a + 1 + i) = l[i])"}]]},"steps":[],"stepGoalPool":[],"references":[],"axioms":[]}