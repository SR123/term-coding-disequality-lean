{"dependencies":["TopologicalSpace","T0Space.mk","Inseparable","T0Space","Eq"],"doc":null,"extra":{"indices":0,"minorPremises":1,"motives":1,"parameters":2,"rules":[{"constructor":"T0Space.mk","fields":1,"rhs":56}]},"kind":"recursor","levels":["u_1","u"],"module":"Mathlib.Topology.Separation.Basic","name":"T0Space.rec","nodes":[["sort",["succ",["param","u"]]],["constant","TopologicalSpace",[["param","u"]]],["bound",0],["apply",1,2],["constant","T0Space",[["param","u"]]],["bound",1],["apply",4,5],["apply",6,2],["sort",["param","u_1"]],["forall","t",7,8,"explicit"],["bound",2],["bound",3],["constant","Inseparable",[["param","u"]]],["bound",4],["apply",12,13],["apply",14,11],["apply",15,5],["apply",16,2],["constant","Eq",[["succ",["param","u"]]]],["bound",5],["apply",18,19],["apply",20,10],["apply",21,5],["forall","a._@._internal._hyg.0",17,22,"explicit"],["forall","y",11,23,"strictImplicit"],["forall","x",10,24,"strictImplicit"],["constant","T0Space.mk",[["param","u"]]],["apply",26,11],["apply",27,10],["apply",28,2],["apply",5,29],["forall","t0",25,30,"explicit"],["apply",4,11],["apply",32,10],["apply",10,2],["forall","t",33,34,"explicit"],["forall","mk",31,35,"explicit"],["forall","motive",9,36,"implicit"],["forall","inst._@.Mathlib.Topology.Separation.Basic.1650707418._hygCtx._hyg.13",3,37,"instance"],["forall","X",0,38,"implicit"],["apply",12,19],["apply",40,13],["apply",41,5],["apply",42,2],["bound",6],["apply",18,44],["apply",45,10],["apply",46,5],["forall","a._@._internal._hyg.0",43,47,"explicit"],["forall","y",13,48,"strictImplicit"],["forall","x",11,49,"strictImplicit"],["apply",5,2],["lambda","t0",50,51,"explicit"],["lambda","mk",31,52,"explicit"],["lambda","motive",9,53,"explicit"],["lambda","inst._@.Mathlib.Topology.Separation.Basic.1650707418._hygCtx._hyg.13",3,54,"instance"],["lambda","X",0,55,"explicit"]],"project":false,"range":{"column":0,"endColumn":43,"endLine":79,"line":73},"type":39,"typeText":"{X : Type u} →\n  [inst : TopologicalSpace.{u} X] →\n    {motive : T0Space.{u} X → Sort u_1} →\n      ((t0 : ∀ ⦃x y : X⦄, Inseparable.{u} x y → Eq.{u + 1} x y) → motive ⋯) → (t : T0Space.{u} X) → motive t","unsafe":false,"value":null,"source":{"code":"/-- A T₀ space, also known as a Kolmogorov space, is a topological space such that for every pair\n`x ≠ y`, there is an open set containing one but not the other. We formulate the definition in terms\nof the `Inseparable` relation. -/\n@[stacks 004X \"(2)\"]\nclass T0Space (X : Type u) [TopologicalSpace X] : Prop where\n  /-- Two inseparable points in a T₀ space are equal. -/\n  t0 : ∀ ⦃x y : X⦄, Inseparable x y → x = y","start":73,"end":79},"axioms":["Quot.sound","propext"]}