"u"],["param","v"]]],["bound",8],["apply",69,70],["apply",71,48],["apply",72,39],["apply",73,26],["apply",74,13],["apply",75,11],["constant","PSigma.mk",[["succ",["zero"]],["succ",["zero"]]]],["apply",25,70],["apply",78,13],["apply",24,79],["apply",80,36],["apply",14,81],["apply",77,82],["constant","PSigma",[["succ",["zero"]],["zero"]]],["bound",9],["apply",25,85],["apply",86,26],["apply",14,87],["apply",84,88],["bound",10],["apply",25,90],["apply",91,39],["apply",24,92],["apply",93,36],["apply",47,94],["apply",95,2],["apply",46,96],["apply",47,92],["apply",98,57],["apply",97,99],["lambda","hi",88,100,"explicit"],["apply",89,101],["lambda","lo",82,102,"explicit"],["apply",83,103],["apply",104,3],["constant","PSigma.mk",[["succ",["zero"]],["zero"]]],["apply",14,79],["apply",106,107],["apply",24,87],["apply",109,36],["apply",47,110],["apply",111,11],["apply",46,112],["apply",47,87],["apply",114,57],["apply",113,115],["lambda","hi",107,116,"explicit"],["apply",108,117],["apply",118,2],["apply",119,57],["apply",105,120],["apply",76,121],["lambda","a._@._internal._hyg.0",59,122,"explicit"],["lambda","hi",42,123,"explicit"],["lambda","lo",38,124,"explicit"],["lambda","k",13,125,"explicit"],["lambda","as",12,126,"explicit"],["lambda","found",9,127,"explicit"],["lambda","lt",6,128,"explicit"],["lambda","β",1,129,"implicit"],["lambda","α",0,130,"implicit"]],"project":false,"range":{"column":0,"endColumn":35,"endLine":32,"line":19},"type":68,"typeText":"{α : Type u} →\n  {β : Type v} →\n    (α → α → Bool) →\n      (Option.{u} α → β) →\n        (as : Array.{u} α) →\n          α →\n            (lo : Fin (HAdd.hAdd.{0, 0, 0} (Array.size.{u} as) 1)) →\n              (hi : Fin (Array.size.{u} as)) → LE.le.{0} ↑lo ↑hi → β","unsafe":false,"value":131,"source":{"code":"@[specialize] def binSearchAux {α : Type u} {β : Type v} (lt : α → α → Bool) (found : Option α → β) (as : Array α) (k : α) :\n    (lo : Fin (as.size + 1)) → (hi : Fin as.size) → (lo.1 ≤ hi.1) → β\n  | lo, hi, h =>\n    let m := (lo.1 + hi.1)/2\n    let a := as[m]\n    if lt a k then\n      if h' : m + 1 ≤ hi.1 then\n        binSearchAux lt found as k ⟨m+1, by omega⟩ hi h'\n      else found none\n    else if lt k a then\n      if h' : m = 0 ∨ m - 1 < lo.1 then found none\n      else binSearchAux lt found as k lo ⟨m-1, by omega⟩ (by simp; omega)\n    else found (some a)\ntermination_by lo hi => hi.1 - lo.1","start":19,"end":32},"axioms":["Quot.sound","propext"]}