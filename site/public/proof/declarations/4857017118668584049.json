mSpace.{ua} α] (s : Set.{ua} (Prod.{ua, ua} α α)),\n  Eq.{ua + 1} (closure.{ua} s)\n    (⋂ V,\n      ⋂ (_ :\n        Membership.mem.{ua, ua}\n          (setOf.{ua} fun V => And (Membership.mem.{ua, ua} (uniformity.{ua} α) V) (SetRel.IsSymm.{ua} V)) V),\n        SetRel.comp.{ua, ua, ua} (SetRel.comp.{ua, ua, ua} V s) V)","unsafe":false,"value":656,"source":{"code":"theorem closure_eq_uniformity (s : Set <| α × α) :\n    closure s = ⋂ V ∈ {V | V ∈ 𝓤 α ∧ SetRel.IsSymm V}, V ○ s ○ V := by\n  ext ⟨x, y⟩\n  simp +contextual only\n    [mem_closure_iff_nhds_basis (UniformSpace.hasBasis_nhds_prod x y), mem_iInter, mem_setOf_eq,\n      and_imp, mem_comp_comp, ← mem_inter_iff, inter_comm, Set.Nonempty]","start":187,"end":192},"axioms":["Classical.choice","Quot.sound","propext"]}