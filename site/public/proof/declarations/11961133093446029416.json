pply",1320,1324],["lambda","hx",16,1325,"explicit"],["lambda","x",0,1326,"implicit"]],"project":false,"range":{"column":0,"endColumn":42,"endLine":267,"line":260},"type":98,"typeText":"∀ {x : Real},\n  LE.le.{0} 0 x →\n    LE.le.{0} (HAdd.hAdd.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} 1 x) (HDiv.hDiv.{0, 0, 0} (HPow.hPow.{0, 0, 0} x 2) 2))\n      (Real.exp x)","unsafe":false,"value":1327,"source":{"code":"theorem quadratic_le_exp_of_nonneg {x : ℝ} (hx : 0 ≤ x) : 1 + x + x ^ 2 / 2 ≤ exp x :=\n  calc\n    1 + x + x ^ 2 / 2 = ∑ i ∈ range 3, x ^ i / i ! := by\n        simp only [sum_range_succ, range_one, sum_singleton, _root_.pow_zero, factorial,\n          pow_one, mul_one, Nat.mul_one,\n          cast_succ]\n        ring_nf\n    _ ≤ exp x := sum_le_exp_of_nonneg hx 3","start":260,"end":267},"axioms":["Classical.choice","Quot.sound","propext"]}