false,"range":{"column":0,"endColumn":65,"endLine":1160,"line":1149},"type":47,"typeText":"∀ {a n m : Nat}, LT.lt.{0} 1 a → Iff (LE.le.{0} (HPow.hPow.{0, 0, 0} a n) (HPow.hPow.{0, 0, 0} a m)) (LE.le.{0} n m)","unsafe":false,"value":241,"source":{"code":"protected theorem pow_le_pow_iff_right {a n m : Nat} (h : 1 < a) :\n    a ^ n ≤ a ^ m ↔ n ≤ m := by\n  constructor\n  · apply Decidable.by_contra\n    intro w\n    simp at w\n    apply Nat.lt_irrefl (a ^ n)\n    exact Nat.lt_of_le_of_lt w.1 (Nat.pow_lt_pow_of_lt h w.2)\n  · intro w\n    cases Nat.eq_or_lt_of_le w\n    case inl eq => subst eq; apply Nat.le_refl\n    case inr lt => exact Nat.le_of_lt (Nat.pow_lt_pow_of_lt h lt)","start":1149,"end":1160},"axioms":["Classical.choice","Quot.sound","propext"]}