nce"],["lambda","α",0,1406,"implicit"]],"project":false,"range":{"column":0,"endColumn":88,"endLine":1079,"line":1067},"type":69,"typeText":"∀ {α : Type u_1} [inst : Lean.Grind.CommRing.{u_1} α] (ctx : Lean.Grind.CommRing.Context.{u_1} α) (k : Int)\n  (m : Lean.Grind.CommRing.Mon) (p : Lean.Grind.CommRing.Poly),\n  Eq.{u_1 + 1} (Lean.Grind.CommRing.Poly.denote.{u_1} ctx (Lean.Grind.CommRing.Poly.mulMon k m p))\n    (HMul.hMul.{u_1, u_1, u_1} (HMul.hMul.{u_1, u_1, u_1} (↑k) (Lean.Grind.CommRing.Mon.denote.{u_1} ctx m))\n      (Lean.Grind.CommRing.Poly.denote.{u_1} ctx p))","unsafe":false,"value":1407,"source":{"code":"theorem Poly.denote_mulMon {α} [CommRing α] (ctx : Context α) (k : Int) (m : Mon) (p : Poly)\n    : (mulMon k m p).denote ctx = k * m.denote ctx * p.denote ctx := by\n  simp [mulMon, cond_eq_ite] <;> split\n  next => simp [denote, *, intCast_zero, zero_mul]\n  next =>\n    split\n    next h =>\n      simp at h; simp [*, Mon.denote, mul_one, denote_mulConst]\n    next =>\n      fun_induction mulMon.go <;> simp [denote, zsmul_eq_intCast_mul, *]\n      next h => simp +zetaDelta at h; simp [*, intCast_zero, mul_zero]\n      next => simp [intCast_mul, intCast_zero, add_zero, mul_comm, mul_left_comm, mul_assoc]\n      next => simp [Mon.denote_mul, intCast_mul, left_distrib, mul_left_comm, mul_assoc]","start":1067,"end":1079},"axioms":["Classical.choice","Quot.sound","propext"]}