mbda","x",137,705,"explicit"],["apply",698,706],["constant","_private.Init.Grind.Ring.Basic.0.Lean.Grind.IsCharP.mk'._simp_2",[["succ",["zero"]]]],["apply",708,0],["apply",709,382],["apply",710,378],["apply",707,711],["apply",696,712],["constant","iff_self",[]],["apply",714,383],["apply",713,715],["apply",688,716],["lambda","k₂",0,717,"explicit"],["apply",684,718],["lambda","k₁",0,719,"explicit"],["apply",682,720],["apply",678,721],["apply",650,722],["apply",608,723],["apply",585,724],["apply",555,725],["let","this",500,533,726,true],["lambda","h",487,727,"explicit"],["apply",485,728],["apply",269,729],["apply",173,730],["lambda","y",0,731,"implicit"],["lambda","x",0,732,"implicit"],["apply",74,733],["lambda","ofNat_eq_zero_iff",62,734,"explicit"],["lambda","inst._@.Init.Grind.Ring.Basic.156091895._hygCtx._hyg.13",4,735,"instance"],["lambda","α",1,736,"explicit"],["lambda","p",0,737,"explicit"]],"project":false,"range":{"column":0,"endColumn":20,"endLine":497,"line":479},"type":70,"typeText":"∀ (p : Nat) (α : Type u) [inst : Lean.Grind.Ring.{u} α],\n  (∀ (x : Nat), Iff (Eq.{u + 1} (OfNat.ofNat.{u} x) 0) (Eq.{1} (HMod.hMod.{0, 0, 0} x p) 0)) →\n    Lean.Grind.IsCharP.{u} α p","unsafe":false,"value":738,"source":{"code":"/-- Alternative constructor when `α` is a `Ring`. -/\ndef mk' (p : Nat) (α : Type u) [Ring α]\n    (ofNat_eq_zero_iff : ∀ (x : Nat), OfNat.ofNat (α := α) x = 0 ↔ x % p = 0) : IsCharP α p where\n  ofNat_ext_iff {x y} := by\n    rw [← sub_eq_zero_iff]\n    rw [Nat.mod_eq_mod_iff]\n    by_cases h : y ≤ x\n    · have : OfNat.ofNat (α := α) x - OfNat.ofNat y = OfNat.ofNat (x - y) := by rw [ofNat_sub h]\n      rw [this, ofNat_eq_zero_iff]\n      apply mk'_aux _ h\n    · have : OfNat.ofNat (α := α) x - OfNat.ofNat (α := α) y = - OfNat.ofNat (y - x) := by rw [neg_ofNat_sub (by omega)]\n      rw [this, neg_eq_zero, ofNat_eq_zero_iff]\n      rw [mk'_aux _ (by omega)]\n      rw [exists_comm]\n      apply exists_congr\n      intro k₁\n      apply exists_congr\n      intro k₂\n      simp [eq_comm]","start":479,"end":497},"axioms":["Classical.choice","Quot.sound","propext"]}