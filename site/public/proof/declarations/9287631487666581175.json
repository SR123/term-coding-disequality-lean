":28,"typeText":"∀ {α : Type u} {f g : α → α},\n  Function.LeftInverse.{u + 1, u + 1} g f →\n    ∀ (n : Nat), Function.LeftInverse.{u + 1, u + 1} (Nat.iterate.{u + 1} g n) (Nat.iterate.{u + 1} f n)","unsafe":false,"value":156,"source":{"code":"theorem LeftInverse.iterate {g : α → α} (hg : LeftInverse g f) (n : ℕ) :\n    LeftInverse g^[n] f^[n] :=\n  Nat.recOn n (fun _ ↦ rfl) fun n ihn ↦ by\n    rw [iterate_succ', iterate_succ]\n    exact ihn.comp hg","start":197,"end":201},"axioms":["Quot.sound","propext"]}