{u_1} α},\n  (∀ (i : Nat), Eq.{u_1 + 1} (GetElem?.getElem?.{u_1, 0, u_1} l₁ i) (GetElem?.getElem?.{u_1, 0, u_1} l₂ i)) →\n    Eq.{u_1 + 1} l₁ l₂","unsafe":false,"value":769,"source":{"code":"@[ext] theorem ext_getElem? {l₁ l₂ : List α} (h : ∀ i : Nat, l₁[i]? = l₂[i]?) : l₁ = l₂ :=\n  match l₁, l₂, h with\n  | [], [], _ => rfl\n  | _ :: _, [], h => by simpa using h 0\n  | [], _ :: _, h => by simpa using h 0\n  | a :: l₁, a' :: l₂, h => by\n    have h0 : some a = some a' := by simpa using h 0\n    injection h0 with aa; simp only [aa, ext_getElem? fun n => by simpa using h (n+1)]","start":283,"end":290},"axioms":["propext"]}