ply",71,75],["apply",70,76],["apply",69,77],["apply",67,78],["constant","AddUnits.mk",[["param","u"]]],["bound",7],["apply",80,81],["apply",82,53],["apply",83,13],["apply",84,10],["apply",85,5],["apply",86,2],["apply",16,87],["forall","neg_val",79,88,"explicit"],["forall","val_neg",52,89,"explicit"],["forall","neg",14,90,"explicit"],["forall","val",13,91,"explicit"],["apply",10,5],["forall","mk",92,93,"explicit"],["forall","t",12,94,"explicit"],["forall","motive",9,95,"implicit"],["forall","inst._@.Mathlib.Algebra.Group.Units.Defs.784886155._hygCtx._hyg.5",3,96,"instance"],["forall","α",0,97,"implicit"],["constant","AddUnits.rec",[["param","u_1"],["param","u"]]],["apply",99,14],["apply",100,13],["apply",101,10],["apply",65,2],["apply",54,103],["apply",104,78],["apply",15,81],["apply",18,81],["apply",107,81],["apply",108,81],["apply",22,81],["apply",24,81],["apply",26,81],["apply",112,53],["apply",111,113],["apply",110,114],["apply",109,115],["apply",116,5],["apply",117,10],["apply",106,118],["apply",35,81],["apply",120,37],["apply",39,81],["apply",41,81],["apply",43,81],["apply",45,81],["apply",125,53],["apply",124,126],["apply",123,127],["apply",122,128],["apply",121,129],["apply",119,130],["apply",14,13],["apply",132,10],["apply",133,5],["apply",134,2],["lambda","neg_val",131,135,"explicit"],["lambda","val_neg",105,136,"explicit"],["lambda","neg",16,137,"explicit"],["lambda","val",14,138,"explicit"],["apply",102,139],["apply",140,5],["lambda","mk",92,141,"explicit"],["lambda","t",12,142,"explicit"],["lambda","motive",9,143,"implicit"],["lambda","inst._@.Mathlib.Algebra.Group.Units.Defs.784886155._hygCtx._hyg.5",3,144,"instance"],["lambda","α",0,145,"implicit"]],"project":false,"range":{"column":0,"endColumn":25,"endLine":77,"line":64},"type":98,"typeText":"{α : Type u} →\n  [inst : AddMonoid.{u} α] →\n    {motive : AddUnits.{u} α → Sort u_1} →\n      (t : AddUnits.{u} α) →\n        ((val neg : α) →\n            (val_neg : Eq.{u + 1} (HAdd.hAdd.{u, u, u} val neg) 0) →\n              (neg_val : Eq.{u + 1} (HAdd.hAdd.{u, u, u} neg val) 0) →\n                motive (AddUnits.mk.{u} val neg val_neg neg_val)) →\n          motive t","unsafe":false,"value":146,"source":{"code":"/-- Units of an `AddMonoid`, bundled version.\n\nAn element of an `AddMonoid` is a unit if it has a two-sided additive inverse.\nThis version bundles the inverse element so that it can be computed.\nFor a predicate see `isAddUnit`. -/\nstructure AddUnits (α : Type u) [AddMonoid α] where\n  /-- The underlying value in the base `AddMonoid`. -/\n  val : α\n  /-- The additive inverse value of `val` in the base `AddMonoid`. -/\n  neg : α\n  /-- `neg` is the right additive inverse of `val` in the base `AddMonoid`. -/\n  val_neg : val + neg = 0\n  /-- `neg` is the left additive inverse of `val` in the base `AddMonoid`. -/\n  neg_val : neg + val = 0","start":64,"end":77},"axioms":[]}