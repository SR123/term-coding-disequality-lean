._proof_3",[]],["apply",216,94],["apply",217,62],["apply",218,17],["apply",215,219],["constant","Nat.rfindX._proof_4",[]],["apply",221,94],["apply",222,62],["apply",223,17],["apply",220,224],["let","this",190,196,225,true],["lambda","e",179,226,"explicit"],["apply",178,227],["apply",228,126],["constant","Nat.rfindX._proof_5",[]],["apply",230,62],["apply",231,46],["apply",232,16],["apply",233,17],["apply",229,234],["constant","Nat.rfindX._proof_6",[]],["apply",236,62],["apply",237,46],["apply",238,16],["apply",235,239],["lambda","h._@.Mathlib.Computability.Partrec.3531154262._hygCtx._hyg.298",151,240,"explicit"],["apply",149,241],["apply",150,20],["apply",153,20],["apply",244,177],["apply",127,20],["constant","Subtype.mk",[["succ",["zero"]]]],["apply",247,1],["apply",248,140],["apply",249,106],["constant","Nat.rfindX._proof_7",[]],["apply",251,155],["apply",252,106],["apply",253,31],["apply",254,41],["apply",255,17],["apply",250,256],["lambda","e",246,257,"explicit"],["apply",245,258],["apply",259,126],["constant","Nat.rfindX._proof_8",[]],["apply",261,62],["apply",262,46],["apply",263,16],["apply",264,17],["apply",260,265],["apply",266,239],["lambda","h._@.Mathlib.Computability.Partrec.3531154262._hygCtx._hyg.299",243,267,"explicit"],["apply",242,268],["apply",236,106],["apply",270,31],["apply",271,17],["apply",269,272],["let","pm",113,118,273,true],["lambda","al",111,274,"explicit"],["lambda","IH",105,275,"explicit"],["lambda","m",1,276,"explicit"],["apply",83,277],["natural","0"],["apply",208,279],["apply",211,279],["apply",280,281],["apply",17,282],["constant","Nat.rfindX._proof_9",[]],["apply",284,41],["apply",283,285],["let","this",72,278,286,true],["lambda","H",38,287,"explicit"],["lambda","p",4,288,"explicit"]],"project":false,"range":{"column":0,"endColumn":30,"endLine":84,"line":62},"type":57,"typeText":"(p : PFun.{0, 0} Nat Bool) →\n  (∃ n, And (Membership.mem.{0, 0} (p n) Bool.true) (∀ (k : Nat), LT.lt.{0} k n → Part.Dom.{0} (p k))) →\n    Subtype.{1} fun n =>\n      And (Membership.mem.{0, 0} (p n) Bool.true) (∀ (m : Nat), LT.lt.{0} m n → Membership.mem.{0, 0} (p m) Bool.false)","unsafe":false,"value":289,"source":{"code":"/-- Find the smallest `n` satisfying `p n`, where all `p k` for `k < n` are defined as false.\nReturns a subtype. -/\ndef rfindX : { n // true ∈ p n ∧ ∀ m < n, false ∈ p m } :=\n  suffices ∀ k, (∀ n < k, false ∈ p n) → { n // true ∈ p n ∧ ∀ m < n, false ∈ p m } from\n    this 0 fun _ => (Nat.not_lt_zero _).elim\n  @WellFounded.fix _ _ (lbp p) (wf_lbp p H)\n    (by\n      intro m IH al\n      have pm : (p m).Dom := by\n        rcases H with ⟨n, h₁, h₂⟩\n        rcases lt_trichotomy m n with (h₃ | h₃ | h₃)\n        · exact h₂ _ h₃\n        · rw [h₃]\n          exact h₁.fst\n        · injection mem_unique h₁ (al _ h₃)\n      cases e : (p m).get pm\n      · suffices ∀ᵉ k ≤ m, false ∈ p k from IH _ ⟨rfl, this⟩ fun n h => this _ (le_of_lt_succ h)\n        intro n h\n        rcases h.lt_or_eq_dec with h | h\n        · exact al _ h\n        · rw [h]\n          exact ⟨_, e⟩\n      · exact ⟨m, ⟨_, e⟩, al⟩)","start":62,"end":84},"axioms":["Classical.choice","Quot.sound","propext"]}