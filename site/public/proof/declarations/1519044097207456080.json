,"this",562,576,970,true],["lambda","h",542,971,"explicit"],["apply",541,972],["lambda","h",358,973,"explicit"],["lambda","ih",106,974,"explicit"],["lambda","x",4,975,"explicit"],["apply",341,976],["apply",977,36],["apply",978,2],["lambda","h",11,979,"explicit"],["lambda","y",4,980,"implicit"],["lambda","x",4,981,"implicit"],["lambda","inst._@.Init.Grind.Ring.Basic.120924313._hygCtx._hyg.3",3,982,"instance"],["lambda","α",0,983,"implicit"]],"project":false,"range":{"column":0,"endColumn":48,"endLine":269,"line":256},"type":71,"typeText":"∀ {α : Type u} [inst : Lean.Grind.Ring.{u} α] {x y : Nat},\n  GE.ge.{0} x y → Eq.{u + 1} (↑↑(HSub.hSub.{0, 0, 0} x y)) (HSub.hSub.{u, u, u} ↑x ↑y)","unsafe":false,"value":984,"source":{"code":"theorem intCast_nat_sub {x y : Nat} (h : x ≥ y) : (((x - y : Nat) : Int) : α) = ((x : α) - (y : α)) := by\n  induction x with\n  | zero =>\n    have : y = 0 := by omega\n    simp [this, intCast_zero, natCast_zero, sub_eq_add_neg, zero_add, neg_zero]\n  | succ x ih =>\n    by_cases h : x + 1 = y\n    · simp [h, intCast_zero, sub_self]\n    · have : ((x + 1 - y : Nat) : Int) = (x - y : Nat) + 1 := by omega\n      rw [this, intCast_natCast_add_one]\n      specialize ih (by omega)\n      rw [intCast_natCast] at ih\n      rw [ih, natCast_succ, sub_eq_add_neg, sub_eq_add_neg, add_assoc,\n        AddCommMonoid.add_comm _ 1, ← add_assoc]","start":256,"end":269},"axioms":["Quot.sound","propext"]}