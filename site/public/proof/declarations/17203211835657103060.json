t","Option.some",[["zero"]]],["apply",98,0],["apply",67,65],["apply",99,100],["apply",97,101],["lambda","y._@.Lean.Meta.SynthInstance.2003723107._hygCtx._hyg.10",71,102,"explicit"],["bound",1],["apply",18,104],["apply",105,48],["apply",15,106],["apply",51,104],["apply",108,48],["apply",107,109],["apply",61,71],["apply",111,5],["apply",96,71],["constant","PUnit.unit",[["succ",["zero"]]]],["apply",113,114],["apply",112,115],["apply",104,12],["lambda","y._@.Lean.Meta.SynthInstance.2003723107._hygCtx._hyg.20",71,117,"explicit"],["apply",116,118],["apply",110,119],["constant","Option.none",[["zero"]]],["apply",121,0],["apply",97,122],["apply",120,123],["let","__do_jp._@.Lean.Meta.SynthInstance.2003723107._hygCtx._hyg.19",72,103,124,true],["lambda","__do_lift._@.Lean.Meta.SynthInstance.2003723107._hygCtx._hyg.17.0",17,125,"explicit"],["apply",70,126],["apply",54,127],["constant","_private.Lean.Meta.SynthInstance.0.Lean.Meta.applyAbstractResult?",[]],["apply",129,65],["apply",130,104],["apply",128,131],["lambda","abstResult",2,132,"explicit"],["apply",13,133],["lambda","x._@.Lean.Meta.SynthInstance.2003723107._hygCtx._hyg.114",3,123,"explicit"],["apply",134,135],["lambda","abstResult?",3,136,"explicit"],["lambda","type",0,137,"explicit"]],"project":false,"range":{"column":0,"endColumn":41,"endLine":769,"line":753},"type":8,"typeText":"Lean.Expr → Option.{0} Lean.Meta.AbstractMVarsResult → Lean.Meta.MetaM (Option.{0} Lean.Expr)","unsafe":false,"value":138,"source":{"code":"/--\nAuxiliary function for converting a cached `AbstractMVarsResult` returned by `SynthInstance.main` into an `Expr`.\nThis function tries to avoid the potentially expensive `check` at `applyCachedAbstractResult?`.\n-/\nprivate def applyCachedAbstractResult? (type : Expr) (abstResult? : Option AbstractMVarsResult) : MetaM (Option Expr) := do\n  let some abstResult := abstResult? | return none\n  if abstResult.numMVars == 0 && abstResult.paramNames.isEmpty then\n    /-\n    Result does not introduce new metavariables, thus we don't need to perform (again)\n    the `check` at `applyAbstractResult?`.\n    This is an optimization.\n    -/\n    unless (← assignOutParams type abstResult.expr) do\n      return none\n    return some abstResult.expr\n  else\n    applyAbstractResult? type abstResult?","start":753,"end":769},"axioms":["Classical.choice","Quot.sound","propext"]}