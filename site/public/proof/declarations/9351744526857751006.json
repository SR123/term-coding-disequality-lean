6",4,52,"explicit"]],"project":false,"range":{"column":0,"endColumn":48,"endLine":342,"line":335},"type":7,"typeText":"Prod.{0, 0} Lean.Omega.Constraint Lean.Omega.Coeffs → Option.{0} (Prod.{0, 0} Lean.Omega.Constraint Lean.Omega.Coeffs)","unsafe":false,"value":53,"source":{"code":"/-- `positivize` and `normalize`, returning `none` if neither does anything. -/\ndef tidy? : Constraint × Coeffs → Option (Constraint × Coeffs)\n  | ⟨s, x⟩ =>\n    match positivize? (s, x) with\n    | none => match normalize? (s, x) with\n      | none => none\n      | some (s', x') => some (s', x')\n    | some (s', x') => some (normalize (s', x'))","start":335,"end":342},"axioms":[]}