ply",276,278],["apply",279,10],["apply",280,4],["apply",263,281],["apply",277,27],["apply",276,283],["apply",284,10],["apply",285,2],["apply",282,286],["forall","hi₂",262,287,"explicit"],["forall","hi₁",259,288,"explicit"],["forall","i",7,289,"explicit"],["constant","congrArg",[["succ",["param","u"]],["succ",["param","u"]]]],["apply",83,159],["apply",291,292],["apply",1,159],["apply",293,294],["apply",295,94],["apply",296,23],["apply",297,256],["constant","_private.Init.Data.Array.Basic.0.Array.ext.extAux",[["param","u"]]],["apply",299,159],["apply",300,94],["apply",301,23],["apply",302,4],["apply",303,2],["apply",298,304],["lambda","h₂",290,305,"explicit"],["lambda","h₁",255,306,"explicit"],["apply",251,307],["apply",308,39],["constant","Eq.symm",[["succ",["param","u"]]]],["apply",310,155],["apply",311,39],["apply",312,198],["apply",313,2],["apply",309,314],["apply",315,23],["apply",316,10],["lambda","h._@.Init.Data.Array.Basic.722126854._hygCtx._hyg.792",196,317,"explicit"],["lambda","toList._@.Init.Data.Array.Basic.722126854._hygCtx._hyg.791",193,318,"explicit"],["apply",192,319],["constant","Eq.refl",[["succ",["param","u"]]]],["apply",321,182],["apply",322,32],["apply",320,323],["lambda","h₂",180,324,"explicit"],["lambda","h₁",147,325,"explicit"],["apply",142,326],["apply",327,27],["apply",310,35],["apply",329,27],["apply",330,92],["apply",331,2],["apply",328,332],["apply",333,23],["apply",334,10],["lambda","h._@.Init.Data.Array.Basic.722126854._hygCtx._hyg.787",88,335,"explicit"],["lambda","toList._@.Init.Data.Array.Basic.722126854._hygCtx._hyg.786",84,336,"explicit"],["apply",82,337],["apply",321,60],["apply",339,23],["apply",338,340],["lambda","h₂",59,341,"explicit"],["lambda","h₁",15,342,"explicit"],["lambda","ys",5,343,"implicit"],["lambda","xs",3,344,"implicit"],["lambda","α",0,345,"implicit"]],"project":false,"range":{"column":0,"endColumn":12,"endLine":79,"line":46},"type":68,"typeText":"∀ {α : Type u} {xs ys : Array.{u} α},\n  Eq.{1} (Array.size.{u} xs) (Array.size.{u} ys) →\n    (∀ (i : Nat) (hi₁ : LT.lt.{0} i (Array.size.{u} xs)) (hi₂ : LT.lt.{0} i (Array.size.{u} ys)),\n        Eq.{u + 1} (GetElem.getElem.{u, 0, u} xs i hi₁) (GetElem.getElem.{u, 0, u} ys i hi₂)) →\n      Eq.{u + 1} xs ys","unsafe":false,"value":346,"source":{"code":"theorem ext {xs ys : Array α}\n    (h₁ : xs.size = ys.size)\n    (h₂ : (i : Nat) → (hi₁ : i < xs.size) → (hi₂ : i < ys.size) → xs[i] = ys[i])\n    : xs = ys := by\n  let rec extAux (as bs : List α)\n      (h₁ : as.length = bs.length)\n      (h₂ : (i : Nat) → (hi₁ : i < as.length) → (hi₂ : i < bs.length) → as[i] = bs[i])\n      : as = bs := by\n    induction as generalizing bs with\n    | nil =>\n      cases bs with\n      | nil       => rfl\n      | cons b bs => rw [List.length_cons] at h₁; injection h₁\n    | cons a as ih =>\n      cases bs with\n      | nil => rw [List.length_cons] at h₁; injection h₁\n      | cons b bs =>\n        have hz₁ : 0 < (a::as).length := by rw [List.length_cons]; apply Nat.zero_lt_succ\n        have hz₂ : 0 < (b::bs).length := by rw [List.length_cons]; apply Nat.zero_lt_succ\n        have headEq : a = b := h₂ 0 hz₁ hz₂\n        have h₁' : as.length = bs.length := by rw [List.length_cons, List.length_cons] at h₁; injection h₁\n        have h₂' : (i : Nat) → (hi₁ : i < as.length) → (hi₂ : i < bs.length) → as[i] = bs[i] := by\n          intro i hi₁ hi₂\n          have hi₁' : i+1 < (a::as).length := by rw [List.length_cons]; apply Nat.succ_lt_succ; assumption\n          have hi₂' : i+1 < (b::bs).length := by rw [List.length_cons]; apply Nat.succ_lt_succ; assumption\n          have : (a::as)[i+1] = (b::bs)[i+1] := h₂ (i+1) hi₁' hi₂'\n          apply this\n        have tailEq : as = bs := ih bs h₁' h₂'\n        rw [headEq, tailEq]\n  cases xs; cases ys\n  apply congrArg\n  apply extAux\n  assumption\n  assumption","start":46,"end":79},"axioms":[]}