,["apply",152,466],["lambda","oldTraces",110,467,"explicit"],["apply",117,468],["lambda","y._@.Lean.Util.Trace.2168487494._hygCtx._hyg.54",99,469,"explicit"],["apply",274,102],["apply",385,6],["apply",170,9],["apply",473,172],["apply",472,474],["apply",278,475],["apply",476,39],["apply",471,477],["apply",284,475],["apply",479,39],["apply",478,480],["apply",107,99],["apply",482,101],["apply",302,100],["apply",304,100],["apply",306,100],["apply",486,90],["apply",485,487],["apply",484,488],["apply",489,99],["apply",490,312],["apply",483,491],["apply",492,406],["apply",481,493],["apply",107,101],["apply",495,101],["apply",496,19],["apply",302,101],["apply",304,101],["apply",306,101],["apply",500,100],["apply",499,501],["apply",498,502],["apply",503,125],["apply",504,3],["lambda","__do_lift._@.Lean.Util.Trace.2168487494._hygCtx._hyg.59.0",101,505,"explicit"],["apply",497,506],["apply",494,507],["let","__do_jp._@.Lean.Util.Trace.2168487494._hygCtx._hyg.79",103,470,508,true],["lambda","clsEnabled",37,509,"explicit"],["apply",98,510],["lambda","opts",76,511,"explicit"],["apply",84,512],["let","x._@.Lean.Util.Trace.2168487494._hygCtx._hyg.107",65,69,513,true],["lambda","tag",41,514,"explicit"],["lambda","collapsed",37,515,"explicit"],["lambda","k",35,516,"explicit"],["lambda","msg",33,517,"explicit"],["lambda","cls",26,518,"explicit"],["lambda","inst._@.Lean.Util.Trace.2168487494._hygCtx._hyg.33",25,519,"instance"],["lambda","always",20,520,"instance"],["lambda","ε",0,521,"implicit"],["lambda","inst._@.Lean.Util.Trace.2168487494._hygCtx._hyg.25",16,522,"instance"],["lambda","inst._@.Lean.Util.Trace.2168487494._hygCtx._hyg.22",13,523,"instance"],["lambda","inst._@.Lean.Util.Trace.2168487494._hygCtx._hyg.19",10,524,"instance"],["lambda","inst._@.Lean.Util.Trace.2168487494._hygCtx._hyg.9",7,525,"instance"],["lambda","inst._@.Lean.Util.Trace.2168487494._hygCtx._hyg.6",4,526,"instance"],["lambda","m",1,527,"implicit"],["lambda","α",0,528,"implicit"]],"project":false,"range":{"column":0,"endColumn":26,"endLine":289,"line":254},"type":62,"typeText":"{α : Type} →\n  {m : Type → Type} →\n    [Monad.{0, 0} m] →\n      [Lean.MonadTrace m] →\n        [Lean.MonadRef m] →\n          [Lean.AddMessageContext m] →\n            [Lean.MonadOptions m] →\n              {ε : Type} →\n                [always : Lean.MonadAlwaysExcept.{0, 0} ε m] →\n                  [MonadLiftT.{0, 0, 0} BaseIO m] →\n                    Lean.Name →\n                      (Except.{0, 0} ε α → m Lean.MessageData) →\n                        m α → optParam.{1} Bool Bool.true → optParam.{1} String \"\" → m α","unsafe":false,"value":529,"source":{"code":"/-- Run the provided action `k`, and log its execution within a trace node.\n\nThe message is produced after the action completes, and has access to its return value.\nIf it is more convenient to produce the message as part of the computation,\nthen `Lean.withTraceNode'` can be used instead.\nIf profiling is enabled, this will also log the runtime of `k`.\n\nA typical invocation might be:\n```lean4\nwithTraceNode `isPosTrace (msg := (return m!\"{ExceptToEmoji.toEmoji ·} checking positivity\")) do\n  return 0 < x\n```\n\nThe `cls`, `collapsed`, and `tag` arguments are fowarded to the constructor of `TraceData`.\n-/\ndef withTraceNode [always : MonadAlwaysExcept ε m] [MonadLiftT BaseIO m] (cls : Name)\n    (msg : Except ε α → m MessageData) (k : m α) (collapsed := true) (tag := \"\") : m α := do\n  let _ := always.except\n  let opts ← getOptions\n  let clsEnabled ← isTracingEnabledFor cls\n  unless clsEnabled || trace.profiler.get opts do\n    return (← k)\n  let oldTraces ← getResetTraces\n  let (res, start, stop) ← withStartStop opts <| observing k\n  let aboveThresh := trace.profiler.get opts &&\n    stop - start > trace.profiler.threshold.unitAdjusted opts\n  unless clsEnabled || aboveThresh do\n    modifyTraces (oldTraces ++ ·)\n    return (← MonadExcept.ofExcept res)\n  let ref ← getRef\n  let mut m ← try msg res catch _ => pure m!\"<exception thrown while producing trace node message>\"\n  let mut data := { cls, collapsed, tag }\n  if trace.profiler.get opts then\n    data := { data with startTime := start, stopTime := stop }\n  addTraceNode oldTraces data ref m\n  MonadExcept.ofExcept res","start":254,"end":289},"axioms":["Classical.choice","Quot.sound","propext"]}