urn m!\"could not unify the {conclusion} of {term?.getD \"the term\"}{indentExpr conclusionType}\\n\\\n      with the goal{indentExpr targetType}{note}{← mkUnfoldAxiomsNote conclusionType targetType}\"","start":28,"end":37},"axioms":["Classical.choice","Quot.sound","propext"]}