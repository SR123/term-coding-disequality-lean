{"dependencies":["instHAppendOfAppend","HAppend.hAppend","List.isSetoid","Quotient.liftOn₂","Multiset.add._proof_1","List","Multiset.ofList","Multiset","List.instAppend"],"doc":"The sum of two multisets is the lift of the list append operation.\nThis adds the multiplicities of each element,\ni.e. `count a (s + t) = count a s + count a t`. ","extra":null,"kind":"definition","levels":["u_1"],"module":"Mathlib.Data.Multiset.AddSub","name":"Multiset.add","nodes":[["sort",["succ",["param","u_1"]]],["constant","Multiset",[["param","u_1"]]],["bound",0],["apply",1,2],["bound",1],["apply",1,4],["bound",2],["apply",1,6],["forall","s₂",5,7,"explicit"],["forall","s₁",3,8,"explicit"],["forall","α",0,9,"implicit"],["constant","Quotient.liftOn₂",[["succ",["param","u_1"]],["succ",["param","u_1"]],["succ",["param","u_1"]]]],["constant","List",[["param","u_1"]]],["apply",12,6],["apply",11,13],["apply",14,13],["apply",15,7],["constant","List.isSetoid",[["param","u_1"]]],["apply",17,6],["apply",16,18],["apply",19,18],["apply",20,4],["apply",21,2],["bound",3],["apply",12,23],["constant","Multiset.ofList",[["param","u_1"]]],["bound",4],["apply",25,26],["constant","HAppend.hAppend",[["param","u_1"],["param","u_1"],["param","u_1"]]],["apply",12,26],["apply",28,29],["apply",30,29],["apply",31,29],["constant","instHAppendOfAppend",[["param","u_1"]]],["apply",33,29],["constant","List.instAppend",[["param","u_1"]]],["apply",35,26],["apply",34,36],["apply",32,37],["apply",38,4],["apply",39,2],["apply",27,40],["lambda","l₂",24,41,"explicit"],["lambda","l₁",13,42,"explicit"],["apply",22,43],["constant","Multiset.add._proof_1",[["param","u_1"]]],["apply",45,6],["apply",44,46],["lambda","s₂",5,47,"explicit"],["lambda","s₁",3,48,"explicit"],["lambda","α",0,49,"implicit"]],"project":false,"range":{"column":0,"endColumn":30,"endLine":52,"line":47},"type":10,"typeText":"{α : Type u_1} → Multiset.{u_1} α → Multiset.{u_1} α → Multiset.{u_1} α","unsafe":false,"value":50,"source":{"code":"/-- The sum of two multisets is the lift of the list append operation.\n  This adds the multiplicities of each element,\n  i.e. `count a (s + t) = count a s + count a t`. -/\nprotected def add (s₁ s₂ : Multiset α) : Multiset α :=\n  (Quotient.liftOn₂ s₁ s₂ fun l₁ l₂ => ((l₁ ++ l₂ : List α) : Multiset α)) fun _ _ _ _ p₁ p₂ =>\n    Quot.sound <| p₁.append p₂","start":47,"end":52},"axioms":["Quot.sound"]}