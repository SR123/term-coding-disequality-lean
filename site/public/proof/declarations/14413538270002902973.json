pply",408,1053],["apply",51,1040],["apply",1055,112],["apply",1054,1056],["apply",380,112],["apply",1058,18],["apply",1059,1040],["apply",1057,1060],["apply",87,1040],["apply",1062,112],["apply",414,1063],["apply",1061,1064],["apply",1051,1065],["apply",1066,1024],["apply",453,209],["apply",1068,112],["apply",1069,1040],["apply",1070,69],["apply",1071,18],["apply",1067,1072],["apply",438,1065],["apply",1074,1064],["apply",1075,1024],["apply",892,1053],["apply",1077,1056],["apply",1078,1060],["apply",1079,1064],["apply",523,1053],["apply",76,1053],["constant","_private.Init.Data.BitVec.Lemmas.0.BitVec.extractLsb'_append_eq_ite._proof_1_7",[]],["apply",1083,209],["apply",1084,18],["apply",1085,20],["apply",1086,36],["apply",1087,38],["apply",1088,5],["lambda","a._@._internal._hyg.0",1053,1089,"explicit"],["let","this",1082,1090,5,true],["apply",1081,1091],["apply",1080,1092],["apply",1076,1093],["apply",902,1063],["apply",1095,1023],["apply",1096,414],["apply",906,1063],["apply",1098,1023],["apply",496,1099],["apply",910,1063],["apply",1101,1023],["apply",1100,1102],["apply",76,1099],["constant","_private.Init.Data.BitVec.Lemmas.0.BitVec.extractLsb'_append_eq_ite._proof_1_8",[]],["apply",1105,209],["apply",1106,18],["apply",1107,20],["apply",1108,36],["apply",1109,38],["apply",1110,5],["lambda","a._@._internal.0.Init.Data.BitVec.Lemmas.1537924074._hygCtx._hyg.371",1104,1111,"explicit"],["apply",1103,1112],["let","this",1099,1113,5,true],["apply",1097,1114],["apply",1094,1115],["apply",1073,1116],["apply",1050,1117],["apply",1035,1118],["apply",1032,1119],["apply",462,212],["apply",1121,36],["apply",1122,69],["apply",1123,2],["apply",1124,5],["apply",1120,1125],["apply",1028,1126],["apply",861,1024],["apply",1127,1128],["apply",1020,1129],["lambda","hi",984,1130,"explicit"],["lambda","i",0,1131,"explicit"],["apply",983,1132],["apply",980,1133],["lambda","hstart",128,1134,"explicit"],["apply",963,1135],["lambda","len",0,1136,"implicit"],["lambda","start",0,1137,"implicit"],["lambda","xlo",3,1138,"implicit"],["lambda","xhi",3,1139,"implicit"],["lambda","w",0,1140,"implicit"],["lambda","v",0,1141,"implicit"]],"project":false,"range":{"column":0,"endColumn":50,"endLine":3042,"line":2994},"type":141,"typeText":"∀ {v w : Nat} {xhi : BitVec v} {xlo : BitVec w} {start len : Nat},\n  Eq.{1} (BitVec.extractLsb' start len (HAppend.hAppend.{0, 0, 0} xhi xlo))\n    (if hstart : LT.lt.{0} start w then\n      if hlen : LE.le.{0} (HAdd.hAdd.{0, 0, 0} start len) w then BitVec.extractLsb' start len xlo\n      else\n        BitVec.cast ⋯\n          (HAppend.hAppend.{0, 0, 0}\n            (BitVec.extractLsb' (HSub.hSub.{0, 0, 0} start w) (HSub.hSub.{0, 0, 0} len (HSub.hSub.{0, 0, 0} w start))\n              xhi)\n            (BitVec.extractLsb' start (HSub.hSub.{0, 0, 0} w start) xlo))\n    else BitVec.extractLsb' (HSub.hSub.{0, 0, 0} start w) len xhi)","unsafe":false,"value":1142,"source":{"code":"/--\nThe 'master theorem' for extracting bits from `(xhi ++ xlo)`,\nwhich performs a case analysis on the start index, length, and the lengths of `xlo, xhi`.\n· If the start index is entirely out of the `xlo` bitvector, then grab the bits from `xhi`.\n· If the start index is entirely contained in the `xlo` bitvector, then grab the bits from `xlo`.\n· If the start index is split between the two bitvectors,\n  then append `(w - start)` bits from `xlo` with `(len - (w - start))` bits from xhi.\n  Diagrammatically:\n  ```\n                 xhi                      xlo\n          (<---------------------](<-------w--------]\n  start+len..start:  (<-----len---*------]\n  w - start:                      *------*\n  len - (w -start):  *------------*\n  ```\n-/\n@[grind =]\ntheorem extractLsb'_append_eq_ite {v w} {xhi : BitVec v} {xlo : BitVec w} {start len : Nat} :\n    extractLsb' start len (xhi ++ xlo) =\n    if hstart : start < w\n    then\n      if hlen : start + len ≤ w\n      then extractLsb' start len xlo\n      else\n        (((extractLsb' (start - w) (len - (w - start)) xhi) ++\n            extractLsb' start (w - start) xlo)).cast (by omega)\n    else\n      extractLsb' (start - w) len xhi := by\n  by_cases hstart : start < w\n  · simp only [hstart, ↓reduceDIte]\n    by_cases hlen : start + len ≤ w\n    · simp only [hlen, ↓reduceDIte]\n      ext i hi\n      simp only [getElem_extractLsb', getLsbD_append, ite_eq_left_iff, Nat.not_lt]\n      intro hcontra\n      omega\n    · simp only [hlen, ↓reduceDIte]\n      ext i hi\n      simp only [getElem_extractLsb', getLsbD_append, getElem_cast,\n        getElem_append, dite_eq_ite]\n      by_cases hi₂ : start + i < w\n      · simp [hi₂, show i < w - start by omega]\n      · simp [hi₂, ↓reduceIte, show ¬i < w - start by omega,\n          show start + i - w = start - w + (i - (w - start)) by omega]\n  · simp only [hstart, ↓reduceDIte]\n    ext i hi\n    simp [getElem_extractLsb', getLsbD_append,\n      show ¬start + i < w by omega, ↓reduceIte,\n      show start + i - w = start - w + i by omega]","start":2994,"end":3042},"axioms":["Quot.sound","propext"]}