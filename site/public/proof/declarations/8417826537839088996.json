nge":{"column":0,"endColumn":42,"endLine":87,"line":68},"type":4,"typeText":"Char → List.{0} UInt8","unsafe":false,"value":174,"source":{"code":"/--\nReturns the sequence of bytes in a character's UTF-8 encoding.\n-/\n@[expose]\npublic def String.utf8EncodeCharFast (c : Char) : List UInt8 :=\n  let v := c.val\n  if v ≤ 0x7f then\n    [v.toUInt8]\n  else if v ≤ 0x7ff then\n    [(v >>>  6).toUInt8 &&& 0x1f ||| 0xc0,\n              v.toUInt8 &&& 0x3f ||| 0x80]\n  else if v ≤ 0xffff then\n    [(v >>> 12).toUInt8 &&& 0x0f ||| 0xe0,\n     (v >>>  6).toUInt8 &&& 0x3f ||| 0x80,\n              v.toUInt8 &&& 0x3f ||| 0x80]\n  else\n    [(v >>> 18).toUInt8 &&& 0x07 ||| 0xf0,\n     (v >>> 12).toUInt8 &&& 0x3f ||| 0x80,\n     (v >>>  6).toUInt8 &&& 0x3f ||| 0x80,\n              v.toUInt8 &&& 0x3f ||| 0x80]","start":68,"end":87},"axioms":["Quot.sound","propext"]}