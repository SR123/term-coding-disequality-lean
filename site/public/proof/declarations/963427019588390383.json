Data.List.Sublist.2230396446._hygCtx._hyg.66",0,339,"implicit"]],"project":false,"range":{"column":0,"endColumn":64,"endLine":200,"line":192},"type":61,"typeText":"∀ {α : Type u_1} {l l₁ : List.{u_1} α} {a : α} {l₂ : List.{u_1} α},\n  List.Sublist.{u_1} l (HAppend.hAppend.{u_1, u_1, u_1} l₁ (List.cons.{u_1} a l₂)) →\n    Or (List.Sublist.{u_1} l (HAppend.hAppend.{u_1, u_1, u_1} l₁ l₂)) (Membership.mem.{u_1, u_1} l a)","unsafe":false,"value":340,"source":{"code":"theorem sublist_or_mem_of_sublist (h : l <+ l₁ ++ a :: l₂) : l <+ l₁ ++ l₂ ∨ a ∈ l := by\n  induction l₁ generalizing l with\n  | nil => match h with\n    | .cons _ h => exact .inl h\n    | .cons₂ _ h => exact .inr (.head ..)\n  | cons b l₁ IH =>\n    match h with\n    | .cons _ h => exact (IH h).imp_left (Sublist.cons _)\n    | .cons₂ _ h => exact (IH h).imp (Sublist.cons₂ _) (.tail _)","start":192,"end":200},"axioms":[]}