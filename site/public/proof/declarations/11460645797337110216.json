],["apply",141,10],["apply",144,145],["apply",110,146],["let","m",0,108,147,false],["let","s",0,39,148,false],["apply",18,149],["apply",77,37],["apply",106,85],["apply",151,152],["apply",109,153],["apply",141,85],["apply",154,155],["apply",150,156],["lambda","e",0,157,"explicit"],["lambda","s",1,158,"explicit"],["lambda","m",0,159,"explicit"]],"project":false,"range":{"column":0,"endColumn":40,"endLine":53,"line":41},"type":5,"typeText":"Nat → Bool → Nat → Float","unsafe":false,"value":160,"source":{"code":"/--\nConstructs a `Float` from the given mantissa, sign, and exponent values.\n\nThis function is part of the implementation of the `OfScientific Float` instance that is used to\ninterpret floating-point literals.\n-/\nprotected opaque Float.ofScientific (m : Nat) (s : Bool) (e : Nat) : Float :=\n  if s then\n    let s := 64 - m.log2 -- ensure we have 64 bits of mantissa left after division\n    let m := (m <<< (3 * e + s)) / 5^e\n    Float.ofBinaryScientific m (-4 * e - s)\n  else\n    Float.ofBinaryScientific (m * 5^e) e","start":41,"end":53},"axioms":["Classical.choice"]}