mem",[["param","u"]]],["apply",608,268],["apply",609,196],["apply",610,165],["apply",611,147],["apply",612,172],["apply",613,132],["apply",614,484],["apply",607,615],["apply",579,616],["apply",569,617],["apply",519,618],["apply",486,619],["lambda","hn",277,620,"explicit"],["lambda","n",12,621,"explicit"],["apply",426,622],["lambda","hm",157,623,"explicit"],["lambda","m",12,624,"explicit"],["apply",231,625],["lambda","hs",144,626,"explicit"],["lambda","s",131,627,"explicit"],["apply",130,628],["lambda","ha",97,629,"explicit"],["lambda","a",40,630,"strictImplicit"],["lambda","U_le",71,631,"explicit"],["lambda","U_mem",37,632,"explicit"],["lambda","U",17,633,"implicit"],["lambda","hf",11,634,"explicit"],["lambda","f",6,635,"implicit"],["lambda","uniformSpace",3,636,"instance"],["lambda","α",0,637,"implicit"]],"project":false,"range":{"column":0,"endColumn":44,"endLine":784,"line":772},"type":125,"typeText":"∀ {α : Type u} [uniformSpace : UniformSpace.{u} α] {f : Filter.{u} α} (hf : Cauchy.{u} f) {U : Nat → SetRel.{u, u} α α}\n  (U_mem : ∀ (n : Nat), Membership.mem.{u, u} (uniformity.{u} α) (U n)),\n  (∀ (s : Set.{u} (Prod.{u, u} α α)), Membership.mem.{u, u} (uniformity.{u} α) s → ∃ n, HasSubset.Subset.{u} (U n) s) →\n    ∀ ⦃a : α⦄,\n      Filter.Tendsto.{0, u} (SequentiallyComplete.seq.{u} hf U_mem) Filter.atTop.{0} (nhds.{u} a) →\n        LE.le.{u} f (nhds.{u} a)","unsafe":false,"value":638,"source":{"code":"/-- If the sequence `SequentiallyComplete.seq` converges to `a`, then `f ≤ 𝓝 a`. -/\ntheorem le_nhds_of_seq_tendsto_nhds (U_le : ∀ s ∈ 𝓤 α, ∃ n, U n ⊆ s)\n    ⦃a : α⦄ (ha : Tendsto (seq hf U_mem) atTop (𝓝 a)) : f ≤ 𝓝 a :=\n  le_nhds_of_cauchy_adhp_aux\n    (fun s hs => by\n      rcases U_le s hs with ⟨m, hm⟩\n      rcases tendsto_atTop'.1 ha _ (mem_nhds_left a (U_mem m)) with ⟨n, hn⟩\n      refine\n        ⟨setSeq hf U_mem (max m n), setSeq_mem hf U_mem _, ?_, seq hf U_mem (max m n), ?_,\n          seq_mem hf U_mem _⟩\n      · have := le_max_left m n\n        exact Set.Subset.trans (setSeq_prod_subset hf U_mem this this) hm\n      · exact hm (hn _ <| le_max_right m n))","start":772,"end":784},"axioms":["Classical.choice","Quot.sound","propext"]}