 := Nat.mul_lt_mul_of_pos_left p np\n    simp [h] at r\n  | Or.inr (Or.inl p) => exact p\n  | Or.inr (Or.inr p) =>\n    have r : n * k < n * m := Nat.mul_lt_mul_of_pos_left p np\n    simp [h] at r","start":576,"end":584},"axioms":["propext"]}