cit"],["lambda","n",0,655,"explicit"],["lambda","m",0,656,"explicit"]],"project":false,"range":{"column":0,"endColumn":87,"endLine":489,"line":477},"type":41,"typeText":"∀ (m n k : Nat),\n  Eq.{1} (HMul.hMul.{0, 0, 0} (Int.negSucc m) (Int.subNatNat n k))\n    (Int.subNatNat (HMul.hMul.{0, 0, 0} (Nat.succ m) k) (HMul.hMul.{0, 0, 0} (Nat.succ m) n))","unsafe":false,"value":657,"source":{"code":"theorem negSucc_mul_subNatNat (m n k : Nat) :\n    -[m+1] * subNatNat n k = subNatNat (succ m * k) (succ m * n) := by\n  cases n.lt_or_ge k with\n  | inl h =>\n    have h' : succ m * n < succ m * k := Nat.mul_lt_mul_of_pos_left h (Nat.succ_pos m)\n    rw [subNatNat_of_lt h, subNatNat_of_le (Nat.le_of_lt h')]\n    simp [sub_one_add_one_eq_of_pos (Nat.sub_pos_of_lt h), Nat.mul_sub_left_distrib]\n  | inr h => cases Nat.lt_or_ge k n with\n    | inl h' =>\n      have h₁ : succ m * n > succ m * k := Nat.mul_lt_mul_of_pos_left h' (Nat.succ_pos m)\n      rw [subNatNat_of_le h, subNatNat_of_lt h₁, negSucc_mul_ofNat,\n        Nat.mul_sub_left_distrib, ← succ_pred_eq_of_pos (Nat.sub_pos_of_lt h₁)]; rfl\n    | inr h' => rw [Nat.le_antisymm h h', subNatNat_self, subNatNat_self, Int.mul_zero]","start":477,"end":489},"axioms":["propext"]}