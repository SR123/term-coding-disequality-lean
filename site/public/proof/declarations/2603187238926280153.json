Core_eq_mod (n m : Nat) : Nat.modCore n m = n % m := by\n  change Nat.modCore n m = Nat.mod n m\n  match n, m with\n  | 0, _ =>\n    rw [Nat.modCore_eq]\n    exact if_neg fun ⟨hlt, hle⟩ => Nat.lt_irrefl _ (Nat.lt_of_lt_of_le hlt hle)\n  | (_ + 1), _ =>\n    rw [Nat.mod]; dsimp\n    refine iteInduction (fun _ => rfl) (fun h => ?false) -- cannot use `split` this early yet\n    rw [Nat.modCore_eq]\n    exact if_neg fun ⟨_hlt, hle⟩ => h hle","start":144,"end":154},"axioms":["propext"]}