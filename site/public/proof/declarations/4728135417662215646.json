","p",6,706,"explicit"],["lambda","k",1,707,"explicit"],["lambda","α",0,708,"implicit"]],"project":true,"range":null,"type":85,"typeText":"∀ {α : Type} (k : Nat) (p : α → DisequalityDispersion.Costed Bool) (x : List.{0} α),\n  Eq.{1} (DisequalityDispersion.Costed.allM k p x)\n    (match x with\n    | List.nil.{0} => Pure.pure.{0, 0} Bool.true\n    | List.cons.{0} a l => do\n      DisequalityDispersion.Costed.tick k\n      let b ← p a\n      let r ← DisequalityDispersion.Costed.allM k p l\n      Pure.pure.{0, 0} (Bool.and b r))","unsafe":false,"value":709,"steps":[],"stepGoalPool":[],"references":[],"axioms":[]}