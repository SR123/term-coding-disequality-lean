],"project":false,"range":{"column":0,"endColumn":64,"endLine":812,"line":804},"type":77,"typeText":"{α : Type u_2} →\n  {β : Type u_3} →\n    [inst : PartialOrder.{u_3} β] →\n      [inst_1 : LE.{u_2} α] →\n        [inst_2 : LT.{u_2} α] →\n          (f : α → β) →\n            Function.Injective.{u_2 + 1, u_3 + 1} f →\n              (∀ {x y : α}, Iff (LE.le.{u_3} (f x) (f y)) (LE.le.{u_2} x y)) →\n                (∀ {x y : α}, Iff (LT.lt.{u_3} (f x) (f y)) (LT.lt.{u_2} x y)) → PartialOrder.{u_2} α","unsafe":false,"value":119,"source":{"code":"/-- Pull back a `PartialOrder` instance along an injective function.\n\nSee note [reducible non-instances]. -/\nabbrev Function.Injective.partialOrder [PartialOrder β] [LE α] [LT α] (f : α → β)\n    (hf : Function.Injective f)\n    (le : ∀ {x y}, f x ≤ f y ↔ x ≤ y) (lt : ∀ {x y}, f x < f y ↔ x < y) :\n    PartialOrder α where\n  __ := Function.Injective.preorder f le lt\n  le_antisymm _ _ h₁ h₂ := hf <| le_antisymm (le.2 h₁) (le.2 h₂)","start":804,"end":812},"axioms":["propext"]}