":false,"range":{"column":0,"endColumn":32,"endLine":232,"line":226},"type":51,"typeText":"∀ {n : Nat} (x : Nat),\n  (∀ (i : Nat), GE.ge.{0} i n → Eq.{1} (Nat.testBit x i) Bool.false) → LT.lt.{0} x (HPow.hPow.{0, 0, 0} 2 n)","unsafe":false,"value":150,"source":{"code":"theorem lt_pow_two_of_testBit (x : Nat) (p : ∀i, i ≥ n → testBit x i = false) : x < 2^n := by\n  apply Decidable.by_contra\n  intro not_lt\n  have x_ge_n := Nat.ge_of_not_lt not_lt\n  have ⟨i, ⟨i_ge_n, test_true⟩⟩ := exists_ge_and_testBit_of_ge_two_pow x_ge_n\n  have test_false := p _ i_ge_n\n  simp [test_true] at test_false","start":226,"end":232},"axioms":["Quot.sound","propext"]}