23,"explicit"],["lambda","it",38,524,"explicit"],["lambda","inst._@.Init.Data.Iterators.Combinators.Monadic.FilterMap.381269238._hygCtx._hyg.26",25,525,"instance"],["lambda","f",18,526,"implicit"],["lambda","lift",11,527,"implicit"],["lambda","n",4,528,"implicit"],["lambda","m",2,529,"implicit"],["lambda","γ",0,530,"implicit"],["lambda","β",0,531,"implicit"],["lambda","α",0,532,"implicit"]],"project":false,"range":{"column":0,"endColumn":80,"endLine":140,"line":122},"type":346,"typeText":"∀ {α β γ : Type w} {m : Type w → Type w'} {n : Type w → Type w''} {lift : ⦃α : Type w⦄ → m α → n α}\n  {f : β → Std.Iterators.PostconditionT.{w, w''} n (Option.{w} γ)} [inst : Std.Iterators.Iterator.{w, w'} α m β]\n  {it : Std.Iterators.IterM.{w, w''} n γ}\n  {motive :\n    (a : Std.Iterators.IterStep.{w + 1, w + 1} (Std.Iterators.IterM.{w, w''} n γ) γ) →\n      Std.Iterators.FilterMap.PlausibleStep.{w, w', w''} it a → Prop},\n  (∀ {it' : Std.Iterators.IterM.{w, w'} m β} {out : β}\n      (a :\n        Std.Iterators.IterM.IsPlausibleStep.{w, w'}\n          (Std.Iterators.FilterMap.inner.{w, w', w''} (Std.Iterators.IterM.internalState.{w, w''} it))\n          (Std.Iterators.IterStep.yield.{w + 1, w + 1} it' out))\n      (a_1 : Std.Iterators.PostconditionT.Property.{w, w''} (f out) Option.none.{w}),\n      motive\n        (Std.Iterators.IterStep.skip.{w + 1, w + 1}\n          (Std.Iterators.IterM.InternalCombinators.filterMap.{w, w', w''} lift f it'))\n        ⋯) →\n    (∀ {it' : Std.Iterators.IterM.{w, w'} m β} {out : β} {out' : γ}\n        (a :\n          Std.Iterators.IterM.IsPlausibleStep.{w, w'}\n            (Std.Iterators.FilterMap.inner.{w, w', w''} (Std.Iterators.IterM.internalState.{w, w''} it))\n            (Std.Iterators.IterStep.yield.{w + 1, w + 1} it' out))\n        (a_1 : Std.Iterators.PostconditionT.Property.{w, w''} (f out) (Option.some.{w} out')),\n        motive\n          (Std.Iterators.IterStep.yield.{w + 1, w + 1}\n            (Std.Iterators.IterM.InternalCombinators.filterMap.{w, w', w''} lift f it') out')\n          ⋯) →\n      (∀ {it' : Std.Iterators.IterM.{w, w'} m β}\n          (a :\n            Std.Iterators.IterM.IsPlausibleStep.{w, w'}\n              (Std.Iterators.FilterMap.inner.{w, w', w''} (Std.Iterators.IterM.internalState.{w, w''} it))\n              (Std.Iterators.IterStep.skip.{w + 1, w + 1} it')),\n          motive\n            (Std.Iterators.IterStep.skip.{w + 1, w + 1}\n              (Std.Iterators.IterM.InternalCombinators.filterMap.{w, w', w''} lift f it'))\n            ⋯) →\n        (∀\n            (a :\n              Std.Iterators.IterM.IsPlausibleStep.{w, w'}\n                (Std.Iterators.FilterMap.inner.{w, w', w''} (Std.Iterators.IterM.internalState.{w, w''} it))\n                Std.Iterators.IterStep.done.{w + 1, w + 1}),\n            motive Std.Iterators.IterStep.done.{w + 1, w + 1} ⋯) →\n          ∀ {a : Std.Iterators.IterStep.{w + 1, w + 1} (Std.Iterators.IterM.{w, w''} n γ) γ}\n            (t : Std.Iterators.FilterMap.PlausibleStep.{w, w', w''} it a), motive a t","unsafe":false,"value":null,"source":{"code":"/--\n`it.PlausibleStep step` is the proposition that `step` is a possible next step from the\n`filterMap` iterator `it`. This is mostly internally relevant, except if one needs to manually\nprove termination (`Finite` or `Productive` instances, for example) of a `filterMap` iterator.\n-/\ninductive FilterMap.PlausibleStep {α β γ : Type w} {m : Type w → Type w'} {n : Type w → Type w''}\n    {lift : ⦃α : Type w⦄ → m α → n α} {f : β → PostconditionT n (Option γ)} [Iterator α m β]\n    (it : IterM (α := FilterMap α m n lift f) n γ) :\n    IterStep (IterM (α := FilterMap α m n lift f) n γ) γ → Prop where\n  | yieldNone : ∀ {it' out},\n      it.internalState.inner.IsPlausibleStep (.yield it' out) →\n      (f out).Property none →\n      PlausibleStep it (.skip (IterM.InternalCombinators.filterMap lift f it'))\n  | yieldSome : ∀ {it' out out'}, it.internalState.inner.IsPlausibleStep (.yield it' out) →\n      (f out).Property (some out') →\n      PlausibleStep it (.yield (IterM.InternalCombinators.filterMap lift f it') out')\n  | skip : ∀ {it'}, it.internalState.inner.IsPlausibleStep (.skip it') →\n      PlausibleStep it (.skip (IterM.InternalCombinators.filterMap lift f it'))\n  | done : it.internalState.inner.IsPlausibleStep .done → PlausibleStep it .done","start":122,"end":140},"axioms":[]}