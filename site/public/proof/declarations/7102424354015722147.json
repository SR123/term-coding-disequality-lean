,"type":37,"typeText":"{motive : Lean.Meta.Origin → Sort u} →\n  (t : Lean.Meta.Origin) →\n    ((declName : Lean.Name) → (post inv : Bool) → motive (Lean.Meta.Origin.decl declName post inv)) →\n      (Ne.{1} (Lean.Meta.Origin.ctorIdx t) 0 → motive t) → motive t","unsafe":false,"value":135,"source":{"code":"instance : BEq Origin where\n  beq a b := match a, b with\n    | .decl declName₁ _ inv₁, .decl declName₂ _ inv₂ =>\n      /- Remark: we must distinguish `thm` from `←thm`. See issue #4290. -/\n      declName₁ == declName₂ && inv₁ == inv₂\n    | .decl .., _ => false\n    | _, .decl .. => false\n    | a, b => a.key == b.key","start":93,"end":100},"axioms":[]}