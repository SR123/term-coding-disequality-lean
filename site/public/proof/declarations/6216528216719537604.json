{"dependencies":["Lean.Expr.replace","Lean.Name","Option","Lean.Level","Lean.Expr","_private.Lean.Util.InstantiateLevelParams.0.Lean.Expr.instantiateLevelParamsCore.replaceFn"],"doc":"Instantiate level parameters\n","extra":null,"kind":"definition","levels":[],"module":"Lean.Util.InstantiateLevelParams","name":"Lean.Expr.instantiateLevelParamsCore","nodes":[["constant","Lean.Name",[]],["constant","Option",[["zero"]]],["constant","Lean.Level",[]],["apply",1,2],["forall","a._@._internal._hyg.0",0,3,"explicit"],["constant","Lean.Expr",[]],["forall","e",5,5,"explicit"],["forall","s",4,6,"explicit"],["constant","Lean.Expr.replace",[]],["constant","_private.Lean.Util.InstantiateLevelParams.0.Lean.Expr.instantiateLevelParamsCore.replaceFn",[]],["bound",1],["apply",9,10],["apply",8,11],["bound",0],["apply",12,13],["lambda","e",5,14,"explicit"],["lambda","s",4,15,"explicit"]],"project":false,"range":{"column":0,"endColumn":15,"endLine":25,"line":15},"type":7,"typeText":"(Lean.Name → Option.{0} Lean.Level) → Lean.Expr → Lean.Expr","unsafe":false,"value":16,"source":{"code":"/--\nInstantiate level parameters\n-/\n@[specialize] def instantiateLevelParamsCore (s : Name → Option Level) (e : Expr) : Expr :=\n  e.replace replaceFn\nwhere\n  @[specialize] replaceFn (e : Expr) : Option Expr :=\n    if !e.hasLevelParam then e else match e with\n    | const _ us => e.updateConst! (us.map fun u => u.substParams s)\n    | sort u => e.updateSort! (u.substParams s)\n    | _ => none","start":15,"end":25},"axioms":["Quot.sound","propext"]}