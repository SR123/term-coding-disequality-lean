value":66,"source":{"code":"@[macro_inline] instance {p q} [dp : Decidable p] [dq : Decidable q] : Decidable (And p q) :=\n  match dp with\n  | isTrue  hp =>\n    match dq with\n    | isTrue hq  => isTrue ⟨hp, hq⟩\n    | isFalse hq => isFalse (fun h => hq (And.right h))\n  | isFalse hp =>\n    isFalse (fun h => hp (And.left h))","start":1082,"end":1089},"axioms":[]}