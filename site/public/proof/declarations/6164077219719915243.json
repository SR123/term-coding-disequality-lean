"constant","LinearOrder.toOrd",[["param","u_2"]]],["apply",246,210],["apply",247,2],["apply",245,248],["constant","subsetConditionallyCompleteLinearOrder._proof_5",[["param","u_2"]]],["apply",250,197],["apply",251,128],["apply",252,78],["apply",249,253],["constant","LinearOrder.toDecidableLE",[["param","u_2"]]],["apply",255,210],["apply",256,2],["apply",254,257],["constant","LinearOrder.toDecidableEq",[["param","u_2"]]],["apply",259,210],["apply",260,2],["apply",258,261],["constant","LinearOrder.toDecidableLT",[["param","u_2"]]],["apply",263,210],["apply",264,2],["apply",262,265],["constant","subsetConditionallyCompleteLinearOrder._proof_8",[["param","u_2"]]],["apply",267,197],["apply",268,128],["apply",269,78],["apply",270,50],["apply",266,271],["constant","subsetConditionallyCompleteLinearOrder._proof_11",[["param","u_2"]]],["apply",273,197],["apply",274,128],["apply",275,78],["apply",276,50],["apply",272,277],["constant","subsetConditionallyCompleteLinearOrder._proof_12",[["param","u_2"]]],["apply",279,197],["apply",280,128],["apply",281,78],["apply",278,282],["let","__src._@.Mathlib.Order.CompleteLatticeIntervals.151951226._hygCtx._hyg.67",190,207,283,false],["let","__src._@.Mathlib.Order.CompleteLatticeIntervals.151951226._hygCtx._hyg.66",173,186,284,false],["let","__src._@.Mathlib.Order.CompleteLatticeIntervals.151951226._hygCtx._hyg.65",163,171,285,false],["let","__src._@.Mathlib.Order.CompleteLatticeIntervals.151951226._hygCtx._hyg.64",153,161,286,false],["lambda","h_Inf",144,287,"explicit"],["lambda","h_Sup",94,288,"explicit"],["lambda","inst._@.Mathlib.Order.CompleteLatticeIntervals.151951226._hygCtx._hyg.9",12,289,"instance"],["lambda","inst._@.Mathlib.Order.CompleteLatticeIntervals.151951226._hygCtx._hyg.6",6,290,"instance"],["lambda","s",3,291,"explicit"],["lambda","α",0,292,"implicit"]],"project":false,"range":{"column":0,"endColumn":54,"endLine":145,"line":119},"type":151,"typeText":"{α : Type u_2} →\n  (s : Set.{u_2} α) →\n    [inst : ConditionallyCompleteLinearOrder.{u_2} α] →\n      [Inhabited.{u_2 + 1} ↑s] →\n        (∀ {t : Set.{u_2} ↑s},\n            Set.Nonempty.{u_2} t →\n              BddAbove.{u_2} t →\n                Membership.mem.{u_2, u_2} s (SupSet.sSup.{u_2} (Set.image.{u_2, u_2} Subtype.val.{u_2 + 1} t))) →\n          (∀ {t : Set.{u_2} ↑s},\n              Set.Nonempty.{u_2} t →\n                BddBelow.{u_2} t →\n                  Membership.mem.{u_2, u_2} s (InfSet.sInf.{u_2} (Set.image.{u_2, u_2} Subtype.val.{u_2 + 1} t))) →\n            ConditionallyCompleteLinearOrder.{u_2} ↑s","unsafe":false,"value":293,"source":{"code":"/-- For a nonempty subset of a conditionally complete linear order to be a conditionally complete\nlinear order, it suffices that it contain the `sSup` of all its nonempty bounded-above subsets, and\nthe `sInf` of all its nonempty bounded-below subsets.\nSee note [reducible non-instances]. -/\nnoncomputable abbrev subsetConditionallyCompleteLinearOrder [Inhabited s]\n    (h_Sup : ∀ {t : Set s} (_ : t.Nonempty) (_h_bdd : BddAbove t), sSup ((↑) '' t : Set α) ∈ s)\n    (h_Inf : ∀ {t : Set s} (_ : t.Nonempty) (_h_bdd : BddBelow t), sInf ((↑) '' t : Set α) ∈ s) :\n    ConditionallyCompleteLinearOrder s :=\n  { subsetSupSet s, subsetInfSet s, DistribLattice.toLattice, (inferInstance : LinearOrder s) with\n    le_csSup := by\n      rintro t c h_bdd hct\n      rw [← Subtype.coe_le_coe, ← subset_sSup_of_within s ⟨c, hct⟩ h_bdd (h_Sup ⟨c, hct⟩ h_bdd)]\n      exact (Subtype.mono_coe _).le_csSup_image hct h_bdd\n    csSup_le := by\n      rintro t B ht hB\n      rw [← Subtype.coe_le_coe, ← subset_sSup_of_within s ht ⟨B, hB⟩ (h_Sup ht ⟨B, hB⟩)]\n      exact (Subtype.mono_coe s).csSup_image_le ht hB\n    le_csInf := by\n      intro t B ht hB\n      rw [← Subtype.coe_le_coe, ← subset_sInf_of_within s ht ⟨B, hB⟩ (h_Inf ht ⟨B, hB⟩)]\n      exact (Subtype.mono_coe s).le_csInf_image ht hB\n    csInf_le := by\n      rintro t c h_bdd hct\n      rw [← Subtype.coe_le_coe, ← subset_sInf_of_within s ⟨c, hct⟩ h_bdd (h_Inf ⟨c, hct⟩ h_bdd)]\n      exact (Subtype.mono_coe s).csInf_image_le hct h_bdd\n    csSup_of_not_bddAbove := fun t ht ↦ by simp [ht]\n    csInf_of_not_bddBelow := fun t ht ↦ by simp [ht] }","start":119,"end":145},"axioms":["Classical.choice","Quot.sound","propext"]}