ect":false,"range":{"column":0,"endColumn":53,"endLine":1353,"line":1344},"type":23,"typeText":"{α : Type u} →\n  {R : α → α → Prop} → [DecidableRel.{u + 1, u + 1} R] → (l : List.{u} α) → Decidable (List.Pairwise.{u} R l)","unsafe":false,"value":198,"source":{"code":"instance instDecidablePairwise [DecidableRel R] :\n    (l : List α) → Decidable (Pairwise R l)\n  | [] => isTrue .nil\n  | hd :: tl =>\n    match instDecidablePairwise tl with\n    | isTrue ht =>\n      match decidableBAll (R hd) tl with\n      | isFalse hf => isFalse fun hf' => hf (pairwise_cons.1 hf').1\n      | isTrue ht' => isTrue <| pairwise_cons.mpr (And.intro ht' ht)\n    | isFalse hf => isFalse fun | .cons _ ih => hf ih","start":1344,"end":1353},"axioms":[]}