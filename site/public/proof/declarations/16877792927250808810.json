stance"],["lambda","uniformSpace",4,592,"instance"],["lambda","β",1,593,"implicit"],["lambda","α",0,594,"implicit"]],"project":false,"range":{"column":0,"endColumn":32,"endLine":313,"line":303},"type":130,"typeText":"∀ {α : Type u} {β : Type v} [uniformSpace : UniformSpace.{u} α] [inst : SemilatticeSup.{v} β] [Nonempty.{v + 1} β]\n  (U : β → SetRel.{u, u} α α),\n  (∀ (s : Set.{u} (Prod.{u, u} α α)), Membership.mem.{u, u} (uniformity.{u} α) s → ∃ n, HasSubset.Subset.{u} (U n) s) →\n    ∀ {f : β → α},\n      (∀ ⦃N m n : β⦄, LE.le.{v} N m → LE.le.{v} N n → Membership.mem.{u, u} (U N) (Prod.mk.{u, u} (f m) (f n))) →\n        CauchySeq.{u, v} f","unsafe":false,"value":595,"source":{"code":"theorem cauchySeq_of_controlled [SemilatticeSup β] [Nonempty β] (U : β → SetRel α α)\n    (hU : ∀ s ∈ 𝓤 α, ∃ n, U n ⊆ s) {f : β → α}\n    (hf : ∀ ⦃N m n : β⦄, N ≤ m → N ≤ n → (f m, f n) ∈ U N) : CauchySeq f :=\n  cauchySeq_iff_tendsto.2\n    (by\n      intro s hs\n      rw [mem_map, mem_atTop_sets]\n      obtain ⟨N, hN⟩ := hU s hs\n      refine ⟨(N, N), fun mn hmn => ?_⟩\n      obtain ⟨m, n⟩ := mn\n      exact hN (hf hmn.1 hmn.2))","start":303,"end":313},"axioms":["Classical.choice","Quot.sound","propext"]}