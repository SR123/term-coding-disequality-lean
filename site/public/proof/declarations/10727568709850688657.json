pply",755,928],["lambda","hl",642,929,"explicit"],["lambda","l",0,930,"explicit"],["apply",686,931],["let","h₂'",624,28,932,true],["apply",619,933],["lambda","ih",561,934,"explicit"],["lambda","h₂",523,935,"explicit"],["lambda","c",33,936,"explicit"],["lambda","h₁",205,937,"explicit"],["lambda","hf",198,938,"explicit"],["lambda","fuel",1,939,"explicit"],["lambda","hi",193,940,"explicit"],["lambda","acc",34,941,"explicit"],["lambda","i",1,942,"explicit"],["apply",518,943],["apply",944,44],["apply",945,25],["apply",946,6],["apply",947,9],["apply",948,28],["lambda","acc",34,949,"implicit"],["lambda","hf",31,950,"implicit"],["lambda","hi",11,951,"implicit"],["lambda","i",1,952,"implicit"],["lambda","fuel",1,953,"implicit"],["lambda","b",0,954,"implicit"]],"project":false,"range":{"column":0,"endColumn":79,"endLine":181,"line":159},"type":68,"typeText":"∀ {b : ByteArray} {fuel i : Nat} {hi : LE.le.{0} i (ByteArray.size b)}\n  {hf : LT.lt.{0} (HSub.hSub.{0, 0, 0} (ByteArray.size b) i) fuel} {acc : Array.{0} Char},\n  Iff (Eq.{1} (Option.isSome.{0} (ByteArray.utf8Decode?.go b fuel i acc hi hf)) Bool.true)\n    (ByteArray.IsValidUTF8 (ByteArray.extract b i (ByteArray.size b)))","unsafe":false,"value":955,"source":{"code":"private theorem ByteArray.isSome_utf8Decode?go_iff {b : ByteArray} {fuel i : Nat} {hi : i ≤ b.size} {hf} {acc : Array Char} :\n    (ByteArray.utf8Decode?.go b fuel i acc hi hf).isSome ↔ IsValidUTF8 (b.extract i b.size) := by\n  fun_induction ByteArray.utf8Decode?.go with\n  | case1 => simp\n  | case2 fuel i hi hf acc h₁ h₂ =>\n    simp only [Option.isSome_none, Bool.false_eq_true, false_iff]\n    rintro ⟨l, hl⟩\n    have : l ≠ [] := by\n      rintro rfl\n      simp at hl\n      omega\n    rw [← l.cons_head_tail this] at hl\n    rw [utf8DecodeChar?_eq_utf8DecodeChar?_extract, hl, List.utf8DecodeChar?_utf8Encode_cons] at h₂\n    simp at h₂\n  | case3 i acc hi fuel hf h₁ c h₂ ih =>\n    rw [ih]\n    have h₂' := h₂\n    rw [utf8DecodeChar?_eq_utf8DecodeChar?_extract] at h₂'\n    obtain ⟨l, hl⟩ := exists_of_utf8DecodeChar?_eq_some h₂'\n    rw [ByteArray.extract_eq_extract_append_extract (i := i) (i + c.utf8Size) (by omega)\n      (le_size_of_utf8DecodeChar?_eq_some h₂)] at hl ⊢\n    rw [ByteArray.append_inj_left hl (by have := le_size_of_utf8DecodeChar?_eq_some h₂; simp; omega),\n      ← List.utf8Encode_singleton, isValidUTF8_utf8Encode_singleton_append_iff]","start":159,"end":181},"axioms":["Classical.choice","Quot.sound","propext"]}