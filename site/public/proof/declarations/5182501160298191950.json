induced",70,71,"explicit"],["apply",62,72],["apply",73,3],["lambda","mk",46,74,"explicit"],["lambda","t",25,75,"explicit"],["lambda","motive",19,76,"implicit"],["lambda","f",8,77,"implicit"],["lambda","tY",6,78,"instance"],["lambda","tX",4,79,"instance"],["lambda","Y",1,80,"implicit"],["lambda","X",0,81,"implicit"]],"project":false,"range":{"column":0,"endColumn":32,"endLine":109,"line":103},"type":55,"typeText":"{X : Type u_1} →\n  {Y : Type u_2} →\n    [tX : TopologicalSpace.{u_1} X] →\n      [tY : TopologicalSpace.{u_2} Y] →\n        {f : X → Y} →\n          {motive : Topology.IsInducing.{u_1, u_2} f → Sort u} →\n            (t : Topology.IsInducing.{u_1, u_2} f) →\n              ((eq_induced : Eq.{u_1 + 1} tX (TopologicalSpace.induced.{u_1, u_2} f tY)) → motive ⋯) → motive t","unsafe":false,"value":82,"source":{"code":"/-- A function `f : X → Y` between topological spaces is inducing if the topology on `X` is induced\nby the topology on `Y` through `f`, meaning that a set `s : Set X` is open iff it is the preimage\nunder `f` of some open set `t : Set Y`. -/\n@[fun_prop, mk_iff]\nstructure IsInducing (f : X → Y) : Prop where\n  /-- The topology on the domain is equal to the induced topology. -/\n  eq_induced : tX = tY.induced f","start":103,"end":109},"axioms":["Classical.choice","Quot.sound","propext"]}