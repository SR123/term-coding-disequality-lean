a","M₂",22,440,"implicit"],["lambda","M",21,441,"implicit"],["lambda","σ",20,442,"implicit"],["lambda","inst._@.Mathlib.Algebra.Module.LinearMap.Defs.2302359325._hygCtx._hyg.33",6,443,"instance"],["lambda","inst._@.Mathlib.Algebra.Module.LinearMap.Defs.2302359325._hygCtx._hyg.30",4,444,"instance"],["lambda","S",1,445,"implicit"],["lambda","R",0,446,"implicit"]],"project":false,"range":{"column":0,"endColumn":36,"endLine":87,"line":79},"type":277,"typeText":"{R : Type u_14} →\n  {S : Type u_15} →\n    [inst : Semiring.{u_14} R] →\n      [inst_1 : Semiring.{u_15} S] →\n        {σ : RingHom.{u_14, u_15} R S} →\n          {M : Type u_16} →\n            {M₂ : Type u_17} →\n              [inst_2 : AddCommMonoid.{u_16} M] →\n                [inst_3 : AddCommMonoid.{u_17} M₂] →\n                  [inst_4 : Module.{u_14, u_16} R M] →\n                    [inst_5 : Module.{u_15, u_17} S M₂] →\n                      {motive : LinearMap.{u_14, u_15, u_16, u_17} σ M M₂ → Sort u} →\n                        (t : LinearMap.{u_14, u_15, u_16, u_17} σ M M₂) →\n                          ((toAddHom : AddHom.{u_16, u_17} M M₂) →\n                              (map_smul' :\n                                  ∀ (m : R) (x : M),\n                                    Eq.{u_17 + 1}\n                                      (AddHom.toFun.{u_16, u_17} toAddHom (HSMul.hSMul.{u_14, u_16, u_16} m x))\n                                      (HSMul.hSMul.{u_15, u_17, u_17} (σ m) (AddHom.toFun.{u_16, u_17} toAddHom x))) →\n                                motive (LinearMap.mk.{u_14, u_15, u_16, u_17} toAddHom map_smul')) →\n                            motive t","unsafe":false,"value":447,"source":{"code":"/-- A map `f` between an `R`-module and an `S`-module over a ring homomorphism `σ : R →+* S`\nis semilinear if it satisfies the two properties `f (x + y) = f x + f y` and\n`f (c • x) = (σ c) • f x`. Elements of `LinearMap σ M M₂` (available under the notation\n`M →ₛₗ[σ] M₂`) are bundled versions of such maps. For plain linear maps (i.e. for which\n`σ = RingHom.id R`), the notation `M →ₗ[R] M₂` is available. An unbundled version of plain linear\nmaps is available with the predicate `IsLinearMap`, but it should be avoided most of the time. -/\nstructure LinearMap {R S : Type*} [Semiring R] [Semiring S] (σ : R →+* S) (M : Type*)\n    (M₂ : Type*) [AddCommMonoid M] [AddCommMonoid M₂] [Module R M] [Module S M₂] extends\n    AddHom M M₂, MulActionHom σ M M₂","start":79,"end":87},"axioms":[]}