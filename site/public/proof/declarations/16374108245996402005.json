,["lambda","inst._@.Mathlib.Logic.Equiv.Defs.1454878754._hygCtx._hyg.6",9,57,"instance"],["lambda","F",2,58,"implicit"],["lambda","β",1,59,"implicit"],["lambda","α",0,60,"implicit"]],"project":false,"range":{"column":0,"endColumn":36,"endLine":89,"line":82},"type":19,"typeText":"{α : Sort u} → {β : Sort v} → {F : Sort u_1} → [EquivLike.{u_1, u, v} F α β] → F → Equiv.{u, v} α β","unsafe":false,"value":61,"source":{"code":"/-- Turn an element of a type `F` satisfying `EquivLike F α β` into an actual\n`Equiv`. This is declared as the default coercion from `F` to `α ≃ β`. -/\n@[coe]\ndef EquivLike.toEquiv {F} [EquivLike F α β] (f : F) : α ≃ β where\n  toFun := f\n  invFun := EquivLike.inv f\n  left_inv := EquivLike.left_inv f\n  right_inv := EquivLike.right_inv f","start":82,"end":89},"axioms":["Quot.sound"]}