,180,"explicit"],["apply",155,181],["lambda","x._@.Lean.ReducibilityAttrs.1511126859._hygCtx._hyg.29",54,182,"explicit"],["apply",67,183],["let","m",11,51,184,true],["lambda","declName",1,185,"explicit"],["lambda","env",0,186,"explicit"]],"project":false,"range":{"column":0,"endColumn":108,"endLine":59,"line":49},"type":4,"typeText":"Lean.Environment → Lean.Name → Lean.ReducibilityStatus","unsafe":false,"value":187,"source":{"code":"@[export lean_get_reducibility_status]\ndef getReducibilityStatusCore (env : Environment) (declName : Name) : ReducibilityStatus :=\n  let m := reducibilityExtraExt.getState env\n  if let some status := m.find? declName then\n    status\n  else match env.getModuleIdxFor? declName with\n  | some modIdx =>\n    match (reducibilityCoreExt.getModuleEntries env modIdx).binSearch (declName, .semireducible) (fun a b => Name.quickLt a.1 b.1) with\n    | some (_, status) => status\n    | none => .semireducible\n  | none => (reducibilityCoreExt.getState (asyncDecl := declName) env).find? declName |>.getD .semireducible","start":49,"end":59},"axioms":["Classical.choice","Quot.sound","propext"]}