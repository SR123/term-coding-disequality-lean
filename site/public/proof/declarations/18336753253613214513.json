123],["apply",124,3],["apply",125,112],["apply",126,5],["apply",119,127],["lambda","h",113,128,"explicit"],["apply",110,129],["apply",130,3],["lambda","k",28,131,"explicit"],["lambda","h",22,132,"explicit"],["lambda","t",13,133,"explicit"],["lambda","ctorIdx",9,134,"explicit"],["lambda","motive",8,135,"implicit"],["lambda","β",1,136,"implicit"],["lambda","α",0,137,"implicit"]],"project":false,"range":{"column":0,"endColumn":23,"endLine":232,"line":212},"type":36,"typeText":"{α : Sort u_1} →\n  {β : Sort u_2} →\n    {motive : Std.Iterators.IterStep.{u_1, u_2} α β → Sort u} →\n      (ctorIdx : Nat) →\n        (t : Std.Iterators.IterStep.{u_1, u_2} α β) →\n          Eq.{1} ctorIdx (Std.Iterators.IterStep.ctorIdx.{u_1, u_2} t) →\n            Std.Iterators.IterStep.ctorElimType.{u, u_1, u_2} ctorIdx → motive t","unsafe":false,"value":138,"source":{"code":"/--\n`IterStep α β` represents a step taken by an iterator (`Iter β` or `IterM m β`).\n-/\ninductive IterStep (α β) where\n  /--\n  `IterStep.yield it out` describes the situation that an iterator emits `out` and provides `it`\n  as the succeeding iterator.\n  -/\n  | yield : (it : α) → (out : β) → IterStep α β\n  /--\n  `IterStep.skip it` describes the situation that an iterator does not emit anything in this\n  iteration and provides `it'` as the succeeding iterator.\n\n  Allowing `skip` steps is necessary to generate efficient code from a loop over an iterator.\n  -/\n  | skip : (it : α) → IterStep α β\n  /--\n  `IterStep.done` describes the situation that an iterator has finished and will neither emit\n  more values nor cause any monadic effects. In this case, no succeeding iterator is provided.\n  -/\n  | done : IterStep α β","start":212,"end":232},"axioms":[]}