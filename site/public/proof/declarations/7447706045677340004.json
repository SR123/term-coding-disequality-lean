ly",68,64],["apply",69,6],["apply",70,6],["forall","out_eq",71,64,"explicit"],["forall","it_eq",67,72,"explicit"],["constant","Eq.refl",[["param","u_1"]]],["bound",9],["apply",74,75],["apply",76,4],["apply",17,77],["constant","Eq.refl",[["param","u_2"]]],["apply",79,64],["apply",80,6],["apply",78,81],["lambda","k",73,82,"explicit"],["lambda","out",37,83,"explicit"],["lambda","it",37,84,"explicit"],["apply",62,85],["apply",63,43],["apply",87,17],["apply",88,17],["forall","it_eq",89,37,"explicit"],["apply",74,64],["apply",91,6],["apply",17,92],["lambda","k",90,93,"explicit"],["lambda","it",37,94,"explicit"],["apply",86,95],["lambda","k",12,17,"explicit"],["apply",96,97],["lambda","h11",54,98,"explicit"],["apply",51,99],["apply",100,6],["apply",101,17],["apply",102,17],["lambda","h12",18,103,"explicit"],["lambda","x2",10,104,"implicit"],["lambda","x1",7,105,"implicit"],["lambda","P",2,106,"implicit"],["lambda","β",1,107,"implicit"],["lambda","α",0,108,"implicit"]],"project":false,"range":{"column":0,"endColumn":23,"endLine":232,"line":212},"type":31,"typeText":"{α : Sort u_1} →\n  {β : Sort u_2} →\n    {P : Sort u} →\n      {x1 x2 : Std.Iterators.IterStep.{u_1, u_2} α β} →\n        Eq.{max (max 1 u_1) u_2} x1 x2 → Std.Iterators.IterStep.noConfusionType.{u, u_1, u_2} P x1 x2","unsafe":false,"value":109,"source":{"code":"/--\n`IterStep α β` represents a step taken by an iterator (`Iter β` or `IterM m β`).\n-/\ninductive IterStep (α β) where\n  /--\n  `IterStep.yield it out` describes the situation that an iterator emits `out` and provides `it`\n  as the succeeding iterator.\n  -/\n  | yield : (it : α) → (out : β) → IterStep α β\n  /--\n  `IterStep.skip it` describes the situation that an iterator does not emit anything in this\n  iteration and provides `it'` as the succeeding iterator.\n\n  Allowing `skip` steps is necessary to generate efficient code from a loop over an iterator.\n  -/\n  | skip : (it : α) → IterStep α β\n  /--\n  `IterStep.done` describes the situation that an iterator has finished and will neither emit\n  more values nor cause any monadic effects. In this case, no succeeding iterator is provided.\n  -/\n  | done : IterStep α β","start":212,"end":232},"axioms":[]}