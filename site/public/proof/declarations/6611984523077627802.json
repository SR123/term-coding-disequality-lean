,["apply",22,44],["apply",49,46],["apply",48,50],["apply",29,46],["lambda","tailPos",12,52,"explicit"],["lambda","pos",12,53,"explicit"],["apply",51,54],["bound",5],["apply",44,56],["lambda","x._@.Init.Prelude.782758110._hygCtx._hyg.54",13,57,"explicit"],["lambda","x._@.Init.Prelude.782758110._hygCtx._hyg.55",13,58,"explicit"],["apply",55,59],["lambda","_",43,60,"explicit"],["apply",42,61],["apply",27,44],["lambda","_",43,63,"explicit"],["apply",62,64],["let","noncanonical",9,38,65,true],["lambda","canonical",2,66,"explicit"],["lambda","ref",0,67,"explicit"]],"project":false,"range":{"column":0,"endColumn":29,"endLine":5251,"line":5240},"type":8,"typeText":"Lean.Syntax → optParam.{1} Bool Bool.false → Lean.SourceInfo","unsafe":false,"value":68,"source":{"code":"/-- Constructs a synthetic `SourceInfo` using a `ref : Syntax` for the span. -/\ndef SourceInfo.fromRef (ref : Syntax) (canonical := false) : SourceInfo :=\n  let noncanonical ref :=\n    match ref.getPos?, ref.getTailPos? with\n    | some pos, some tailPos => .synthetic pos tailPos\n    | _,        _            => .none\n  match canonical with\n  | true =>\n    match ref.getPos? true, ref.getTailPos? true with\n    | some pos, some tailPos => .synthetic pos tailPos true\n    | _,        _            => noncanonical ref\n  | false => noncanonical ref","start":5240,"end":5251},"axioms":[]}