_ (HAdd.hAdd.{0, 0, 0} L 1))) (m0 q)) →\n                      (x : Eq.{1} (m (DisequalityDispersion.Machine.X_ L)) q) →\n                        (i0 : Eq.{1} (m (DisequalityDispersion.Machine.I_ L)) j) →\n                          (cnt : Eq.{1} (m (DisequalityDispersion.Machine.CNT_ L)) (List.length.{0} l)) →\n                            (out : Eq.{1} (m (DisequalityDispersion.Machine.OUT_ L)) hdr) →\n                              (arr :\n                                  Eq.{1} (DisequalityDispersion.Machine.arrAt m hdr)\n                                    (HAppend.hAppend.{0, 0, 0}\n                                      (List.flatten.{0}\n                                        (List.map.{0, 0} (fun q => DisequalityDispersion.Machine.arrAt m0 q)\n                                          (List.take.{0} j l)))\n                                      (List.take.{0} i (DisequalityDispersion.Machine.arrAt m0 q)))) →\n                                (room :\n                                    LE.le.{0} (HAdd.hAdd.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} hdr 1) tot)\n                                      (m DisequalityDispersion.Machine.HP)) →\n                                  motive ⋯) →\n                (t : DisequalityDispersion.Machine.FlatInInv L m0 hdr tot l j q i m) → motive t","unsafe":false,"value":null,"source":{"code":"/-- The inner invariant of `flattenM` (copying the `j`-th inner array). -/\nstructure FlatInInv (L : ℕ) (m0 : Mem) (hdr tot : ℕ) (l : List ℕ) (j : ℕ) (q : ℕ) (i : ℕ)\n    (m : Mem) : Prop where\n  agree : Agree m0 m (Lvars L ++ Lvars (L + 1))\n  ii : m (I_ (L + 1)) = i\n  icnt : m (CNT_ (L + 1)) = m0 q\n  x : m (X_ L) = q\n  i0 : m (I_ L) = j\n  cnt : m (CNT_ L) = l.length\n  out : m (OUT_ L) = hdr\n  arr : arrAt m hdr = ((l.take j).map (fun q => arrAt m0 q)).flatten ++ (arrAt m0 q).take i\n  room : hdr + 1 + tot ≤ m HP","start":548,"end":559,"lines":[[{"text":"/-- The inner invariant of `flattenM` (copying the `j`-th inner array). -/"}],[{"text":"structure FlatInInv (L : ℕ) (m0 : Mem) (hdr tot : ℕ) (l : List ℕ) (j : ℕ) (q : ℕ) (i : ℕ)"}],[{"text":"    (m : Mem) : Prop where"}],[{"text":"  agree : Agree m0 m (Lvars L ++ Lvars (L + 1))"}],[{"text":"  ii : m (I_ (L + 1)) = i"}],[{"text":"  icnt : m (CNT_ (L + 1)) = m0 q"}],[{"text":"  x : m (X_ L) = q"}],[{"text":"  i0 : m (I_ L) = j"}],[{"text":"  cnt : m (CNT_ L) = l.length"}],[{"text":"  out : m (OUT_ L) = hdr"}],[{"text":"  arr : arrAt m hdr = ((l.take j).map (fun q => arrAt m0 q)).flatten ++ (arrAt m0 q).take i"}],[{"text":"  room : hdr + 1 + tot ≤ m HP"}]]},"steps":[],"stepGoalPool":[],"references":[],"axioms":[]}