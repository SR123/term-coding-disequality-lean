ce"],["lambda","inst._@.Mathlib.Algebra.Group.InjSurj.1297685069._hygCtx._hyg.16",15,346,"instance"],["lambda","inst._@.Mathlib.Algebra.Group.InjSurj.1297685069._hygCtx._hyg.10",12,347,"instance"],["lambda","inst._@.Mathlib.Algebra.Group.InjSurj.1297685069._hygCtx._hyg.7",7,348,"instance"],["lambda","inst._@.Mathlib.Algebra.Group.InjSurj.1297685069._hygCtx._hyg.4",4,349,"instance"],["lambda","M₂",1,350,"implicit"],["lambda","M₁",0,351,"implicit"]],"project":false,"range":{"column":0,"endColumn":78,"endLine":233,"line":217},"type":237,"typeText":"{M₁ : Type u_1} →\n  {M₂ : Type u_2} →\n    [inst : Mul.{u_1} M₁] →\n      [inst_1 : One.{u_1} M₁] →\n        [inst_2 : Pow.{u_1, 0} M₁ Nat] →\n          [inst_3 : Inv.{u_1} M₁] →\n            [inst_4 : Div.{u_1} M₁] →\n              [inst_5 : Pow.{u_1, 0} M₁ Int] →\n                [inst_6 : DivInvMonoid.{u_2} M₂] →\n                  (f : M₁ → M₂) →\n                    Function.Injective.{u_1 + 1, u_2 + 1} f →\n                      Eq.{u_2 + 1} (f 1) 1 →\n                        (∀ (x y : M₁),\n                            Eq.{u_2 + 1} (f (HMul.hMul.{u_1, u_1, u_1} x y)) (HMul.hMul.{u_2, u_2, u_2} (f x) (f y))) →\n                          (∀ (x : M₁), Eq.{u_2 + 1} (f (Inv.inv.{u_1} x)) (Inv.inv.{u_2} (f x))) →\n                            (∀ (x y : M₁),\n                                Eq.{u_2 + 1} (f (HDiv.hDiv.{u_1, u_1, u_1} x y))\n                                  (HDiv.hDiv.{u_2, u_2, u_2} (f x) (f y))) →\n                              (∀ (x : M₁) (n : Nat),\n                                  Eq.{u_2 + 1} (f (HPow.hPow.{u_1, 0, u_1} x n)) (HPow.hPow.{u_2, 0, u_2} (f x) n)) →\n                                (∀ (x : M₁) (n : Int),\n                                    Eq.{u_2 + 1} (f (HPow.hPow.{u_1, 0, u_1} x n)) (HPow.hPow.{u_2, 0, u_2} (f x) n)) →\n                                  DivInvMonoid.{u_1} M₁","unsafe":false,"value":352,"source":{"code":"/-- A type endowed with `1`, `*`, `⁻¹`, and `/` is a `DivInvMonoid` if it admits an injective map\nthat preserves `1`, `*`, `⁻¹`, and `/` to a `DivInvMonoid`. See note [reducible non-instances]. -/\n@[to_additive subNegMonoid\n/-- A type endowed with `0`, `+`, unary `-`, and binary `-` is a\n`SubNegMonoid` if it admits an injective map that preserves `0`, `+`, unary `-`, and binary `-` to\na `SubNegMonoid`. This version takes custom `nsmul` and `zsmul` as `[SMul ℕ M₁]` and `[SMul ℤ M₁]`\narguments. -/]\nprotected abbrev divInvMonoid [DivInvMonoid M₂] (f : M₁ → M₂) (hf : Injective f) (one : f 1 = 1)\n    (mul : ∀ x y, f (x * y) = f x * f y) (inv : ∀ x, f x⁻¹ = (f x)⁻¹)\n    (div : ∀ x y, f (x / y) = f x / f y) (npow : ∀ (x) (n : ℕ), f (x ^ n) = f x ^ n)\n    (zpow : ∀ (x) (n : ℤ), f (x ^ n) = f x ^ n) : DivInvMonoid M₁ :=\n  { hf.monoid f one mul npow, ‹Inv M₁›, ‹Div M₁› with\n    zpow := fun n x => x ^ n,\n    zpow_zero' := fun x => hf <| by rw [zpow, zpow_zero, one],\n    zpow_succ' := fun n x => hf <| by rw [zpow, mul, zpow_natCast, pow_succ, zpow, zpow_natCast],\n    zpow_neg' := fun n x => hf <| by rw [zpow, zpow_negSucc, inv, zpow, zpow_natCast],\n    div_eq_mul_inv := fun x y => hf <| by rw [div, mul, inv, div_eq_mul_inv] }","start":217,"end":233},"axioms":[]}