pe":33,"typeText":"∀ {xs ys : Lean.Omega.IntList},\n  (∀ (x : Int), Membership.mem.{0, 0} xs x → Eq.{1} x 0) → Eq.{1} (Lean.Omega.IntList.dot xs ys) 0","unsafe":false,"value":332,"source":{"code":"theorem dot_of_left_zero (w : ∀ x, x ∈ xs → x = 0) : dot xs ys = 0 := by\n  induction xs generalizing ys with\n  | nil => simp\n  | cons x xs ih =>\n    cases ys with\n    | nil => simp\n    | cons y ys =>\n      rw [dot_cons₂, w x (by simp [List.mem_cons_self]), ih]\n      · simp\n      · intro x m\n        apply w\n        exact List.mem_cons_of_mem _ m","start":310,"end":321},"axioms":["propext"]}