ly",676,679],["apply",204,680],["lambda","n",7,681,"explicit"],["lambda","inst._@.Mathlib.Logic.Encodable.Basic.3259167256._hygCtx._hyg.7",6,682,"instance"],["lambda","inst._@.Mathlib.Logic.Encodable.Basic.3259167256._hygCtx._hyg.4",4,683,"instance"],["lambda","β",1,684,"implicit"],["lambda","α",0,685,"implicit"]],"project":false,"range":{"column":0,"endColumn":9,"endLine":335,"line":329},"type":71,"typeText":"∀ {α : Type u_1} {β : Type u_2} [inst : Encodable.{u_1} α] [inst_1 : Encodable.{u_2} β] (n : Nat),\n  Eq.{max (u_1 + 1) (u_2 + 1)} (Encodable.decode.{max u_2 u_1} n)\n    (Option.bind.{u_1, max u_2 u_1} (Encodable.decode.{u_1} (Nat.unpair n).1) fun a =>\n      Option.map.{u_2, max u_2 u_1} (Prod.mk.{u_1, u_2} a) (Encodable.decode.{u_2} (Nat.unpair n).2))","unsafe":false,"value":686,"source":{"code":"@[simp]\ntheorem decode_prod_val (n : ℕ) :\n    (@decode (α × β) _ n : Option (α × β))\n      = (decode n.unpair.1).bind fun a => (decode n.unpair.2).map <| Prod.mk a := by\n  simp only [decode_ofEquiv, Equiv.symm_symm, decode_sigma_val]\n  cases (decode n.unpair.1 : Option α) <;> cases (decode n.unpair.2 : Option β)\n  <;> rfl","start":329,"end":335},"axioms":["Classical.choice","Quot.sound","propext"]}