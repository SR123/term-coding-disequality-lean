da","_a",14,1045,"explicit"],["apply",1042,1046],["apply",1029,751],["apply",1047,1048],["apply",1040,1049],["apply",1037,1050],["apply",559,751],["apply",1051,1052],["apply",1033,1053],["apply",1011,1054],["lambda","ha",974,1055,"explicit"],["apply",973,1056],["apply",737,1057],["let","hc_beq",571,578,1058,true],["lambda","hc",569,1059,"explicit"],["apply",567,1060],["apply",349,1061],["lambda","x._@.Init.Data.List.Count.965730882._hygCtx._hyg.385",270,1062,"explicit"],["lambda","l",146,1063,"explicit"],["lambda","c",112,1064,"explicit"],["apply",235,1065],["apply",1066,2],["lambda","f",140,1067,"explicit"],["lambda","x._@.Init.Data.List.Count.965730882._hygCtx._hyg.42",79,1068,"explicit"],["apply",108,1069],["lambda","x._@.Init.Data.List.Count.965730882._hygCtx._hyg.42",12,1070,"explicit"],["lambda","b",9,1071,"implicit"],["lambda","a",8,1072,"implicit"],["lambda","inst._@.Init.Data.List.Count.965730882._hygCtx._hyg.8",7,1073,"instance"],["lambda","inst._@.Init.Data.List.Count.965730882._hygCtx._hyg.5",3,1074,"instance"],["lambda","α",0,1075,"implicit"]],"project":false,"range":{"column":0,"endColumn":67,"endLine":399,"line":383},"type":76,"typeText":"∀ {α : Type u_1} [inst : BEq.{u_1} α] [LawfulBEq.{u_1} α] {a b : α} {l : List.{u_1} α},\n  Eq.{1} (List.count.{u_1} a (List.erase.{u_1} l b))\n    (HSub.hSub.{0, 0, 0} (List.count.{u_1} a l) (ite.{1} (Eq.{1} (BEq.beq.{u_1} b a) Bool.true) 1 0))","unsafe":false,"value":1076,"source":{"code":"@[grind =]\ntheorem count_erase {a b : α} :\n    ∀ {l : List α}, count a (l.erase b) = count a l - if b == a then 1 else 0\n  | [] => by simp\n  | c :: l => by\n    rw [erase_cons]\n    if hc : c = b then\n      have hc_beq := beq_iff_eq.mpr hc\n      rw [if_pos hc_beq, hc, count_cons, Nat.add_sub_cancel]\n    else\n      have hc_beq := beq_false_of_ne hc\n      simp only [hc_beq, if_false, count_cons, count_cons, count_erase, reduceCtorEq]\n      if ha : b = a then\n        rw [ha, eq_comm] at hc\n        rw [if_pos (beq_iff_eq.2 ha), if_neg (by simpa using Ne.symm hc), Nat.add_zero, Nat.add_zero]\n      else\n        rw [if_neg (by simpa using ha), Nat.sub_zero, Nat.sub_zero]","start":383,"end":399},"axioms":["Classical.choice","Quot.sound","propext"]}