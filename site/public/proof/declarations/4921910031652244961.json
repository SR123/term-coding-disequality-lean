,"x._@.Mathlib.Data.Fintype.EquivFin.2772847051._hygCtx._hyg.138",57,618,"explicit"],["apply",608,619],["apply",600,620],["apply",621,21],["constant","Fintype.card_unit",[]],["apply",622,623],["lambda","h",63,624,"explicit"],["apply",588,625],["lambda","ha",266,626,"explicit"],["lambda","n",6,627,"explicit"],["apply",249,628],["let","hn",40,43,629,true],["let","n",6,13,630,false],["lambda","inst._@.Mathlib.Data.Fintype.EquivFin.2772847051._hygCtx._hyg.5",3,631,"instance"],["lambda","α",0,632,"implicit"]],"project":false,"range":{"column":0,"endColumn":72,"endLine":236,"line":224},"type":34,"typeText":"∀ {α : Type u_1} [inst : Fintype.{u_1} α], Iff (LE.le.{0} (Fintype.card.{u_1} α) 1) (∀ (a b : α), Eq.{u_1 + 1} a b)","unsafe":false,"value":633,"source":{"code":"theorem card_le_one_iff : card α ≤ 1 ↔ ∀ a b : α, a = b :=\n  let n := card α\n  have hn : n = card α := rfl\n  match n, hn with\n  | 0, ha =>\n    ⟨fun _h => fun a => (card_eq_zero_iff.1 ha.symm).elim a, fun _ => ha ▸ Nat.le_succ _⟩\n  | 1, ha =>\n    ⟨fun _h => fun a b => by\n      let ⟨x, hx⟩ := card_eq_one_iff.1 ha.symm\n      rw [hx a, hx b], fun _ => ha ▸ le_rfl⟩\n  | n + 2, ha =>\n    ⟨fun h => False.elim <| by rw [← ha] at h; cases h with | step h => cases h; , fun h =>\n      card_unit ▸ card_le_of_injective (fun _ => ()) fun _ _ _ => h _ _⟩","start":224,"end":236},"axioms":["Classical.choice","Quot.sound","propext"]}