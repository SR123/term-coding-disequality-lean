":115,"typeText":"∀ {M : Type u} [inst : LE.{u} M] [inst_1 : Std.IsPreorder.{u} M] [inst_2 : Lean.Grind.IntModule.{u} M]\n  [Lean.Grind.OrderedAdd.{u} M] [inst_4 : LT.{u} M] [Std.LawfulOrderLT.{u} M] (k : Int) {x : M},\n  LT.lt.{u} 0 x → Iff (LT.lt.{u} 0 (HSMul.hSMul.{0, u, u} k x)) (LT.lt.{0} 0 k)","unsafe":false,"value":817,"source":{"code":"theorem zsmul_pos_iff (k : Int) {x : M} (h : 0 < x) : 0 < k • x ↔ 0 < k :=\n  match k with\n  | (k + 1 : Nat) => by\n    simpa [zsmul_zero, ← zsmul_natCast_eq_nsmul] using nsmul_lt_nsmul_iff (k := k + 1) h\n  | (0 : Nat) => by simp [zero_zsmul]; exact Preorder.lt_irrefl 0\n  | -(k + 1 : Nat) => by\n    have : ¬ (k : Int) + 1 < 0 := by omega\n    simp [this]; clear this\n    rw [neg_zsmul]\n    rw [lt_iff_le_and_not_ge]\n    simp\n    intro h'\n    rw [OrderedAdd.neg_le_iff, neg_zero]\n    simpa [zsmul_zero, ← zsmul_natCast_eq_nsmul] using\n      nsmul_le_nsmul (k := k + 1) (Preorder.le_of_lt h)","start":148,"end":162},"axioms":["Classical.choice","Quot.sound","propext"]}