["lambda","r",201,604,"explicit"],["lambda","l",199,605,"explicit"],["lambda","v'",197,606,"explicit"],["lambda","k'",103,607,"explicit"],["lambda","sz",22,608,"explicit"],["apply",196,609],["apply",610,5],["lambda","h",97,611,"explicit"],["lambda","f",96,612,"explicit"],["lambda","t",56,613,"explicit"],["apply",74,614],["apply",615,1],["lambda","h",16,616,"explicit"],["lambda","t",11,617,"explicit"],["lambda","k",7,618,"explicit"],["lambda","inst._@.Std.Data.DTreeMap.Internal.Operations.4132535615._hygCtx._hyg.10",6,619,"instance"],["lambda","β",3,620,"implicit"],["lambda","α",0,621,"implicit"]],"project":false,"range":{"column":0,"endColumn":38,"endLine":439,"line":426},"type":51,"typeText":"{α : Type u} →\n  {β : α → Type v} →\n    [Ord.{u} α] →\n      α →\n        (t : Std.DTreeMap.Internal.Impl.{u, v} α β) →\n          Std.DTreeMap.Internal.Impl.Balanced.{u, v} t →\n            Std.DTreeMap.Internal.Impl.SizedBalancedTree.{u, v} α β\n              (HSub.hSub.{0, 0, 0} (Std.DTreeMap.Internal.Impl.size.{u, v} t) 1)\n              (Std.DTreeMap.Internal.Impl.size.{u, v} t)","unsafe":false,"value":622,"source":{"code":"/-- Removes the mapping with key `k`, if it exists. -/\ndef erase [Ord α] (k : α) (t : Impl α β) (h : t.Balanced) :\n    SizedBalancedTree α β (t.size - 1) t.size :=\n  match t with\n  | leaf => ⟨.leaf, ✓, ✓, ✓⟩\n  | inner sz k' v' l r =>\n    match compare k k' with\n    | .lt =>\n      let ⟨l', hl'₁, hl'₂, hl'₃⟩ := erase k l ✓\n      ⟨balanceRErase k' v' l' r ✓ ✓ ✓, ✓, ✓, ✓⟩\n    | .gt =>\n      let ⟨r', hr'₁, hr'₂, hr'₃⟩ := erase k r ✓\n      ⟨balanceLErase k' v' l r' ✓ ✓ ✓, ✓, ✓, ✓⟩\n    | .eq => ⟨glue l r ✓ ✓ ✓, ✓, ✓, ✓⟩","start":426,"end":439},"axioms":["Classical.choice","Quot.sound","propext"]}