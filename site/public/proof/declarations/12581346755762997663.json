],["lambda","inst._@.Mathlib.Algebra.Module.NatInt.1667573641._hygCtx._hyg.9",6,907,"instance"],["lambda","inst._@.Mathlib.Algebra.Module.NatInt.1667573641._hygCtx._hyg.6",4,908,"instance"],["lambda","M",1,909,"implicit"],["lambda","R",0,910,"explicit"]],"project":false,"range":{"column":0,"endColumn":79,"endLine":98,"line":93},"type":110,"typeText":"∀ (R : Type u_1) {M : Type u_3} [inst : Semiring.{u_1} R] [inst_1 : AddCommMonoid.{u_3} M]\n  [inst_2 : Module.{u_1, u_3} R M] (n : Nat) (b : M),\n  Eq.{u_3 + 1} (HSMul.hSMul.{u_1, u_3, u_3} (↑n) b) (HSMul.hSMul.{0, u_3, u_3} n b)","unsafe":false,"value":911,"source":{"code":"/-- `nsmul` is equal to any other module structure via a cast. -/\n@[norm_cast]\nlemma Nat.cast_smul_eq_nsmul (n : ℕ) (b : M) : (n : R) • b = n • b := by\n  induction n with\n  | zero => rw [Nat.cast_zero, zero_smul, zero_smul]\n  | succ n ih => rw [Nat.cast_succ, add_smul, add_smul, one_smul, ih, one_smul]","start":93,"end":98},"axioms":["propext"]}