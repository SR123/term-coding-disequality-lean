"constant","TFAE_mem_nhdsGE",[["param","u_1"]]],["apply",960,349],["apply",961,359],["apply",962,393],["constant","instOrderTopologyOrderDual",[["param","u_1"]]],["apply",964,56],["apply",965,49],["apply",966,80],["apply",967,28],["apply",963,968],["apply",969,382],["apply",970,429],["constant","LT.lt.dual",[["param","u_1"]]],["apply",972,56],["apply",32,56],["apply",974,80],["apply",973,975],["apply",976,8],["apply",977,27],["apply",978,5],["apply",971,979],["apply",980,423],["apply",959,981],["apply",346,982],["lambda","s",50,983,"explicit"],["lambda","h",47,984,"explicit"],["lambda","b",28,985,"implicit"],["lambda","a",27,986,"implicit"],["lambda","inst._@.Mathlib.Topology.Order.LeftRightNhds.3246228336._hygCtx._hyg.11",26,987,"instance"],["lambda","inst._@.Mathlib.Topology.Order.LeftRightNhds.3246228336._hygCtx._hyg.8",6,988,"instance"],["lambda","inst._@.Mathlib.Topology.Order.LeftRightNhds.3246228336._hygCtx._hyg.5",3,989,"instance"],["lambda","α",0,990,"implicit"]],"project":false,"range":{"column":0,"endColumn":51,"endLine":292,"line":279},"type":174,"typeText":"∀ {α : Type u_1} [inst : TopologicalSpace.{u_1} α] [inst_1 : LinearOrder.{u_1} α] [OrderTopology.{u_1} α] {a b : α},\n  LT.lt.{u_1} a b →\n    ∀ (s : Set.{u_1} α),\n      List.TFAE\n        (List.cons.{0} (Membership.mem.{u_1, u_1} (nhdsWithin.{u_1} b (Set.Iic.{u_1} b)) s)\n          (List.cons.{0} (Membership.mem.{u_1, u_1} (nhdsWithin.{u_1} b (Set.Icc.{u_1} a b)) s)\n            (List.cons.{0} (Membership.mem.{u_1, u_1} (nhdsWithin.{u_1} b (Set.Ioc.{u_1} a b)) s)\n              (List.cons.{0}\n                (∃ l,\n                  And (Membership.mem.{u_1, u_1} (Set.Ico.{u_1} a b) l) (HasSubset.Subset.{u_1} (Set.Ioc.{u_1} l b) s))\n                (List.cons.{0}\n                  (∃ l,\n                    And (Membership.mem.{u_1, u_1} (Set.Iio.{u_1} b) l) (HasSubset.Subset.{u_1} (Set.Ioc.{u_1} l b) s))\n                  List.nil.{0})))))","unsafe":false,"value":991,"source":{"code":"/-- The following statements are equivalent:\n\n0. `s` is a neighborhood of `b` within `(-∞, b]`\n1. `s` is a neighborhood of `b` within `[a, b]`\n2. `s` is a neighborhood of `b` within `(a, b]`\n3. `s` includes `(l, b]` for some `l ∈ [a, b)`\n4. `s` includes `(l, b]` for some `l < b` -/\ntheorem TFAE_mem_nhdsLE {a b : α} (h : a < b) (s : Set α) :\n    TFAE [s ∈ 𝓝[≤] b,-- 0 : `s` is a neighborhood of `b` within `(-∞, b]`\n      s ∈ 𝓝[Icc a b] b,-- 1 : `s` is a neighborhood of `b` within `[a, b]`\n      s ∈ 𝓝[Ioc a b] b,-- 2 : `s` is a neighborhood of `b` within `(a, b]`\n      ∃ l ∈ Ico a b, Ioc l b ⊆ s,-- 3 : `s` includes `(l, b]` for some `l ∈ [a, b)`\n      ∃ l ∈ Iio b, Ioc l b ⊆ s] := by-- 4 : `s` includes `(l, b]` for some `l < b`\n  simpa using TFAE_mem_nhdsGE h.dual (ofDual ⁻¹' s)","start":279,"end":292},"axioms":["Classical.choice","Quot.sound","propext"]}