"]],"project":false,"range":{"column":0,"endColumn":8,"endLine":234,"line":230},"type":98,"typeText":"∀ {M : Type u_1} [inst : CommGroupWithZero.{u_1} M] (a₁ : Prod.{0, u_1} Int M) {a₂ : Prod.{0, u_1} Int M}\n  {l₁ l₂ l : Mathlib.Tactic.FieldSimp.NF.{u_1} M},\n  Eq.{u_1 + 1}\n      (HMul.hMul.{u_1, u_1, u_1} (Mathlib.Tactic.FieldSimp.NF.eval.{u_1} l₁)\n        (Mathlib.Tactic.FieldSimp.NF.eval.{u_1} (Mathlib.Tactic.FieldSimp.NF.cons.{u_1} a₂ l₂)))\n      (Mathlib.Tactic.FieldSimp.NF.eval.{u_1} l) →\n    Eq.{u_1 + 1}\n      (HMul.hMul.{u_1, u_1, u_1} (Mathlib.Tactic.FieldSimp.NF.eval.{u_1} (Mathlib.Tactic.FieldSimp.NF.cons.{u_1} a₁ l₁))\n        (Mathlib.Tactic.FieldSimp.NF.eval.{u_1} (Mathlib.Tactic.FieldSimp.NF.cons.{u_1} a₂ l₂)))\n      (Mathlib.Tactic.FieldSimp.NF.eval.{u_1} (Mathlib.Tactic.FieldSimp.NF.cons.{u_1} a₁ l))","unsafe":false,"value":474,"source":{"code":"theorem mul_eq_eval₁ [CommGroupWithZero M] (a₁ : ℤ × M) {a₂ : ℤ × M} {l₁ l₂ l : NF M}\n    (h : l₁.eval * (a₂ ::ᵣ l₂).eval = l.eval) :\n    (a₁ ::ᵣ l₁).eval * (a₂ ::ᵣ l₂).eval = (a₁ ::ᵣ l).eval := by\n  simp only [eval_cons, ← h]\n  ac_rfl","start":230,"end":234},"axioms":["Classical.choice","Quot.sound","propext"]}