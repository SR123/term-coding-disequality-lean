"column":0,"endColumn":22,"endLine":125,"line":118},"type":16,"typeText":"∀ (ctx : Int.Linear.Context) (p : Int.Linear.Poly),\n  Eq.{1} (Int.Linear.Poly.denote' ctx p) (Int.Linear.Poly.denote ctx p)","unsafe":false,"value":755,"source":{"code":"theorem Poly.denote'_eq_denote (ctx : Context) (p : Poly) : p.denote' ctx = p.denote ctx := by\n  unfold Poly.denote' Poly.denote; cases p <;> simp\n  next k v p =>\n    cases h : k.beq' 1 <;> simp [*]\n    next => ac_rfl\n    next =>\n      simp [Int.beq'_eq_beq] at h\n      simp [h]; ac_rfl","start":118,"end":125},"axioms":["Quot.sound","propext"]}