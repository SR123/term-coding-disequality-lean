bra.Group.Hom.Defs.301044266._hygCtx._hyg.34",4,151,"instance"],["lambda","N",1,152,"explicit"],["lambda","M",0,153,"explicit"]],"project":false,"range":{"column":0,"endColumn":29,"endLine":367,"line":357},"type":98,"typeText":"{M : Type u_10} →\n  {N : Type u_11} →\n    [inst : MulOne.{u_10} M] →\n      [inst_1 : MulOne.{u_11} N] →\n        {motive : MonoidHom.{u_10, u_11} M N → Sort u} →\n          ((toOneHom : OneHom.{u_10, u_11} M N) →\n              (map_mul' :\n                  ∀ (x y : M),\n                    Eq.{u_11 + 1} (OneHom.toFun.{u_10, u_11} toOneHom (HMul.hMul.{u_10, u_10, u_10} x y))\n                      (HMul.hMul.{u_11, u_11, u_11} (OneHom.toFun.{u_10, u_11} toOneHom x)\n                        (OneHom.toFun.{u_10, u_11} toOneHom y))) →\n                motive (MonoidHom.mk.{u_10, u_11} toOneHom map_mul')) →\n            (t : MonoidHom.{u_10, u_11} M N) → motive t","unsafe":false,"value":null,"source":{"code":"/-- `M →* N` is the type of functions `M → N` that preserve the `MulOne` structure.\n`MonoidHom` is used for both monoid and group homomorphisms.\n\nWhen possible, instead of parametrizing results over `(f : M →* N)`,\nyou should parametrize over `(F : Type*) [MonoidHomClass F M N] (f : F)`.\n\nWhen you extend this structure, make sure to extend `MonoidHomClass`.\n-/\n@[to_additive]\nstructure MonoidHom (M : Type*) (N : Type*) [MulOne M] [MulOne N]\n  extends OneHom M N, M →ₙ* N","start":357,"end":367},"axioms":[]}