ect":false,"range":{"column":0,"endColumn":16,"endLine":229,"line":222},"type":28,"typeText":"∀ (x : Nat), Eq.{1} (HMod.hMod.{0, 0, 0} x 1) 0","unsafe":false,"value":155,"source":{"code":"theorem mod_one (x : Nat) : x % 1 = 0 := by\n  have h : x % 1 < 1 := mod_lt x (by decide)\n  have : (y : Nat) → y < 1 → y = 0 := by\n    intro y\n    cases y with\n    | zero   => intro _; rfl\n    | succ y => intro h; apply absurd (Nat.lt_of_succ_lt_succ h) (Nat.not_lt_zero y)\n  exact this _ h","start":222,"end":229},"axioms":[]}