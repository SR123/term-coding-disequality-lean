apply",22,54],["lambda","userName",4,55,"explicit"],["lambda","kind",3,56,"explicit"],["lambda","type?",2,57,"explicit"]],"project":false,"range":{"column":0,"endColumn":42,"endLine":851,"line":845},"type":9,"typeText":"Option.{0} Lean.Expr → Lean.MetavarKind → Lean.Name → Lean.Meta.MetaM Lean.Expr","unsafe":false,"value":58,"source":{"code":"private def mkFreshExprMVarImpl (type? : Option Expr) (kind : MetavarKind) (userName : Name) : MetaM Expr :=\n  match type? with\n  | some type => mkFreshExprMVarCore type kind userName\n  | none      => do\n    let u ← mkFreshLevelMVar\n    let type ← mkFreshExprMVarCore (mkSort u) MetavarKind.natural Name.anonymous\n    mkFreshExprMVarCore type kind userName","start":845,"end":851},"axioms":["Classical.choice","Quot.sound","propext"]}