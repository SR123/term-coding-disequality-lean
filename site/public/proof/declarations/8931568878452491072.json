cit"],["lambda","b_lt",30,518,"explicit"],["lambda","b",0,519,"implicit"],["lambda","i",0,520,"implicit"]],"project":false,"range":{"column":0,"endColumn":49,"endLine":742,"line":729},"type":74,"typeText":"∀ {i b : Nat},\n  LT.lt.{0} b (HPow.hPow.{0, 0, 0} 2 i) →\n    ∀ (a : Nat),\n      Eq.{1} (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} (HPow.hPow.{0, 0, 0} 2 i) a) b)\n        (HOr.hOr.{0, 0, 0} (HMul.hMul.{0, 0, 0} (HPow.hPow.{0, 0, 0} 2 i) a) b)","unsafe":false,"value":521,"source":{"code":"theorem two_pow_add_eq_or_of_lt {b : Nat} (b_lt : b < 2^i) (a : Nat) :\n    2^i * a + b = 2^i * a ||| b := by\n  apply eq_of_testBit_eq\n  intro j\n  simp only [testBit_two_pow_mul_add _ b_lt,\n        testBit_or, testBit_two_pow_mul]\n  if j_lt : j < i then\n    simp [Nat.not_le_of_lt, j_lt]\n  else\n    have i_le : i ≤ j := Nat.le_of_not_lt j_lt\n    have b_lt_j :=\n            calc b < 2 ^ i := b_lt\n                 _ ≤ 2 ^ j := Nat.pow_le_pow_right Nat.zero_lt_two i_le\n    simp [i_le, j_lt, testBit_lt_two_pow, b_lt_j]","start":729,"end":742},"axioms":["Quot.sound","propext"]}