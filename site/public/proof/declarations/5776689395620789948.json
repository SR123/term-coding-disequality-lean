 ι → Prop) (s : ι → Set α) : Prop where\n  /-- A set `t` belongs to a filter `l` iff it includes an element of the basis. -/\n  mem_iff' : ∀ t : Set α, t ∈ l ↔ ∃ i, p i ∧ s i ⊆ t","start":207,"end":211},"axioms":[]}