9],["apply",682,840],["apply",681,841],["apply",632,842],["lambda","h'",526,843,"explicit"],["apply",525,844],["lambda","h",47,845,"explicit"],["lambda","n",0,846,"explicit"],["lambda","b",12,847,"explicit"],["lambda","bit",24,848,"implicit"],["lambda","zero",11,849,"implicit"],["lambda","motive",2,850,"implicit"]],"project":false,"range":{"column":0,"endColumn":15,"endLine":154,"line":140},"type":70,"typeText":"∀ {motive : Nat → Sort u} {zero : motive 0} {bit : (b : Bool) → (n : Nat) → motive n → motive (Nat.bit b n)} (b : Bool)\n  (n : Nat),\n  Or (Eq.{u} (bit Bool.false 0 zero) zero) (Eq.{1} n 0 → Eq.{1} b Bool.true) →\n    Eq.{u} (Nat.binaryRec.{u} zero bit (Nat.bit b n)) (bit b n (Nat.binaryRec.{u} zero bit n))","unsafe":false,"value":851,"source":{"code":"theorem binaryRec_eq {zero : motive 0} {bit : ∀ b n, motive n → motive (bit b n)}\n    (b n) (h : bit false 0 zero = zero ∨ (n = 0 → b = true)) :\n    binaryRec zero bit (n.bit b) = bit b n (binaryRec zero bit n) := by\n  by_cases h' : n.bit b = 0\n  case pos =>\n    obtain ⟨rfl, rfl⟩ := bit_eq_zero_iff.mp h'\n    simp only [Bool.false_eq_true, imp_false, not_true_eq_false, or_false] at h\n    unfold binaryRec\n    exact h.symm\n  case neg =>\n    rw [binaryRec, dif_neg h']\n    change congrArg motive (n.bit b).bit_testBit_zero_shiftRight_one ▸ bit _ _ _ = _\n    generalize congrArg motive (n.bit b).bit_testBit_zero_shiftRight_one = e; revert e\n    rw [testBit_bit_zero, bit_shiftRight_one]\n    intros; rfl","start":140,"end":154},"axioms":["Quot.sound","propext"]}