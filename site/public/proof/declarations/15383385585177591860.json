ata.String.Decode.1477934340._hygCtx._hyg.240",482,886,"explicit"],["apply",480,887],["apply",523,439],["apply",888,889],["constant","HEq.refl",[["zero"]]],["apply",891,442],["apply",892,479],["apply",890,893],["let","hc",260,278,894,true],["let","h₀",250,257,895,true],["lambda","h",42,896,"explicit"],["apply",244,897],["lambda","c",1,898,"implicit"],["lambda","w",0,899,"implicit"]],"project":false,"range":{"column":0,"endColumn":24,"endLine":507,"line":491},"type":45,"typeText":"∀ {w : UInt8} {c : Char},\n  Iff\n    (∃ (h : Eq.{1} (ByteArray.utf8DecodeChar?.parseFirstByte w) ByteArray.utf8DecodeChar?.FirstByte.done),\n      Eq.{1} (ByteArray.utf8DecodeChar?.assemble₁ w h) (Option.some.{0} c))\n    (Eq.{1} (String.utf8EncodeChar c) (List.cons.{0} w List.nil.{0}))","unsafe":false,"value":900,"source":{"code":"theorem assemble₁_eq_some_iff_utf8EncodeChar_eq {w : UInt8} {c : Char} :\n    (∃ h : parseFirstByte w = .done, assemble₁ w h = some c) ↔ String.utf8EncodeChar c = [w] := by\n  refine ⟨fun ⟨h₁, h₂⟩ => ?_, ?_⟩\n  · have hc := utf8Size_assemble₁ h₂\n    simp only [String.utf8EncodeChar_eq_singleton hc, List.cons.injEq, and_true]\n    simp only [assemble₁, Option.some.injEq] at h₂\n    simpa using congrArg (·.val.toUInt8) h₂ |>.symm\n  · intro h\n    have h₀ : (String.utf8EncodeChar c).length = 1 := congrArg List.length h\n    have hc : c.utf8Size = 1 := String.length_utf8EncodeChar _ ▸ h₀\n    obtain ⟨rfl⟩ : w = (String.utf8EncodeChar c)[0] := by simp [h]\n    refine ⟨parseFirstByte_utf8EncodeChar_eq_done hc, ?_⟩\n    have : c.val.toNat < 256 := by\n      simp only [Char.utf8Size_eq_one_iff, UInt32.le_iff_toNat_le, UInt32.reduceToNat] at hc\n      omega\n    simpa [String.utf8EncodeChar_eq_singleton hc, assemble₁, Char.ext_iff, ← UInt32.toNat_inj,\n      -Char.toUInt8_val]","start":491,"end":507},"axioms":["Classical.choice","Quot.sound","propext"]}