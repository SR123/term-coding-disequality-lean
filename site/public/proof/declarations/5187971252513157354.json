","u_1"],["param","u_4"]]],["apply",116,61],["apply",117,16],["apply",118,8],["apply",115,119],["constant","Subtype.val",[["param","u_4"]]],["apply",121,16],["apply",122,41],["apply",123,12],["apply",120,124],["apply",97,125],["constant","Equiv.subtypeEquiv._proof_2",[["param","u_1"],["param","u_4"]]],["apply",127,61],["apply",128,16],["apply",129,10],["apply",130,6],["apply",131,8],["apply",132,2],["apply",133,12],["apply",126,134],["lambda","b",47,135,"explicit"],["apply",94,136],["constant","Equiv.subtypeEquiv._proof_4",[["param","u_1"],["param","u_4"]]],["apply",138,16],["apply",139,10],["apply",140,6],["apply",141,8],["apply",142,2],["apply",143,12],["apply",137,144],["constant","Equiv.subtypeEquiv._proof_6",[["param","u_4"],["param","u_1"]]],["apply",146,16],["apply",147,10],["apply",148,6],["apply",149,8],["apply",150,2],["apply",151,12],["apply",145,152],["lambda","h",36,153,"explicit"],["lambda","e",9,154,"explicit"],["lambda","q",4,155,"implicit"],["lambda","p",4,156,"implicit"],["lambda","β",1,157,"implicit"],["lambda","α",0,158,"implicit"]],"project":false,"range":{"column":0,"endColumn":39,"endLine":270,"line":261},"type":54,"typeText":"{α : Sort u_1} →\n  {β : Sort u_4} →\n    {p : α → Prop} →\n      {q : β → Prop} →\n        (e : Equiv.{u_1, u_4} α β) →\n          (∀ (a : α), Iff (p a) (q (e a))) →\n            Equiv.{max 1 u_1, max 1 u_4} (Subtype.{u_1} fun a => p a) (Subtype.{u_4} fun b => q b)","unsafe":false,"value":159,"source":{"code":"/-- If `α` is equivalent to `β` and the predicates `p : α → Prop` and `q : β → Prop` are equivalent\nat corresponding points, then `{a // p a}` is equivalent to `{b // q b}`.\nFor the statement where `α = β`, that is, `e : perm α`, see `Perm.subtypePerm`. -/\n@[simps apply]\ndef subtypeEquiv {p : α → Prop} {q : β → Prop} (e : α ≃ β) (h : ∀ a, p a ↔ q (e a)) :\n    { a : α // p a } ≃ { b : β // q b } where\n  toFun a := ⟨e a, (h _).mp a.property⟩\n  invFun b := ⟨e.symm b, (h _).mpr ((e.apply_symm_apply b).symm ▸ b.property)⟩\n  left_inv a := Subtype.ext <| by simp\n  right_inv b := Subtype.ext <| by simp","start":261,"end":270},"axioms":["Quot.sound","propext"]}