DisequalityDispersion.strict_threshold_iff {V F : Type} {arity : F → ℕ} [Fintype V] [Fintype F] (x y : V) (hxy : x ≠ y)
  (t : DisequalityDispersion.Term V F arity)
  (tests : List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity))
  (hguard : (DisequalityDispersion.Term.var x, DisequalityDispersion.Term.var y) ∈ tests) :
  (∃ n, 2 ≤ n ∧ n * (n - 1) + 1 ≤ DisequalityDispersion.dispersionOn x y t tests) ↔
    (∀ uv ∈ tests, uv.1 ≠ uv.2) ∧ ∃ z, t.Uses z ∧ z ≠ x ∧ z ≠ y
DisequalityDispersion.cubic_lower_bound {V F : Type} {arity : F → ℕ} [Fintype V] [Fintype F] (x y z : V) (hxy : x ≠ y)
  (hxz : x ≠ z) (hyz : y ≠ z) (t : DisequalityDispersion.Term V F arity) (hz : t.Uses z)
  (tests : List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity))
  (distinct : ∀ uv ∈ tests, uv.1 ≠ uv.2) (n : ℕ) (hn : (DisequalityDispersion.instanceSupport t tests).card ≤ n) :
  (n / (DisequalityDispersion.instanceSupport t tests).card) ^ 3 ≤ DisequalityDispersion.dispersionOn x y t tests
DisequalityDispersion.undecidable_hard_threshold (d : ℕ) (rels : List (List (DisequalityDispersion.Letter (Fin d))))
  (slobodskoiBridsonWilton : ¬ComputablePred (DisequalityDispersion.HasFiniteQuotient rels)) :
  ¬ComputablePred (DisequalityDispersion.HardThreshold d rels)
