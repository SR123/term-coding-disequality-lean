          DisequalityDispersion.Term.eval (DisequalityDispersion.routeTable pred b₀)
            (DisequalityDispersion.taggedSources a) t
@DisequalityDispersion.finite_route_distinct_terms_pass : ∀ {V F B : Type} {arity : F → ℕ}
  (S : Finset (DisequalityDispersion.Term V F arity)) (d : { t // t ∈ S }),
  DisequalityDispersion.SubtermClosed S →
    ∀ (pred : DisequalityDispersion.Term V F arity → Option (DisequalityDispersion.Term V F arity)) (b₀ : B) (a : V → B)
      (u v : DisequalityDispersion.Term V F arity),
