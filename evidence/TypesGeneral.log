  ∑ x ∈ S, DisequalityDispersion.Flow.Network.indeg U x = {a ∈ U | a.2 ∈ S}.card
@DisequalityDispersion.Flow.Network.sum_cut : ∀ {ν : Type} [inst : DecidableEq ν]
  (N : DisequalityDispersion.Flow.Network ν),
  N.Ok →
    ∀ {U : Finset (ν × ν)},
      N.IsFlow U →
        ∀ (S : Finset ν),
          N.s ∈ S →
            N.t ∉ S →
              ∑ x ∈ S, DisequalityDispersion.Flow.Network.outdeg U x =
