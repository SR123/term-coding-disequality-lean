    Finset.image (fun c => List.ofFn (DisequalityDispersion.sharpAssign k hk c))
      (DisequalityDispersion.pairImage tests I ×ˢ Finset.univ)
@DisequalityDispersion.padded_filteredImage_card : ∀ {F A : Type} {arity : F → ℕ} [inst : Fintype A] (k : ℕ)
  (hk : 2 ≤ k) (tests : List (DisequalityDispersion.Term (Fin 2) F arity × DisequalityDispersion.Term (Fin 2) F arity))
  (I : DisequalityDispersion.Interpretation F arity A),
  (DisequalityDispersion.filteredImage (DisequalityDispersion.identityOutputs k)
