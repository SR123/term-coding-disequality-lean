@DisequalityDispersion.routeAssign_apply : ∀ {V B : Type} {q : ℕ} (z : Fin q → V),
  Function.Injective z → ∀ (b₀ : B) (c : Fin q → B) (i : Fin q), DisequalityDispersion.routeAssign z b₀ c (z i) = c i
@DisequalityDispersion.finite_route_image_lower : ∀ {V F B : Type} {arity : F → ℕ} [inst : Fintype V]
  [inst_1 : Fintype B] (outputs : List (DisequalityDispersion.Term V F arity))
