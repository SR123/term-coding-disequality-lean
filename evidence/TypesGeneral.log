DisequalityDispersion.Encoded.interpTabs_getElem : ∀ (γ : DisequalityDispersion.Encoded.Instance) (n : ℕ)
  [inst : NeZero n] (I : DisequalityDispersion.Interpretation (Fin γ.m) γ.arity (Fin n)) (f : Fin γ.m),
  (DisequalityDispersion.Encoded.interpTabs γ n I)[↑f] =
    List.map (fun e => ↑(I f (DisequalityDispersion.Encoded.digits n (γ.arity f) e))) (List.range (n ^ γ.arity f))
DisequalityDispersion.Encoded.interpTabs_mem : ∀ (γ : DisequalityDispersion.Encoded.Instance) (n : ℕ) [inst : NeZero n]
  (I : DisequalityDispersion.Interpretation (Fin γ.m) γ.arity (Fin n)),
