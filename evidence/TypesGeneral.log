  e ∈ DisequalityDispersion.Flow.Network.steps p → e.1 ∈ p ∧ e.2 ∈ p
@DisequalityDispersion.Flow.Network.chain_steps : ∀ {ν : Type} {R : ν → ν → Prop} {p : List ν},
  List.IsChain R p → ∀ e ∈ DisequalityDispersion.Flow.Network.steps p, R e.1 e.2
@DisequalityDispersion.Flow.Network.steps_nodup : ∀ {ν : Type} {p : List ν},
