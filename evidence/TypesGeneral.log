  {arity : F → ℕ} →
    (V → V') →
      List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity) →
        List (DisequalityDispersion.Term V' F arity × DisequalityDispersion.Term V' F arity)
@DisequalityDispersion.Valid_mapVarTests : ∀ {V V' F A : Type} {arity : F → ℕ} (g : V → V')
  (tests : List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity))
