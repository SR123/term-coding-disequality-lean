DisequalityDispersion.Encoded.strictAtG_iff : ∀ (k : ℕ) (g : DisequalityDispersion.Encoded.GInstance) (n : ℕ),
  DisequalityDispersion.Encoded.strictAtG k g n = true ↔
    ∃ (hv : g.Valid), 2 ≤ n ∧ DisequalityDispersion.threshold k n + 1 ≤ g.dispersion hv n
DisequalityDispersion.Encoded.Strict_iff_exists_strictAtG : ∀ (k : ℕ) (g : DisequalityDispersion.Encoded.GInstance),
