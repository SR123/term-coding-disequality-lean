        DisequalityDispersion.Routed pred z t →
          (DisequalityDispersion.Term.eval (DisequalityDispersion.finiteRouteTable S d pred b₀)
                (DisequalityDispersion.finiteTaggedSources S d a) t).2 =
            a z
