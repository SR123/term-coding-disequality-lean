  Function.Injective g →
    ∀ (tests : List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity)),
      (∀ uv ∈ DisequalityDispersion.mapVarTests g tests, uv.1 ≠ uv.2) ↔ ∀ uv ∈ tests, uv.1 ≠ uv.2
