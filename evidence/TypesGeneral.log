DisequalityDispersion.Encoded.GInstance.passesL_iff : ∀ (g : DisequalityDispersion.Encoded.GInstance) (n : ℕ)
  [inst : NeZero n] (hv : g.Valid) (tabs : List (List ℕ)),
  (∀ t ∈ tabs, ∀ v ∈ t, v < n) →
    ∀ (a : List ℕ),
      (∀ v ∈ a, v < n) →
        (g.passesL n tabs a = true ↔
          DisequalityDispersion.Valid (g.tests hv) (DisequalityDispersion.Encoded.tabInterp g.base n tabs)
            (g.base.listAssign n a))
DisequalityDispersion.Encoded.GInstance.outTupleL_eq : ∀ (g : DisequalityDispersion.Encoded.GInstance) (n : ℕ)
  [inst : NeZero n] (hv : g.Valid) (tabs : List (List ℕ)),
  (∀ t ∈ tabs, ∀ v ∈ t, v < n) →
    ∀ (a : List ℕ),
      (∀ v ∈ a, v < n) →
        g.outTupleL n tabs a =
          List.map Fin.val
            (DisequalityDispersion.tupleEval (g.outputs hv) (DisequalityDispersion.Encoded.tabInterp g.base n tabs)
              (g.base.listAssign n a))
