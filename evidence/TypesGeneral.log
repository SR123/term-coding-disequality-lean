@DisequalityDispersion.Encoded.buildList_map : ∀ {α β : Type} (g : α → β) (s₁ : List β → ℕ → β) (s₂ : List α → ℕ → α)
  (N : ℕ),
  (∀ j < N, ∀ (l : List α), l.length = j → s₁ (List.map g l) j = g (s₂ l j)) →
    DisequalityDispersion.Encoded.buildList s₁ N = List.map g (DisequalityDispersion.Encoded.buildList s₂ N)
DisequalityDispersion.Encoded.Instance.evalNodesL_eq : ∀ (γ : DisequalityDispersion.Encoded.Instance) (n : ℕ)
  [inst : NeZero n],
  γ.Valid →
    ∀ (tabs : List (List ℕ)),
      (∀ t ∈ tabs, ∀ v ∈ t, v < n) →
