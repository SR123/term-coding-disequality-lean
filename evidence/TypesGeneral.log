  DisequalityDispersion.Flow.Network ν → List (ν × ν) → List ν → Prop
@DisequalityDispersion.Flow.Network.Inv : {ν : Type} →
  DisequalityDispersion.Flow.Network ν → List (ν × ν) → List ν → List ν → Prop
@DisequalityDispersion.Flow.Network.inv_step : ∀ {ν : Type} [inst : DecidableEq ν]
  (N : DisequalityDispersion.Flow.Network ν) (U : List (ν × ν)) (seen front : List ν),
