DisequalityDispersion.Encoded.tabInterp_interpTabs : ∀ (γ : DisequalityDispersion.Encoded.Instance) (n : ℕ)
  [inst : NeZero n] (I : DisequalityDispersion.Interpretation (Fin γ.m) γ.arity (Fin n)),
  DisequalityDispersion.Encoded.tabInterp γ n (DisequalityDispersion.Encoded.interpTabs γ n I) = I
