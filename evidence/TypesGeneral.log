    (DisequalityDispersion.pairImage tests I).card
@DisequalityDispersion.fin2_ext : ∀ {A : Type} (a b : Fin 2 → A), a 0 = b 0 → a 1 = b 1 → a = b
@DisequalityDispersion.padded_filteredImage : ∀ {F A : Type} {arity : F → ℕ} [inst : Fintype A] (k : ℕ) (hk : 2 ≤ k)
  (tests : List (DisequalityDispersion.Term (Fin 2) F arity × DisequalityDispersion.Term (Fin 2) F arity))
  (I : DisequalityDispersion.Interpretation F arity A),
  DisequalityDispersion.filteredImage (DisequalityDispersion.identityOutputs k)
