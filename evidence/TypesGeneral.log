  {arity : F → ℕ} →
    [Fintype V] →
      [Fintype F] →
        ℕ →
          List (DisequalityDispersion.Term V F arity) →
            List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity) → Prop
