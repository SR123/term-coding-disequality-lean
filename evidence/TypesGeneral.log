  (N : DisequalityDispersion.Flow.Network ν) (U : List (ν × ν)),
  N.Ok → N.t ∈ N.seen U → (N.augPath U).length ≤ N.nodes.length
@DisequalityDispersion.Flow.Network.steps_length : ∀ {ν : Type} (p : List ν),
  (DisequalityDispersion.Flow.Network.steps p).length ≤ p.length
DisequalityDispersion.Flow.Network.resB : ℕ → ℕ → ℕ
DisequalityDispersion.Flow.Network.frontB : ℕ → ℕ → ℕ → ℕ
DisequalityDispersion.Flow.Network.layerRoundB : ℕ → ℕ → ℕ → ℕ
DisequalityDispersion.Flow.Network.layersB : ℕ → ℕ → ℕ → ℕ
DisequalityDispersion.Flow.Network.seenB : ℕ → ℕ → ℕ → ℕ
DisequalityDispersion.Flow.Network.augPathB : ℕ → ℕ → ℕ → ℕ
DisequalityDispersion.Flow.Network.augmentB : ℕ → ℕ → ℕ → ℕ
DisequalityDispersion.Flow.Network.roundB : ℕ → ℕ → ℕ → ℕ
DisequalityDispersion.Flow.Network.flowBound : ℕ → ℕ → ℕ → ℕ
@DisequalityDispersion.Flow.Network.pc_le : ∀ {ν : Type} (N : DisequalityDispersion.Flow.Network ν) (c : ν → ℕ) (L : ℕ),
  (∀ x ∈ N.nodes, c x ≤ L) →
    ∀ (e : ν × ν), e.1 ∈ N.nodes → e.2 ∈ N.nodes → DisequalityDispersion.Flow.Network.pc c e ≤ 2 * L
@DisequalityDispersion.Flow.Network.memC_le : ∀ {ν : Type} (N : DisequalityDispersion.Flow.Network ν) (c : ν → ℕ)
  (L : ℕ),
  (∀ x ∈ N.nodes, c x ≤ L) →
    ∀ (l : List (ν × ν)) (e : ν × ν),
      (∀ e' ∈ l, e'.1 ∈ N.nodes ∧ e'.2 ∈ N.nodes) →
        e.1 ∈ N.nodes → e.2 ∈ N.nodes → DisequalityDispersion.Flow.Network.memC c l e ≤ l.length * (1 + 4 * L)
@DisequalityDispersion.Flow.Network.memNC_le : ∀ {ν : Type} (N : DisequalityDispersion.Flow.Network ν) (c : ν → ℕ)
  (L : ℕ),
  (∀ x ∈ N.nodes, c x ≤ L) →
    ∀ (l : List ν) (x : ν),
      (∀ y ∈ l, y ∈ N.nodes) → x ∈ N.nodes → DisequalityDispersion.Flow.Network.memNC c l x ≤ l.length * (1 + 2 * L)
@DisequalityDispersion.Flow.Network.resC_le : ∀ {ν : Type} (N : DisequalityDispersion.Flow.Network ν) (c : ν → ℕ),
  N.Ok →
    ∀ (L : ℕ),
      (∀ x ∈ N.nodes, c x ≤ L) →
        ∀ (U : List (ν × ν)),
          (∀ a ∈ U, a ∈ N.arcs) →
            U.length ≤ N.arcs.length →
              ∀ (a b : ν),
                a ∈ N.nodes → b ∈ N.nodes → N.resC c U a b ≤ DisequalityDispersion.Flow.Network.resB N.arcs.length L
@DisequalityDispersion.Flow.Network.newFrontC_le : ∀ {ν : Type} (N : DisequalityDispersion.Flow.Network ν) (c : ν → ℕ),
  N.Ok →
    ∀ (L : ℕ),
      (∀ x ∈ N.nodes, c x ≤ L) →
        ∀ (U : List (ν × ν)),
          (∀ a ∈ U, a ∈ N.arcs) →
            U.length ≤ N.arcs.length →
              ∀ (seen front : List ν),
                (∀ y ∈ seen, y ∈ N.nodes) →
                  (∀ y ∈ front, y ∈ N.nodes) →
                    seen.length ≤ N.nodes.length →
                      front.length ≤ N.nodes.length →
                        N.newFrontC c U seen front ≤
                          DisequalityDispersion.Flow.Network.frontB N.nodes.length N.arcs.length L
@DisequalityDispersion.Flow.Network.layersAuxC_le : ∀ {ν : Type} [inst : DecidableEq ν]
  (N : DisequalityDispersion.Flow.Network ν) (c : ν → ℕ),
  N.Ok →
    ∀ (L : ℕ),
      (∀ x ∈ N.nodes, c x ≤ L) →
        ∀ (U : List (ν × ν)),
          (∀ a ∈ U, a ∈ N.arcs) →
            U.length ≤ N.arcs.length →
              ∀ (k : ℕ) (seen front : List ν),
                seen.Nodup →
                  front.Nodup →
                    (∀ y ∈ front, y ∉ seen) →
                      (∀ y ∈ seen, y ∈ N.nodes) →
                        (∀ y ∈ front, y ∈ N.nodes) →
                          k ≤ N.nodes.length →
                            N.layersAuxC c U k seen front ≤
                              (k + 1) * DisequalityDispersion.Flow.Network.layerRoundB N.nodes.length N.arcs.length L
@DisequalityDispersion.Flow.Network.layersC_le : ∀ {ν : Type} [inst : DecidableEq ν]
  (N : DisequalityDispersion.Flow.Network ν) (c : ν → ℕ),
  N.Ok →
    ∀ (L : ℕ),
      (∀ x ∈ N.nodes, c x ≤ L) →
        ∀ (U : List (ν × ν)),
          (∀ a ∈ U, a ∈ N.arcs) →
            U.length ≤ N.arcs.length →
              N.layersC c U ≤ DisequalityDispersion.Flow.Network.layersB N.nodes.length N.arcs.length L
@DisequalityDispersion.Flow.Network.seenC_le : ∀ {ν : Type} [inst : DecidableEq ν]
  (N : DisequalityDispersion.Flow.Network ν) (c : ν → ℕ),
  N.Ok →
    ∀ (L : ℕ),
      (∀ x ∈ N.nodes, c x ≤ L) →
        ∀ (U : List (ν × ν)),
          (∀ a ∈ U, a ∈ N.arcs) →
            U.length ≤ N.arcs.length →
              N.seenC c U ≤ DisequalityDispersion.Flow.Network.seenB N.nodes.length N.arcs.length L
@DisequalityDispersion.Flow.Network.descendRC_le : ∀ {ν : Type} [inst : DecidableEq ν]
  (N : DisequalityDispersion.Flow.Network ν) (c : ν → ℕ),
  N.Ok →
    ∀ (L : ℕ),
      (∀ x ∈ N.nodes, c x ≤ L) →
        ∀ (U : List (ν × ν)),
          (∀ a ∈ U, a ∈ N.arcs) →
            U.length ≤ N.arcs.length →
              ∀ (rls : List (List ν)) (y : ν),
                (∀ Ly ∈ rls, ∀ x ∈ Ly, x ∈ N.nodes) →
                  y ∈ N.nodes →
                    N.descendRC c U rls y ≤
                      rls.length + 1 +
                        rls.flatten.length * (1 + DisequalityDispersion.Flow.Network.resB N.arcs.length L)
@DisequalityDispersion.Flow.Network.extractRC_le : ∀ {ν : Type} [inst : DecidableEq ν]
  (N : DisequalityDispersion.Flow.Network ν) (c : ν → ℕ),
  N.Ok →
    ∀ (L : ℕ),
      (∀ x ∈ N.nodes, c x ≤ L) →
        ∀ (U : List (ν × ν)),
          (∀ a ∈ U, a ∈ N.arcs) →
            U.length ≤ N.arcs.length →
              ∀ (rls : List (List ν)) (y : ν),
                (∀ Ly ∈ rls, ∀ x ∈ Ly, x ∈ N.nodes) →
                  y ∈ N.nodes →
                    N.extractRC c U rls y ≤
                      2 * rls.length + 1 +
                        rls.flatten.length * (2 + 2 * L + DisequalityDispersion.Flow.Network.resB N.arcs.length L)
@DisequalityDispersion.Flow.Network.augPathC_le : ∀ {ν : Type} [inst : DecidableEq ν]
  (N : DisequalityDispersion.Flow.Network ν) (c : ν → ℕ),
  N.Ok →
    ∀ (L : ℕ),
      (∀ x ∈ N.nodes, c x ≤ L) →
        ∀ (U : List (ν × ν)),
          (∀ a ∈ U, a ∈ N.arcs) →
            U.length ≤ N.arcs.length →
              N.t ∈ N.seen U →
                N.augPathC c U ≤ DisequalityDispersion.Flow.Network.augPathB N.nodes.length N.arcs.length L
@DisequalityDispersion.Flow.Network.augmentC_le : ∀ {ν : Type} (N : DisequalityDispersion.Flow.Network ν) (c : ν → ℕ),
  N.Ok →
    ∀ (L : ℕ),
      (∀ x ∈ N.nodes, c x ≤ L) →
        ∀ (U : List (ν × ν)),
          (∀ a ∈ U, a ∈ N.arcs) →
            U.length ≤ N.arcs.length →
              ∀ (p : List ν),
                (∀ x ∈ p, x ∈ N.nodes) →
                  p.length ≤ N.nodes.length →
                    N.augmentC c U p ≤ DisequalityDispersion.Flow.Network.augmentB N.nodes.length N.arcs.length L
@DisequalityDispersion.Flow.Network.good_augment : ∀ {ν : Type} [inst : DecidableEq ν]
  (N : DisequalityDispersion.Flow.Network ν),
  N.Ok → ∀ (U : List (ν × ν)), N.Good U → N.t ∈ N.seen U → N.Good (N.augment U (N.augPath U))
@DisequalityDispersion.Flow.Network.ffAuxC_le : ∀ {ν : Type} [inst : DecidableEq ν]
  (N : DisequalityDispersion.Flow.Network ν) (c : ν → ℕ),
  N.Ok →
    ∀ (L : ℕ),
      (∀ x ∈ N.nodes, c x ≤ L) →
        ∀ (f : ℕ) (U : List (ν × ν)),
          N.Good U →
            f ≤ N.arcs.length + 1 →
              N.ffAuxC c f U ≤ 1 + f * DisequalityDispersion.Flow.Network.roundB N.nodes.length N.arcs.length L
@DisequalityDispersion.Flow.Network.maxflowC_le : ∀ {ν : Type} [inst : DecidableEq ν]
  (N : DisequalityDispersion.Flow.Network ν) (c : ν → ℕ),
