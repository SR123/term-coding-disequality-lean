@DisequalityDispersion.Flow.Network.din_dout : ∀ {ν : Type} [inst : DecidableEq ν] (p : List ν) (x : ν),
  (DisequalityDispersion.Flow.Network.din p x + if p.head? = some x then 1 else 0) =
    DisequalityDispersion.Flow.Network.dout p x + if p.getLast? = some x then 1 else 0
