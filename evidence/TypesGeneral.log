  (s.sup fun i => c i * m) = s.sup c * m
@DisequalityDispersion.padding_dispersion : ∀ {F : Type} {arity : F → ℕ} [inst : Fintype F] (k : ℕ) (hk : 2 ≤ k)
  (tests : List (DisequalityDispersion.Term (Fin 2) F arity × DisequalityDispersion.Term (Fin 2) F arity)) (n : ℕ),
  DisequalityDispersion.dispersionTuple (DisequalityDispersion.identityOutputs k)
      (DisequalityDispersion.padTests k hk tests) =
    DisequalityDispersion.dispersionTuple [DisequalityDispersion.Term.var 0, DisequalityDispersion.Term.var 1] tests *
      n ^ (k - 2)
@DisequalityDispersion.cutSize_of_all_vars : ∀ {V F : Type} {arity : F → ℕ} [inst : Fintype V]
  (outputs : List (DisequalityDispersion.Term V F arity))
  (tests : List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity)),
