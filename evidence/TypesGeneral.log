  {x y : V} {outputs : List (DisequalityDispersion.Term V F arity)}
  {tests : List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity)},
  DisequalityDispersion.InClassC x y outputs tests →
    ∀ (n : ℕ), DisequalityDispersion.dispersionTuple outputs tests ≤ n ^ DisequalityDispersion.cutSize outputs tests
@DisequalityDispersion.cut_sandwich : ∀ {V F : Type} {arity : F → ℕ} [inst : Fintype V] [inst_1 : Fintype F] {x y : V}
  {outputs : List (DisequalityDispersion.Term V F arity)}
  {tests : List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity)},
  DisequalityDispersion.InClassC x y outputs tests →
    (∀ uv ∈ tests, uv.1 ≠ uv.2) →
      ∀ (n : ℕ),
        (DisequalityDispersion.tupleSupport outputs tests).card ≤ n →
          (n / (DisequalityDispersion.tupleSupport outputs tests).card) ^ DisequalityDispersion.cutSize outputs tests ≤
              DisequalityDispersion.dispersionTuple outputs tests ∧
            DisequalityDispersion.dispersionTuple outputs tests ≤ n ^ DisequalityDispersion.cutSize outputs tests
