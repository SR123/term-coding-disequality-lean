@DisequalityDispersion.routing_lower_tag : ∀ {V F : Type} {arity : F → ℕ} [inst : Fintype V] [inst_1 : Fintype F]
  (outputs : List (DisequalityDispersion.Term V F arity))
  (tests : List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity))
  (R : DisequalityDispersion.RoutingData outputs),
  (∀ uv ∈ tests, uv.1 ≠ uv.2) → ∀ (x : V) (m : ℕ), 0 < m → m ^ R.q ≤ DisequalityDispersion.dispersionTuple outputs tests
@DisequalityDispersion.routing_lower : ∀ {V F : Type} {arity : F → ℕ} [inst : Fintype V] [inst_1 : Fintype F]
  (outputs : List (DisequalityDispersion.Term V F arity))
  (tests : List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity))
  (R : DisequalityDispersion.RoutingData outputs),
