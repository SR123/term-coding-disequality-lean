    ∀ (U : List (ν × ν)),
      N.IsFlow U.toFinset →
        ∀ (S : Finset ν),
          (∀ x ∈ S, ∀ y ∈ N.nodes, N.ResL U x y → y ∈ S) → N.s ∈ S → N.t ∉ S → N.value U.toFinset = N.cap S
