DisequalityDispersion.Encoded.lowerAtG_iff : ∀ (k : ℕ) (g : DisequalityDispersion.Encoded.GInstance) (n : ℕ),
  DisequalityDispersion.Encoded.lowerAtG k g n = true ↔
    ∃ (hv : g.Valid), 2 ≤ n ∧ DisequalityDispersion.threshold k n ≤ g.dispersion hv n
DisequalityDispersion.Encoded.Lower_iff_exists_lowerAtG : ∀ (k : ℕ) (g : DisequalityDispersion.Encoded.GInstance),
  DisequalityDispersion.Encoded.GInstance.Lower k g ↔ ∃ n, DisequalityDispersion.Encoded.lowerAtG k g n = true
