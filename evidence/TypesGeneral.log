DisequalityDispersion.Encoded.GInstance.strictDecideP_def : ∀ (g : DisequalityDispersion.Encoded.GInstance) (k : ℕ),
  g.strictDecideP k =
    (decide (2 ≤ k) && g.isValid && g.base.testsDistinct g.base.canonIds && decide (k + 1 ≤ g.rhoFlow))
DisequalityDispersion.Encoded.GInstance.network_arcs : ∀ (g : DisequalityDispersion.Encoded.GInstance),
  g.network.arcs = g.nodeArcs ++ g.edgeArcs ++ g.srcArcs ++ g.snkArcs
