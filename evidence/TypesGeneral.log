      DisequalityDispersion.Flow.Network.outdeg ({a ∈ G | ¬q a}) x =
    DisequalityDispersion.Flow.Network.outdeg G x
@DisequalityDispersion.Flow.Network.card_swap_filter : ∀ {ν : Type} [inst : DecidableEq ν] (G E' : Finset (ν × ν))
  (r : ν × ν → Prop) [inst_1 : DecidablePred r],
  {a ∈ G | r a ∧ (a.2, a.1) ∈ E'}.card = {e ∈ E' | r (e.2, e.1) ∧ (e.2, e.1) ∈ G}.card
@DisequalityDispersion.Flow.Network.card_filter_toFinset : ∀ {ν : Type} [inst : DecidableEq ν] {E : List (ν × ν)},
  E.Nodup → ∀ (q : ν × ν → Bool), {e ∈ E.toFinset | q e = true}.card = List.countP q E
@DisequalityDispersion.Flow.Network.augment_flow : ∀ {ν : Type} [inst : DecidableEq ν]
  (N : DisequalityDispersion.Flow.Network ν),
  N.Ok →
    ∀ (U : List (ν × ν)) (p : List ν),
      N.IsFlow U.toFinset →
        p.Nodup →
          List.IsChain (N.ResL U) p →
            p.head? = some N.s →
              p.getLast? = some N.t →
                N.IsFlow (N.augment U p).toFinset ∧ N.value U.toFinset + 1 ≤ N.value (N.augment U p).toFinset
@DisequalityDispersion.Flow.Network.value_eq_cap_of_closed : ∀ {ν : Type} [inst : DecidableEq ν]
  (N : DisequalityDispersion.Flow.Network ν),
