  (N : DisequalityDispersion.Flow.Network ν),
  N.Ok →
    ∀ (f : ℕ) (U : List (ν × ν)),
      N.Good U → N.arcs.length < N.value U.toFinset + f → N.Good (N.ffAux f U) ∧ N.t ∉ N.seen (N.ffAux f U)
