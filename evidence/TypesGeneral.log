  [DecidableEq ν] → DisequalityDispersion.Flow.Network ν → List (ν × ν) → List (List ν) → ν → List ν
@DisequalityDispersion.Flow.Network.extractR : {ν : Type} →
  [DecidableEq ν] → DisequalityDispersion.Flow.Network ν → List (ν × ν) → List (List ν) → ν → List ν
@DisequalityDispersion.Flow.Network.augPath : {ν : Type} →
  [DecidableEq ν] → DisequalityDispersion.Flow.Network ν → List (ν × ν) → List ν
@DisequalityDispersion.Flow.Network.RChain : {ν : Type} →
  DisequalityDispersion.Flow.Network ν → List (ν × ν) → List (List ν) → Prop
@DisequalityDispersion.Flow.Network.descendR_spec : ∀ {ν : Type} [inst : DecidableEq ν]
  (N : DisequalityDispersion.Flow.Network ν) (U : List (ν × ν)) (rls : List (List ν)) (y : ν),
  N.RChain U rls →
    (∀ L ∈ rls.head?, ∃ x ∈ L, N.ResL U x y) →
      ∃ q,
        N.descendR U rls y = y :: q ∧
          q.length = rls.length ∧
            (∀ (i : ℕ) (hi : i < q.length) (hi' : i < rls.length), q[i] ∈ rls[i]) ∧
              List.IsChain (fun a b => N.ResL U b a) (y :: q)
@DisequalityDispersion.Flow.Network.RChain_tail : ∀ {ν : Type} (N : DisequalityDispersion.Flow.Network ν)
  (U : List (ν × ν)) (L : List ν) (rest : List (List ν)), N.RChain U (L :: rest) → N.RChain U rest
@DisequalityDispersion.Flow.Network.extractR_spec : ∀ {ν : Type} [inst : DecidableEq ν]
  (N : DisequalityDispersion.Flow.Network ν) (U : List (ν × ν)) (rls : List (List ν)) (y : ν),
  N.RChain U rls →
    y ∈ rls.flatten →
      ∃ j,
        ∃ (hj : j < rls.length),
          ∃ q,
            y ∈ rls[j] ∧
              N.extractR U rls y = y :: q ∧
                q.length + j + 1 = rls.length ∧
                  (∀ (i : ℕ) (hi : i < q.length) (hi' : i + j + 1 < rls.length), q[i] ∈ rls[i + j + 1]) ∧
                    List.IsChain (fun a b => N.ResL U b a) (y :: q)
@DisequalityDispersion.Flow.Network.nodup_of_layers : ∀ {ν : Type} (Ls : List (List ν)) (q : List ν),
  Ls.flatten.Nodup →
    q.length = Ls.length → (∀ (i : ℕ) (hi : i < q.length) (hi' : i < Ls.length), q[i] ∈ Ls[i]) → q.Nodup
@DisequalityDispersion.Flow.Network.nodup_of_layers_drop : ∀ {ν : Type} (Ls : List (List ν)) (q : List ν) (j : ℕ),
  Ls.flatten.Nodup →
    q.length + j = Ls.length → (∀ (i : ℕ) (hi : i < q.length) (hi' : i + j < Ls.length), q[i] ∈ Ls[i + j]) → q.Nodup
@DisequalityDispersion.Flow.Network.augPath_spec : ∀ {ν : Type} [inst : DecidableEq ν]
  (N : DisequalityDispersion.Flow.Network ν) (U : List (ν × ν)),
  N.nodes.Nodup →
    N.t ∈ N.seen U →
      (N.augPath U).Nodup ∧
        List.IsChain (N.ResL U) (N.augPath U) ∧ (N.augPath U).head? = some N.s ∧ (N.augPath U).getLast? = some N.t
