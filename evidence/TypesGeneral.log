  {tests : List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity)},
  DisequalityDispersion.InClassC x y outputs tests →
    (∀ uv ∈ tests, uv.1 ≠ uv.2) →
      ∀ (n : ℕ),
        2 * (DisequalityDispersion.tupleSupport outputs tests).card ≤ n →
          (↑n / (2 * ↑(DisequalityDispersion.tupleSupport outputs tests).card)) ^
