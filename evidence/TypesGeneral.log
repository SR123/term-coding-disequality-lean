DisequalityDispersion.Encoded.all_degree_headline : ∀ (d : ℕ)
  (rels : List (List (DisequalityDispersion.Letter (Fin d)))),
  ¬ComputablePred (DisequalityDispersion.HasFiniteQuotient rels) →
    ∀ (k : ℕ),
      2 ≤ k →
        ¬ComputablePred (DisequalityDispersion.Encoded.GInstance.Lower k) ∧
          (REPred (DisequalityDispersion.Encoded.GInstance.Lower k) ∧
              ¬REPred fun g => ¬DisequalityDispersion.Encoded.GInstance.Lower k g) ∧
            (ComputablePred (DisequalityDispersion.Encoded.GInstance.Strict k) ∧
                (∀ (g : DisequalityDispersion.Encoded.GInstance),
                    g.strictDecideG k = true ↔ DisequalityDispersion.Encoded.GInstance.Strict k g) ∧
                  ∀ (g : DisequalityDispersion.Encoded.GInstance), ¬g.Valid → g.strictDecideG k = false) ∧
              (∀ (w : List (DisequalityDispersion.Letter (Fin d))),
                  (DisequalityDispersion.Encoded.GInstance.Lower k
                        (DisequalityDispersion.Encoded.compileDegree k d rels w) ↔
                      DisequalityDispersion.HasFiniteQuotient rels w) ∧
                    ¬DisequalityDispersion.Encoded.GInstance.Strict k
                        (DisequalityDispersion.Encoded.compileDegree k d rels w)) ∧
                ∀ (sz : DisequalityDispersion.Encoded.GInstance → ℕ),
                  Computable sz →
                    ∀ (B : ℕ → ℕ),
                      Computable B →
                        ¬∀ (g : DisequalityDispersion.Encoded.GInstance),
                            DisequalityDispersion.Encoded.GInstance.Lower k g →
                              ∃ n, 2 ≤ n ∧ n ≤ B (sz g) ∧ DisequalityDispersion.Encoded.lowerAtG k g n = true
DisequalityDispersion.Encoded.polynomial_time_headline : ∀ (k : ℕ),
  2 ≤ k →
    (∀ (g : DisequalityDispersion.Encoded.GInstance),
        (g.strictDecideP k = true ↔ DisequalityDispersion.Encoded.GInstance.Strict k g) ∧
          (∀ (hv : g.Valid), g.rhoFlow = DisequalityDispersion.cutSize (g.outputs hv) (g.tests hv)) ∧
            (¬g.Valid → g.strictDecideP k = false)) ∧
      (∀ (bs : List Bool),
          (DisequalityDispersion.Encoded.decideBits bs = true ↔ DisequalityDispersion.Encoded.StrictBits bs) ∧
            ∀ (k' : ℕ) (g : DisequalityDispersion.Encoded.GInstance),
              DisequalityDispersion.Encoded.decodeInput bs = some (k', g) ↔
                bs = DisequalityDispersion.Encoded.encodeInput k' g) ∧
        (ComputablePred (DisequalityDispersion.Encoded.GInstance.Strict k) ∧ Primrec fun p => p.2.strictDecideP p.1) ∧
          (∀ (g : DisequalityDispersion.Encoded.GInstance),
              g.strictDecidePC k ≤
                  91000 * DisequalityDispersion.Encoded.sizeG g ^ 6 + 3 * DisequalityDispersion.Encoded.natC k ∧
                (DisequalityDispersion.Encoded.encodeInput k g).length =
                  DisequalityDispersion.Encoded.natC k + DisequalityDispersion.Encoded.sizeG g) ∧
            (∀ (bs : List Bool), DisequalityDispersion.Encoded.decideBitsC bs ≤ 92000 * (bs.length + 1) ^ 6) ∧
              (∀ (bs : List Bool),
                  (DisequalityDispersion.Encoded.decodeInputM bs).val = DisequalityDispersion.Encoded.decodeInput bs ∧
                    (DisequalityDispersion.Encoded.decodeInputM bs).cost =
                      DisequalityDispersion.Encoded.decodeInputC bs) ∧
                (∀ (g : DisequalityDispersion.Encoded.GInstance),
                    (g.strictDecidePM k).val = g.strictDecideP k ∧ (g.strictDecidePM k).cost = g.strictDecidePC k) ∧
                  (∀ (bs : List Bool),
                      (DisequalityDispersion.Encoded.decideBitsM bs).val = DisequalityDispersion.Encoded.decideBits bs ∧
                        (DisequalityDispersion.Encoded.decideBitsM bs).cost =
                          DisequalityDispersion.Encoded.decideBitsC bs) ∧
                    ∀ (g : DisequalityDispersion.Encoded.GInstance) (hv : g.Valid),
                      DisequalityDispersion.Encoded.GInstance.Strict k g →
                        ((DisequalityDispersion.tupleSupport (g.outputs hv) (g.tests hv)).card ^ (k + 1)).size ≤
                          (g.base.k + g.base.nodes.length) * (g.base.k + g.base.nodes.length).size
@DisequalityDispersion.semantic_interface : ∀ {V F : Type} [inst : Fintype V] [inst_1 : Fintype F] {arity : F → ℕ}
  {x y : V} {outputs : List (DisequalityDispersion.Term V F arity)}
  {tests : List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity)},
  DisequalityDispersion.InClassC x y outputs tests →
    (∀ uv ∈ tests, uv.1 ≠ uv.2) →
      (∀ (n : ℕ),
          (DisequalityDispersion.tupleSupport outputs tests).card ≤ n →
            (n / (DisequalityDispersion.tupleSupport outputs tests).card) ^
                  DisequalityDispersion.cutSize outputs tests ≤
                DisequalityDispersion.dispersionTuple outputs tests ∧
              DisequalityDispersion.dispersionTuple outputs tests ≤
                  DisequalityDispersion.threshold (DisequalityDispersion.cutSize outputs tests) n ∧
                DisequalityDispersion.threshold (DisequalityDispersion.cutSize outputs tests) n ≤
                  n ^ DisequalityDispersion.cutSize outputs tests) ∧
        (∀ (j : ℕ) (hj : 2 ≤ j) (n : ℕ),
            DisequalityDispersion.dispersionTuple (DisequalityDispersion.identityOutputs j)
                (DisequalityDispersion.firstGuard j hj) =
              DisequalityDispersion.threshold j n) ∧
          (∀ (k : ℕ),
              2 ≤ k →
                (DisequalityDispersion.StrictT k outputs tests ↔
                    DisequalityDispersion.EventualStrictT k outputs tests) ∧
                  (DisequalityDispersion.StrictT k outputs tests ↔
                    (∀ uv ∈ tests, uv.1 ≠ uv.2) ∧ k + 1 ≤ DisequalityDispersion.cutSize outputs tests)) ∧
            Filter.Tendsto (fun n => Real.log ↑(DisequalityDispersion.dispersionTuple outputs tests) / Real.log ↑n)
              Filter.atTop (nhds ↑(DisequalityDispersion.cutSize outputs tests))
