            List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity) → Prop
@DisequalityDispersion.lowerT_of_strictT : ∀ {V F : Type} {arity : F → ℕ} [inst : Fintype V] [inst_1 : Fintype F]
  (k : ℕ) (outputs : List (DisequalityDispersion.Term V F arity))
  (tests : List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity)),
  DisequalityDispersion.StrictT k outputs tests → DisequalityDispersion.LowerT k outputs tests
DisequalityDispersion.witness_arithmetic : ∀ (s k ρ : ℕ),
  2 ≤ s → k + 1 ≤ ρ → 1 ≤ k → DisequalityDispersion.threshold k (s ^ (k + 1)) + 1 ≤ (s ^ (k + 1) / s) ^ ρ
@DisequalityDispersion.strict_witness : ∀ {V F : Type} {arity : F → ℕ} [inst : Fintype V] [inst_1 : Fintype F] (k : ℕ),
  1 ≤ k →
    ∀ (x y : V),
      x ≠ y →
        ∀ (outputs : List (DisequalityDispersion.Term V F arity))
          (tests : List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity)),
          DisequalityDispersion.MengerInput outputs tests →
            (∀ uv ∈ tests, uv.1 ≠ uv.2) →
              k + 1 ≤ DisequalityDispersion.cutSize outputs tests →
                2 ≤ (DisequalityDispersion.tupleSupport outputs tests).card ^ (k + 1) ∧
                  DisequalityDispersion.threshold k
                        ((DisequalityDispersion.tupleSupport outputs tests).card ^ (k + 1)) +
                      1 ≤
                    DisequalityDispersion.dispersionTuple outputs tests
@DisequalityDispersion.strict_degree_iff : ∀ {V F : Type} {arity : F → ℕ} [inst : Fintype V] [inst_1 : Fintype F]
  (k : ℕ),
  2 ≤ k →
    ∀ (x y : V),
      x ≠ y →
        ∀ (outputs : List (DisequalityDispersion.Term V F arity))
          (tests : List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity)),
          DisequalityDispersion.Term.var x ∈ outputs →
            DisequalityDispersion.Term.var y ∈ outputs →
              (DisequalityDispersion.Term.var x, DisequalityDispersion.Term.var y) ∈ tests →
                DisequalityDispersion.MengerInput outputs tests →
                  (DisequalityDispersion.StrictT k outputs tests ↔
                    (∀ uv ∈ tests, uv.1 ≠ uv.2) ∧ k + 1 ≤ DisequalityDispersion.cutSize outputs tests)
@DisequalityDispersion.dispersionTuple_le_threshold_of_cut_le : ∀ {V F : Type} {arity : F → ℕ} [inst : Fintype V]
  [inst_1 : Fintype F] (k : ℕ) (x y : V),
  x ≠ y →
    ∀ (outputs : List (DisequalityDispersion.Term V F arity))
      (tests : List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity)),
      DisequalityDispersion.Term.var x ∈ outputs →
        DisequalityDispersion.Term.var y ∈ outputs →
          (DisequalityDispersion.Term.var x, DisequalityDispersion.Term.var y) ∈ tests →
            DisequalityDispersion.cutSize outputs tests ≤ k →
              ∀ (n : ℕ),
                1 ≤ n → DisequalityDispersion.dispersionTuple outputs tests ≤ DisequalityDispersion.threshold k n
@DisequalityDispersion.not_lowerT_of_cut_lt : ∀ {V F : Type} {arity : F → ℕ} [inst : Fintype V] [inst_1 : Fintype F]
  (k : ℕ) (x y : V),
  x ≠ y →
    ∀ (outputs : List (DisequalityDispersion.Term V F arity))
      (tests : List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity)),
      DisequalityDispersion.Term.var x ∈ outputs →
        DisequalityDispersion.Term.var y ∈ outputs →
          (DisequalityDispersion.Term.var x, DisequalityDispersion.Term.var y) ∈ tests →
            DisequalityDispersion.cutSize outputs tests < k → ¬DisequalityDispersion.LowerT k outputs tests
DisequalityDispersion.threshold_interleave : ∀ (k n : ℕ),
  2 ≤ k →
    2 ≤ n →
      DisequalityDispersion.threshold k n < DisequalityDispersion.threshold k n + 1 ∧
        DisequalityDispersion.threshold k n + 1 < DisequalityDispersion.threshold (k + 1) n
