  ∃ a ∈ DisequalityDispersion.Encoded.allLists n g.base.k, g.base.listAssign n a = a'
DisequalityDispersion.Encoded.GInstance.imageCountL_eq : ∀ (g : DisequalityDispersion.Encoded.GInstance) (n : ℕ)
  [inst : NeZero n] (hv : g.Valid) (tabs : List (List ℕ)),
  (∀ t ∈ tabs, ∀ v ∈ t, v < n) →
    g.imageCountL n tabs =
