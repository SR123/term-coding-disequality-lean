  ∀ j < g.base.nodes.length, g.repOf j = g.base.rep ⋯ j
DisequalityDispersion.Encoded.GInstance.repOf_lt : ∀ (g : DisequalityDispersion.Encoded.GInstance),
  g.Valid → ∀ j < g.base.nodes.length, g.repOf j < g.base.nodes.length
DisequalityDispersion.Encoded.GInstance.repOf_le : ∀ (g : DisequalityDispersion.Encoded.GInstance),
  g.Valid → ∀ j < g.base.nodes.length, g.repOf j ≤ j
DisequalityDispersion.Encoded.GInstance.repOf_repOf : ∀ (g : DisequalityDispersion.Encoded.GInstance),
  g.Valid → ∀ j < g.base.nodes.length, g.repOf (g.repOf j) = g.repOf j
DisequalityDispersion.Encoded.GInstance.termD_repOf : ∀ (g : DisequalityDispersion.Encoded.GInstance) (hv : g.Valid),
  ∀ j < g.base.nodes.length, g.base.termD ⋯ (g.repOf j) = g.base.termD ⋯ j
DisequalityDispersion.Encoded.GInstance.repOf_eq_iff : ∀ (g : DisequalityDispersion.Encoded.GInstance) (hv : g.Valid)
  (i j : ℕ),
  i < g.base.nodes.length → j < g.base.nodes.length → (g.repOf i = g.repOf j ↔ g.base.termD ⋯ i = g.base.termD ⋯ j)
DisequalityDispersion.Encoded.GInstance.mem_reps : ∀ (g : DisequalityDispersion.Encoded.GInstance) (r : ℕ),
  r ∈ g.reps ↔ r < g.base.nodes.length ∧ g.repOf r = r
DisequalityDispersion.Encoded.GInstance.repOf_mem_reps : ∀ (g : DisequalityDispersion.Encoded.GInstance),
  g.Valid → ∀ j < g.base.nodes.length, g.repOf j ∈ g.reps
DisequalityDispersion.Encoded.GInstance.reps_nodup : ∀ (g : DisequalityDispersion.Encoded.GInstance), g.reps.Nodup
DisequalityDispersion.Encoded.GInstance.reps_lt : ∀ (g : DisequalityDispersion.Encoded.GInstance),
  ∀ r ∈ g.reps, r < g.base.nodes.length
DisequalityDispersion.Encoded.GInstance.mem_nodeArcs : ∀ (g : DisequalityDispersion.Encoded.GInstance) (e : ℕ × ℕ),
  e ∈ g.nodeArcs ↔ ∃ r ∈ g.reps, e = (2 * r, 2 * r + 1)
DisequalityDispersion.Encoded.GInstance.mem_edgeArcs : ∀ (g : DisequalityDispersion.Encoded.GInstance) (e : ℕ × ℕ),
  e ∈ g.edgeArcs ↔ ∃ j < g.base.nodes.length, ∃ a ∈ g.argsOf j, e = (2 * g.repOf a + 1, 2 * g.repOf j)
DisequalityDispersion.Encoded.GInstance.mem_srcArcs : ∀ (g : DisequalityDispersion.Encoded.GInstance) (e : ℕ × ℕ),
  e ∈ g.srcArcs ↔ ∃ j < g.base.nodes.length, g.isSrcNode j = true ∧ e = (g.netS, 2 * g.repOf j)
DisequalityDispersion.Encoded.GInstance.mem_snkArcs : ∀ (g : DisequalityDispersion.Encoded.GInstance) (e : ℕ × ℕ),
  e ∈ g.snkArcs ↔ ∃ j ∈ g.outNodes, e = (2 * g.repOf j + 1, g.netT)
DisequalityDispersion.Encoded.GInstance.mem_arcs_iff : ∀ (g : DisequalityDispersion.Encoded.GInstance) (e : ℕ × ℕ),
  e ∈ g.network.arcs ↔
    (∃ r ∈ g.reps, e = (2 * r, 2 * r + 1)) ∨
      (∃ j < g.base.nodes.length, ∃ a ∈ g.argsOf j, e = (2 * g.repOf a + 1, 2 * g.repOf j)) ∨
        (∃ j < g.base.nodes.length, g.isSrcNode j = true ∧ e = (g.netS, 2 * g.repOf j)) ∨
          ∃ j ∈ g.outNodes, e = (2 * g.repOf j + 1, g.netT)
DisequalityDispersion.Encoded.GInstance.mem_netNodes : ∀ (g : DisequalityDispersion.Encoded.GInstance) (v : ℕ),
  v ∈ g.network.nodes ↔ (∃ r ∈ g.reps, v = 2 * r) ∨ (∃ r ∈ g.reps, v = 2 * r + 1) ∨ v = g.netS ∨ v = g.netT
DisequalityDispersion.Encoded.GInstance.argsOf_lt : ∀ (g : DisequalityDispersion.Encoded.GInstance),
  g.Valid → ∀ j < g.base.nodes.length, ∀ a ∈ g.argsOf j, a < j
DisequalityDispersion.Encoded.GInstance.argsOf_isArg : ∀ (g : DisequalityDispersion.Encoded.GInstance) (hv : g.Valid),
  ∀ j < g.base.nodes.length, ∀ a ∈ g.argsOf j, DisequalityDispersion.IsArg (g.base.termD ⋯ a) (g.base.termD ⋯ j)
DisequalityDispersion.Encoded.GInstance.repOf_arg_ne : ∀ (g : DisequalityDispersion.Encoded.GInstance),
  g.Valid → ∀ j < g.base.nodes.length, ∀ a ∈ g.argsOf j, g.repOf a ≠ g.repOf j
DisequalityDispersion.Encoded.GInstance.isSrcNode_iff : ∀ (g : DisequalityDispersion.Encoded.GInstance) (hv : g.Valid),
  ∀ j < g.base.nodes.length, g.isSrcNode j = true ↔ ∃ v, g.base.termD ⋯ j = DisequalityDispersion.Term.var v
DisequalityDispersion.Encoded.GInstance.argsOf_app : ∀ (g : DisequalityDispersion.Encoded.GInstance) (hv : g.Valid),
  ∀ j < g.base.nodes.length,
    g.isSrcNode j = false →
      ∃ f,
        ∃ (_ : (g.argsOf j).length = g.base.arity f),
          g.base.termD ⋯ j = DisequalityDispersion.Term.app f fun i => g.base.termD ⋯ ((g.argsOf j).getD (↑i) 0)
DisequalityDispersion.Encoded.GInstance.network_ok : ∀ (g : DisequalityDispersion.Encoded.GInstance),
  g.Valid → g.network.Ok
DisequalityDispersion.Encoded.GInstance.Pre : (g : DisequalityDispersion.Encoded.GInstance) →
  Finset g.base.Tm → g.base.Tm → Prop
DisequalityDispersion.Encoded.GInstance.mem_of_pre_not_avoids : ∀ (g : DisequalityDispersion.Encoded.GInstance)
  (K : Finset g.base.Tm) (t : g.base.Tm), g.Pre K t → ¬DisequalityDispersion.Avoids K t → t ∈ K
DisequalityDispersion.Encoded.GInstance.cutSet : (g : DisequalityDispersion.Encoded.GInstance) →
  g.Valid → Finset g.base.Tm → Finset ℕ
DisequalityDispersion.Encoded.GInstance.mem_cutSet : ∀ (g : DisequalityDispersion.Encoded.GInstance) (hv : g.Valid)
  (K : Finset g.base.Tm) (v : ℕ),
  v ∈ g.cutSet hv K ↔
    v ∈ g.network.nodes ∧
      (v = g.netS ∨
        v / 2 < g.base.nodes.length ∧
          (v % 2 = 0 ∧ g.Pre K (g.base.termD ⋯ (v / 2)) ∨
            v % 2 = 1 ∧ DisequalityDispersion.Avoids K (g.base.termD ⋯ (v / 2))))
DisequalityDispersion.Encoded.GInstance.s_mem_cutSet : ∀ (g : DisequalityDispersion.Encoded.GInstance) (hv : g.Valid)
  (K : Finset g.base.Tm), g.netS ∈ g.cutSet hv K
DisequalityDispersion.Encoded.GInstance.t_notMem_cutSet : ∀ (g : DisequalityDispersion.Encoded.GInstance) (hv : g.Valid)
  (K : Finset g.base.Tm), g.netT ∉ g.cutSet hv K
DisequalityDispersion.Encoded.GInstance.entry_mem_cutSet : ∀ (g : DisequalityDispersion.Encoded.GInstance)
  (hv : g.Valid) (K : Finset g.base.Tm),
  ∀ j < g.base.nodes.length, g.Pre K (g.base.termD ⋯ j) → 2 * g.repOf j ∈ g.cutSet hv K
DisequalityDispersion.Encoded.GInstance.exit_mem_cutSet_iff : ∀ (g : DisequalityDispersion.Encoded.GInstance)
  (hv : g.Valid) (K : Finset g.base.Tm),
  ∀ j < g.base.nodes.length, 2 * g.repOf j + 1 ∈ g.cutSet hv K ↔ DisequalityDispersion.Avoids K (g.base.termD ⋯ j)
DisequalityDispersion.Encoded.GInstance.entry_mem_cutSet_iff : ∀ (g : DisequalityDispersion.Encoded.GInstance)
  (hv : g.Valid) (K : Finset g.base.Tm),
  ∀ j < g.base.nodes.length, 2 * g.repOf j ∈ g.cutSet hv K ↔ g.Pre K (g.base.termD ⋯ j)
DisequalityDispersion.Encoded.GInstance.pre_of_arg : ∀ (g : DisequalityDispersion.Encoded.GInstance) (hv : g.Valid)
  (K : Finset g.base.Tm),
  ∀ j < g.base.nodes.length,
    ∀ a ∈ g.argsOf j, DisequalityDispersion.Avoids K (g.base.termD ⋯ a) → g.Pre K (g.base.termD ⋯ j)
DisequalityDispersion.Encoded.GInstance.pre_of_src : ∀ (g : DisequalityDispersion.Encoded.GInstance) (hv : g.Valid)
  (K : Finset g.base.Tm), ∀ j < g.base.nodes.length, g.isSrcNode j = true → g.Pre K (g.base.termD ⋯ j)
DisequalityDispersion.Encoded.GInstance.crossing_cutSet : ∀ (g : DisequalityDispersion.Encoded.GInstance) (hv : g.Valid)
  (b : List ℕ),
  g.isCutB g.base.canonIds b = true →
    ∀ e ∈ g.network.arcs,
      e.1 ∈ g.cutSet hv (g.termCut hv b) →
        e.2 ∉ g.cutSet hv (g.termCut hv b) → ∃ r ∈ g.cutReps g.base.canonIds b, e = (2 * r, 2 * r + 1)
DisequalityDispersion.Encoded.GInstance.cap_cutSet_le : ∀ (g : DisequalityDispersion.Encoded.GInstance) (hv : g.Valid)
  (b : List ℕ),
  g.isCutB g.base.canonIds b = true → g.network.cap (g.cutSet hv (g.termCut hv b)) ≤ g.cutCard g.base.canonIds b
DisequalityDispersion.Encoded.GInstance.value_le_cutCard : ∀ (g : DisequalityDispersion.Encoded.GInstance),
  g.Valid →
    ∀ (b : List ℕ),
      g.isCutB g.base.canonIds b = true → g.network.value g.network.maxflow.toFinset ≤ g.cutCard g.base.canonIds b
DisequalityDispersion.Encoded.GInstance.pickOf : DisequalityDispersion.Encoded.GInstance → ℕ × ℕ → ℕ
DisequalityDispersion.Encoded.GInstance.picks : DisequalityDispersion.Encoded.GInstance → List ℕ → List ℕ
