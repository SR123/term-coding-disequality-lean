DisequalityDispersion.Encoded.digits : (n : ℕ) → [NeZero n] → (r : ℕ) → ℕ → Fin r → Fin n
DisequalityDispersion.Encoded.digits_idx : ∀ (n : ℕ) [inst : NeZero n] (r : ℕ) (args : Fin r → Fin n),
