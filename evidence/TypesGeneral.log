@DisequalityDispersion.Flow.Network.newFront_nil : ∀ {ν : Type} [inst : DecidableEq ν]
  (N : DisequalityDispersion.Flow.Network ν) (U : List (ν × ν)) (seen : List ν), N.newFront U seen [] = []
