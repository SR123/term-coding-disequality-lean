@DisequalityDispersion.Menger.exists_truncated_prefix : ∀ {α : Type} {E : Finset (α × α)} {A Z X : Finset α} {q : ℕ}
  (P : Fin q → List α),
  (∀ (j : Fin q), DisequalityDispersion.Menger.Walk E A Z X (P j)) →
    ∃ L z,
      ∀ (j : Fin q),
        DisequalityDispersion.Menger.Walk E A Z X (L j ++ [z j]) ∧
          (∀ v ∈ L j ++ [z j], v ∈ P j) ∧ z j ∈ Z ∧ ∀ v ∈ L j, v ∉ Z
@DisequalityDispersion.Menger.exists_truncated_suffix : ∀ {α : Type} {E : Finset (α × α)} {Z B X : Finset α} {q : ℕ}
  (Q : Fin q → List α),
  (∀ (j : Fin q), DisequalityDispersion.Menger.Walk E Z B X (Q j)) →
    ∃ r M,
      ∀ (j : Fin q),
        DisequalityDispersion.Menger.Walk E Z B X (r j :: M j) ∧
          (∀ v ∈ r j :: M j, v ∈ Q j) ∧ r j ∈ Z ∧ ∀ v ∈ M j, v ∉ Z
@DisequalityDispersion.Menger.meet_in_S : ∀ {α : Type} {E : Finset (α × α)} {A B S Z₁ Z₂ : Finset α},
  DisequalityDispersion.Menger.Separates E S A B →
    S ⊆ Z₁ →
      S ⊆ Z₂ →
        ∀ (L : List α) (p : α),
          DisequalityDispersion.Menger.Walk E A Z₁ ∅ (L ++ [p]) →
            (∀ v ∈ L, v ∉ Z₁) →
              ∀ (r : α) (M : List α),
                DisequalityDispersion.Menger.Walk E Z₂ B ∅ (r :: M) →
                  (∀ v ∈ M, v ∉ Z₂) → ∀ w ∈ L ++ [p], w ∈ r :: M → w ∈ S
@DisequalityDispersion.Menger.combine : ∀ {α : Type} [inst : DecidableEq α] (E : Finset (α × α)),
  ∀ e ∈ E,
    ∀ (A B S : Finset α) (q : ℕ),
      DisequalityDispersion.Menger.Separates (E.erase e) S A B →
        e.2 ∉ S →
          S.card + 1 = q →
            ∀ (P : Fin q → List α),
              (∀ (j : Fin q), DisequalityDispersion.Menger.Walk (E.erase e) A (insert e.1 S) ∅ (P j)) →
                DisequalityDispersion.Menger.PairwiseDisjoint P →
                  ∀ (Q : Fin q → List α),
                    (∀ (j : Fin q), DisequalityDispersion.Menger.Walk (E.erase e) (insert e.2 S) B ∅ (Q j)) →
                      DisequalityDispersion.Menger.PairwiseDisjoint Q →
                        ∃ W,
                          (∀ (j : Fin q), DisequalityDispersion.Menger.Walk E A B ∅ (W j)) ∧
                            DisequalityDispersion.Menger.PairwiseDisjoint W
@DisequalityDispersion.Menger.separates_empty_iff : ∀ {α : Type} [inst : DecidableEq α] (A B X : Finset α),
  DisequalityDispersion.Menger.Separates ∅ X A B ↔ A ∩ B ⊆ X
@DisequalityDispersion.Menger.menger_aux : ∀ {α : Type} [DecidableEq α] (n : ℕ) (E : Finset (α × α)),
  E.card = n →
    ∀ (A B : Finset α) (q : ℕ),
      (∀ (X : Finset α), DisequalityDispersion.Menger.Separates E X A B → q ≤ X.card) →
        ∃ ps,
          (∀ (j : Fin q), DisequalityDispersion.Menger.Walk E A B ∅ (ps j)) ∧
            DisequalityDispersion.Menger.PairwiseDisjoint ps
@DisequalityDispersion.Menger.menger : ∀ {α : Type} [DecidableEq α] (E : Finset (α × α)) (A B : Finset α) (q : ℕ),
  (∀ (X : Finset α), DisequalityDispersion.Menger.Separates E X A B → q ≤ X.card) →
    ∃ ps,
      (∀ (j : Fin q), DisequalityDispersion.Menger.Walk E A B ∅ (ps j)) ∧
        DisequalityDispersion.Menger.PairwiseDisjoint ps
@DisequalityDispersion.Term.size : {V F : Type} → {arity : F → ℕ} → DisequalityDispersion.Term V F arity → ℕ
@DisequalityDispersion.Term.size_arg_lt : ∀ {V F : Type} {arity : F → ℕ} (f : F)
  (ts : Fin (arity f) → DisequalityDispersion.Term V F arity) (i : Fin (arity f)),
  (ts i).size < (DisequalityDispersion.Term.app f ts).size
@DisequalityDispersion.isArg_size_lt : ∀ {V F : Type} {arity : F → ℕ} {u t : DisequalityDispersion.Term V F arity},
  DisequalityDispersion.IsArg u t → u.size < t.size
@DisequalityDispersion.argEdges : {V F : Type} →
  {arity : F → ℕ} →
    Finset (DisequalityDispersion.Term V F arity) →
      Finset (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity)
@DisequalityDispersion.mem_argEdges : ∀ {V F : Type} {arity : F → ℕ} (S : Finset (DisequalityDispersion.Term V F arity))
  (t u : DisequalityDispersion.Term V F arity),
  (t, u) ∈ DisequalityDispersion.argEdges S ↔ t ∈ S ∧ u ∈ S ∧ DisequalityDispersion.IsArg u t
@DisequalityDispersion.varVerts : {V F : Type} →
  {arity : F → ℕ} → Finset (DisequalityDispersion.Term V F arity) → Finset (DisequalityDispersion.Term V F arity)
@DisequalityDispersion.mem_varVerts : ∀ {V F : Type} {arity : F → ℕ} (S : Finset (DisequalityDispersion.Term V F arity))
  (t : DisequalityDispersion.Term V F arity),
  t ∈ DisequalityDispersion.varVerts S ↔ t ∈ S ∧ ∃ v, t = DisequalityDispersion.Term.var v
@DisequalityDispersion.walk_nodup : ∀ {V F : Type} {arity : F → ℕ} (S : Finset (DisequalityDispersion.Term V F arity))
  (l : List (DisequalityDispersion.Term V F arity)),
  List.IsChain (DisequalityDispersion.Menger.Adj (DisequalityDispersion.argEdges S)) l → l.Nodup
@DisequalityDispersion.walk_avoids : ∀ {V F : Type} {arity : F → ℕ}
  (S K : Finset (DisequalityDispersion.Term V F arity)) (l : List (DisequalityDispersion.Term V F arity))
  (t : DisequalityDispersion.Term V F arity),
  DisequalityDispersion.Menger.Walk (DisequalityDispersion.argEdges S) {t} (DisequalityDispersion.varVerts S) K l →
    DisequalityDispersion.Avoids K t
@DisequalityDispersion.avoids_walk : ∀ {V F : Type} {arity : F → ℕ} (S : Finset (DisequalityDispersion.Term V F arity)),
  DisequalityDispersion.SubtermClosed S →
    ∀ (K : Finset (DisequalityDispersion.Term V F arity)),
      ∀ t ∈ S,
        DisequalityDispersion.Avoids K t →
          ∃ l,
            DisequalityDispersion.Menger.Walk (DisequalityDispersion.argEdges S) {t} (DisequalityDispersion.varVerts S)
              K l
@DisequalityDispersion.separates_iff_isCut : ∀ {V F : Type} {arity : F → ℕ}
  (S : Finset (DisequalityDispersion.Term V F arity)),
  DisequalityDispersion.SubtermClosed S →
    ∀ (outputs : List (DisequalityDispersion.Term V F arity)),
      (∀ t ∈ outputs, t ∈ S) →
        ∀ (K : Finset (DisequalityDispersion.Term V F arity)),
          DisequalityDispersion.Menger.Separates (DisequalityDispersion.argEdges S) K outputs.toFinset
              (DisequalityDispersion.varVerts S) ↔
            DisequalityDispersion.IsCut K outputs
@DisequalityDispersion.nextOf : {V F : Type} →
  {arity : F → ℕ} →
    List (DisequalityDispersion.Term V F arity) →
      DisequalityDispersion.Term V F arity → Option (DisequalityDispersion.Term V F arity)
@DisequalityDispersion.nextOf_cons_cons_self : ∀ {V F : Type} {arity : F → ℕ}
  (a b : DisequalityDispersion.Term V F arity) (l : List (DisequalityDispersion.Term V F arity)),
  DisequalityDispersion.nextOf (a :: b :: l) a = some b
@DisequalityDispersion.nextOf_cons_cons_of_ne : ∀ {V F : Type} {arity : F → ℕ}
  (a b t : DisequalityDispersion.Term V F arity) (l : List (DisequalityDispersion.Term V F arity)),
  a ≠ t → DisequalityDispersion.nextOf (a :: b :: l) t = DisequalityDispersion.nextOf (b :: l) t
@DisequalityDispersion.routed_of_walk : ∀ {V F : Type} {arity : F → ℕ}
  (S : Finset (DisequalityDispersion.Term V F arity))
  (pred : DisequalityDispersion.Term V F arity → Option (DisequalityDispersion.Term V F arity)) (z : V)
  (l : List (DisequalityDispersion.Term V F arity)) (a : DisequalityDispersion.Term V F arity),
  List.IsChain (DisequalityDispersion.Menger.Adj (DisequalityDispersion.argEdges S)) (a :: l) →
    (a :: l).Nodup →
      (a :: l).getLast? = some (DisequalityDispersion.Term.var z) →
        (∀ t ∈ a :: l, pred t = DisequalityDispersion.nextOf (a :: l) t) → DisequalityDispersion.Routed pred z a
@DisequalityDispersion.mengerInput : ∀ {V F : Type} {arity : F → ℕ} [inst : Fintype V]
  (outputs : List (DisequalityDispersion.Term V F arity))
  (tests : List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity)),
  DisequalityDispersion.MengerInput outputs tests
@DisequalityDispersion.routing_lower_bound : ∀ {V F : Type} {arity : F → ℕ} [inst : Fintype V] [inst_1 : Fintype F]
  (outputs : List (DisequalityDispersion.Term V F arity))
  (tests : List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity)),
  (∀ uv ∈ tests, uv.1 ≠ uv.2) →
    ∀ (x : V) (n : ℕ),
      (DisequalityDispersion.tupleSupport outputs tests).card ≤ n →
        (n / (DisequalityDispersion.tupleSupport outputs tests).card) ^ DisequalityDispersion.cutSize outputs tests ≤
          DisequalityDispersion.dispersionTuple outputs tests
@DisequalityDispersion.strict_witness' : ∀ {V F : Type} {arity : F → ℕ} [inst : Fintype V] [inst_1 : Fintype F] (k : ℕ),
  1 ≤ k →
    ∀ (x y : V),
      x ≠ y →
        ∀ (outputs : List (DisequalityDispersion.Term V F arity))
          (tests : List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity)),
          (∀ uv ∈ tests, uv.1 ≠ uv.2) →
            k + 1 ≤ DisequalityDispersion.cutSize outputs tests →
              2 ≤ (DisequalityDispersion.tupleSupport outputs tests).card ^ (k + 1) ∧
                DisequalityDispersion.threshold k ((DisequalityDispersion.tupleSupport outputs tests).card ^ (k + 1)) +
                    1 ≤
                  DisequalityDispersion.dispersionTuple outputs tests
@DisequalityDispersion.strict_degree_iff' : ∀ {V F : Type} {arity : F → ℕ} [inst : Fintype V] [inst_1 : Fintype F]
  (k : ℕ),
  2 ≤ k →
    ∀ (x y : V),
      x ≠ y →
        ∀ (outputs : List (DisequalityDispersion.Term V F arity))
          (tests : List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity)),
          DisequalityDispersion.Term.var x ∈ outputs →
            DisequalityDispersion.Term.var y ∈ outputs →
              (DisequalityDispersion.Term.var x, DisequalityDispersion.Term.var y) ∈ tests →
                (DisequalityDispersion.StrictT k outputs tests ↔
                  (∀ uv ∈ tests, uv.1 ≠ uv.2) ∧ k + 1 ≤ DisequalityDispersion.cutSize outputs tests)
