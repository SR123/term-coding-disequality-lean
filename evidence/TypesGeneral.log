@DisequalityDispersion.Flow.Network.layersAux_flatten_subset : ∀ {ν : Type} [inst : DecidableEq ν]
  (N : DisequalityDispersion.Flow.Network ν) (U : List (ν × ν)) (k : ℕ) (seen front : List ν),
