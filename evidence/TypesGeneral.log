DisequalityDispersion.padMap_injective : ∀ (k : ℕ) (hk : 2 ≤ k), Function.Injective (DisequalityDispersion.padMap k hk)
@DisequalityDispersion.padTests : {F : Type} →
  {arity : F → ℕ} →
    (k : ℕ) →
      2 ≤ k →
        List (DisequalityDispersion.Term (Fin 2) F arity × DisequalityDispersion.Term (Fin 2) F arity) →
          List (DisequalityDispersion.Term (Fin k) F arity × DisequalityDispersion.Term (Fin k) F arity)
@DisequalityDispersion.pairImage : {F A : Type} →
  {arity : F → ℕ} →
    [Fintype A] →
      List (DisequalityDispersion.Term (Fin 2) F arity × DisequalityDispersion.Term (Fin 2) F arity) →
        DisequalityDispersion.Interpretation F arity A → Finset (A × A)
@DisequalityDispersion.pairImage_card : ∀ {F A : Type} {arity : F → ℕ} [inst : Fintype A]
  (tests : List (DisequalityDispersion.Term (Fin 2) F arity × DisequalityDispersion.Term (Fin 2) F arity))
