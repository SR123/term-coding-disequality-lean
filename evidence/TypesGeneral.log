DisequalityDispersion.threshold : ℕ → ℕ → ℕ
DisequalityDispersion.threshold_eq : ∀ (k n : ℕ), 1 ≤ k → DisequalityDispersion.threshold k n = n ^ (k - 1) * (n - 1)
DisequalityDispersion.threshold_two : ∀ (n : ℕ), DisequalityDispersion.threshold 2 n = n * (n - 1)
DisequalityDispersion.guard_count_eq_threshold : ∀ (k n : ℕ),
  2 ≤ k → n * (n - 1) * n ^ (k - 2) = DisequalityDispersion.threshold k n
DisequalityDispersion.threshold_mono : ∀ (j k n : ℕ),
  1 ≤ j → j ≤ k → 1 ≤ n → DisequalityDispersion.threshold j n ≤ DisequalityDispersion.threshold k n
@DisequalityDispersion.eval_eq_of_agree_on_cut : ∀ {V F A : Type} {arity : F → ℕ}
  (I : DisequalityDispersion.Interpretation F arity A) (a a' : V → A)
  (K : Finset (DisequalityDispersion.Term V F arity)),
  (∀ u ∈ K, DisequalityDispersion.Term.eval I a u = DisequalityDispersion.Term.eval I a' u) →
    ∀ (t : DisequalityDispersion.Term V F arity),
      ¬DisequalityDispersion.Avoids K t → DisequalityDispersion.Term.eval I a t = DisequalityDispersion.Term.eval I a' t
@DisequalityDispersion.tupleEval_eq_of_agree_on_cut : ∀ {V F A : Type} {arity : F → ℕ}
  (I : DisequalityDispersion.Interpretation F arity A) (a a' : V → A)
  (K : Finset (DisequalityDispersion.Term V F arity)) (outputs : List (DisequalityDispersion.Term V F arity)),
  DisequalityDispersion.IsCut K outputs →
    (∀ u ∈ K, DisequalityDispersion.Term.eval I a u = DisequalityDispersion.Term.eval I a' u) →
      DisequalityDispersion.tupleEval outputs I a = DisequalityDispersion.tupleEval outputs I a'
@DisequalityDispersion.cutRest : {V F : Type} →
  {arity : F → ℕ} →
    Finset (DisequalityDispersion.Term V F arity) → V → V → Finset (DisequalityDispersion.Term V F arity)
@DisequalityDispersion.cutRest_card : ∀ {V F : Type} {arity : F → ℕ} (K : Finset (DisequalityDispersion.Term V F arity))
  (x y : V),
  x ≠ y →
    DisequalityDispersion.Term.var x ∈ K →
      DisequalityDispersion.Term.var y ∈ K → (DisequalityDispersion.cutRest K x y).card = K.card - 2
@DisequalityDispersion.cutKey : {V F A : Type} →
  {arity : F → ℕ} →
    (K : Finset (DisequalityDispersion.Term V F arity)) →
      (x y : V) →
        DisequalityDispersion.Interpretation F arity A →
          (V → A) → (A × A) × ({ u // u ∈ DisequalityDispersion.cutRest K x y } → A)
@DisequalityDispersion.agree_of_cutKey_eq : ∀ {V F A : Type} {arity : F → ℕ}
  (K : Finset (DisequalityDispersion.Term V F arity)) (x y : V) (I : DisequalityDispersion.Interpretation F arity A)
  (a a' : V → A),
  DisequalityDispersion.cutKey K x y I a = DisequalityDispersion.cutKey K x y I a' →
    ∀ u ∈ K, DisequalityDispersion.Term.eval I a u = DisequalityDispersion.Term.eval I a' u
@DisequalityDispersion.filteredImage_card_le_cut : ∀ {V F A : Type} {arity : F → ℕ} [inst : Fintype V]
  [inst_1 : Fintype A] (x y : V) (outputs : List (DisequalityDispersion.Term V F arity))
  (tests : List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity)),
  (DisequalityDispersion.Term.var x, DisequalityDispersion.Term.var y) ∈ tests →
    ∀ (K : Finset (DisequalityDispersion.Term V F arity)),
      DisequalityDispersion.IsCut K outputs →
        ∀ (I : DisequalityDispersion.Interpretation F arity A),
          (DisequalityDispersion.filteredImage outputs tests I).card ≤
            Fintype.card A * (Fintype.card A - 1) * Fintype.card A ^ (DisequalityDispersion.cutRest K x y).card
@DisequalityDispersion.dispersionTuple_le_cut : ∀ {V F : Type} {arity : F → ℕ} [inst : Fintype V] [inst_1 : Fintype F]
  (x y : V),
  x ≠ y →
    ∀ (outputs : List (DisequalityDispersion.Term V F arity))
      (tests : List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity)),
      DisequalityDispersion.Term.var x ∈ outputs →
        DisequalityDispersion.Term.var y ∈ outputs →
          (DisequalityDispersion.Term.var x, DisequalityDispersion.Term.var y) ∈ tests →
            ∀ (K : Finset (DisequalityDispersion.Term V F arity)),
              DisequalityDispersion.IsCut K outputs →
                ∀ (n : ℕ),
                  DisequalityDispersion.dispersionTuple outputs tests ≤ DisequalityDispersion.threshold K.card n
@DisequalityDispersion.dispersionTuple_le_threshold : ∀ {V F : Type} {arity : F → ℕ} [inst : Fintype V]
  [inst_1 : Fintype F] (x y : V),
  x ≠ y →
    ∀ (outputs : List (DisequalityDispersion.Term V F arity))
      (tests : List (DisequalityDispersion.Term V F arity × DisequalityDispersion.Term V F arity)),
      DisequalityDispersion.Term.var x ∈ outputs →
        DisequalityDispersion.Term.var y ∈ outputs →
          (DisequalityDispersion.Term.var x, DisequalityDispersion.Term.var y) ∈ tests →
            ∀ (n : ℕ),
              DisequalityDispersion.dispersionTuple outputs tests ≤
                DisequalityDispersion.threshold (DisequalityDispersion.cutSize outputs tests) n
