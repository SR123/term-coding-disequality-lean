@DisequalityDispersion.Flow.Network.indeg_split : ∀ {ν : Type} [inst : DecidableEq ν] (G : Finset (ν × ν))
  (q : ν × ν → Prop) [inst_1 : DecidablePred q] (x : ν),
  DisequalityDispersion.Flow.Network.indeg (Finset.filter q G) x +
      DisequalityDispersion.Flow.Network.indeg ({a ∈ G | ¬q a}) x =
    DisequalityDispersion.Flow.Network.indeg G x
@DisequalityDispersion.Flow.Network.outdeg_split : ∀ {ν : Type} [inst : DecidableEq ν] (G : Finset (ν × ν))
  (q : ν × ν → Prop) [inst_1 : DecidablePred q] (x : ν),
