@DisequalityDispersion.Flow.Network.indeg_union : ∀ {ν : Type} [inst : DecidableEq ν] (G₁ G₂ : Finset (ν × ν)),
  Disjoint G₁ G₂ →
    ∀ (x : ν),
      DisequalityDispersion.Flow.Network.indeg (G₁ ∪ G₂) x =
        DisequalityDispersion.Flow.Network.indeg G₁ x + DisequalityDispersion.Flow.Network.indeg G₂ x
@DisequalityDispersion.Flow.Network.outdeg_union : ∀ {ν : Type} [inst : DecidableEq ν] (G₁ G₂ : Finset (ν × ν)),
  Disjoint G₁ G₂ →
