      N.t ∉ N.seen N.maxflow ∧
        N.s ∈ (N.seen N.maxflow).toFinset ∧
          N.t ∉ (N.seen N.maxflow).toFinset ∧ N.value N.maxflow.toFinset = N.cap (N.seen N.maxflow).toFinset
@DisequalityDispersion.Flow.Network.maxflow_minCut : ∀ {ν : Type} [inst : DecidableEq ν]
  (N : DisequalityDispersion.Flow.Network ν),
  N.Ok →
    (∀ (S : Finset ν), N.s ∈ S → N.t ∉ S → N.value N.maxflow.toFinset ≤ N.cap S) ∧
      ∃ S, N.s ∈ S ∧ N.t ∉ S ∧ N.value N.maxflow.toFinset = N.cap S
