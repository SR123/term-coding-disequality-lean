DisequalityDispersion.Encoded.mem_allLists : ∀ (n L : ℕ) (l : List ℕ),
  l ∈ DisequalityDispersion.Encoded.allLists n L ↔ l.length = L ∧ ∀ v ∈ l, v < n
@DisequalityDispersion.Encoded.cartesian : {α : Type} → List (List α) → List (List α)
@DisequalityDispersion.Encoded.mem_cartesian : ∀ {α : Type} (xss : List (List α)) (l : List α),
  l ∈ DisequalityDispersion.Encoded.cartesian xss ↔ List.Forall₂ (fun x xs => x ∈ xs) l xss
DisequalityDispersion.Encoded.idxL : ℕ → List ℕ → ℕ
DisequalityDispersion.Encoded.idxL_ofFn : ∀ (n r : ℕ) (args : Fin r → Fin n),
  DisequalityDispersion.Encoded.idxL n (List.map Fin.val (List.ofFn args)) = ∑ i, ↑(args i) * n ^ ↑i
DisequalityDispersion.Encoded.allTables : ℕ → DisequalityDispersion.Encoded.Instance → List (List (List ℕ))
DisequalityDispersion.Encoded.mem_allTables : ∀ (n : ℕ) (γ : DisequalityDispersion.Encoded.Instance)
  (tabs : List (List ℕ)),
  tabs ∈ DisequalityDispersion.Encoded.allTables n γ ↔
    tabs.length = γ.m ∧ ∀ (f : ℕ) (hf : f < tabs.length), tabs[f].length = n ^ γ.arityOf f ∧ ∀ v ∈ tabs[f], v < n
DisequalityDispersion.Encoded.tabInterp : (γ : DisequalityDispersion.Encoded.Instance) →
