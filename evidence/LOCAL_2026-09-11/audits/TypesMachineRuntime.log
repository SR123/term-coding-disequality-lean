DisequalityDispersion.Machine.countBody_spec : ∀ (m₀ : DisequalityDispersion.Machine.Mem) (bs : List Bool) (p : ℕ)
  (m : DisequalityDispersion.Machine.Mem),
  DisequalityDispersion.Machine.CountInv m₀ bs p m →
    (DisequalityDispersion.Machine.Cond.eq DisequalityDispersion.Machine.CONT DisequalityDispersion.Machine.ONE).eval
          m =
        true →
      ∃ m' k,
        ((DisequalityDispersion.Machine.add DisequalityDispersion.Machine.CNT DisequalityDispersion.Machine.CNT
                    DisequalityDispersion.Machine.ONE).seq
                ((DisequalityDispersion.Machine.add DisequalityDispersion.Machine.POS DisequalityDispersion.Machine.POS
                      DisequalityDispersion.Machine.ONE).seq
                  DisequalityDispersion.Machine.contM)).Exec
            m m' k ∧
          DisequalityDispersion.Machine.CountInv m₀ bs p m' ∧
            k ≤ 7 ∧ bs.length - m' DisequalityDispersion.Machine.POS < bs.length - m DisequalityDispersion.Machine.POS
DisequalityDispersion.Machine.countLoop_spec : ∀ (m₀ : DisequalityDispersion.Machine.Mem) (bs : List Bool) (p : ℕ)
  (m : DisequalityDispersion.Machine.Mem),
  DisequalityDispersion.Machine.CountInv m₀ bs p m →
    ∃ m' k,
      DisequalityDispersion.Machine.countLoop.Exec m m' k ∧
        DisequalityDispersion.Machine.CountInv m₀ bs p m' ∧
          (m' DisequalityDispersion.Machine.POS = bs.length ∨
              ∃ (h : m' DisequalityDispersion.Machine.POS < bs.length),
                bs[m' DisequalityDispersion.Machine.POS] = false) ∧
            k ≤ (bs.length - m DisequalityDispersion.Machine.POS) * 9 + 2
