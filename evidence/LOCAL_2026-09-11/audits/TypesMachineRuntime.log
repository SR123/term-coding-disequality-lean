    ∀ {q : ℕ},
      m DisequalityDispersion.Machine.POS = q →
        ∃ m' k,
          DisequalityDispersion.Machine.contM.Exec m m' k ∧
            k ≤ 5 ∧
              (m' DisequalityDispersion.Machine.CONT =
                  if h : q < bs.length then DisequalityDispersion.Machine.bitv bs[q] else 0) ∧
                DisequalityDispersion.Machine.Pres m m' (m DisequalityDispersion.Machine.HP)
