          k ≤ 8 ∧
            m' DisequalityDispersion.Machine.J = j ∧
              m' DisequalityDispersion.Machine.ONE = 1 ∧
                DisequalityDispersion.Machine.BitInv m₀ bs q1 c (j + 1)
                  (m'.write DisequalityDispersion.Machine.J (j + 1))
