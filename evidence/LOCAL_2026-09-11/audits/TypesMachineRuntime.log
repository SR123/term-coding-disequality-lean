@DisequalityDispersion.Machine.listLoop_spec : ∀ {α : Type} {f : List Bool → Option (α × List Bool)}
  {rep : DisequalityDispersion.Machine.Rep α},
  DisequalityDispersion.Machine.GoodRep rep →
    ∀ {elemM : DisequalityDispersion.Machine.Cmd} {W : List ℕ} {S d : ℕ},
      DisequalityDispersion.Machine.ParserSpec elemM f rep W S d →
        DisequalityDispersion.Encoded.Progress f →
          DisequalityDispersion.Machine.SuffixP f →
            DisequalityDispersion.Machine.GoodVars W →
              ∀ l ≤ 1,
                DisequalityDispersion.Machine.A_ l ∉ W ∧
                    DisequalityDispersion.Machine.NEL l ∉ W ∧
                      DisequalityDispersion.Machine.JJ l ∉ W ∧ DisequalityDispersion.Machine.CC l ∉ W →
                  ∀ (r : ℕ) (bs : List Bool) (A n j p : ℕ) (m : DisequalityDispersion.Machine.Mem),
                    DisequalityDispersion.Machine.LInv bs l A n j p m →
                      r = n - j →
                        ∃ m' k,
                          (DisequalityDispersion.Machine.listLoop l elemM).Exec m m' k ∧
                            (∀ x < m DisequalityDispersion.Machine.HP,
                                x ∉ W →
                                  x ∉ DisequalityDispersion.Machine.loopVars l →
                                    ¬(A + 1 + j ≤ x ∧ x < A + 1 + n) → m' x = m x) ∧
                              DisequalityDispersion.Machine.PState m' bs ∧
                                m DisequalityDispersion.Machine.HP ≤ m' DisequalityDispersion.Machine.HP ∧
                                  m' (DisequalityDispersion.Machine.A_ l) = A ∧
                                    m' (DisequalityDispersion.Machine.NEL l) = n ∧
                                      DisequalityDispersion.Machine.LResult rep m m' bs l A j n
                                          (DisequalityDispersion.Encoded.decodeN f r (List.drop p bs)) ∧
                                        k ≤ (bs.length - p + 1) * (S * (bs.length - p + 1) ^ d + 14) + 2
